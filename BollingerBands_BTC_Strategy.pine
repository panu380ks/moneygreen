//@version=6
strategy("Bollinger Bands Strategy directed", overlay=true,
     initial_capital=1000000, default_qty_type=strategy.percent_of_equity,
     default_qty_value=100, commission_type=strategy.commission.percent,
     commission_value=0.04, slippage=2, pyramiding=0)

source = close
length = input.int(20, minval=1)
mult = input.float(1.5, "Band Multiplier", minval=0.001, maxval=50, step=0.1,
     tooltip="Tighter bands (1.5) = more signals near price. Original was 2.0")
direction = input.int(0, title="Strategy Direction", minval=-1, maxval=1)

// ── Session Filter ──
sessionStart = input.int(8, "Session Start Hour", minval=0, maxval=23, group="Session")
sessionEnd   = input.int(16, "Session End Hour", minval=0, maxval=23, group="Session")

// ── Trend Filter ──
useTrend  = input.bool(true, "Use Trend Filter", group="Trend")
trendLen  = input.int(200, "Trend EMA Length", minval=10, maxval=500, group="Trend")
trendLen2 = input.int(50, "Fast EMA Length", minval=5, maxval=200, group="Trend",
     tooltip="Fast EMA confirms trend direction with the slow EMA")

// ── Drawdown Filter ──
useDD       = input.bool(true, "Use Drawdown Filter", group="Drawdown")
maxDDPct    = input.float(5.0, "Max Drawdown %", minval=1.0, maxval=50.0, step=0.5, group="Drawdown",
     tooltip="Pause new entries when equity drops this % from peak")
cooldownBars = input.int(20, "Cooldown Bars After DD", minval=1, maxval=100, group="Drawdown",
     tooltip="Wait this many bars after drawdown clears before re-entering")

strategy.risk.allow_entry_in(direction == 0 ? strategy.direction.all : (direction < 0 ? strategy.direction.short : strategy.direction.long))

// ── Bollinger Bands (tighter) ──
basis = ta.sma(source, length)
dev = mult * ta.stdev(source, length)
upper = basis + dev
lower = basis - dev

// ── Trend Filter: dual EMA ──
slowEMA = ta.ema(source, trendLen)
fastEMA = ta.ema(source, trendLen2)
trendBull = not useTrend or (fastEMA > slowEMA and source > slowEMA)
trendBear = not useTrend or (fastEMA < slowEMA and source < slowEMA)

// ── Drawdown Filter: equity circuit breaker ──
var float peakEquity = strategy.initial_capital
var int   barsSinceDDClear = cooldownBars  // start ready to trade

peakEquity := math.max(peakEquity, strategy.equity)
currentDD  = (peakEquity - strategy.equity) / peakEquity * 100

inDrawdown = useDD and currentDD >= maxDDPct

// Track cooldown: once drawdown clears, count bars before re-entry
if inDrawdown
    barsSinceDDClear := 0
else
    barsSinceDDClear := barsSinceDDClear + 1

ddAllowed = not useDD or (not inDrawdown and barsSinceDDClear >= cooldownBars)

// Reset peak after cooldown clears so we track from current level
if ddAllowed and barsSinceDDClear == cooldownBars
    peakEquity := strategy.equity

// ── Session Filter ──
inSession = hour >= sessionStart and hour < sessionEnd

// ── Combined entry conditions ──
canTrade = inSession and ddAllowed

if (ta.crossover(source, lower)) and canTrade and trendBull
    strategy.entry("BBandLE", strategy.long, stop=lower, oca_name="BollingerBands", oca_type=strategy.oca.cancel, comment="BBandLE")
else
    strategy.cancel(id="BBandLE")

if (ta.crossunder(source, upper)) and canTrade and trendBear
    strategy.entry("BBandSE", strategy.short, stop=upper, oca_name="BollingerBands", oca_type=strategy.oca.cancel, comment="BBandSE")
else
    strategy.cancel(id="BBandSE")

// ── Exit long at upper band or basis lost ──
if strategy.position_size > 0
    if ta.crossover(source, upper)
        strategy.close("BBandLE", comment="TP Upper")
    if ta.crossunder(source, basis)
        strategy.close("BBandLE", comment="Exit Basis")

// ── Exit short at lower band or basis lost ──
if strategy.position_size < 0
    if ta.crossunder(source, lower)
        strategy.close("BBandSE", comment="TP Lower")
    if ta.crossover(source, basis)
        strategy.close("BBandSE", comment="Exit Basis")

// ── Force close all when drawdown circuit breaker trips ──
if inDrawdown and strategy.position_size != 0
    strategy.close_all(comment="DD Circuit Breaker")

// ── Plots ──
plot(basis, "Basis", color=color.new(#ffeb3b, 0))
p1 = plot(upper, "Upper", color=color.new(#ff5252, 0))
p2 = plot(lower, "Lower", color=color.new(#00e676, 0))
fill(p1, p2, color=color.new(#2196f3, 90), title="BB Fill")
plot(useTrend ? slowEMA : na, "Slow EMA", color=color.new(#ff9800, 0), linewidth=2)
plot(useTrend ? fastEMA : na, "Fast EMA", color=color.new(#ff9800, 50), linewidth=1)

// ── Drawdown dashboard ──
var table ddPanel = table.new(position.top_right, 2, 4, bgcolor=color.new(#1e1e1e, 20), border_width=1)
if barstate.islastconfirmedhistory or barstate.isrealtime
    table.cell(ddPanel, 0, 0, "Peak Equity", text_color=color.gray, text_size=size.small)
    table.cell(ddPanel, 1, 0, str.tostring(peakEquity, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(ddPanel, 0, 1, "Current DD%", text_color=color.gray, text_size=size.small)
    ddColor = currentDD >= maxDDPct ? color.red : (currentDD >= maxDDPct * 0.5 ? color.orange : color.green)
    table.cell(ddPanel, 1, 1, str.tostring(currentDD, "#.##") + "%", text_color=ddColor, text_size=size.small)
    table.cell(ddPanel, 0, 2, "Status", text_color=color.gray, text_size=size.small)
    table.cell(ddPanel, 1, 2, ddAllowed ? "TRADING" : (inDrawdown ? "HALTED" : "COOLDOWN"), text_color=ddAllowed ? color.green : color.red, text_size=size.small)
    table.cell(ddPanel, 0, 3, "Trend", text_color=color.gray, text_size=size.small)
    trendText = trendBull ? "BULL" : (trendBear ? "BEAR" : "NEUTRAL")
    trendColor = trendBull ? color.green : (trendBear ? color.red : color.gray)
    table.cell(ddPanel, 1, 3, trendText, text_color=trendColor, text_size=size.small)
//plot(strategy.equity, title="equity", color=color.red, linewidth=2, style=plot.style_areabr)
