//@version=6
strategy("Bollinger Bands Strategy directed", overlay=true,
     initial_capital=1000000, default_qty_type=strategy.percent_of_equity,
     default_qty_value=100, commission_type=strategy.commission.percent,
     commission_value=0.04, slippage=2, pyramiding=0)

source = close
length = input.int(20, minval=1)
mult = input.float(2.0, minval=0.001, maxval=50)
direction = input.int(0, title="Strategy Direction", minval=-1, maxval=1)

// ── Session Filter (supports overnight: e.g. 20 to 0) ──
sessionStart = input.int(20, "Session Start Hour", minval=0, maxval=23, group="Session")
sessionEnd   = input.int(0, "Session End Hour", minval=0, maxval=23, group="Session")

strategy.risk.allow_entry_in(direction == 0 ? strategy.direction.all : (direction < 0 ? strategy.direction.short : strategy.direction.long))

// ── Bollinger Bands ──
basis = ta.sma(source, length)
dev = mult * ta.stdev(source, length)
upper = basis + dev
lower = basis - dev

// ── Volume Color Filter ──
// Green candle = close > open (bullish), Red candle = close < open (bearish)
greenVol = close > open
redVol   = close < open

// ── Session Filter (handles overnight crossover: 20 to 0) ──
inSession = sessionStart <= sessionEnd ? (hour >= sessionStart and hour < sessionEnd) : (hour >= sessionStart or hour < sessionEnd)

// ── Entry: BB crossover + matching volume color ──
if (ta.crossover(source, lower)) and inSession and greenVol
    strategy.entry("BBandLE", strategy.long, stop=lower, oca_name="BollingerBands", oca_type=strategy.oca.cancel, comment="BBandLE")
else
    strategy.cancel(id="BBandLE")

if (ta.crossunder(source, upper)) and inSession and redVol
    strategy.entry("BBandSE", strategy.short, stop=upper, oca_name="BollingerBands", oca_type=strategy.oca.cancel, comment="BBandSE")
else
    strategy.cancel(id="BBandSE")

// ── Exit long at upper band or basis lost ──
if strategy.position_size > 0
    if ta.crossover(source, upper)
        strategy.close("BBandLE", comment="TP Upper")
    if ta.crossunder(source, basis)
        strategy.close("BBandLE", comment="Exit Basis")

// ── Exit short at lower band or basis lost ──
if strategy.position_size < 0
    if ta.crossunder(source, lower)
        strategy.close("BBandSE", comment="TP Lower")
    if ta.crossover(source, basis)
        strategy.close("BBandSE", comment="Exit Basis")

// ── Plots ──
plot(basis, "Basis", color=color.new(#ffeb3b, 0))
p1 = plot(upper, "Upper", color=color.new(#ff5252, 0))
p2 = plot(lower, "Lower", color=color.new(#00e676, 0))
fill(p1, p2, color=color.new(#2196f3, 90), title="BB Fill")
//plot(strategy.equity, title="equity", color=color.red, linewidth=2, style=plot.style_areabr)
