// This Pine Script™ is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
//
// MarketCipher B — Full Oscillator Strategy
// Recreates the complete MCB indicator look (WT, MF, SRSI, VWAP, momentum dots)
// with built-in strategy logic optimized for high trade frequency + profitability

//@version=6
strategy("MarketCipher B Strategy", shorttitle="MCB Strat", overlay=false,
     initial_capital=10000, default_qty_type=strategy.percent_of_equity,
     default_qty_value=100, commission_type=strategy.commission.percent,
     commission_value=0.04, slippage=2, pyramiding=0,
     calc_on_every_tick=false, process_orders_on_close=false,
     max_bars_back=500)

// ══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════════════════════════════════════════

// ── Wave Trend ──
wtChannelLen = input.int(9,   "WT Channel Length", group="Wave Trend")
wtAverageLen = input.int(12,  "WT Average Length", group="Wave Trend")
wtMALen      = input.int(3,   "WT MA Length", group="Wave Trend")

obLevel1 = input.int(60,   "Overbought 1", group="Wave Trend")
obLevel2 = input.int(53,   "Overbought 2", group="Wave Trend")
osLevel1 = input.int(-60,  "Oversold 1", group="Wave Trend")
osLevel2 = input.int(-53,  "Oversold 2", group="Wave Trend")

// ── Money Flow ──
mfLength   = input.int(50,     "MF Length", group="Money Flow")
mfMultiply = input.float(150,  "MF Multiplier", group="Money Flow")

// ── Stochastic RSI ──
srsiLen    = input.int(14, "SRSI Length", group="Stoch RSI")
stochLen   = input.int(14, "Stoch K Length", group="Stoch RSI")
smK        = input.int(3,  "Smooth K", group="Stoch RSI")
smD        = input.int(3,  "Smooth D", group="Stoch RSI")

// ── VWAP ──
useVWAP    = input.bool(true, "Show VWAP", group="VWAP")
vwapLen    = input.int(50,    "VWAP Lookback", group="VWAP")

// ── Strategy Settings ──
tradeMode  = input.string("All Crosses", "Entry Mode",
     options=["All Crosses", "Extreme Only", "Trend + Cross"], group="Strategy")
useOppExit = input.bool(true,  "Exit on Opposite Signal", group="Strategy")
useMFFilter = input.bool(false, "Require MF Confirmation", group="Strategy",
     tooltip="OFF = more trades. ON = fewer but higher quality.")
tradeDir   = input.string("Both", "Direction", options=["Long", "Short", "Both"], group="Strategy")

// ── Risk ──
atrLen       = input.int(14,    "ATR Length", group="Risk")
slMult       = input.float(1.5, "SL ATR Multiplier", minval=0.5, maxval=5.0, step=0.1, group="Risk")
tpMult       = input.float(3.0, "TP ATR Multiplier", minval=1.0, maxval=10.0, step=0.5, group="Risk")
usePartialTP = input.bool(true, "Partial TP (50% at half target)", group="Risk")
useTrail     = input.bool(true, "Trailing Stop After 1.5R", group="Risk")

// ── Visuals ──
showWT     = input.bool(true, "Show Wave Trend", group="Visuals")
showMF     = input.bool(true, "Show Money Flow", group="Visuals")
showSRSI   = input.bool(true, "Show Stoch RSI Dots", group="Visuals")
showSignals = input.bool(true, "Show Buy/Sell Signals", group="Visuals")
showDiv    = input.bool(true, "Show Divergences", group="Visuals")
showMomDots = input.bool(true, "Show Momentum Dots", group="Visuals")
showLevels = input.bool(true, "Show OB/OS Levels", group="Visuals")

// ══════════════════════════════════════════════════════════════════════════════
// WAVE TREND OSCILLATOR
// ══════════════════════════════════════════════════════════════════════════════

wtSrc = hlc3
esa   = ta.ema(wtSrc, wtChannelLen)
de    = ta.ema(math.abs(wtSrc - esa), wtChannelLen)
ci    = (wtSrc - esa) / (0.015 * de)
wt1   = ta.ema(ci, wtAverageLen)
wt2   = ta.sma(wt1, wtMALen)
wtDiff = wt1 - wt2

wtCrossUp   = ta.crossover(wt1, wt2)
wtCrossDown = ta.crossunder(wt1, wt2)

// ══════════════════════════════════════════════════════════════════════════════
// MONEY FLOW
// ══════════════════════════════════════════════════════════════════════════════

f_mf(_src, _len, _mult) =>
    _mfi     = ta.mfi(_src, _len)
    _upper   = ta.highest(_mfi, _len)
    _lower   = ta.lowest(_mfi, _len)
    _mid     = (_upper + _lower) / 2.0
    _range   = _upper - _lower
    _scaled  = _range != 0 ? ((_mfi - _mid) / _range) * _mult : 0.0
    _scaled

mfValue   = f_mf(hlc3, mfLength, mfMultiply)
mfBull    = mfValue > 0
mfBear    = mfValue < 0

// ══════════════════════════════════════════════════════════════════════════════
// STOCHASTIC RSI
// ══════════════════════════════════════════════════════════════════════════════

rsiVal   = ta.rsi(close, srsiLen)
stochRSI = ta.stoch(rsiVal, rsiVal, rsiVal, stochLen)
srsiK    = ta.sma(stochRSI, smK)
srsiD    = ta.sma(srsiK, smD)

// Scale SRSI to fit the WT pane (-100 to 100 range mapped to a smaller visual area)
srsiScaledK = (srsiK - 50) * 1.6  // maps 0-100 to roughly -80 to +80
srsiScaledD = (srsiD - 50) * 1.6

// ══════════════════════════════════════════════════════════════════════════════
// VWAP OSCILLATOR
// ══════════════════════════════════════════════════════════════════════════════

vwapOsc = 0.0
if useVWAP
    typPrice  = hlc3
    cumVol    = ta.sma(volume, vwapLen)
    cumPV     = ta.sma(typPrice * volume, vwapLen)
    vwapVal   = cumVol != 0 ? cumPV / cumVol : typPrice
    vwapDev   = typPrice - vwapVal
    devNorm   = ta.stdev(typPrice, vwapLen)
    vwapOsc  := devNorm != 0 ? (vwapDev / devNorm) * 25 : 0.0

// ══════════════════════════════════════════════════════════════════════════════
// DIVERGENCE DETECTION
// ══════════════════════════════════════════════════════════════════════════════

lkbk = 5

f_div(_src, _lkbk) =>
    _pLow    = ta.pivotlow(_src, _lkbk, _lkbk)
    _pHigh   = ta.pivothigh(_src, _lkbk, _lkbk)
    _srcLowP = ta.valuewhen(not na(_pLow),  _src[_lkbk], 1)
    _srcLowC = ta.valuewhen(not na(_pLow),  _src[_lkbk], 0)
    _prcLowP = ta.valuewhen(not na(_pLow),  low[_lkbk],  1)
    _prcLowC = ta.valuewhen(not na(_pLow),  low[_lkbk],  0)
    _srcHiP  = ta.valuewhen(not na(_pHigh), _src[_lkbk], 1)
    _srcHiC  = ta.valuewhen(not na(_pHigh), _src[_lkbk], 0)
    _prcHiP  = ta.valuewhen(not na(_pHigh), high[_lkbk], 1)
    _prcHiC  = ta.valuewhen(not na(_pHigh), high[_lkbk], 0)
    _bullD   = not na(_pLow)  and _prcLowC < _prcLowP and _srcLowC > _srcLowP
    _bearD   = not na(_pHigh) and _prcHiC  > _prcHiP  and _srcHiC  < _srcHiP
    [_bullD, _bearD]

[bullDiv, bearDiv] = f_div(wt2, lkbk)

// ══════════════════════════════════════════════════════════════════════════════
// MOMENTUM DOTS (based on WT momentum direction)
// ══════════════════════════════════════════════════════════════════════════════

momUp    = wt1 > wt1[1]
momDn    = wt1 < wt1[1]
momLevel = -80  // positioned at bottom of pane

// ══════════════════════════════════════════════════════════════════════════════
// SIGNAL CLASSIFICATION
// ══════════════════════════════════════════════════════════════════════════════

// Strong signals: WT cross in extreme zones
buyStrong  = wtCrossUp   and wt2 < osLevel1
buyMedium  = wtCrossUp   and wt2 < osLevel2 and not buyStrong
buyNormal  = wtCrossUp   and not buyStrong  and not buyMedium
sellStrong = wtCrossDown and wt2 > obLevel1
sellMedium = wtCrossDown and wt2 > obLevel2 and not sellStrong
sellNormal = wtCrossDown and not sellStrong  and not sellMedium

// Divergence signals
divBull = bullDiv and wt2 < osLevel2
divBear = bearDiv and wt2 > obLevel2

// ══════════════════════════════════════════════════════════════════════════════
// STRATEGY ENTRY LOGIC
// ══════════════════════════════════════════════════════════════════════════════

atrVal = ta.atr(atrLen)

// Money flow filter (optional)
mfLongOK  = not useMFFilter or mfBull
mfShortOK = not useMFFilter or mfBear

// Entry signals based on mode
var bool goLong  = false
var bool goShort = false

if tradeMode == "All Crosses"
    // Maximum trades: every WT cross triggers
    goLong  := (wtCrossUp or divBull) and mfLongOK
    goShort := (wtCrossDown or divBear) and mfShortOK
else if tradeMode == "Extreme Only"
    // Only trade extreme zone crosses + divergences
    goLong  := (buyStrong or buyMedium or divBull) and mfLongOK
    goShort := (sellStrong or sellMedium or divBear) and mfShortOK
else // "Trend + Cross"
    // WT cross + money flow must agree (medium frequency)
    goLong  := (wtCrossUp or divBull) and mfBull
    goShort := (wtCrossDown or divBear) and mfBear

allowLong  = tradeDir == "Long" or tradeDir == "Both"
allowShort = tradeDir == "Short" or tradeDir == "Both"

// ══════════════════════════════════════════════════════════════════════════════
// POSITION MANAGEMENT
// ══════════════════════════════════════════════════════════════════════════════

var float entryPrice  = na
var float slPrice     = na
var float tpPrice     = na
var float slDist      = na
var bool  partialDone = false

// Close on opposite signal
if useOppExit
    if strategy.position_size > 0 and goShort
        strategy.close("Long", comment="Opp Signal")
    if strategy.position_size < 0 and goLong
        strategy.close("Short", comment="Opp Signal")

// Long Entry
if goLong and allowLong and strategy.position_size <= 0
    if strategy.position_size < 0
        strategy.close("Short", comment="Flip Long")
    slD        = atrVal * slMult
    tpD        = atrVal * tpMult
    entryPrice := close
    slPrice    := close - slD
    tpPrice    := close + tpD
    slDist     := slD
    partialDone := false
    strategy.entry("Long", strategy.long)

// Short Entry
if goShort and allowShort and strategy.position_size >= 0
    if strategy.position_size > 0
        strategy.close("Long", comment="Flip Short")
    slD        = atrVal * slMult
    tpD        = atrVal * tpMult
    entryPrice := close
    slPrice    := close + slD
    tpPrice    := close - tpD
    slDist     := slD
    partialDone := false
    strategy.entry("Short", strategy.short)

// ══════════════════════════════════════════════════════════════════════════════
// EXIT MANAGEMENT — PARTIAL TP + TRAILING
// ══════════════════════════════════════════════════════════════════════════════

if strategy.position_size > 0 and not na(entryPrice) and not na(slDist) and slDist > 0
    profitR = (high - entryPrice) / slDist

    // Partial TP at half target
    if usePartialTP and not partialDone and profitR >= (tpMult / slMult) / 2
        closeQty    = math.max(math.floor(strategy.position_size * 50 / 100), 1)
        strategy.close("Long", comment="Partial TP", qty=closeQty)
        partialDone := true

    // Trailing: move SL to breakeven at 1.5R, then ratchet
    if useTrail
        if profitR >= 3.0
            slPrice := math.max(slPrice, entryPrice + slDist * 2.0)
        else if profitR >= 2.0
            slPrice := math.max(slPrice, entryPrice + slDist * 1.0)
        else if profitR >= 1.5
            slPrice := math.max(slPrice, entryPrice)

    strategy.exit("Long Exit", "Long", stop=slPrice, limit=tpPrice)

if strategy.position_size < 0 and not na(entryPrice) and not na(slDist) and slDist > 0
    profitR = (entryPrice - low) / slDist

    if usePartialTP and not partialDone and profitR >= (tpMult / slMult) / 2
        closeQty    = math.max(math.floor(math.abs(strategy.position_size) * 50 / 100), 1)
        strategy.close("Short", comment="Partial TP", qty=closeQty)
        partialDone := true

    if useTrail
        if profitR >= 3.0
            slPrice := math.min(slPrice, entryPrice - slDist * 2.0)
        else if profitR >= 2.0
            slPrice := math.min(slPrice, entryPrice - slDist * 1.0)
        else if profitR >= 1.5
            slPrice := math.min(slPrice, entryPrice)

    strategy.exit("Short Exit", "Short", stop=slPrice, limit=tpPrice)

// Reset on flat
if strategy.position_size == 0
    entryPrice  := na
    slPrice     := na
    tpPrice     := na
    slDist      := na
    partialDone := false

// ══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════  V I S U A L S  ════════════════════════════════════
// ══════════════════════════════════════════════════════════════════════════════

// ── OB/OS Level Lines ──
h1 = hline(obLevel1,  "OB 1",   color=color.new(color.red, 70),   linestyle=hline.style_dotted)
h2 = hline(obLevel2,  "OB 2",   color=color.new(color.red, 80),   linestyle=hline.style_dotted)
h3 = hline(0,         "Zero",   color=color.new(color.gray, 70),  linestyle=hline.style_dotted)
h4 = hline(osLevel2,  "OS 2",   color=color.new(color.green, 80), linestyle=hline.style_dotted)
h5 = hline(osLevel1,  "OS 1",   color=color.new(color.green, 70), linestyle=hline.style_dotted)

// OB/OS zone fills
fill(h1, h2, color=color.new(color.red, 92),   title="OB Zone")
fill(h4, h5, color=color.new(color.green, 92),  title="OS Zone")

// ── Wave Trend Lines ──
wtColor1 = wt1 > wt2 ? color.new(#00e5ff, 0) : color.new(#ff5252, 0)  // cyan when bullish, red when bearish
wtColor2 = color.new(#b2dfdb, 40)

plot(showWT ? wt1 : na, "WT1", color=wtColor1, linewidth=2)
plot(showWT ? wt2 : na, "WT2", color=wtColor2, linewidth=1, style=plot.style_line)

// WT cross-area fill (green when wt1>wt2, red when below)
wtFillColor = wt1 >= wt2 ? color.new(#00e676, 75) : color.new(#ff1744, 75)
p_wt1 = plot(showWT ? wt1 : na, "WT1 fill", color=color.new(color.white, 100), display=display.none)
p_wt2 = plot(showWT ? wt2 : na, "WT2 fill", color=color.new(color.white, 100), display=display.none)
fill(p_wt1, p_wt2, color=wtFillColor, title="WT Fill")

// ── Money Flow Histogram ──
mfColor = mfValue >= 0 ? (mfValue > mfValue[1] ? color.new(#00e676, 20) : color.new(#00e676, 55))
                       : (mfValue < mfValue[1] ? color.new(#ff1744, 20) : color.new(#ff1744, 55))
plot(showMF ? mfValue : na, "Money Flow", color=mfColor, style=plot.style_columns, linewidth=2)

// ── VWAP Line ──
plot(useVWAP ? vwapOsc : na, "VWAP Osc", color=color.new(#ffeb3b, 30), linewidth=1)

// ── Stochastic RSI Dots (small dots at the bottom region) ──
srsiDotColor = srsiK > srsiD ? color.new(#00e5ff, 20) : color.new(#ff6f00, 20)
plot(showSRSI ? srsiScaledK : na, "SRSI K", color=srsiDotColor, style=plot.style_circles, linewidth=1)

// ── Momentum Dots (very bottom of pane) ──
momColor = momUp ? color.new(#00e676, 0) : momDn ? color.new(#ff1744, 0) : color.new(color.gray, 50)
plot(showMomDots ? momLevel : na, "Momentum", color=momColor, style=plot.style_circles, linewidth=3)

// ══════════════════════════════════════════════════════════════════════════════
// SIGNAL MARKERS — matching MCB look
// ══════════════════════════════════════════════════════════════════════════════

// Buy signals — green circles/triangles below WT
plotshape(showSignals and buyStrong, "Strong Buy",
     shape.circle, location.absolute, color.new(#00e676, 0),
     size=size.normal, offset=0, text="", textcolor=color.white)
plotshape(showSignals and buyStrong, "Strong Buy Dot",
     shape.diamond, location.absolute, color.new(#00e676, 0),
     size=size.tiny, offset=0)

plotshape(showSignals and buyMedium, "Medium Buy",
     shape.circle, location.absolute, color.new(#00e676, 30),
     size=size.small, offset=0)

plotshape(showSignals and buyNormal and strategy.position_size <= 0, "Normal Buy",
     shape.triangleup, location.absolute, color.new(#00e676, 50),
     size=size.tiny, offset=0)

// Sell signals — red circles/triangles above WT
plotshape(showSignals and sellStrong, "Strong Sell",
     shape.circle, location.absolute, color.new(#ff1744, 0),
     size=size.normal, offset=0)
plotshape(showSignals and sellStrong, "Strong Sell Dot",
     shape.diamond, location.absolute, color.new(#ff1744, 0),
     size=size.tiny, offset=0)

plotshape(showSignals and sellMedium, "Medium Sell",
     shape.circle, location.absolute, color.new(#ff1744, 30),
     size=size.small, offset=0)

plotshape(showSignals and sellNormal and strategy.position_size >= 0, "Normal Sell",
     shape.triangledown, location.absolute, color.new(#ff1744, 50),
     size=size.tiny, offset=0)

// Divergence markers
plotshape(showDiv and divBull, "Bull Divergence",
     shape.labelup, location.absolute, color.new(#00bcd4, 0),
     size=size.tiny, text="D", textcolor=color.white, offset=-lkbk)
plotshape(showDiv and divBear, "Bear Divergence",
     shape.labeldown, location.absolute, color.new(#e040fb, 0),
     size=size.tiny, text="D", textcolor=color.white, offset=-lkbk)

// ══════════════════════════════════════════════════════════════════════════════
// DASHBOARD TABLE
// ══════════════════════════════════════════════════════════════════════════════

if barstate.islast
    var table dash = table.new(position.bottom_right, 2, 8,
         bgcolor=color.new(color.black, 15), border_width=1,
         border_color=color.new(color.gray, 60))

    // Header
    table.cell(dash, 0, 0, "MCB Strategy", text_color=color.white, text_size=size.small,
         bgcolor=color.new(#1565c0, 20), text_halign=text.align_center)
    table.merge_cells(dash, 0, 0, 1, 0)

    // Wave Trend
    table.cell(dash, 0, 1, "Wave Trend", text_color=color.white, text_size=size.tiny)
    wtZone = wt1 > obLevel1 ? "OVERBOUGHT" : wt1 < osLevel1 ? "OVERSOLD" :
             wt1 > obLevel2 ? "HIGH" : wt1 < osLevel2 ? "LOW" : "NEUTRAL"
    wtClr  = wt1 > obLevel2 ? color.red : wt1 < osLevel2 ? color.lime : color.gray
    table.cell(dash, 1, 1, wtZone, text_color=wtClr, text_size=size.tiny)

    // Money Flow
    table.cell(dash, 0, 2, "Money Flow", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 2, mfBull ? "BULLISH" : "BEARISH",
         text_color=mfBull ? color.lime : color.red, text_size=size.tiny)

    // SRSI
    table.cell(dash, 0, 3, "Stoch RSI", text_color=color.white, text_size=size.tiny)
    srsiZone = srsiK > 80 ? "OB" : srsiK < 20 ? "OS" : "MID"
    srsiClr  = srsiK > 80 ? color.red : srsiK < 20 ? color.lime : color.gray
    table.cell(dash, 1, 3, str.tostring(srsiK, "#") + " " + srsiZone,
         text_color=srsiClr, text_size=size.tiny)

    // Position
    table.cell(dash, 0, 4, "Position", text_color=color.white, text_size=size.tiny)
    posText = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"
    posClr  = strategy.position_size > 0 ? color.lime : strategy.position_size < 0 ? color.red : color.gray
    table.cell(dash, 1, 4, posText, text_color=posClr, text_size=size.tiny)

    // Current R
    curR = 0.0
    if strategy.position_size > 0 and not na(entryPrice) and not na(slDist) and slDist > 0
        curR := (close - entryPrice) / slDist
    if strategy.position_size < 0 and not na(entryPrice) and not na(slDist) and slDist > 0
        curR := (entryPrice - close) / slDist
    table.cell(dash, 0, 5, "Open P/L", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 5, str.tostring(curR, "#.##") + "R",
         text_color=curR >= 0 ? color.lime : color.red, text_size=size.tiny)

    // Win Rate
    wins   = strategy.wintrades
    losses = strategy.losstrades
    total  = wins + losses
    wr     = total > 0 ? (wins / total) * 100 : 0.0
    table.cell(dash, 0, 6, "Win Rate", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 6, str.tostring(wr, "#.#") + "% (" + str.tostring(total) + ")",
         text_color=wr >= 50 ? color.lime : color.orange, text_size=size.tiny)

    // Net Profit
    table.cell(dash, 0, 7, "Net Profit", text_color=color.white, text_size=size.tiny)
    np = strategy.netprofit
    table.cell(dash, 1, 7, str.tostring(np, "#.##"),
         text_color=np >= 0 ? color.lime : color.red, text_size=size.tiny)

// ══════════════════════════════════════════════════════════════════════════════
// BACKGROUND COLORING
// ══════════════════════════════════════════════════════════════════════════════

// Subtle background when in trade
bgcolor(strategy.position_size > 0 ? color.new(#00e676, 95) :
        strategy.position_size < 0 ? color.new(#ff1744, 95) : na)
