// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// ETH Market Structure Strategy v2 — Low Drawdown Edition
// Adapted from BTC version for Ethereum's higher-volatility profile
// Reads swing highs/lows, BOS, CHoCH, and liquidity sweeps
// 5-layer drawdown control: 200EMA gate, vol regime, equity curve, cooldown, dynamic sizing
// No lookahead — honest backtest results
//@version=6
strategy("ETH Market Structure v2", overlay=true,
     initial_capital=10000, default_qty_type=strategy.percent_of_equity,
     default_qty_value=100, commission_type=strategy.commission.percent,
     commission_value=0.075, slippage=3, pyramiding=0)

// Emergency brake — hard stop at 50% drawdown from peak
strategy.risk.max_drawdown(50, strategy.percent_of_equity)

// ═══════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════
strat_dir = input.string("long", "Direction", options=["long", "short", "all"])
strategy.risk.allow_entry_in(strat_dir == "long" ? strategy.direction.long : strat_dir == "short" ? strategy.direction.short : strategy.direction.all)

// Structure
swingLen   = input.int(4, "Swing Length", minval=2, maxval=20, group="Structure")
useHTF     = input.bool(true, "Use HTF Filter", group="Structure")
htfTF      = input.timeframe("D", "HTF Timeframe", group="Structure")

// Filters
emaFastLen = input.int(21, "Fast EMA", group="Filters")
emaSlowLen = input.int(50, "Slow EMA", group="Filters")
rsiLen     = input.int(14, "RSI Length", group="Filters")
volLen     = input.int(20, "Volume MA Length", group="Filters")

// Risk — ETH is more volatile so wider SL, scaled TPs
q1  = input.int(25, "TP1 Qty %", group="Risk")
q2  = input.int(25, "TP2 Qty %", group="Risk")
q3  = input.int(25, "TP3 Qty %", group="Risk")
tp1 = input.float(2.5, "TP1 %", step=0.5, group="Risk")
tp2 = input.float(6.0, "TP2 %", step=0.5, group="Risk")
tp3 = input.float(10.0, "TP3 %", step=1.0, group="Risk")
tp4 = input.float(16.0, "TP4 %", step=1.0, group="Risk")
sl  = input.float(5.0, "Stop Loss %", step=0.5, group="Risk")

// Drawdown controls
basePos      = input.float(75.0, "Base Position %", minval=10, maxval=100, step=5, group="Drawdown")
use200EMA    = input.bool(true, "200 EMA Trend Gate", group="Drawdown")
useVolFilter = input.bool(true, "Volatility Regime Filter", group="Drawdown")
volFilterLen = input.int(40, "Vol Filter MA Length", minval=10, group="Drawdown")
maxVolRatio  = input.float(1.8, "Max Vol Ratio", step=0.1, minval=1.0, maxval=3.0, group="Drawdown")
useEqFilter  = input.bool(true, "Equity Curve Filter", group="Drawdown")
eqFilterLen  = input.int(50, "Equity SMA Length", minval=10, group="Drawdown")
useCooldown  = input.bool(true, "Loss Cooldown", group="Drawdown")
coolBars     = input.int(5, "Cooldown Bars", minval=1, maxval=20, group="Drawdown")

// ═══════════════════════════════════════════════════════════════
// SWING DETECTION
// ═══════════════════════════════════════════════════════════════
swH = ta.pivothigh(high, swingLen, swingLen)
swL = ta.pivotlow(low, swingLen, swingLen)

var float lastSH = na
var float lastSL = na

// Detect breaks BEFORE updating levels
breakAbove = not na(lastSH) and close > lastSH and close[1] <= lastSH
breakBelow = not na(lastSL) and close < lastSL and close[1] >= lastSL

// Liquidity sweeps: wick beyond level, close back inside
sweepHigh = not na(lastSH) and high > lastSH and close < lastSH
sweepLow  = not na(lastSL) and low < lastSL and close > lastSL

// Update swing levels after break detection
if not na(swH)
    lastSH := swH
if not na(swL)
    lastSL := swL

// ═══════════════════════════════════════════════════════════════
// MARKET STRUCTURE TREND
// ═══════════════════════════════════════════════════════════════
var int msTrend = 0
if breakAbove
    msTrend := 1
if breakBelow
    msTrend := -1

// CHoCH = first break AGAINST prior trend (reversal)
chochBull = breakAbove and msTrend[1] <= 0
chochBear = breakBelow and msTrend[1] >= 0

// BOS = break WITH trend (continuation)
bosLong  = breakAbove and msTrend[1] == 1
bosShort = breakBelow and msTrend[1] == -1

// ═══════════════════════════════════════════════════════════════
// CONFLUENCE FILTERS
// ═══════════════════════════════════════════════════════════════
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)

rsiVal     = ta.rsi(close, rsiLen)
rsiOKlong  = rsiVal > 30 and rsiVal < 78
rsiOKshort = rsiVal > 22 and rsiVal < 70

volMA = ta.sma(volume, volLen)
volOK = na(volume) or volume > volMA * 0.8

// HTF trend — no lookahead
htfEma  = request.security(syminfo.tickerid, htfTF, ta.ema(close, 50))
htfBull = not useHTF or na(htfEma) or close > htfEma
htfBear = not useHTF or na(htfEma) or close < htfEma

// ═══════════════════════════════════════════════════════════════
// DRAWDOWN CONTROLS (5 layers)
// ═══════════════════════════════════════════════════════════════
atrVal = ta.atr(14)

// Layer 1 — 200 EMA trend gate: no longs in bear markets, no shorts in bull
ema200       = ta.ema(close, 200)
trendLongOK  = not use200EMA or close > ema200
trendShortOK = not use200EMA or close < ema200

// Layer 2 — Volatility regime: skip entries during crash/panic conditions
// ETH spikes harder so maxVolRatio defaults higher (1.8)
atrMA      = ta.sma(atrVal, volFilterLen)
volRatio   = atrVal / nz(atrMA, atrVal)
volRegimeOK = not useVolFilter or volRatio < maxVolRatio

// Layer 3 — Equity curve: stop trading during cascading losses
eqSMA    = ta.sma(strategy.equity, eqFilterLen)
equityOK = not useEqFilter or strategy.equity >= eqSMA

// Layer 4 — Loss cooldown: pause after stop loss hits
var int lastLossBar     = -999
var int prevClosedCount = 0
if strategy.closedtrades > prevClosedCount
    if strategy.closedtrades.profit(strategy.closedtrades - 1) < 0
        lastLossBar := bar_index
    prevClosedCount := strategy.closedtrades
cooldownOK = not useCooldown or (bar_index - lastLossBar) > coolBars

// Layer 5 — Dynamic position sizing: scale down in elevated volatility
// ETH thresholds slightly more generous since baseline vol is higher
volScale = useVolFilter ? (volRatio > 1.4 ? 0.5 : volRatio > 1.2 ? 0.75 : 1.0) : 1.0
unitQty  = strategy.equity * (basePos / 100.0) * volScale / close

// Combined drawdown gate
ddGate = volRegimeOK and equityOK and cooldownOK

// ═══════════════════════════════════════════════════════════════
// ENTRY CONDITIONS
// ═══════════════════════════════════════════════════════════════
// Structure breaks + confluence
longBreak  = (chochBull or (bosLong and close > emaFast)) and htfBull and rsiOKlong and volOK
shortBreak = (chochBear or (bosShort and close < emaFast)) and htfBear and rsiOKshort and volOK

// Liquidity sweep reversals — ETH sweeps tend to be sharper
longSweep  = sweepLow and msTrend >= 0 and htfBull and rsiVal < 45 and volOK
shortSweep = sweepHigh and msTrend <= 0 and htfBear and rsiVal > 55 and volOK

// Execute with drawdown controls
if (longBreak or longSweep) and ddGate and trendLongOK
    strategy.entry("Long", strategy.long, qty=unitQty)

if (shortBreak or shortSweep) and ddGate and trendShortOK
    strategy.entry("Short", strategy.short, qty=unitQty)

// ═══════════════════════════════════════════════════════════════
// EXITS — Tiered TP + SL + Structure Exit
// ═══════════════════════════════════════════════════════════════
per(pcnt) =>
    strategy.position_size != 0 ? math.round(pcnt / 100 * strategy.position_avg_price / syminfo.mintick) : float(na)

strategy.exit("x1", qty_percent=q1, profit=per(tp1), loss=per(sl))
strategy.exit("x2", qty_percent=q2, profit=per(tp2), loss=per(sl))
strategy.exit("x3", qty_percent=q3, profit=per(tp3), loss=per(sl))
strategy.exit("x4", profit=per(tp4), loss=per(sl))

// Structure-based exit: close on opposing CHoCH
if strategy.position_size > 0 and chochBear
    strategy.close("Long", comment="CHoCH Exit")
if strategy.position_size < 0 and chochBull
    strategy.close("Short", comment="CHoCH Exit")

// ═══════════════════════════════════════════════════════════════
// PLOTS
// ═══════════════════════════════════════════════════════════════
plot(lastSH, "Swing High", color.new(#ff5252, 30), style=plot.style_stepline_diamond)
plot(lastSL, "Swing Low", color.new(#00e676, 30), style=plot.style_stepline_diamond)
plot(emaFast, "EMA 21", color.new(#2196f3, 50))
plot(emaSlow, "EMA 50", color.new(#ff9800, 50))
plot(use200EMA ? ema200 : na, "EMA 200", color.new(#ffffff, 30), linewidth=2)
plot(useHTF and not na(htfEma) ? htfEma : na, "HTF EMA", color.new(#e040fb, 0), linewidth=2)

// Structure labels
plotshape(chochBull, "CHoCH Bull", shape.triangleup, location.belowbar, color.new(#00e676, 0), size=size.small, text="CHoCH")
plotshape(chochBear, "CHoCH Bear", shape.triangledown, location.abovebar, color.new(#ff5252, 0), size=size.small, text="CHoCH")
plotshape(bosLong and not chochBull, "BOS Long", shape.circle, location.belowbar, color.new(#2196f3, 0), size=size.tiny)
plotshape(bosShort and not chochBear, "BOS Short", shape.circle, location.abovebar, color.new(#ff9800, 0), size=size.tiny)
plotshape(longSweep, "Sweep Long", shape.diamond, location.belowbar, color.new(#00bcd4, 0), size=size.tiny)
plotshape(shortSweep, "Sweep Short", shape.diamond, location.abovebar, color.new(#ff6f00, 0), size=size.tiny)

// Trend background + drawdown gate warning
bgcolor(msTrend == 1 ? color.new(#00e676, 95) : msTrend == -1 ? color.new(#ff5252, 95) : na, title="Structure Trend")
bgcolor(not ddGate ? color.new(#ff9800, 88) : na, title="DD Gate Paused")
