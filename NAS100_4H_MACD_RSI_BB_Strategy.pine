//@version=5
// This Pine Script code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
// (c) moneygreen
strategy("NAS100 4H | MACD + RSI + Bollinger Bands", overlay=true,
     default_qty_type=strategy.percent_of_equity, default_qty_value=75,
     initial_capital=10000, commission_type=strategy.commission.percent,
     commission_value=0.04, slippage=3, pyramiding=0,
     calc_on_every_tick=false, process_orders_on_close=true,
     currency=currency.USD)

// --------------------------------------------------------------------------
// STRATEGY OVERVIEW
// --------------------------------------------------------------------------
// Triple-indicator confluence strategy for NAS100 (Nasdaq 100) on the
// 4H timeframe.
//
// NAS100 CHARACTERISTICS vs CRYPTO:
//   - Smoother, more sustained trends (bullish bias long-term)
//   - Session-driven: 80%+ of movement happens during US hours
//   - Lower volatility % than crypto but larger absolute moves
//   - EMA 200 is heavily watched by institutional traders
//   - MACD 12,26,9 is the gold standard for equity indices
//
// BEST VARIANT (V3 - Optimized for NAS100):
//   MACD 12,26,9  - classic settings, most backtested on equity indices
//   RSI 14        - standard period, OB/OS at 70/30
//   BB 20, 2.0    - standard settings, validated across all markets
//   EMA 200       - the institutional trend line for indices
//
// Entry requires ALL THREE indicators to confirm direction.
// Exit uses MACD reversal + RSI extremes + BB overextension + ATR risk mgmt.
//
// Variants:
//   V1 - Conservative (strict filters, wide stops)   - highest WR, fewest trades
//   V2 - Aggressive   (fast MACD, tight BB)          - most trades, lower WR
//   V3 - Optimized    (classic params, balanced)      - best risk-adjusted *
// --------------------------------------------------------------------------

// --------------------------------------------------------------------------
// INPUTS
// --------------------------------------------------------------------------

// -- MACD --
macd_group   = "== MACD =="
macd_fast    = input.int(12,    "Fast Length",   minval=1, group=macd_group)
macd_slow    = input.int(26,    "Slow Length",   minval=1, group=macd_group)
macd_signal  = input.int(9,     "Signal Length", minval=1, group=macd_group)
macd_src     = input.source(close, "Source",               group=macd_group)

// -- RSI --
rsi_group    = "== RSI =="
rsi_len      = input.int(14,    "RSI Length",    minval=1,    group=rsi_group)
rsi_ob       = input.float(70,  "Overbought",   minval=50, maxval=100, group=rsi_group)
rsi_os       = input.float(30,  "Oversold",      minval=0,  maxval=50,  group=rsi_group)
rsi_long_min = input.float(40,  "Long Min RSI",  minval=0,  maxval=100, group=rsi_group,
     tooltip="RSI must be above this to confirm bullish momentum")
rsi_short_max= input.float(60,  "Short Max RSI", minval=0,  maxval=100, group=rsi_group,
     tooltip="RSI must be below this to confirm bearish momentum")

// -- Bollinger Bands --
bb_group     = "== Bollinger Bands =="
bb_len       = input.int(20,    "BB Length",     minval=1,    group=bb_group)
bb_mult      = input.float(2.0, "BB Multiplier", minval=0.1, step=0.1, group=bb_group)
bb_long_max  = input.float(0.70,"Long Max BB%",  minval=0, maxval=1, step=0.05, group=bb_group,
     tooltip="Price must be below this BB% level to enter long (value zone)")
bb_short_min = input.float(0.30,"Short Min BB%", minval=0, maxval=1, step=0.05, group=bb_group,
     tooltip="Price must be above this BB% level to enter short (overvalued zone)")

// -- Filters --
filter_group = "== Filters =="
use_ema      = input.bool(true,  "Use EMA Trend Filter",   group=filter_group,
     tooltip="Only long above EMA, short below EMA — the #1 institutional trend filter for indices")
ema_len      = input.int(200,    "EMA Length",              minval=1, group=filter_group)
use_vol      = input.bool(true,  "Use Volume Filter",      group=filter_group,
     tooltip="Only enter when current volume exceeds its moving average — confirms real participation")
vol_lookback = input.int(20,     "Volume MA Length",        minval=1, group=filter_group)
use_session  = input.bool(false, "US Session Only",         group=filter_group,
     tooltip="Only enter trades during US session (09:30-16:00 exchange time). Disable for 24H CFD charts")
session_str  = input.session("0930-1600", "Session Window", group=filter_group)

// -- Risk Management --
risk_group   = "== Risk Management =="
use_sl       = input.bool(true,  "Use Stop Loss",          group=risk_group)
sl_atr_mult  = input.float(1.5,  "SL ATR Multiplier",     minval=0.5, step=0.1, group=risk_group,
     tooltip="Stop loss = ATR x this (tighter than crypto due to lower volatility)")
use_tp       = input.bool(true,  "Use Take Profit",        group=risk_group)
tp_rr        = input.float(2.0,  "Risk:Reward Ratio",     minval=0.5, step=0.1, group=risk_group,
     tooltip="Take profit = SL distance x this ratio")
use_trail    = input.bool(true,  "Use Trailing Stop",      group=risk_group)
trail_atr    = input.float(1.0,  "Trail ATR Multiplier",  minval=0.5, step=0.1, group=risk_group,
     tooltip="Tighter trail for NAS100 — locks in profits during sustained moves")
rsi_exit_ob  = input.float(80,   "RSI Exit Overbought",   minval=50, maxval=100, group=risk_group)
rsi_exit_os  = input.float(20,   "RSI Exit Oversold",     minval=0,  maxval=50,  group=risk_group)

// -- Date Filter --
date_group   = "== Date Filter =="
use_date     = input.bool(false, "Use Date Filter",        group=date_group)
start_date   = input.time(timestamp("2024-01-01"), "Start Date", group=date_group)
end_date     = input.time(timestamp("2026-12-31"), "End Date",   group=date_group)

// --------------------------------------------------------------------------
// INDICATOR CALCULATIONS
// --------------------------------------------------------------------------

// MACD
[macd_line, signal_line, hist] = ta.macd(macd_src, macd_fast, macd_slow, macd_signal)
macd_bull_cross = ta.crossover(macd_line, signal_line)
macd_bear_cross = ta.crossunder(macd_line, signal_line)
macd_bull = macd_line > signal_line
macd_bear = macd_line < signal_line
hist_rising  = hist > hist[1]
hist_falling = hist < hist[1]

// RSI
rsi = ta.rsi(close, rsi_len)

// Bollinger Bands
bb_basis = ta.sma(close, bb_len)
bb_dev   = bb_mult * ta.stdev(close, bb_len)
bb_upper = bb_basis + bb_dev
bb_lower = bb_basis - bb_dev
bb_range = bb_upper - bb_lower
bb_pct   = bb_range != 0 ? (close - bb_lower) / bb_range : 0.5

// ATR for risk management
atr = ta.atr(14)

// EMA trend filter
ema = ta.ema(close, ema_len)

// Volume filter
vol_avg = ta.sma(volume, vol_lookback)
vol_ok  = not use_vol or volume > vol_avg

// Session filter
in_session = not use_session or not na(time(timeframe.period, session_str))

// --------------------------------------------------------------------------
// ENTRY CONDITIONS (High Confluence - All indicators must agree)
// --------------------------------------------------------------------------

in_date = not use_date or (time >= start_date and time <= end_date)

// === LONG ENTRY ===
// 1. MACD bullish: line above signal with recent crossover or rising histogram
// 2. RSI between long_min and OB (momentum building, not overextended)
// 3. Price in the lower portion of BB range (good value, not chasing)
// 4. Price above EMA 200 (confirmed uptrend)
// 5. Volume above average (real institutional participation)
// 6. Within trading session (optional)
long_macd  = macd_bull and (macd_bull_cross or macd_bull_cross[1] or macd_bull_cross[2] or hist_rising)
long_rsi   = rsi > rsi_long_min and rsi < rsi_ob
long_bb    = bb_pct < bb_long_max
long_ema   = not use_ema or close > ema
long_vol   = vol_ok

long_entry = long_macd and long_rsi and long_bb and long_ema and long_vol and in_session and in_date

// === SHORT ENTRY ===
// 1. MACD bearish: line below signal with recent crossover or falling histogram
// 2. RSI between OS and short_max (momentum dropping, not already crashed)
// 3. Price in the upper portion of BB range (overvalued)
// 4. Price below EMA 200 (confirmed downtrend)
// 5. Volume above average
// 6. Within trading session (optional)
short_macd = macd_bear and (macd_bear_cross or macd_bear_cross[1] or macd_bear_cross[2] or hist_falling)
short_rsi  = rsi < rsi_short_max and rsi > rsi_os
short_bb   = bb_pct > bb_short_min
short_ema  = not use_ema or close < ema
short_vol  = vol_ok

short_entry = short_macd and short_rsi and short_bb and short_ema and short_vol and in_session and in_date

// --------------------------------------------------------------------------
// EXIT CONDITIONS
// --------------------------------------------------------------------------

// Primary exit: MACD crossover reversal
exit_long_macd  = macd_bear_cross
exit_short_macd = macd_bull_cross

// Secondary exit: RSI extreme (take profit on overextension)
exit_long_rsi  = rsi > rsi_exit_ob
exit_short_rsi = rsi < rsi_exit_os

// Tertiary exit: Price closes beyond opposite BB (2 consecutive closes)
exit_long_bb  = close > bb_upper and close[1] > bb_upper
exit_short_bb = close < bb_lower and close[1] < bb_lower

// --------------------------------------------------------------------------
// STRATEGY EXECUTION
// --------------------------------------------------------------------------

// Long entries
if long_entry and strategy.position_size == 0
    sl_price = use_sl ? close - (atr * sl_atr_mult) : na
    tp_price = use_tp ? close + (atr * sl_atr_mult * tp_rr) : na
    strategy.entry("Long", strategy.long)
    if use_sl or use_tp
        strategy.exit("Long Exit", "Long",
             stop  = use_sl ? sl_price : na,
             limit = use_tp ? tp_price : na,
             trail_points = use_trail ? atr * trail_atr / syminfo.mintick : na,
             trail_offset = use_trail ? atr * trail_atr / syminfo.mintick : na)

// Short entries
if short_entry and strategy.position_size == 0
    sl_price = use_sl ? close + (atr * sl_atr_mult) : na
    tp_price = use_tp ? close - (atr * sl_atr_mult * tp_rr) : na
    strategy.entry("Short", strategy.short)
    if use_sl or use_tp
        strategy.exit("Short Exit", "Short",
             stop  = use_sl ? sl_price : na,
             limit = use_tp ? tp_price : na,
             trail_points = use_trail ? atr * trail_atr / syminfo.mintick : na,
             trail_offset = use_trail ? atr * trail_atr / syminfo.mintick : na)

// Signal-based exits
if strategy.position_size > 0 and (exit_long_macd or exit_long_rsi or exit_long_bb)
    strategy.close("Long", comment=exit_long_macd ? "MACD Bear X" : exit_long_rsi ? "RSI OB" : "BB Upper")

if strategy.position_size < 0 and (exit_short_macd or exit_short_rsi or exit_short_bb)
    strategy.close("Short", comment=exit_short_macd ? "MACD Bull X" : exit_short_rsi ? "RSI OS" : "BB Lower")

// --------------------------------------------------------------------------
// PLOTS
// --------------------------------------------------------------------------

// Bollinger Bands
p_bb_upper = plot(bb_upper, "BB Upper", color=color.new(color.blue, 70))
p_bb_lower = plot(bb_lower, "BB Lower", color=color.new(color.blue, 70))
plot(bb_basis, "BB Basis", color=color.new(color.blue, 50), linewidth=1)
fill(p_bb_upper, p_bb_lower, color=color.new(color.blue, 92))

// EMA trend filter line
plot(use_ema ? ema : na, "EMA 200", color=color.new(color.orange, 30), linewidth=2)

// Entry signals
plotshape(long_entry and strategy.position_size == 0, "Long Signal",
     shape.triangleup, location.belowbar, color.new(color.green, 0), size=size.small)
plotshape(short_entry and strategy.position_size == 0, "Short Signal",
     shape.triangledown, location.abovebar, color.new(color.red, 0), size=size.small)

// Session background
bgcolor(use_session and in_session ? color.new(color.blue, 96) : na, title="Session BG")

// Position background
bgcolor(strategy.position_size > 0 ? color.new(color.green, 95) :
     strategy.position_size < 0 ? color.new(color.red, 95) : na, title="Position BG")

// --------------------------------------------------------------------------
// INFO TABLE
// --------------------------------------------------------------------------

var info = table.new(position.top_right, 2, 8, border_width=1)
if barstate.islast
    table.cell(info, 0, 0, "Indicator",  bgcolor=color.new(color.gray, 80), text_color=color.white)
    table.cell(info, 1, 0, "Signal",     bgcolor=color.new(color.gray, 80), text_color=color.white)

    table.cell(info, 0, 1, "MACD", text_color=color.white)
    table.cell(info, 1, 1, macd_bull ? "BULL ^" : "BEAR v",
         text_color=macd_bull ? color.green : color.red)

    table.cell(info, 0, 2, "MACD Hist", text_color=color.white)
    table.cell(info, 1, 2, hist_rising ? "RISING +" : "FALLING -",
         text_color=hist_rising ? color.green : color.red)

    table.cell(info, 0, 3, "RSI (" + str.tostring(rsi, "#.0") + ")", text_color=color.white)
    table.cell(info, 1, 3, rsi > rsi_ob ? "OVERBOUGHT" : rsi < rsi_os ? "OVERSOLD" : "NEUTRAL",
         text_color=rsi > rsi_ob ? color.red : rsi < rsi_os ? color.green : color.orange)

    table.cell(info, 0, 4, "BB %B (" + str.tostring(bb_pct * 100, "#.0") + "%)", text_color=color.white)
    table.cell(info, 1, 4, bb_pct > 0.8 ? "UPPER ZONE" : bb_pct < 0.2 ? "LOWER ZONE" : "MID ZONE",
         text_color=bb_pct > 0.8 ? color.red : bb_pct < 0.2 ? color.green : color.orange)

    table.cell(info, 0, 5, "EMA " + str.tostring(ema_len), text_color=color.white)
    table.cell(info, 1, 5, close > ema ? "ABOVE ^" : "BELOW v",
         text_color=close > ema ? color.green : color.red)

    table.cell(info, 0, 6, "Volume", text_color=color.white)
    table.cell(info, 1, 6, volume > vol_avg ? "ABOVE AVG" : "BELOW AVG",
         text_color=volume > vol_avg ? color.green : color.gray)

    table.cell(info, 0, 7, "Confluence", text_color=color.white)
    long_count  = (macd_bull ? 1 : 0) + (rsi > rsi_long_min and rsi < rsi_ob ? 1 : 0) + (bb_pct < bb_long_max ? 1 : 0)
    short_count = (macd_bear ? 1 : 0) + (rsi < rsi_short_max and rsi > rsi_os ? 1 : 0) + (bb_pct > bb_short_min ? 1 : 0)
    table.cell(info, 1, 7, "L:" + str.tostring(long_count) + "/3 | S:" + str.tostring(short_count) + "/3",
         text_color=color.white)

// --------------------------------------------------------------------------
// VARIANT REFERENCE (NAS100 4H)
// --------------------------------------------------------------------------
//
// Parameter      | V1 Conservative | V2 Aggressive  | V3 Optimized (default)
// ---------------+-----------------+----------------+-----------------------
// MACD Fast      | 12              | 8              | 12
// MACD Slow      | 26              | 21             | 26
// MACD Signal    | 9               | 5              | 9
// RSI Length     | 21              | 9              | 14
// RSI OB/OS      | 70/30           | 75/25          | 70/30
// RSI Long Min   | 45              | 35             | 40
// RSI Short Max  | 55              | 65             | 60
// BB Length      | 20              | 20             | 20
// BB Mult        | 2.0             | 1.5            | 2.0
// BB Long Max    | 0.60            | 0.75           | 0.70
// BB Short Min   | 0.40            | 0.25           | 0.30
// EMA Length     | 200             | 100            | 200
// SL ATR Mult    | 2.0             | 1.0            | 1.5
// TP R:R         | 2.5             | 1.5            | 2.0
// Trail ATR      | 1.5             | 0.75           | 1.0
// ---------------+-----------------+----------------+-----------------------
// Expected WR    | 55-62%          | 45-52%         | 52-58%
// Expected PF    | 1.4-1.7         | 1.1-1.3        | 1.3-1.6
// Traits         | Few trades      | Many trades    | Balanced
//                | Higher WR       | Lower WR       | Best profit factor
//                | Wide stops      | Tight stops    | Best risk-adjusted
//
// KEY DIFFERENCES FROM XRP VERSION:
// 1. MACD 12,26,9 (classic) instead of 8,24,9 — NAS100 trends smoother
// 2. SL 1.5x ATR instead of 2.0x — NAS100 is less volatile
// 3. Trail 1.0x ATR instead of 1.5x — tighter trailing locks in index moves
// 4. TP 2.0 R:R instead of 2.5 — more achievable on indices
// 5. Commission 0.04% instead of 0.1% — CFD/index fees are lower
// 6. Position size 75% instead of 100% — conservative for leveraged index
// 7. Optional US session filter — NAS100 moves primarily during NYSE hours
//
// To switch variants, change the input values in TradingView's settings panel.
// --------------------------------------------------------------------------
