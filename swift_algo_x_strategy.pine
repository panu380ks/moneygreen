//@version=6
strategy("Swift Algo X - RayAlgo Style Structure Strategy", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=200, pyramiding=0, process_orders_on_close=true)

// ============================================================================
// INPUTS
// ============================================================================
string GRP_CORE   = "Core Settings"
string GRP_SIGNAL = "Signal Settings"
string GRP_STRUCT = "Market Structure"
string GRP_TP     = "Take Profit / Stop Loss"
string GRP_RAY    = "RayAlgo Style"
string GRP_VOL    = "Volume / Vector Candles"
string GRP_DASH   = "Dashboard"
string GRP_CONSOL = "Consolidation Filter"
string GRP_SPEED  = "Signal Speed"
string GRP_H1     = "1H Trend Reader"

// Core
sensitivity = input.timeframe("240", "Indicator Sensitivity", group=GRP_CORE, tooltip="Higher timeframe for trend context. 1H to 4H recommended for more trades")
multiplier  = input.float(1.5, "Multiplier", minval=0.1, step=0.5, group=GRP_CORE)
period      = input.int(2, "Swing Period", minval=1, group=GRP_CORE)
atrLength   = input.int(14, "ATR Length", minval=1, group=GRP_CORE)
volDriftLen = input.int(3, "Volume Drift Length", minval=1, group=GRP_CORE)

// Signal
showBuy           = input.bool(true, "Show Buy Signals", group=GRP_SIGNAL)
showSell          = input.bool(true, "Show Sell Signals", group=GRP_SIGNAL)
showTP            = input.bool(true, "Show Take Profit Labels", group=GRP_SIGNAL)
showSL            = input.bool(true, "Show Stop Loss Lines", group=GRP_SIGNAL)
showSignalShapes  = input.bool(true, "Show Buy/Sell Markers", group=GRP_SIGNAL)
showRaySignals    = input.bool(true, "Show RayAlgo Signals", group=GRP_SIGNAL)
showSignalBarColor = input.bool(true, "Highlight Signal Bars", group=GRP_SIGNAL)
showStructure     = input.bool(true, "Show HH / HL Labels", group=GRP_SIGNAL)
showBosChoch      = input.bool(true, "Show BOS / CHOCH", group=GRP_SIGNAL)
showReversalTags  = input.bool(true, "Show Trend Reversal Tags", group=GRP_SIGNAL)
labelSize         = input.string("Small", "Label Size", options=["Tiny", "Small", "Normal", "Large"], group=GRP_SIGNAL)
signalSize        = input.string("Huge", "Signal Marker Size", options=["Small", "Normal", "Large", "Huge"], group=GRP_SIGNAL)
signalOffsetAtr   = input.float(0.30, "Signal Offset (ATR)", minval=0.0, step=0.05, group=GRP_SIGNAL)

// Structure rules
useTrendFilter    = input.bool(true, "Use Trend Direction Filter", group=GRP_STRUCT)
useHtfFilter      = input.bool(true, "Use Higher Timeframe Filter", group=GRP_STRUCT)
useMomentumFilter = input.bool(true, "Use EMA / Pressure Filter", group=GRP_STRUCT)
useVolatilityFilter = input.bool(true, "Use Volatility Filter", group=GRP_STRUCT)
allowContinuationEntries = input.bool(true, "Allow Trend Continuation Entries", group=GRP_STRUCT)
useRaySignalsForEntries = input.bool(true, "Use RayAlgo Signals For Entries", group=GRP_STRUCT)
closeConfirm      = input.bool(true, "Breakout Must Close Beyond Level", group=GRP_STRUCT)
emaLength         = input.int(34, "EMA Filter Length", minval=1, group=GRP_STRUCT)
breakoutBuffer    = input.float(0.05, "Breakout Buffer (ATR)", minval=0.0, step=0.05, group=GRP_STRUCT)
minPressure       = input.float(0.05, "Minimum Pressure Bias", minval=0.0, step=0.05, group=GRP_STRUCT)
minAtrPercent     = input.float(0.20, "Minimum ATR %", minval=0.0, step=0.05, group=GRP_STRUCT)
cooldownBars      = input.int(2, "Bars Between Entries", minval=0, group=GRP_STRUCT)

// TP / SL
tpMultiplier = input.float(2.2, "TP ATR Multiplier", minval=0.5, step=0.1, group=GRP_TP)
slMultiplier = input.float(0.9, "SL ATR Multiplier", minval=0.5, step=0.1, group=GRP_TP)
useTrailStop = input.bool(true, "Use Trailing Stop", group=GRP_TP, tooltip="Trail stop loss behind price as trade moves in your favor")
trailATRMult = input.float(1.2, "Trail ATR Multiplier", minval=0.5, step=0.1, group=GRP_TP)
useBreakeven = input.bool(true, "Move Stop To Breakeven", group=GRP_TP)
breakevenATR = input.float(1.0, "Breakeven Trigger (ATR)", minval=0.25, step=0.25, group=GRP_TP)
exitOnTrendFlip = input.bool(true, "Exit On Trend Flip", group=GRP_TP)

// RayAlgo style
showRayBands = input.bool(true, "Show Main Line + Wires", group=GRP_RAY)
showZones    = input.bool(true, "Show Buy / Sell Zones", group=GRP_RAY)
wireAtrStep  = input.float(0.35, "Wire Step (ATR)", minval=0.05, step=0.05, group=GRP_RAY)
rayRetestWire = input.int(2, "Signal Retest Wire", minval=1, maxval=5, group=GRP_RAY)
raySignalGap  = input.int(6, "Signal Gap Bars", minval=1, group=GRP_RAY)

// Volume / Vector candles
showVolumeMarkers      = input.bool(true, "Show Relative Volume Markers", group=GRP_VOL)
showVectorCandles      = input.bool(true, "Highlight Vector Candles", group=GRP_VOL)
showVectorSignals      = input.bool(true, "Show Vector Markers", group=GRP_VOL)
useVolumeFilter        = input.bool(true, "Use Relative Volume Filter", group=GRP_VOL)
requireVectorCandle    = input.bool(false, "Require Recent Vector Candle", group=GRP_VOL)
volumeMaLength         = input.int(20, "Volume SMA Length", minval=1, group=GRP_VOL)
minRelativeVolume      = input.float(1.10, "Min Relative Volume", minval=0.1, step=0.05, group=GRP_VOL)
vectorVolumeMultiplier = input.float(1.50, "Vector Volume Multiplier", minval=0.5, step=0.05, group=GRP_VOL)
vectorBodyRatio        = input.float(0.55, "Vector Body / Range Min", minval=0.1, maxval=1.0, step=0.05, group=GRP_VOL)
vectorLookback         = input.int(3, "Vector Lookback Bars", minval=1, group=GRP_VOL)

// Consolidation Filter (NEW)
useConsolidationFilter = input.bool(true, "Avoid Consolidation", group=GRP_CONSOL, tooltip="Block signals when market is ranging - uses ADX + BB Squeeze + Range Compression")
adxLen          = input.int(14, "ADX Length", minval=1, group=GRP_CONSOL)
adxSmooth       = input.int(14, "ADX Smoothing", minval=1, group=GRP_CONSOL)
minAdx          = input.float(20.0, "Minimum ADX (Trend Strength)", minval=5.0, step=0.5, group=GRP_CONSOL)
bbSqueezePeriod = input.int(20, "BB Squeeze Period", minval=1, group=GRP_CONSOL)
bbSqueezeKcMult = input.float(1.5, "KC Multiplier for Squeeze", minval=0.1, step=0.1, group=GRP_CONSOL)
rangeCompLen    = input.int(20, "Range Compression Lookback", minval=1, group=GRP_CONSOL)
rangeCompThresh = input.float(0.5, "Range Compression Threshold", minval=0.01, step=0.05, group=GRP_CONSOL)

// Signal Speed (NEW)
signalSpeed      = input.string("Normal", "Signal Speed", options=["Fast", "Normal", "Slow"], group=GRP_SPEED, tooltip="Fast = earlier signals, shorter cooldown. Slow = more confirmation")
useEarlyMomentum = input.bool(true, "Use Early Momentum Signals", group=GRP_SPEED, tooltip="Fast EMA cross as early entry trigger")
earlyEmaFast     = input.int(5, "Early EMA Fast", minval=1, group=GRP_SPEED)
earlyEmaSlow     = input.int(13, "Early EMA Slow", minval=1, group=GRP_SPEED)

// 1H Trend Reader (NEW)
showH1Trend        = input.bool(true, "Show 1H Trend Reader", group=GRP_H1)
h1Ema1Len          = input.int(8, "1H EMA Fast", minval=1, group=GRP_H1)
h1Ema2Len          = input.int(21, "1H EMA Mid", minval=1, group=GRP_H1)
h1Ema3Len          = input.int(55, "1H EMA Slow", minval=1, group=GRP_H1)
useH1TrendFilter   = input.bool(true, "Use 1H Trend For Entries", group=GRP_H1, tooltip="Only allow longs when 1H bullish, shorts when 1H bearish")

// Dashboard
showDashboard = input.bool(true, "Show Dashboard", group=GRP_DASH)
showBacktest  = input.bool(true, "Show Strategy Panel", group=GRP_DASH)

// ============================================================================
// HELPER: LABEL SIZE
// ============================================================================
lblSize = switch labelSize
    "Tiny" => size.tiny
    "Small" => size.small
    "Normal" => size.normal
    "Large" => size.large

sigSize = switch signalSize
    "Small" => size.small
    "Normal" => size.normal
    "Large" => size.large
    "Huge" => size.huge

// ============================================================================
// VOLUME-DRIFT MODEL
// ============================================================================
volUp        = volume * (close > open ? 1 : close < open ? 0 : 0.5)
volDown      = volume * (close < open ? 1 : close > open ? 0 : 0.5)
netPressure  = volUp - volDown
cumPressure  = nz(ta.sma(netPressure, volDriftLen) * volDriftLen, netPressure)
pressEmaFast = ta.ema(cumPressure, 3)
pressEmaSlow = ta.ema(cumPressure, 8)
pressSpread  = pressEmaFast - pressEmaSlow
pressStdev   = ta.stdev(pressSpread, 20)
normPressure = pressStdev != 0 ? pressSpread / pressStdev : 0
atr          = ta.atr(atrLength)
drift        = normPressure * atr * 0.5
projHigh     = high + drift
projLow      = low + drift

// ============================================================================
// RELATIVE VOLUME AND VECTOR CANDLES
// ============================================================================
volumeMa         = ta.sma(volume, volumeMaLength)
relativeVolume   = volumeMa != 0 ? volume / volumeMa : 0.0
volumeSpike      = relativeVolume >= minRelativeVolume
candleRange      = math.max(high - low, syminfo.mintick)
bodySize         = math.abs(close - open)
bodyRatio        = candleRange != 0 ? bodySize / candleRange : 0.0
closeLocation    = candleRange != 0 ? (close - low) / candleRange : 0.5
bullVectorCandle = close > open and relativeVolume >= vectorVolumeMultiplier and bodyRatio >= vectorBodyRatio and closeLocation >= 0.65
bearVectorCandle = close < open and relativeVolume >= vectorVolumeMultiplier and bodyRatio >= vectorBodyRatio and closeLocation <= 0.35
recentBullVector = nz(ta.barssince(bullVectorCandle), 1000000) < vectorLookback
recentBearVector = nz(ta.barssince(bearVectorCandle), 1000000) < vectorLookback
volumeBullOk     = not useVolumeFilter or volumeSpike
volumeBearOk     = not useVolumeFilter or volumeSpike
vectorBullOk     = not requireVectorCandle or recentBullVector
vectorBearOk     = not requireVectorCandle or recentBearVector
volumeStatusText = relativeVolume >= vectorVolumeMultiplier ? "Vector Flow" : volumeSpike ? "Elevated" : "Normal"
vectorStatusText = bullVectorCandle ? "Bull Vector" : bearVectorCandle ? "Bear Vector" : recentBullVector ? "Bull Recent" : recentBearVector ? "Bear Recent" : "None"
volumeStatusColor = bullVectorCandle ? color.new(color.lime, 35) : bearVectorCandle ? color.new(color.red, 35) : volumeSpike ? color.new(color.orange, 35) : color.new(color.gray, 70)
vectorStatusColor = bullVectorCandle ? color.new(color.lime, 20) : bearVectorCandle ? color.new(color.red, 20) : recentBullVector ? color.new(color.teal, 35) : recentBearVector ? color.new(color.maroon, 35) : color.new(color.gray, 70)

// ============================================================================
// ADAPTIVE TRAILING BANDS
// ============================================================================
basis      = math.avg(projHigh, projLow)
bandOffset = atr * multiplier
upperBand  = basis + bandOffset
lowerBand  = basis - bandOffset

var float trailUpper = na
var float trailLower = na
var int direction = 1

trailUpper := na(trailUpper[1]) ? upperBand : upperBand < trailUpper[1] or close[1] > trailUpper[1] ? upperBand : trailUpper[1]
trailLower := na(trailLower[1]) ? lowerBand : lowerBand > trailLower[1] or close[1] < trailLower[1] ? lowerBand : trailLower[1]
direction := na(direction[1]) ? 1 : direction[1] == -1 and close > trailUpper[1] ? 1 : direction[1] == 1 and close < trailLower[1] ? -1 : direction[1]
trailLine = direction == 1 ? trailLower : trailUpper

// ============================================================================
// FILTERS
// ============================================================================
htfClose      = request.security(syminfo.tickerid, sensitivity, close)
htfEma        = request.security(syminfo.tickerid, sensitivity, ta.ema(close, 21))
htfBullish    = htfClose > htfEma
htfBearish    = htfClose < htfEma
trendEma      = ta.ema(close, emaLength)
atrPercent    = close != 0 ? atr / close * 100 : 0.0
bullMomentum  = close > trendEma and normPressure >= minPressure and pressEmaFast > pressEmaSlow
bearMomentum  = close < trendEma and normPressure <= -minPressure and pressEmaFast < pressEmaSlow
volatilityOk  = atrPercent >= minAtrPercent

// ============================================================================
// CONSOLIDATION DETECTION (NEW)
// ============================================================================
// ADX
upMove   = high - high[1]
downMove = low[1] - low
plusDM   = (upMove > downMove and upMove > 0) ? upMove : 0.0
minusDM  = (downMove > upMove and downMove > 0) ? downMove : 0.0
trVal    = ta.rma(ta.tr, adxLen)
plusDI   = trVal != 0 ? 100.0 * ta.rma(plusDM, adxLen) / trVal : 0.0
minusDI  = trVal != 0 ? 100.0 * ta.rma(minusDM, adxLen) / trVal : 0.0
diSum    = plusDI + minusDI
dx       = diSum == 0 ? 0.0 : 100.0 * math.abs(plusDI - minusDI) / diSum
adxValue = ta.rma(dx, adxSmooth)
adxLow   = adxValue < minAdx

// Bollinger Band Squeeze
bbBasis  = ta.sma(close, bbSqueezePeriod)
bbDev    = ta.stdev(close, bbSqueezePeriod)
bbWidth  = (bbBasis + 2.0 * bbDev) - (bbBasis - 2.0 * bbDev)
kcBasis  = ta.ema(close, bbSqueezePeriod)
kcRange  = ta.atr(bbSqueezePeriod)
kcWidth  = 2.0 * bbSqueezeKcMult * kcRange
bbSqueeze = bbWidth < kcWidth

// Range Compression
currentRange    = high - low
avgRange        = ta.sma(currentRange, rangeCompLen)
rangeRatio      = avgRange != 0 ? currentRange / avgRange : 1.0
rangeCompressed = rangeRatio < rangeCompThresh

// Combined
isConsolidating  = adxLow or bbSqueeze or rangeCompressed
notConsolidating = not useConsolidationFilter or not isConsolidating
consolStatusText  = isConsolidating ? (adxLow ? "Low ADX" : bbSqueeze ? "BB Squeeze" : "Compressed") : "Trending"
consolStatusColor = isConsolidating ? color.new(color.orange, 25) : color.new(color.green, 35)

// ============================================================================
// SIGNAL SPEED (NEW)
// ============================================================================
speedMult = signalSpeed == "Fast" ? 0.5 : signalSpeed == "Slow" ? 2.0 : 1.0
effectiveCooldown = math.max(0, math.round(cooldownBars * speedMult))

// Early Momentum EMA Cross
earlyFast = ta.ema(close, earlyEmaFast)
earlySlow = ta.ema(close, earlyEmaSlow)
earlyBullCross = useEarlyMomentum ? ta.crossover(earlyFast, earlySlow) : false
earlyBearCross = useEarlyMomentum ? ta.crossunder(earlyFast, earlySlow) : false

// ============================================================================
// 1H TREND READER (NEW)
// ============================================================================
h1Ema1 = request.security(syminfo.tickerid, "60", ta.ema(close, h1Ema1Len))
h1Ema2 = request.security(syminfo.tickerid, "60", ta.ema(close, h1Ema2Len))
h1Ema3 = request.security(syminfo.tickerid, "60", ta.ema(close, h1Ema3Len))

h1TrendBull = h1Ema1 > h1Ema2 and h1Ema2 > h1Ema3
h1TrendBear = h1Ema1 < h1Ema2 and h1Ema2 < h1Ema3
h1BullOk    = not useH1TrendFilter or h1TrendBull
h1BearOk    = not useH1TrendFilter or h1TrendBear

h1TrendText  = h1TrendBull ? "BULLISH" : h1TrendBear ? "BEARISH" : "MIXED"
h1TrendColor = h1TrendBull ? color.new(color.green, 25) : h1TrendBear ? color.new(color.red, 25) : color.new(color.gray, 50)

// ============================================================================
// RAYALGO-STYLE MAIN LINES AND WIRES
// ============================================================================
wireStep = atr * wireAtrStep

bullMainLine = direction == 1 ? trailLine : na
bearMainLine = direction == -1 ? trailLine : na

bullWire1 = direction == 1 ? trailLine - wireStep * 1 : na
bullWire2 = direction == 1 ? trailLine - wireStep * 2 : na
bullWire3 = direction == 1 ? trailLine - wireStep * 3 : na
bullWire4 = direction == 1 ? trailLine - wireStep * 4 : na
bullWire5 = direction == 1 ? trailLine - wireStep * 5 : na

bearWire1 = direction == -1 ? trailLine + wireStep * 1 : na
bearWire2 = direction == -1 ? trailLine + wireStep * 2 : na
bearWire3 = direction == -1 ? trailLine + wireStep * 3 : na
bearWire4 = direction == -1 ? trailLine + wireStep * 4 : na
bearWire5 = direction == -1 ? trailLine + wireStep * 5 : na

bullRetestLine = switch rayRetestWire
    1 => bullWire1
    2 => bullWire2
    3 => bullWire3
    4 => bullWire4
    => bullWire5

bearRetestLine = switch rayRetestWire
    1 => bearWire1
    2 => bearWire2
    3 => bearWire3
    4 => bearWire4
    => bearWire5

// ============================================================================
// MARKET STRUCTURE
// ============================================================================
pivotHigh = ta.pivothigh(high, period, period)
pivotLow  = ta.pivotlow(low, period, period)

var float lastSwingHigh = na
var float prevSwingHigh = na
var float lastSwingLow  = na
var float prevSwingLow  = na
var string lastHighType = ""
var string lastLowType  = ""
var int structureBias   = 0

if not na(pivotHigh)
    prevSwingHigh := lastSwingHigh
    lastSwingHigh := pivotHigh
    lastHighType := na(prevSwingHigh) ? "SH" : pivotHigh > prevSwingHigh ? "HH" : "LH"
    if showStructure and bar_index >= period
        label.new(bar_index - period, pivotHigh, lastHighType, style=label.style_label_down, color=lastHighType == "HH" ? color.new(color.fuchsia, 0) : color.new(color.orange, 0), textcolor=color.white, size=lblSize)

if not na(pivotLow)
    prevSwingLow := lastSwingLow
    lastSwingLow := pivotLow
    lastLowType := na(prevSwingLow) ? "SL" : pivotLow > prevSwingLow ? "HL" : "LL"
    if showStructure and bar_index >= period
        label.new(bar_index - period, pivotLow, lastLowType, style=label.style_label_up, color=lastLowType == "HL" ? color.new(color.aqua, 0) : color.new(color.red, 0), textcolor=color.white, size=lblSize)

buyBreakLevel      = not na(lastSwingHigh) ? lastSwingHigh + atr * breakoutBuffer : na
sellBreakLevel     = not na(lastSwingLow) ? lastSwingLow - atr * breakoutBuffer : na
prevBuyBreakLevel  = nz(buyBreakLevel[1], buyBreakLevel)
prevSellBreakLevel = nz(sellBreakLevel[1], sellBreakLevel)

brokeAboveHigh = not na(buyBreakLevel) and (closeConfirm ? close > buyBreakLevel and close[1] <= prevBuyBreakLevel : high > buyBreakLevel and high[1] <= prevBuyBreakLevel)
brokeBelowLow  = not na(sellBreakLevel) and (closeConfirm ? close < sellBreakLevel and close[1] >= prevSellBreakLevel : low < sellBreakLevel and low[1] >= prevSellBreakLevel)

bullBreakTag = ""
bearBreakTag = ""

if brokeAboveHigh and not brokeBelowLow
    bullBreakTag := structureBias == -1 ? "CHOCH" : "BOS"
    structureBias := 1
else if brokeBelowLow
    bearBreakTag := structureBias == 1 ? "CHOCH" : "BOS"
    structureBias := -1

rawBuy  = brokeAboveHigh and lastLowType == "HL"
rawSell = brokeBelowLow and lastHighType == "HH"

bullContinuation = allowContinuationEntries and structureBias == 1 and direction == 1 and close > bullMainLine and low <= nz(bullWire1, trailLine) and close > open
bearContinuation = allowContinuationEntries and structureBias == -1 and direction == -1 and close < bearMainLine and high >= nz(bearWire1, trailLine) and close < open

bullTrendReversalSignal = direction == 1 and direction[1] == -1 and close > nz(bullMainLine, trailLine)
bearTrendReversalSignal = direction == -1 and direction[1] == 1 and close < nz(bearMainLine, trailLine)

bullRetestSignal = direction == 1 and structureBias >= 0 and not na(bullMainLine) and low <= nz(bullRetestLine, bullMainLine) and close >= nz(bullWire1, bullMainLine) and close > open and close > trendEma
bearRetestSignal = direction == -1 and structureBias <= 0 and not na(bearMainLine) and high >= nz(bearRetestLine, bearMainLine) and close <= nz(bearWire1, bearMainLine) and close < open and close < trendEma

bullChochSignal = bullBreakTag == "CHOCH" and direction == 1 and close > nz(bullMainLine, trailLine)
bearChochSignal = bearBreakTag == "CHOCH" and direction == -1 and close < nz(bearMainLine, trailLine)

rayBuySignalRaw  = bullTrendReversalSignal or bullChochSignal or bullRetestSignal
raySellSignalRaw = bearTrendReversalSignal or bearChochSignal or bearRetestSignal

var int lastRayBuyBar = na
var int lastRaySellBar = na

rayBuySignal  = rayBuySignalRaw and (na(lastRayBuyBar) or bar_index - lastRayBuyBar >= raySignalGap)
raySellSignal = raySellSignalRaw and (na(lastRaySellBar) or bar_index - lastRaySellBar >= raySignalGap)

if rayBuySignal
    lastRayBuyBar := bar_index

if raySellSignal
    lastRaySellBar := bar_index

baseBullFilter   = (not useTrendFilter or direction == 1) and (not useHtfFilter or htfBullish)
baseBearFilter   = (not useTrendFilter or direction == -1) and (not useHtfFilter or htfBearish)
passesBullFilter = baseBullFilter and (not useMomentumFilter or bullMomentum) and (not useVolatilityFilter or volatilityOk) and volumeBullOk and vectorBullOk
passesBearFilter = baseBearFilter and (not useMomentumFilter or bearMomentum) and (not useVolatilityFilter or volatilityOk) and volumeBearOk and vectorBearOk

// Early momentum entries (NEW) - aligned with existing filters
earlyBuyEntry  = earlyBullCross and baseBullFilter and notConsolidating and direction == 1 and close > trendEma
earlyBearEntry = earlyBearCross and baseBearFilter and notConsolidating and direction == -1 and close < trendEma

var int lastSignalBar = na
cooldownPassed = na(lastSignalBar) ? true : bar_index - lastSignalBar >= effectiveCooldown

primaryBuy  = rawBuy and passesBullFilter
primarySell = rawSell and passesBearFilter
contBuy     = bullContinuation and passesBullFilter
contSell    = bearContinuation and passesBearFilter
rayBuyEntry  = useRaySignalsForEntries and rayBuySignal and passesBullFilter
raySellEntry = useRaySignalsForEntries and raySellSignal and passesBearFilter

finalBuy  = (primaryBuy or contBuy or rayBuyEntry or earlyBuyEntry) and cooldownPassed and notConsolidating and h1BullOk
finalSell = (primarySell or contSell or raySellEntry or earlyBearEntry) and cooldownPassed and notConsolidating and h1BearOk

buyLabelText  = "BUY"
sellLabelText = "SELL"
var string buyReasonText = "Bull Bias"
var string sellReasonText = "Bear Bias"
if primaryBuy
    buyReasonText := "Structure"
else if contBuy
    buyReasonText := "Continuation"
else if rayBuyEntry
    buyReasonText := "RayAlgo"
else if earlyBuyEntry
    buyReasonText := "Early Mom"
else
    buyReasonText := "Bull Bias"
if primarySell
    sellReasonText := "Structure"
else if contSell
    sellReasonText := "Continuation"
else if raySellEntry
    sellReasonText := "RayAlgo"
else if earlyBearEntry
    sellReasonText := "Early Mom"
else
    sellReasonText := "Bear Bias"

if finalBuy and not finalSell
    strategy.entry("Long", strategy.long)
    lastSignalBar := bar_index
else if finalSell
    strategy.entry("Short", strategy.short)
    lastSignalBar := bar_index

// ============================================================================
// EXITS
// ============================================================================
var float longStop   = na
var float longLimit  = na
var float shortStop  = na
var float shortLimit = na

newLong  = strategy.position_size > 0 and strategy.position_size[1] <= 0
newShort = strategy.position_size < 0 and strategy.position_size[1] >= 0

if newLong
    longStop   := strategy.position_avg_price - atr * slMultiplier
    longLimit  := strategy.position_avg_price + atr * tpMultiplier
    shortStop  := na
    shortLimit := na
else if strategy.position_size <= 0
    longStop  := na
    longLimit := na

if newShort
    shortStop  := strategy.position_avg_price + atr * slMultiplier
    shortLimit := strategy.position_avg_price - atr * tpMultiplier
    longStop   := na
    longLimit  := na
else if strategy.position_size >= 0
    shortStop  := na
    shortLimit := na

if strategy.position_size > 0
    if na(longStop)
        longStop := strategy.position_avg_price - atr * slMultiplier
    structureLongStop = not na(lastSwingLow) ? lastSwingLow - atr * 0.10 : longStop
    longStop := math.max(longStop, structureLongStop)
    if useBreakeven and close - strategy.position_avg_price >= atr * breakevenATR
        longStop := math.max(longStop, strategy.position_avg_price)
    if useTrailStop
        longStop := math.max(longStop, close - atr * trailATRMult)
    longLimit := strategy.position_avg_price + atr * tpMultiplier
    strategy.exit("Long Exit", from_entry="Long", stop=longStop, limit=longLimit)
    if exitOnTrendFlip and direction == -1
        strategy.close("Long", comment="Trend Flip")

if strategy.position_size < 0
    if na(shortStop)
        shortStop := strategy.position_avg_price + atr * slMultiplier
    structureShortStop = not na(lastSwingHigh) ? lastSwingHigh + atr * 0.10 : shortStop
    shortStop := math.min(shortStop, structureShortStop)
    if useBreakeven and strategy.position_avg_price - close >= atr * breakevenATR
        shortStop := math.min(shortStop, strategy.position_avg_price)
    if useTrailStop
        shortStop := math.min(shortStop, close + atr * trailATRMult)
    shortLimit := strategy.position_avg_price - atr * tpMultiplier
    strategy.exit("Short Exit", from_entry="Short", stop=shortStop, limit=shortLimit)
    if exitOnTrendFlip and direction == 1
        strategy.close("Short", comment="Trend Flip")

longClosed  = strategy.position_size <= 0 and strategy.position_size[1] > 0
shortClosed = strategy.position_size >= 0 and strategy.position_size[1] < 0

longTPHit  = longClosed and not na(longLimit[1]) and high >= longLimit[1]
longSLHit  = longClosed and not longTPHit and not na(longStop[1]) and low <= longStop[1]
shortTPHit = shortClosed and not na(shortLimit[1]) and low <= shortLimit[1]
shortSLHit = shortClosed and not shortTPHit and not na(shortStop[1]) and high >= shortStop[1]

// ============================================================================
// ZONES
// ============================================================================
var box bullZone = na
var box bearZone = na

if showZones and finalBuy
    if not na(bullZone)
        box.delete(bullZone)
    bullZoneTop = math.max(close, nz(lastSwingHigh, close))
    bullZoneBottom = math.min(nz(lastSwingLow, close - atr), close - atr * 0.75)
    bullZone := box.new(bar_index - period, bullZoneTop, bar_index + 12, bullZoneBottom, bgcolor=color.new(color.aqua, 88), border_color=color.new(color.aqua, 50))

if showZones and finalSell
    if not na(bearZone)
        box.delete(bearZone)
    bearZoneTop = math.max(nz(lastSwingHigh, close + atr), close + atr * 0.75)
    bearZoneBottom = math.min(close, nz(lastSwingLow, close))
    bearZone := box.new(bar_index - period, bearZoneTop, bar_index + 12, bearZoneBottom, bgcolor=color.new(color.fuchsia, 88), border_color=color.new(color.fuchsia, 50))

if not na(bullZone)
    box.set_right(bullZone, bar_index + 12)

if not na(bearZone)
    box.set_right(bearZone, bar_index + 12)

// ============================================================================
// REVERSAL TAGS AND STRUCTURE LABELS
// ============================================================================
bullReversal = bullBreakTag == "CHOCH" or (direction == 1 and direction[1] == -1)
bearReversal = bearBreakTag == "CHOCH" or (direction == -1 and direction[1] == 1)

if showBosChoch and bullBreakTag != ""
    label.new(bar_index, buyBreakLevel, bullBreakTag, style=label.style_label_down, color=color.new(color.aqua, 0), textcolor=color.white, size=size.tiny)

if showBosChoch and bearBreakTag != ""
    label.new(bar_index, sellBreakLevel, bearBreakTag, style=label.style_label_up, color=color.new(color.fuchsia, 0), textcolor=color.white, size=size.tiny)

if showReversalTags and bullReversal
    label.new(bar_index, low, "Trend Reversal", style=label.style_label_up, color=color.new(color.teal, 30), textcolor=color.white, size=size.tiny)

if showReversalTags and bearReversal
    label.new(bar_index, high, "Trend Reversal", style=label.style_label_down, color=color.new(color.maroon, 30), textcolor=color.white, size=size.tiny)

// ============================================================================
// PLOTTING
// ============================================================================
plot(showRayBands ? bullMainLine : na, "Bullish Main Line", color=color.new(color.aqua, 0), linewidth=2)
plot(showRayBands ? bearMainLine : na, "Bearish Main Line", color=color.new(color.fuchsia, 0), linewidth=2)

plot(showRayBands ? bullWire1 : na, "Bull Wire 1", color=color.new(color.aqua, 10), linewidth=1)
plot(showRayBands ? bullWire2 : na, "Bull Wire 2", color=color.new(color.aqua, 20), linewidth=1)
plot(showRayBands ? bullWire3 : na, "Bull Wire 3", color=color.new(color.aqua, 35), linewidth=1)
plot(showRayBands ? bullWire4 : na, "Bull Wire 4", color=color.new(color.aqua, 50), linewidth=1)
plot(showRayBands ? bullWire5 : na, "Bull Wire 5", color=color.new(color.aqua, 65), linewidth=1)

plot(showRayBands ? bearWire1 : na, "Bear Wire 1", color=color.new(color.fuchsia, 10), linewidth=1)
plot(showRayBands ? bearWire2 : na, "Bear Wire 2", color=color.new(color.fuchsia, 20), linewidth=1)
plot(showRayBands ? bearWire3 : na, "Bear Wire 3", color=color.new(color.fuchsia, 35), linewidth=1)
plot(showRayBands ? bearWire4 : na, "Bear Wire 4", color=color.new(color.fuchsia, 50), linewidth=1)
plot(showRayBands ? bearWire5 : na, "Bear Wire 5", color=color.new(color.fuchsia, 65), linewidth=1)

plot(showSL and strategy.position_size > 0 ? longStop : na, "Long SL", color=color.new(color.red, 35), style=plot.style_linebr, linewidth=1)
plot(showSL and strategy.position_size < 0 ? shortStop : na, "Short SL", color=color.new(color.red, 35), style=plot.style_linebr, linewidth=1)
plot(strategy.position_size > 0 ? longLimit : na, "Long TP", color=color.new(color.green, 40), style=plot.style_linebr, linewidth=1)
plot(strategy.position_size < 0 ? shortLimit : na, "Short TP", color=color.new(color.purple, 40), style=plot.style_linebr, linewidth=1)

// 1H Trend Reader EMAs (NEW)
plot(showH1Trend ? h1Ema1 : na, "1H EMA Fast", color=color.new(color.orange, 30), linewidth=1)
plot(showH1Trend ? h1Ema2 : na, "1H EMA Mid", color=color.new(color.blue, 30), linewidth=1)
plot(showH1Trend ? h1Ema3 : na, "1H EMA Slow", color=color.new(color.purple, 30), linewidth=1)

buySignalY = low - atr * signalOffsetAtr
sellSignalY = high + atr * signalOffsetAtr
rayBuySignalY = low - atr * (signalOffsetAtr + 0.35)
raySellSignalY = high + atr * (signalOffsetAtr + 0.35)
volumeBullY = low - atr * (signalOffsetAtr + 0.14)
volumeBearY = high + atr * (signalOffsetAtr + 0.14)
vectorBullY = low - atr * (signalOffsetAtr + 0.55)
vectorBearY = high + atr * (signalOffsetAtr + 0.55)

plotshape(showSignalShapes and finalBuy ? buySignalY : na, title="Buy Signal Marker", text="BUY", style=shape.labelup, location=location.absolute, color=color.aqua, textcolor=color.white, size=size.huge)
plotshape(showSignalShapes and finalSell ? sellSignalY : na, title="Sell Signal Marker", text="SELL", style=shape.labeldown, location=location.absolute, color=color.fuchsia, textcolor=color.white, size=size.huge)
plotshape(showRaySignals and rayBuySignal ? rayBuySignalY : na, title="RayAlgo Buy Signal", text="BUY", style=shape.triangleup, location=location.absolute, color=color.new(color.lime, 0), textcolor=color.white, size=size.normal)
plotshape(showRaySignals and raySellSignal ? raySellSignalY : na, title="RayAlgo Sell Signal", text="SELL", style=shape.triangledown, location=location.absolute, color=color.new(color.red, 0), textcolor=color.white, size=size.normal)
plotshape(showVolumeMarkers and volumeSpike and close >= open ? volumeBullY : na, title="Bull Volume Spike", style=shape.circle, location=location.absolute, color=color.new(color.orange, 0), size=size.tiny)
plotshape(showVolumeMarkers and volumeSpike and close < open ? volumeBearY : na, title="Bear Volume Spike", style=shape.circle, location=location.absolute, color=color.new(color.orange, 0), size=size.tiny)
plotshape(showVectorSignals and bullVectorCandle ? vectorBullY : na, title="Bull Vector Candle", text="V+", style=shape.triangleup, location=location.absolute, color=color.new(color.lime, 0), textcolor=color.white, size=size.tiny)
plotshape(showVectorSignals and bearVectorCandle ? vectorBearY : na, title="Bear Vector Candle", text="V-", style=shape.triangledown, location=location.absolute, color=color.new(color.red, 0), textcolor=color.white, size=size.tiny)

// Early momentum markers (NEW)
plotshape(earlyBullCross and not finalBuy ? low - atr * (signalOffsetAtr + 0.70) : na, title="Early Bull Momentum", text="EM", style=shape.circle, location=location.absolute, color=color.new(color.lime, 30), textcolor=color.white, size=size.tiny)
plotshape(earlyBearCross and not finalSell ? high + atr * (signalOffsetAtr + 0.70) : na, title="Early Bear Momentum", text="EM", style=shape.circle, location=location.absolute, color=color.new(color.red, 30), textcolor=color.white, size=size.tiny)

if showBuy and finalBuy
    label.new(bar_index, buySignalY, buyLabelText, style=label.style_label_up, color=color.aqua, textcolor=color.white, size=lblSize)

if showSell and finalSell
    label.new(bar_index, sellSignalY, sellLabelText, style=label.style_label_down, color=color.fuchsia, textcolor=color.white, size=lblSize)

if showTP and longTPHit
    label.new(bar_index, high, "Long TP", style=label.style_label_down, color=color.new(color.blue, 20), textcolor=color.white, size=lblSize)

if showTP and shortTPHit
    label.new(bar_index, low, "Short TP", style=label.style_label_up, color=color.new(color.purple, 20), textcolor=color.white, size=lblSize)

signalBarColor = showSignalBarColor ? finalBuy ? color.new(color.aqua, 0) : finalSell ? color.new(color.fuchsia, 0) : na : na
vectorBarColor = showVectorCandles ? bullVectorCandle ? color.new(color.lime, 0) : bearVectorCandle ? color.new(color.red, 0) : na : na
barcolor(not na(signalBarColor) ? signalBarColor : vectorBarColor)
bgcolor(finalBuy ? color.new(color.aqua, 90) : finalSell ? color.new(color.fuchsia, 90) : na)

// Consolidation background (NEW)
bgcolor(useConsolidationFilter and isConsolidating ? color.new(color.gray, 92) : na, title="Consolidation Zone")

// ============================================================================
// DASHBOARDS
// ============================================================================
h1Bias = request.security(syminfo.tickerid, "60", close > ta.ema(close, 21) ? 1 : -1)
h4Bias = request.security(syminfo.tickerid, "240", close > ta.ema(close, 21) ? 1 : -1)
d1Bias = request.security(syminfo.tickerid, "D", close > ta.ema(close, 21) ? 1 : -1)

trendAge = nz(ta.barssince(direction != direction[1]), 0) + 1
strengthScore = math.abs(normPressure)
strengthText = strengthScore > 1.25 ? "Strong" : strengthScore > 0.60 ? "Building" : "Weak"
volatilityScore = math.min(10.0, math.max(1.0, atrPercent * 10.0))
signalText = finalBuy ? buyLabelText + " " + buyReasonText : finalSell ? sellLabelText + " " + sellReasonText : structureBias == 1 ? "Bull Bias" : structureBias == -1 ? "Bear Bias" : "Neutral"
structureText = lastHighType + " / " + lastLowType
mtfText = (h1Bias == 1 ? "H1 Bull" : "H1 Bear") + " | " + (h4Bias == 1 ? "H4 Bull" : "H4 Bear") + " | " + (d1Bias == 1 ? "D1 Bull" : "D1 Bear")

closedTrades = strategy.closedtrades
winTrades    = strategy.wintrades
lossTrades   = strategy.losstrades
winRate      = closedTrades > 0 ? (winTrades * 100.0 / closedTrades) : 0.0

if showBacktest and barstate.islast
    var table btPanel = table.new(position.top_right, 2, 6, border_width=1)
    table.cell(btPanel, 0, 0, "Strategy", bgcolor=color.new(color.gray, 40), text_color=color.white, text_size=size.tiny)
    table.cell(btPanel, 1, 0, "Stats", bgcolor=color.new(color.gray, 40), text_color=color.white, text_size=size.tiny)
    table.cell(btPanel, 0, 1, "Closed Trades", bgcolor=color.new(color.gray, 60), text_color=color.white, text_size=size.tiny)
    table.cell(btPanel, 1, 1, str.tostring(closedTrades), bgcolor=color.new(color.gray, 60), text_color=color.white, text_size=size.tiny)
    table.cell(btPanel, 0, 2, "Wins", bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(btPanel, 1, 2, str.tostring(winTrades), bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(btPanel, 0, 3, "Losses", bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(btPanel, 1, 3, str.tostring(lossTrades), bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(btPanel, 0, 4, "Win %", bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(btPanel, 1, 4, str.tostring(winRate, "#.##") + "%", bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(btPanel, 0, 5, "Net Profit", bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(btPanel, 1, 5, str.tostring(strategy.netprofit, "#.##"), bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)

if showDashboard and barstate.islast
    var table dash = table.new(position.bottom_right, 2, 12, border_width=1)
    trendColor = direction == 1 ? color.new(color.aqua, 20) : color.new(color.fuchsia, 20)
    signalColor = finalBuy ? color.new(color.aqua, 20) : finalSell ? color.new(color.fuchsia, 20) : color.new(color.gray, 55)
    strengthColor = strengthText == "Strong" ? color.new(color.green, 35) : strengthText == "Building" ? color.new(color.orange, 35) : color.new(color.red, 35)

    table.cell(dash, 0, 0, "RAYALGO DASHBOARD", bgcolor=color.new(color.gray, 25), text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 0, syminfo.ticker + " " + timeframe.period, bgcolor=color.new(color.gray, 25), text_color=color.white, text_size=size.tiny)
    table.cell(dash, 0, 1, "Trend", bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 1, direction == 1 ? "BULLISH" : "BEARISH", bgcolor=trendColor, text_color=color.white, text_size=size.tiny)
    table.cell(dash, 0, 2, "Structure", bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 2, structureText, bgcolor=color.new(color.orange, 40), text_color=color.white, text_size=size.tiny)
    table.cell(dash, 0, 3, "Strength", bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 3, strengthText, bgcolor=strengthColor, text_color=color.white, text_size=size.tiny)
    table.cell(dash, 0, 4, "Trend Age", bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 4, str.tostring(trendAge) + " bars", bgcolor=color.new(color.blue, 45), text_color=color.white, text_size=size.tiny)
    table.cell(dash, 0, 5, "Volatility", bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 5, str.tostring(volatilityScore, "#.0") + "/10", bgcolor=color.new(color.yellow, 45), text_color=color.white, text_size=size.tiny)
    table.cell(dash, 0, 6, "Signal", bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 6, signalText + " | " + mtfText, bgcolor=signalColor, text_color=color.white, text_size=size.tiny)
    table.cell(dash, 0, 7, "Rel Volume", bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 7, str.tostring(relativeVolume, "#.##") + "x | " + volumeStatusText, bgcolor=volumeStatusColor, text_color=color.white, text_size=size.tiny)
    table.cell(dash, 0, 8, "Vector", bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 8, vectorStatusText, bgcolor=vectorStatusColor, text_color=color.white, text_size=size.tiny)

    // Consolidation (NEW)
    table.cell(dash, 0, 9, "Consolidation", bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 9, consolStatusText + " | ADX " + str.tostring(adxValue, "#.0"), bgcolor=consolStatusColor, text_color=color.white, text_size=size.tiny)

    // 1H Trend (NEW)
    table.cell(dash, 0, 10, "1H Trend", bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 10, h1TrendText, bgcolor=h1TrendColor, text_color=color.white, text_size=size.tiny)

    // Signal Speed (NEW)
    speedStatusColor = signalSpeed == "Fast" ? color.new(color.orange, 35) : signalSpeed == "Slow" ? color.new(color.aqua, 35) : color.new(color.gray, 55)
    table.cell(dash, 0, 11, "Speed", bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 11, signalSpeed + " | CD " + str.tostring(effectiveCooldown), bgcolor=speedStatusColor, text_color=color.white, text_size=size.tiny)

// ============================================================================
// ALERTS
// ============================================================================
alertcondition(finalBuy, "Buy Signal", "Swift Algo X - RayAlgo Buy Signal")
alertcondition(finalSell, "Sell Signal", "Swift Algo X - RayAlgo Sell Signal")
alertcondition(rayBuySignal, "RayAlgo Buy Signal", "Swift Algo X - RayAlgo indicator-style Buy Signal")
alertcondition(raySellSignal, "RayAlgo Sell Signal", "Swift Algo X - RayAlgo indicator-style Sell Signal")
alertcondition(bullReversal, "Bullish Trend Reversal", "Swift Algo X - Bullish Trend Reversal")
alertcondition(bearReversal, "Bearish Trend Reversal", "Swift Algo X - Bearish Trend Reversal")
alertcondition(longTPHit, "Long TP Hit", "Swift Algo X - Long TP Reached")
alertcondition(shortTPHit, "Short TP Hit", "Swift Algo X - Short TP Reached")
alertcondition(longSLHit, "Long SL Hit", "Swift Algo X - Long Stop Loss Hit")
alertcondition(shortSLHit, "Short SL Hit", "Swift Algo X - Short Stop Loss Hit")
alertcondition(volumeSpike, "Relative Volume Spike", "Swift Algo X - Relative Volume Spike")
alertcondition(bullVectorCandle, "Bull Vector Candle", "Swift Algo X - Bull Vector Candle")
alertcondition(bearVectorCandle, "Bear Vector Candle", "Swift Algo X - Bear Vector Candle")
alertcondition(isConsolidating and not isConsolidating[1], "Consolidation Start", "Swift Algo X - Market Entered Consolidation")
alertcondition(not isConsolidating and isConsolidating[1], "Consolidation End", "Swift Algo X - Market Exiting Consolidation")
alertcondition(earlyBullCross, "Early Bull Momentum", "Swift Algo X - Early Bullish Momentum Cross")
alertcondition(earlyBearCross, "Early Bear Momentum", "Swift Algo X - Early Bearish Momentum Cross")
