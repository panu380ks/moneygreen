//@version=6
// This Pine Script code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
// (c) moneygreen
strategy("HH LL + Supertrend Strategy (Trail)", shorttitle="HH LL + ST Trail", overlay=true,
     process_orders_on_close=true, initial_capital=100000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     currency=currency.USD, pyramiding=0)

// --------------------------------------------------------------------------
// STRATEGY OVERVIEW
// --------------------------------------------------------------------------
// Supertrend flip strategy with dynamic trailing stop.
//
// LONG:  Supertrend flips to uptrend (green)
//        + EMA 200 trend filter (price above EMA)
//        + Volume confirmation (above-average volume on flip bar)
//        + NY session active
// SHORT: Supertrend flips to downtrend (red)
//        + EMA 200 trend filter (price below EMA)
//        + Volume confirmation
//        + NY session active
//
// SL:    Supertrend line as dynamic trailing stop (ratchets only in favor)
//        + max loss safety cap (default 5%)
// TP:    1:3 R:R based on entry-to-Supertrend distance
// Exits: Trailing stop hit, TP hit, or Supertrend flip (backup)
// --------------------------------------------------------------------------

// --------------------------------------------------------------------------
// INPUTS
// --------------------------------------------------------------------------

// -- Breakout Detection (used for channel plots) --
bo_group    = "== Breakout Detection =="
price       = input.source(close, "Price Source", group=bo_group)
lookback    = input.int(41, "Lookback Period", minval=5, maxval=200, group=bo_group,
     tooltip="Number of bars to find the highest high / lowest low. Used for channel plots")

// -- Safety Guard (used for channel plots) --
guard_group = "== Safety Guard =="
guard_len   = input.int(10, "Guard Length", minval=2, maxval=100, group=guard_group,
     tooltip="Secondary lookback for guard level plots")
guard_delay = input.int(1, "Guard Delay (bars)", minval=1, maxval=10, group=guard_group,
     tooltip="How many bars back to compare the guard level")

// -- Supertrend --
st_group    = "== Supertrend =="
st_atr_len  = input.int(10,    "ATR Length",  minval=1, group=st_group)
st_factor   = input.float(3.0, "Factor",      minval=0.01, step=0.01, group=st_group)

// -- EMA Trend Filter --
ema_group       = "== EMA Trend Filter =="
use_ema_filter  = input.bool(true, "Use EMA 200 Filter", group=ema_group,
     tooltip="Only long above EMA 200, only short below EMA 200. Filters counter-trend trades")
ema_len         = input.int(200, "EMA Length", minval=10, maxval=500, group=ema_group)

// -- Volume Confirmation --
vol_group       = "== Volume Filter =="
use_vol_filter  = input.bool(true, "Use Volume Filter", group=vol_group,
     tooltip="Require above-average volume on Supertrend flip bar")
vol_len         = input.int(20, "Volume MA Length", minval=5, maxval=100, group=vol_group)
vol_mult        = input.float(1.2, "Volume Multiplier", minval=0.5, step=0.1, group=vol_group,
     tooltip="Volume must be this multiple of average. 1.2 = 20% above average")

// -- Mode --
mode_group    = "== Trading Mode =="
allow_longs   = input.bool(true, "Allow Long Entries", group=mode_group)
allow_shorts  = input.bool(true, "Allow Short Entries", group=mode_group)

// -- Risk Management --
risk_group  = "== Risk Management =="
rr_ratio    = input.float(3.0,  "Reward:Risk Ratio",  minval=1.0, maxval=10.0, step=1.0, group=risk_group,
     tooltip="TP = distance to Supertrend x ratio. 3 = 1:3 R:R")
max_sl_pct  = input.float(5.0,  "Max Stop Loss %",    minval=1.0, step=0.5, group=risk_group,
     tooltip="Safety cap: maximum loss per trade regardless of Supertrend distance")

// -- New York Session Filter --
sess_group  = "== Session Filter =="
use_session = input.bool(true,   "NY Session Only",    group=sess_group,
     tooltip="Only enter trades during the New York session (09:30-16:00 ET)")
ny_session  = input.session("0930-1600", "NY Session (ET)", group=sess_group,
     tooltip="New York trading session in Eastern Time")

// -- Date Filter --
date_group  = "== Date Filter =="
use_date    = input.bool(false,  "Use Date Filter",    group=date_group)
start_date  = input.time(timestamp("2024-01-01"), "Start Date", group=date_group)
end_date    = input.time(timestamp("2026-12-31"), "End Date",   group=date_group)

// --------------------------------------------------------------------------
// CALCULATIONS
// --------------------------------------------------------------------------

// Highest high and lowest low over the lookback period (for channel plots)
hi = ta.highest(high, lookback)
lo = ta.lowest(low, lookback)

// Safety guard (for channel plots)
hi_guard = ta.highest(high, guard_len)
lo_guard = ta.lowest(low, guard_len)

// Supertrend calculation
[supertrend, st_direction] = ta.supertrend(st_factor, st_atr_len)
st_uptrend   = st_direction < 0   // direction < 0 means price is above supertrend (uptrend)
st_downtrend = st_direction > 0   // direction > 0 means price is below supertrend (downtrend)
st_flip_up   = st_direction < 0 and st_direction[1] > 0  // just flipped to uptrend
st_flip_down = st_direction > 0 and st_direction[1] < 0  // just flipped to downtrend

// Breakout detection (for plots and info table)
breakout_up   = price > hi[1]
breakout_down = price < lo[1]

// EMA 200 trend filter
ema_200      = ta.ema(close, ema_len)
ema_long_ok  = not use_ema_filter or close > ema_200
ema_short_ok = not use_ema_filter or close < ema_200

// Volume confirmation
vol_ma       = ta.sma(volume, vol_len)
vol_confirm  = not use_vol_filter or (volume > vol_ma * vol_mult)

// Date filter
in_date = not use_date or (time >= start_date and time <= end_date)

// New York session filter (uses exchange timezone by default)
in_ny_session = not use_session or not na(time(timeframe.period, ny_session, "America/New_York"))

// --------------------------------------------------------------------------
// ENTRY / EXIT CONDITIONS
// --------------------------------------------------------------------------

// Entry: Supertrend flips + EMA filter + volume confirmation
long_entry  = allow_longs  and st_flip_up   and ema_long_ok  and vol_confirm and in_date and in_ny_session
short_entry = allow_shorts and st_flip_down and ema_short_ok and vol_confirm and in_date and in_ny_session

// Exit: Supertrend flips in opposite direction (backup for trailing stop)
exit_long  = st_flip_down
exit_short = st_flip_up

// --------------------------------------------------------------------------
// STRATEGY EXECUTION — Dynamic Supertrend Trailing Stop
// --------------------------------------------------------------------------

// Persistent state for trailing stop and TP levels
var float trail_sl_long  = na
var float trail_sl_short = na
var float long_tp        = na
var float short_tp       = na

// --- Long entries ---
if long_entry
    strategy.entry("Long", strategy.long)
    trail_sl_long := supertrend
    risk_dist      = close - supertrend
    long_tp       := close + risk_dist * rr_ratio

// --- Long position management: update trailing stop every bar ---
if strategy.position_size > 0
    // Ratchet trailing stop upward (never down) during confirmed uptrend
    if st_uptrend and supertrend > trail_sl_long
        trail_sl_long := supertrend
    // Apply maximum loss safety cap
    max_sl_price  = strategy.position_avg_price * (1 - max_sl_pct / 100)
    effective_sl  = math.max(trail_sl_long, max_sl_price)
    strategy.exit("Long SL/TP", "Long", stop=effective_sl, limit=long_tp)
else
    trail_sl_long := na
    long_tp       := na

// --- Short entries ---
if short_entry
    strategy.entry("Short", strategy.short)
    trail_sl_short := supertrend
    risk_dist       = supertrend - close
    short_tp       := close - risk_dist * rr_ratio

// --- Short position management: update trailing stop every bar ---
if strategy.position_size < 0
    // Ratchet trailing stop downward (never up) during confirmed downtrend
    if st_downtrend and supertrend < trail_sl_short
        trail_sl_short := supertrend
    // Apply maximum loss safety cap
    max_sl_price  = strategy.position_avg_price * (1 + max_sl_pct / 100)
    effective_sl  = math.min(trail_sl_short, max_sl_price)
    strategy.exit("Short SL/TP", "Short", stop=effective_sl, limit=short_tp)
else
    trail_sl_short := na
    short_tp       := na

// --- Backup signal exits: Supertrend flip ---
if strategy.position_size > 0 and exit_long
    strategy.close("Long", comment="ST Flip Down")

if strategy.position_size < 0 and exit_short
    strategy.close("Short", comment="ST Flip Up")

// --------------------------------------------------------------------------
// PLOTS
// --------------------------------------------------------------------------

// Highest high / lowest low channels
plot(hi, "Highest High", color=color.new(color.green, 30), linewidth=2)
plot(lo, "Lowest Low",   color=color.new(color.red, 30),   linewidth=2)

// Guard levels
plot(hi_guard, "Guard High", color=color.new(color.green, 70), linewidth=1, style=plot.style_stepline)
plot(lo_guard, "Guard Low",  color=color.new(color.red, 70),   linewidth=1, style=plot.style_stepline)

// Supertrend
st_plot_up   = plot(st_direction < 0 ? supertrend : na, "ST Up Trend",
     color=color.green, style=plot.style_linebr, linewidth=2)
st_plot_down = plot(st_direction < 0 ? na : supertrend, "ST Down Trend",
     color=color.red, style=plot.style_linebr, linewidth=2)
body_mid     = plot(not barstate.isfirst ? (open + close) / 2 : na, "Body Middle",
     display=display.none)
fill(body_mid, st_plot_up,   title="ST Uptrend BG",   color=color.new(color.green, 90), fillgaps=false)
fill(body_mid, st_plot_down, title="ST Downtrend BG",  color=color.new(color.red,   90), fillgaps=false)

// EMA 200
plot(use_ema_filter ? ema_200 : na, "EMA 200", color=color.new(color.white, 30),
     linewidth=2, style=plot.style_line)

// Trailing stop level (visible during active position)
plot(strategy.position_size > 0 ? trail_sl_long : na, "Trail SL Long",
     color=color.new(color.yellow, 0), linewidth=1, style=plot.style_stepline)
plot(strategy.position_size < 0 ? trail_sl_short : na, "Trail SL Short",
     color=color.new(color.yellow, 0), linewidth=1, style=plot.style_stepline)

// Take profit level (visible during active position)
plot(strategy.position_size > 0 ? long_tp : na, "TP Long",
     color=color.new(color.lime, 0), linewidth=1, style=plot.style_cross)
plot(strategy.position_size < 0 ? short_tp : na, "TP Short",
     color=color.new(color.lime, 0), linewidth=1, style=plot.style_cross)

// Entry signals
plotshape(long_entry and strategy.position_size <= 0,  "Buy Signal",
     shape.triangleup, location.belowbar, color.lime, size=size.normal)
plotshape(short_entry and strategy.position_size >= 0, "Sell Signal",
     shape.triangledown, location.abovebar, color.red, size=size.normal)

// NY session background
bgcolor(use_session and in_ny_session ? color.new(color.blue, 95) : na, title="NY Session BG")

// Background color for position
bgcolor(strategy.position_size > 0 ? color.new(color.green, 95) :
     strategy.position_size < 0 ? color.new(color.red, 95) : na, title="Position BG")

// --------------------------------------------------------------------------
// INFO TABLE
// --------------------------------------------------------------------------

var info = table.new(position.top_right, 2, 14, border_width=1)
if barstate.islast
    table.cell(info, 0, 0, "Indicator",    bgcolor=color.new(color.gray, 80), text_color=color.white)
    table.cell(info, 1, 0, "Value",        bgcolor=color.new(color.gray, 80), text_color=color.white)

    table.cell(info, 0, 1, "Highest (" + str.tostring(lookback) + ")", text_color=color.white)
    table.cell(info, 1, 1, str.tostring(hi, "#.##"), text_color=color.green)

    table.cell(info, 0, 2, "Lowest (" + str.tostring(lookback) + ")", text_color=color.white)
    table.cell(info, 1, 2, str.tostring(lo, "#.##"), text_color=color.red)

    table.cell(info, 0, 3, "Supertrend", text_color=color.white)
    table.cell(info, 1, 3,
         st_uptrend ? "UPTREND" : "DOWNTREND",
         text_color=st_uptrend ? color.green : color.red)

    table.cell(info, 0, 4, "ST Value", text_color=color.white)
    table.cell(info, 1, 4, str.tostring(supertrend, "#.##"),
         text_color=st_uptrend ? color.green : color.red)

    table.cell(info, 0, 5, "EMA 200", text_color=color.white)
    table.cell(info, 1, 5,
         use_ema_filter ? (close > ema_200 ? "ABOVE" : "BELOW") : "OFF",
         text_color=use_ema_filter ? (close > ema_200 ? color.green : color.red) : color.gray)

    table.cell(info, 0, 6, "Volume", text_color=color.white)
    table.cell(info, 1, 6,
         use_vol_filter ? (vol_confirm ? "CONFIRMED" : "WEAK") : "OFF",
         text_color=use_vol_filter ? (vol_confirm ? color.green : color.orange) : color.gray)

    table.cell(info, 0, 7, "R:R Ratio", text_color=color.white)
    table.cell(info, 1, 7, "1 : " + str.tostring(rr_ratio, "#"),
         text_color=color.yellow)

    table.cell(info, 0, 8, "Max SL %", text_color=color.white)
    table.cell(info, 1, 8, str.tostring(max_sl_pct, "#.#") + "%",
         text_color=color.yellow)

    table.cell(info, 0, 9, "Trail SL", text_color=color.white)
    trail_val = strategy.position_size > 0 ? trail_sl_long :
         strategy.position_size < 0 ? trail_sl_short : na
    table.cell(info, 1, 9, not na(trail_val) ? str.tostring(trail_val, "#.##") : "---",
         text_color=color.yellow)

    table.cell(info, 0, 10, "NY Session", text_color=color.white)
    table.cell(info, 1, 10, in_ny_session ? "ACTIVE" : "CLOSED",
         text_color=in_ny_session ? color.lime : color.gray)

    table.cell(info, 0, 11, "Breakout", text_color=color.white)
    table.cell(info, 1, 11, breakout_up ? "HIGHER HIGH ^" : breakout_down ? "LOWER LOW v" : "---",
         text_color=breakout_up ? color.green : breakout_down ? color.red : color.gray)

    table.cell(info, 0, 12, "Position", text_color=color.white)
    table.cell(info, 1, 12,
         strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT",
         text_color=strategy.position_size > 0 ? color.green : strategy.position_size < 0 ? color.red : color.gray)

    table.cell(info, 0, 13, "Target", text_color=color.white)
    tp_val = strategy.position_size > 0 ? long_tp :
         strategy.position_size < 0 ? short_tp : na
    table.cell(info, 1, 13, not na(tp_val) ? str.tostring(tp_val, "#.##") : "---",
         text_color=color.lime)

// --------------------------------------------------------------------------
// STRATEGY LOGIC SUMMARY
// --------------------------------------------------------------------------
//
// +-----------+-----------------------------------------------+
// | BUY LONG  | Supertrend flips to uptrend (green)          |
// |           | + Price above EMA 200 (trend filter)          |
// |           | + Above-average volume on flip bar             |
// |           | + NY session active (09:30-16:00 ET)          |
// |           | SL = Supertrend line (trailing), TP = 1:3 R:R |
// +-----------+-----------------------------------------------+
// | SELL SHORT| Supertrend flips to downtrend (red)           |
// |           | + Price below EMA 200 (trend filter)          |
// |           | + Above-average volume on flip bar             |
// |           | + NY session active (09:30-16:00 ET)          |
// |           | SL = Supertrend line (trailing), TP = 1:3 R:R |
// +-----------+-----------------------------------------------+
// | EXIT LONG | Trailing stop hit (Supertrend line ratchets up)|
// |           | OR max SL hit (5% safety cap)                  |
// |           | OR TP hit (3x risk distance)                   |
// |           | OR Supertrend flips to downtrend (backup)      |
// +-----------+-----------------------------------------------+
// | EXIT SHORT| Trailing stop hit (Supertrend line ratchets dn)|
// |           | OR max SL hit (5% safety cap)                  |
// |           | OR TP hit (3x risk distance)                   |
// |           | OR Supertrend flips to uptrend (backup)        |
// +-----------+-----------------------------------------------+
// --------------------------------------------------------------------------
