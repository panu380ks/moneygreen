//@version=6
// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
// © moneygreen

strategy("HH LL + Supertrend v3 — NAS100", shorttitle="HH LL + ST v3 NAS100", overlay=true,
     process_orders_on_close=true, initial_capital=100000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     currency=currency.USD, pyramiding=0,
     commission_type=strategy.commission.percent, commission_value=0.05,
     slippage=2)

// ═══════════════════════════════════════════════════════════════════════════
// NAS100 ADAPTATION NOTES
// ═══════════════════════════════════════════════════════════════════════════
// NAS100 vs Silver key differences:
// • ATR is 150-400 points (vs silver's $0.30-$0.80) — all ATR filters scaled
// • Stronger mean-reversion tendency — tighter trailing stops lock gains
// • Gap risk overnight — NY session filter is critical
// • Higher correlation to macro events — volatility spike filter widened
// • Trends are driven by earnings/Fed, not supply/demand like commodities
// • Shorts are viable but riskier (long bias in equities)
// ═══════════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════

// ── HH/LL Breakout ──
bo_group    = "== Breakout Detection =="
price       = input.source(close, "Price Source", group=bo_group)
lookback    = input.int(40, "Lookback Period", minval=5, maxval=300, group=bo_group,
     tooltip="40 bars — NAS100 trends faster than commodities, shorter lookback catches momentum earlier")

// ── Safety Guard ──
guard_group = "== Safety Guard =="
guard_len   = input.int(12, "Guard Length", minval=2, maxval=100, group=guard_group,
     tooltip="12 bars — NAS100 breakouts are fast and decisive, tight guard avoids lag")
guard_delay = input.int(2, "Guard Delay (bars)", minval=1, maxval=10, group=guard_group,
     tooltip="2 bars — confirms breakout isn't a single-bar spike")

// ── Supertrend ──
st_group    = "== Supertrend =="
use_st      = input.bool(true, "Use Supertrend Filter", group=st_group)
st_atr_len  = input.int(10, "ATR Length", minval=1, group=st_group,
     tooltip="10 — responsive to NAS100's fast regime changes")
st_factor   = input.float(2.0, "Factor", minval=0.01, step=0.01, group=st_group,
     tooltip="2.0 — tighter than commodities since NAS100 trends are cleaner")
use_st_exit = input.bool(true, "Exit on Supertrend Flip", group=st_group)

// ── Trend Filter ──
trend_group    = "== Trend Filter =="
useTrendFilter = input.bool(true, "Enable 21 EMA Trend Filter", group=trend_group)
trendEmaLen    = input.int(21, "Trend EMA Length", minval=1, group=trend_group,
     tooltip="21 EMA — faster than 50 EMA, NAS100 reacts quickly to trend shifts")
use200EMA      = input.bool(true, "Enable 200 EMA Macro Filter", group=trend_group)
ema200Len      = input.int(200, "200 EMA Length", minval=1, group=trend_group)

// ── Trading Mode ──
mode_group    = "== Trading Mode =="
allow_longs   = input.bool(true, "Allow Long Entries", group=mode_group)
allow_shorts  = input.bool(true, "Allow Short Entries", group=mode_group,
     tooltip="ON — NAS100 has tradeable selloffs (earnings misses, Fed hawkish), but long bias dominates")
cooldownBars  = input.int(5, "Min Bars Between Trades", minval=0, maxval=100, group=mode_group,
     tooltip="5 bars — NAS100 moves fast, minimal cooldown to catch momentum")

// ── Risk Management ──
risk_group  = "== Risk Management =="
atrLen      = input.int(14, "ATR Length", minval=1, group=risk_group)
minATR      = input.float(50.0, "Minimum ATR Filter", minval=0, step=10.0, group=risk_group,
     tooltip="50 points — NAS100 ATR ranges 150-400pts, filters dead low-vol sessions")
slMultLong  = input.float(2.0, "Long Stop Loss ATR Mult", minval=1.0, maxval=10.0, step=0.5, group=risk_group,
     tooltip="2.0x ATR — NAS100 whipsaws less than silver in confirmed trends")
tpMultLong  = input.float(5.0, "Long Take Profit ATR Mult", minval=1.0, maxval=30.0, step=0.5, group=risk_group,
     tooltip="5x ATR — NAS100 trends can run 1000+ points")
slMultShort = input.float(2.0, "Short Stop Loss ATR Mult", minval=1.0, maxval=10.0, step=0.5, group=risk_group,
     tooltip="2.0x — symmetric with longs, shorts get stopped less on clean breakdowns")
tpMultShort = input.float(4.0, "Short Take Profit ATR Mult", minval=1.0, maxval=30.0, step=0.5, group=risk_group,
     tooltip="4x ATR — shorter target for shorts since NAS100 has a long bias, selloffs are faster but shorter")
useTrail    = input.bool(true, "Use Trailing Stop", group=risk_group)
trailATRMult = input.float(1.5, "Trailing Stop ATR Mult", minval=0.5, maxval=10.0, step=0.5, group=risk_group,
     tooltip="1.5x — tighter trail than commodities, NAS100 reversals are sharp")

// ── NY Session ──
sess_group   = "== NY Session =="
use_session  = input.bool(true, "Only Trade During NY Session", group=sess_group)
nyOpenHour   = input.int(9, "NY Open Hour (ET)", minval=0, maxval=23, group=sess_group,
     tooltip="9:00 ET — catches pre-market momentum before the 9:30 cash open")
nyOpenMin    = input.int(0, "NY Open Minute (ET)", minval=0, maxval=59, group=sess_group)
nyCloseHour  = input.int(16, "NY Close Hour (ET)", minval=0, maxval=23, group=sess_group,
     tooltip="16:00 ET — regular market close, avoids thin after-hours liquidity")
nyCloseMin   = input.int(0, "NY Close Minute (ET)", minval=0, maxval=59, group=sess_group)
entryHours   = input.int(6, "Entry Window (hours)", minval=1, maxval=24, group=sess_group,
     tooltip="6 hours — NAS100 does most of its work 9:00-15:00 ET, late-day entries are chop")

// ── Date Filter ──
date_group  = "== Date Filter =="
use_date    = input.bool(false, "Use Date Filter", group=date_group)
start_date  = input.time(timestamp("2024-01-01"), "Start Date", group=date_group)
end_date    = input.time(timestamp("2069-12-31"), "End Date", group=date_group)

// ═══════════════════════════════════════════════════════════════════════════
// TIME FILTERS
// ═══════════════════════════════════════════════════════════════════════════
in_date = not use_date or (time >= start_date and time <= end_date)

nyHour   = hour(time, "America/New_York")
nyMinute = minute(time, "America/New_York")

nyOpenMins  = nyOpenHour * 60 + nyOpenMin
nyCloseMins = nyCloseHour * 60 + nyCloseMin
nowMins     = nyHour * 60 + nyMinute

inNYSession   = nowMins >= nyOpenMins and nowMins < nyCloseMins
minsFromOpen  = nowMins - nyOpenMins
entryWindowOK = minsFromOpen >= 0 and minsFromOpen < entryHours * 60

sessionOK = not use_session or (inNYSession and entryWindowOK)

// ═══════════════════════════════════════════════════════════════════════════
// TREND FILTERS — Dual EMA (21 + 200)
// ═══════════════════════════════════════════════════════════════════════════
ema21  = ta.ema(close, trendEmaLen)
ema200 = ta.ema(close, ema200Len)

trendLongOK  = (not useTrendFilter or close > ema21) and (not use200EMA or ema21 > ema200)
trendShortOK = (not useTrendFilter or close < ema21) and (not use200EMA or ema21 < ema200)

// ═══════════════════════════════════════════════════════════════════════════
// ATR
// ═══════════════════════════════════════════════════════════════════════════
atrValue = ta.atr(atrLen)
atrOK    = minATR == 0.0 or atrValue >= minATR

// ═══════════════════════════════════════════════════════════════════════════
// HH/LL BREAKOUT + SAFETY GUARD
// ═══════════════════════════════════════════════════════════════════════════
hi = ta.highest(high, lookback)
lo = ta.lowest(low, lookback)

hi_guard = ta.highest(high, guard_len)
lo_guard = ta.lowest(low, guard_len)

breakout_up   = price > hi[1]
breakout_down = price < lo[1]

guard_long  = breakout_up and hi[1] > hi_guard[guard_delay]
guard_short = breakout_down and lo[1] < lo_guard[guard_delay]

// ═══════════════════════════════════════════════════════════════════════════
// SUPERTREND
// ═══════════════════════════════════════════════════════════════════════════
[supertrend, st_direction] = ta.supertrend(st_factor, st_atr_len)

st_uptrend   = st_direction < 0
st_downtrend = st_direction > 0

st_flip_up   = st_direction < 0 and st_direction[1] > 0
st_flip_down = st_direction > 0 and st_direction[1] < 0

st_long_ok   = not use_st or st_uptrend
st_short_ok  = not use_st or st_downtrend

// ═══════════════════════════════════════════════════════════════════════════
// MOMENTUM — RSI filter
// ═══════════════════════════════════════════════════════════════════════════
rsiVal     = ta.rsi(close, 14)
rsiLongOK  = rsiVal < 80
rsiShortOK = rsiVal > 20
// NAS100 can stay overbought longer than commodities in strong bull runs,
// so RSI thresholds are wider (80/20 vs silver's 75/25)

// ═══════════════════════════════════════════════════════════════════════════
// NAS100 VOLATILITY FILTER — Skip news/FOMC spikes
// ═══════════════════════════════════════════════════════════════════════════
atrMA      = ta.sma(atrValue, 20)
notTooWild = atrValue < atrMA * 3.0
// 3.0x threshold (vs silver's 2.5x) — NAS100 has wider ATR variance
// during earnings and FOMC, but normal vol range is tighter

// ═══════════════════════════════════════════════════════════════════════════
// VWAP FILTER — NAS100 respects intraday VWAP strongly
// ═══════════════════════════════════════════════════════════════════════════
vwapVal    = ta.vwap(hlc3)
useVWAP    = input.bool(true, "Use VWAP Confirmation", group=trend_group,
     tooltip="NAS100 respects VWAP — longs above VWAP, shorts below")
vwapLongOK  = not useVWAP or close > vwapVal
vwapShortOK = not useVWAP or close < vwapVal

// ═══════════════════════════════════════════════════════════════════════════
// COOLDOWN
// ═══════════════════════════════════════════════════════════════════════════
var int lastEntryBar = 0
barsSinceEntry = bar_index - lastEntryBar
cooldownOK     = barsSinceEntry >= cooldownBars

// ═══════════════════════════════════════════════════════════════════════════
// ENTRY CONDITIONS
// ═══════════════════════════════════════════════════════════════════════════
long_entry  = allow_longs  and guard_long  and st_long_ok  and trendLongOK  and rsiLongOK  and vwapLongOK  and notTooWild and in_date and sessionOK and atrOK and cooldownOK
short_entry = allow_shorts and guard_short and st_short_ok and trendShortOK and rsiShortOK and vwapShortOK and notTooWild and in_date and sessionOK and atrOK and cooldownOK

// Exit signals — run anytime
exit_long  = breakout_down or (use_st_exit and use_st and st_flip_down)
exit_short = breakout_up   or (use_st_exit and use_st and st_flip_up)

// ═══════════════════════════════════════════════════════════════════════════
// ENTRIES
// ═══════════════════════════════════════════════════════════════════════════
if long_entry
    strategy.entry("Long", strategy.long)
    lastEntryBar := bar_index

if short_entry
    strategy.entry("Short", strategy.short)
    lastEntryBar := bar_index

// ═══════════════════════════════════════════════════════════════════════════
// EXITS — Run anytime
// ═══════════════════════════════════════════════════════════════════════════
if strategy.position_size > 0
    longSL = strategy.position_avg_price - slMultLong * atrValue
    longTP = strategy.position_avg_price + tpMultLong * atrValue
    if useTrail
        strategy.exit("Long Exit", "Long",
             stop         = longSL,
             limit        = longTP,
             trail_points = atrValue * trailATRMult / syminfo.mintick,
             trail_offset = atrValue * trailATRMult / syminfo.mintick)
    else
        strategy.exit("Long Exit", "Long", stop=longSL, limit=longTP)

if strategy.position_size < 0
    shortSL = strategy.position_avg_price + slMultShort * atrValue
    shortTP = strategy.position_avg_price - tpMultShort * atrValue
    if useTrail
        strategy.exit("Short Exit", "Short",
             stop         = shortSL,
             limit        = shortTP,
             trail_points = atrValue * trailATRMult / syminfo.mintick,
             trail_offset = atrValue * trailATRMult / syminfo.mintick)
    else
        strategy.exit("Short Exit", "Short", stop=shortSL, limit=shortTP)

// Signal exits
if strategy.position_size > 0 and exit_long
    strategy.close("Long", comment="LL / ST Flip")

if strategy.position_size < 0 and exit_short
    strategy.close("Short", comment="HH / ST Flip")

// ═══════════════════════════════════════════════════════════════════════════
// PLOTS
// ═══════════════════════════════════════════════════════════════════════════
plot(useTrendFilter ? ema21 : na, "21 EMA", color=color.yellow, linewidth=1)
plot(use200EMA ? ema200 : na, "200 EMA", color=color.white, linewidth=1)
plot(useVWAP ? vwapVal : na, "VWAP", color=color.purple, linewidth=1, style=plot.style_circles)

plot(hi, "Highest High", color=color.new(color.green, 30), linewidth=2)
plot(lo, "Lowest Low",   color=color.new(color.red, 30),   linewidth=2)
plot(hi_guard, "Guard Hi", color=color.new(color.green, 70), linewidth=1, style=plot.style_stepline)
plot(lo_guard, "Guard Lo", color=color.new(color.red, 70),   linewidth=1, style=plot.style_stepline)

st_plot_up   = plot(use_st and st_direction < 0 ? supertrend : na, "ST Up",
     color=color.green, style=plot.style_linebr, linewidth=2)
st_plot_down = plot(use_st and st_direction < 0 ? na : (use_st ? supertrend : na), "ST Down",
     color=color.red, style=plot.style_linebr, linewidth=2)
body_mid     = plot(use_st and not barstate.isfirst ? (open + close) / 2 : na, "Body Mid",
     display=display.none)
fill(body_mid, st_plot_up,   title="ST Up BG",   color=color.new(color.green, 90), fillgaps=false)
fill(body_mid, st_plot_down, title="ST Down BG",  color=color.new(color.red,   90), fillgaps=false)

plotshape(long_entry and strategy.position_size <= 0,  "Buy",
     shape.triangleup, location.belowbar, color.lime, size=size.normal)
plotshape(short_entry and strategy.position_size >= 0, "Sell",
     shape.triangledown, location.abovebar, color.red, size=size.normal)

// Volatility spike warning
bgcolor(not notTooWild ? color.new(color.orange, 90) : na, title="Vol Spike")
bgcolor(sessionOK and in_date ? color.new(color.blue, 95) : na, title="NY Session")
bgcolor(not atrOK ? color.new(color.red, 95) : na, title="ATR Low")
bgcolor(strategy.position_size > 0 ? color.new(color.green, 95) :
     strategy.position_size < 0 ? color.new(color.red, 95) : na, title="Position")

// ═══════════════════════════════════════════════════════════════════════════
// INFO TABLE
// ═══════════════════════════════════════════════════════════════════════════
var table info = table.new(position.top_right, 2, 16, bgcolor=color.new(color.black, 80), border_width=1)

if barstate.islast
    table.cell(info, 0, 0, "NAS100",    bgcolor=color.new(color.navy, 40), text_color=color.white, text_size=size.small)
    table.cell(info, 1, 0, "HH LL + ST", bgcolor=color.new(color.navy, 40), text_color=color.white, text_size=size.small)

    table.cell(info, 0, 1, "HH (" + str.tostring(lookback) + ")", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 1, str.tostring(hi, "#.#"), text_color=color.green, text_size=size.small)

    table.cell(info, 0, 2, "LL (" + str.tostring(lookback) + ")", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 2, str.tostring(lo, "#.#"), text_color=color.red, text_size=size.small)

    table.cell(info, 0, 3, "Supertrend", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 3, use_st ? (st_uptrend ? "UPTREND" : "DOWNTREND") : "OFF",
         text_color=use_st ? (st_uptrend ? color.green : color.red) : color.gray, text_size=size.small)

    table.cell(info, 0, 4, "ST Value", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 4, use_st ? str.tostring(supertrend, "#.#") : "---",
         text_color=use_st ? (st_uptrend ? color.green : color.red) : color.gray, text_size=size.small)

    table.cell(info, 0, 5, "21 EMA", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 5, str.tostring(ema21, "#.#"), text_color=color.yellow, text_size=size.small)

    table.cell(info, 0, 6, "200 EMA", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 6, str.tostring(ema200, "#.#"), text_color=color.white, text_size=size.small)

    table.cell(info, 0, 7, "Trend", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 7, ema21 > ema200 ? "BULLISH (21>200)" : "BEARISH (21<200)",
         text_color=ema21 > ema200 ? color.green : color.red, text_size=size.small)

    table.cell(info, 0, 8, "VWAP", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 8, str.tostring(vwapVal, "#.#"),
         text_color=close > vwapVal ? color.green : color.red, text_size=size.small)

    table.cell(info, 0, 9, "RSI (14)", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 9, str.tostring(rsiVal, "#.#"),
         text_color=rsiVal > 70 ? color.red : rsiVal < 30 ? color.green : color.yellow, text_size=size.small)

    table.cell(info, 0, 10, "ATR (" + str.tostring(atrLen) + ")", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 10, str.tostring(atrValue, "#.#"),
         text_color=atrOK ? color.green : color.red, text_size=size.small)

    table.cell(info, 0, 11, "ATR Filter", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 11, atrOK ? "PASS (>=" + str.tostring(minATR, "#") + ")" : "BLOCKED",
         text_color=atrOK ? color.green : color.red, text_size=size.small)

    table.cell(info, 0, 12, "Vol Spike", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 12, notTooWild ? "NORMAL" : "BLOCKED (3x avg)",
         text_color=notTooWild ? color.green : color.orange, text_size=size.small)

    nyTimeStr = str.tostring(nyHour, "00") + ":" + str.tostring(nyMinute, "00") + " ET"
    table.cell(info, 0, 13, "NY Session", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 13, inNYSession ? "OPEN " + nyTimeStr : "CLOSED " + nyTimeStr,
         text_color=inNYSession ? color.green : color.gray, text_size=size.small)

    table.cell(info, 0, 14, "Cooldown", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 14, cooldownOK ? "READY" : str.tostring(cooldownBars - barsSinceEntry) + " bars",
         text_color=cooldownOK ? color.green : color.yellow, text_size=size.small)

    table.cell(info, 0, 15, "Position", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 15,
         strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT",
         text_color=strategy.position_size > 0 ? color.green : strategy.position_size < 0 ? color.red : color.gray,
         text_size=size.small)
