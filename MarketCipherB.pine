// https://mozilla.org/MPL/2.0/
//
// MarketCipher B Strategy
// Components: Wave Trend Oscillator, Money Flow, Stochastic RSI, Buy/Sell Signals

//@version=6
strategy("MarketCipher B Strategy", shorttitle="MCB Strat", overlay=true,
     initial_capital=10000, default_qty_type=strategy.percent_of_equity,
     default_qty_value=100, commission_type=strategy.commission.percent,
     commission_value=0.04, slippage=1, pyramiding=0)

// ──────────────────────────────────────────────────────────────────────────────
// Inputs
// ──────────────────────────────────────────────────────────────────────────────

// Wave Trend
wtChannelLen  = input.int(9,   "Wave Trend Channel Length")
wtAverageLen  = input.int(12,  "Wave Trend Average Length")
wtMALen       = input.int(3,   "Wave Trend MA Length")

// Overbought / Oversold Levels
obLevel1 = input.int(60,  "Overbought Level 1")
obLevel2 = input.int(53,  "Overbought Level 2")
osLevel1 = input.int(-60, "Oversold Level 1")
osLevel2 = input.int(-53, "Oversold Level 2")

// Money Flow
mfLength   = input.int(50, "Money Flow Length")
mfMultiply = input.float(150.0, "Money Flow Multiplier")

// Stochastic RSI
srsiLength  = input.int(14, "Stochastic RSI Length")
stochLength = input.int(14, "Stochastic K Length")
smoothK     = input.int(3,  "Stochastic Smooth K")
smoothD     = input.int(3,  "Stochastic Smooth D")

// Strategy Settings
tradeDirection = input.string("Both", "Trade Direction", options=["Long", "Short", "Both"])
useWeakSignals = input.bool(false, "Trade Weak Signals")
useDivergence  = input.bool(false, "Trade Divergence Signals")
useMFFilter    = input.bool(false, "Money Flow Confirmation Filter")
useSLTP        = input.bool(false, "Use Stop Loss / Take Profit")
slPercent      = input.float(3.0, "Stop Loss %", minval=0.1, step=0.1)
tpPercent      = input.float(6.0, "Take Profit %", minval=0.1, step=0.1)

// ──────────────────────────────────────────────────────────────────────────────
// Wave Trend Oscillator
// ──────────────────────────────────────────────────────────────────────────────

wtSrc = hlc3
esa   = ta.ema(wtSrc, wtChannelLen)
de    = ta.ema(math.abs(wtSrc - esa), wtChannelLen)
ci    = (wtSrc - esa) / (0.015 * de)

wt1 = ta.ema(ci, wtAverageLen)
wt2 = ta.sma(wt1, wtMALen)

wtCrossUp   = ta.crossover(wt1, wt2)
wtCrossDown = ta.crossunder(wt1, wt2)

// ──────────────────────────────────────────────────────────────────────────────
// Money Flow Index
// ──────────────────────────────────────────────────────────────────────────────

f_moneyFlow(_src, _len, _mult) =>
    upperMF  = ta.highest(ta.mfi(_src, _len), _len)
    lowerMF  = ta.lowest(ta.mfi(_src, _len), _len)
    midMF    = (upperMF + lowerMF) / 2.0
    scaledMF = ((ta.mfi(_src, _len) - midMF) / (upperMF - lowerMF)) * _mult
    scaledMF

mfValue = f_moneyFlow(hlc3, mfLength, mfMultiply)

// ──────────────────────────────────────────────────────────────────────────────
// Stochastic RSI
// ──────────────────────────────────────────────────────────────────────────────

rsiValue  = ta.rsi(close, srsiLength)
stochRSI  = ta.stoch(rsiValue, rsiValue, rsiValue, stochLength)
srsiK     = ta.sma(stochRSI, smoothK)
srsiD     = ta.sma(srsiK, smoothD)

srsiScaled = srsiK - 80

// ──────────────────────────────────────────────────────────────────────────────
// Divergence Detection
// ──────────────────────────────────────────────────────────────────────────────

f_findDivergence(_src, _lkbk) =>
    _pLow = ta.pivotlow(_src, _lkbk, _lkbk)
    _pHigh = ta.pivothigh(_src, _lkbk, _lkbk)
    _pLow_prev = ta.valuewhen(not na(_pLow), _src[_lkbk], 1)
    _pLow_curr = ta.valuewhen(not na(_pLow), _src[_lkbk], 0)
    _price_low_prev = ta.valuewhen(not na(_pLow), low[_lkbk], 1)
    _price_low_curr = ta.valuewhen(not na(_pLow), low[_lkbk], 0)
    _pHigh_prev = ta.valuewhen(not na(_pHigh), _src[_lkbk], 1)
    _pHigh_curr = ta.valuewhen(not na(_pHigh), _src[_lkbk], 0)
    _price_high_prev = ta.valuewhen(not na(_pHigh), high[_lkbk], 1)
    _price_high_curr = ta.valuewhen(not na(_pHigh), high[_lkbk], 0)
    _bullDiv = (not na(_pLow)) and (_price_low_curr < _price_low_prev) and (_pLow_curr > _pLow_prev)
    _bearDiv = (not na(_pHigh)) and (_price_high_curr > _price_high_prev) and (_pHigh_curr < _pHigh_prev)
    [_bullDiv, _bearDiv]

lkbk = 5
[bullDiv, bearDiv] = f_findDivergence(wt2, lkbk)

// ──────────────────────────────────────────────────────────────────────────────
// Signal Logic
// ──────────────────────────────────────────────────────────────────────────────

// Strong signals
buySignal  = wtCrossUp and wt2 < osLevel1
sellSignal = wtCrossDown and wt2 > obLevel1

// Weak signals
buySignalWeak  = wtCrossUp and wt2 < osLevel2 and not buySignal
sellSignalWeak = wtCrossDown and wt2 > obLevel2 and not sellSignal

// Money Flow filter
mfLongOK  = not useMFFilter or mfValue > 0
mfShortOK = not useMFFilter or mfValue < 0

// Combined entry conditions
goLong  = (buySignal or (useWeakSignals and buySignalWeak) or (useDivergence and bullDiv)) and mfLongOK
goShort = (sellSignal or (useWeakSignals and sellSignalWeak) or (useDivergence and bearDiv)) and mfShortOK

// Exit conditions: opposite zone cross
exitLong  = wtCrossDown and wt2 > obLevel2
exitShort = wtCrossUp and wt2 < osLevel2

// ──────────────────────────────────────────────────────────────────────────────
// Strategy Execution
// ──────────────────────────────────────────────────────────────────────────────

allowLong  = tradeDirection == "Long" or tradeDirection == "Both"
allowShort = tradeDirection == "Short" or tradeDirection == "Both"

// Entries
if goLong and allowLong
    strategy.entry("Long", strategy.long)
if goShort and allowShort
    strategy.entry("Short", strategy.short)

// Exits
if exitLong and strategy.position_size > 0
    strategy.close("Long", comment="WT Exit")
if exitShort and strategy.position_size < 0
    strategy.close("Short", comment="WT Exit")

// Stop Loss / Take Profit
if useSLTP and strategy.position_size > 0
    strategy.exit("Long SL/TP", "Long",
         stop=strategy.position_avg_price * (1 - slPercent / 100),
         limit=strategy.position_avg_price * (1 + tpPercent / 100))
if useSLTP and strategy.position_size < 0
    strategy.exit("Short SL/TP", "Short",
         stop=strategy.position_avg_price * (1 + slPercent / 100),
         limit=strategy.position_avg_price * (1 - tpPercent / 100))

// ──────────────────────────────────────────────────────────────────────────────
// Plotting (on price chart)
// ──────────────────────────────────────────────────────────────────────────────

plotshape(goLong and allowLong, "Long Entry", shape.triangleup,
     location.belowbar, color.new(color.lime, 0), size=size.small)
plotshape(goShort and allowShort, "Short Entry", shape.triangledown,
     location.abovebar, color.new(color.red, 0), size=size.small)
plotshape(exitLong and strategy.position_size > 0, "Exit Long", shape.xcross,
     location.abovebar, color.new(color.orange, 0), size=size.tiny)
plotshape(exitShort and strategy.position_size < 0, "Exit Short", shape.xcross,
     location.belowbar, color.new(color.orange, 0), size=size.tiny)
