//@version=6
// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
// © moneygreen

strategy("Bollinger Bands Strategy MTF v3 — NAS100", shorttitle="BB MTF v3 NAS100", overlay=true,
     process_orders_on_close=true, initial_capital=100000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     currency=currency.USD, pyramiding=0,
     commission_type=strategy.commission.percent, commission_value=0.05,
     slippage=2)

// ═══════════════════════════════════════════════════════════════════════════
// NAS100 BB STRATEGY — v3
// ═══════════════════════════════════════════════════════════════════════════
// v1: -98.94% (no risk management, 5349 trades)
// v2: +0.48% / 2 trades (filters too tight, blocked everything)
// v3: Loosened filters to generate 50-200 trades while keeping
//     SL/TP/trail risk management intact.
//
// Changes from v2:
//   • BB squeeze filter OFF by default (was biggest blocker)
//   • Session filter OFF (NAS100 CFDs trade 24/5, daily chart ignores sessions)
//   • Trend filter: single 200 EMA only (removed 50 EMA — too restrictive)
//   • minATR lowered to 0 (daily bars always have enough ATR)
//   • Cooldown reduced from 8 to 3
//   • Removed basis-touch early exit (was closing winners too soon)
//   • Wider TP targets: 4x long / 3.5x short (let winners run)
//   • Added BB re-entry: can re-enter on touch of opposite band
// ═══════════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════

// ── Bollinger Bands ──
bb_group  = "== Bollinger Bands =="
source    = input.source(close, "Source", group=bb_group)
length    = input.int(20, "BB Length", minval=1, group=bb_group)
mult      = input.float(2.0, "BB Multiplier", minval=0.001, maxval=50, group=bb_group)

// ── Multi-Timeframe ──
tf_group  = "== Timeframe =="
tf_select = input.string("Chart", "BB Timeframe", options=["Chart", "1H", "4H", "1D"], group=tf_group,
     tooltip="Calculate Bollinger Bands on a higher timeframe. 'Chart' uses the current chart timeframe.")

// ── Trend Filter ──
trend_group    = "== Trend Filter =="
use200EMA      = input.bool(true, "Enable 200 EMA Trend Filter", group=trend_group,
     tooltip="Only long when price > 200 EMA, only short when price < 200 EMA")
ema200Len      = input.int(200, "200 EMA Length", minval=1, group=trend_group)

// ── Trading Mode ──
dir_group     = "== Trading Mode =="
direction     = input.int(0, "Strategy Direction (0=Both, 1=Long, -1=Short)", minval=-1, maxval=1, group=dir_group)
strategy.risk.allow_entry_in(direction == 0 ? strategy.direction.all : (direction < 0 ? strategy.direction.short : strategy.direction.long))
cooldownBars  = input.int(3, "Min Bars Between Trades", minval=0, maxval=100, group=dir_group,
     tooltip="3 bars — enough to prevent same-bar re-entry without blocking trades")

// ── Risk Management ──
risk_group   = "== Risk Management =="
atrLen       = input.int(14, "ATR Length", minval=1, group=risk_group)
minATR       = input.float(0.0, "Minimum ATR Filter", minval=0, step=10.0, group=risk_group,
     tooltip="0 = disabled. Set to 50+ for intraday to filter dead sessions")
slMultLong   = input.float(2.0, "Long Stop Loss ATR Mult", minval=0.5, maxval=10.0, step=0.5, group=risk_group,
     tooltip="2.0x ATR — caps downside on each trade")
tpMultLong   = input.float(4.0, "Long Take Profit ATR Mult", minval=1.0, maxval=30.0, step=0.5, group=risk_group,
     tooltip="4.0x ATR — let winners run, 2:1 R:R")
slMultShort  = input.float(2.0, "Short Stop Loss ATR Mult", minval=0.5, maxval=10.0, step=0.5, group=risk_group)
tpMultShort  = input.float(3.5, "Short Take Profit ATR Mult", minval=1.0, maxval=30.0, step=0.5, group=risk_group,
     tooltip="3.5x ATR — slightly tighter for shorts due to NAS100 long bias")
useTrail     = input.bool(true, "Use Trailing Stop", group=risk_group)
trailATRMult = input.float(2.0, "Trailing Stop ATR Mult", minval=0.5, maxval=10.0, step=0.5, group=risk_group,
     tooltip="2.0x ATR — gives room to breathe, doesn't choke winners")

// ── Volatility Filter ──
vol_group    = "== Volatility Filter =="
useVolFilter = input.bool(true, "Enable Volatility Spike Filter", group=vol_group,
     tooltip="Blocks entries when ATR spikes to 3x its 20-bar average")
volSpikeMult = input.float(3.0, "Vol Spike Multiplier", minval=1.5, maxval=5.0, step=0.5, group=vol_group)

// ── BB Squeeze Filter (OFF by default in v3) ──
squeeze_group = "== BB Squeeze =="
useSqueeze    = input.bool(false, "Require BB Squeeze Before Entry", group=squeeze_group,
     tooltip="OFF by default — was blocking almost all trades in v2. Turn ON for higher-quality but fewer entries")
sqzLookback   = input.int(120, "Squeeze Lookback", minval=20, maxval=500, group=squeeze_group)
sqzPercentile = input.float(50.0, "Squeeze Percentile (%)", minval=5.0, maxval=80.0, step=5.0, group=squeeze_group,
     tooltip="50% — more permissive than v2's 30% when enabled")

// ── NY Session (OFF by default for daily charts) ──
sess_group   = "== NY Session =="
use_session  = input.bool(false, "Only Trade During NY Session", group=sess_group,
     tooltip="OFF by default — daily/4H charts don't need session filtering. Turn ON for 1H or lower")
nyOpenHour   = input.int(9, "NY Open Hour (ET)", minval=0, maxval=23, group=sess_group)
nyOpenMin    = input.int(0, "NY Open Minute (ET)", minval=0, maxval=59, group=sess_group)
nyCloseHour  = input.int(16, "NY Close Hour (ET)", minval=0, maxval=23, group=sess_group)
nyCloseMin   = input.int(0, "NY Close Minute (ET)", minval=0, maxval=59, group=sess_group)
entryHours   = input.int(6, "Entry Window (hours)", minval=1, maxval=24, group=sess_group)

// ── Date Filter ──
date_group  = "== Date Filter =="
use_date    = input.bool(false, "Use Date Filter", group=date_group)
start_date  = input.time(timestamp("2024-01-01"), "Start Date", group=date_group)
end_date    = input.time(timestamp("2069-12-31"), "End Date", group=date_group)

// ═══════════════════════════════════════════════════════════════════════════
// TIME FILTERS
// ═══════════════════════════════════════════════════════════════════════════
in_date = not use_date or (time >= start_date and time <= end_date)

nyHour   = hour(time, "America/New_York")
nyMinute = minute(time, "America/New_York")

nyOpenMins  = nyOpenHour * 60 + nyOpenMin
nyCloseMins = nyCloseHour * 60 + nyCloseMin
nowMins     = nyHour * 60 + nyMinute

inNYSession   = nowMins >= nyOpenMins and nowMins < nyCloseMins
minsFromOpen  = nowMins - nyOpenMins
entryWindowOK = minsFromOpen >= 0 and minsFromOpen < entryHours * 60

sessionOK = not use_session or (inNYSession and entryWindowOK)

// ═══════════════════════════════════════════════════════════════════════════
// TIMEFRAME RESOLUTION
// ═══════════════════════════════════════════════════════════════════════════
tf_res = switch tf_select
    "1H" => "60"
    "4H" => "240"
    "1D" => "1D"
    => timeframe.period

// ═══════════════════════════════════════════════════════════════════════════
// BOLLINGER BANDS — Multi-Timeframe
// ═══════════════════════════════════════════════════════════════════════════
[basis_mtf, upper_mtf, lower_mtf] = request.security(syminfo.tickerid, tf_res, [
     ta.sma(source, length),
     ta.sma(source, length) + mult * ta.stdev(source, length),
     ta.sma(source, length) - mult * ta.stdev(source, length)
     ], lookahead=barmerge.lookahead_off)

// ═══════════════════════════════════════════════════════════════════════════
// TREND FILTER — 200 EMA only
// ═══════════════════════════════════════════════════════════════════════════
ema200 = ta.ema(close, ema200Len)

trendLongOK  = not use200EMA or close > ema200
trendShortOK = not use200EMA or close < ema200

// ═══════════════════════════════════════════════════════════════════════════
// ATR
// ═══════════════════════════════════════════════════════════════════════════
atrValue = ta.atr(atrLen)
atrOK    = minATR == 0.0 or atrValue >= minATR

// ═══════════════════════════════════════════════════════════════════════════
// VOLATILITY SPIKE FILTER
// ═══════════════════════════════════════════════════════════════════════════
atrMA      = ta.sma(atrValue, 20)
notTooWild = not useVolFilter or atrValue < atrMA * volSpikeMult

// ═══════════════════════════════════════════════════════════════════════════
// BB SQUEEZE FILTER (OFF by default)
// ═══════════════════════════════════════════════════════════════════════════
bandwidth    = (upper_mtf - lower_mtf) / basis_mtf * 100
bwMin        = ta.lowest(bandwidth, sqzLookback)
bwMax        = ta.highest(bandwidth, sqzLookback)
bwRange      = bwMax - bwMin
bwThreshold  = bwMin + bwRange * (sqzPercentile / 100.0)
inSqueeze    = not useSqueeze or bandwidth <= bwThreshold

// ═══════════════════════════════════════════════════════════════════════════
// RSI — Wide guard rails
// ═══════════════════════════════════════════════════════════════════════════
rsiVal     = ta.rsi(close, 14)
rsiLongOK  = rsiVal < 85   // very permissive — NAS100 stays overbought in bull runs
rsiShortOK = rsiVal > 15

// ═══════════════════════════════════════════════════════════════════════════
// COOLDOWN
// ═══════════════════════════════════════════════════════════════════════════
var int lastEntryBar = 0
barsSinceEntry = bar_index - lastEntryBar
cooldownOK     = barsSinceEntry >= cooldownBars

// ═══════════════════════════════════════════════════════════════════════════
// ENTRY CONDITIONS
// ═══════════════════════════════════════════════════════════════════════════

// Core BB signals
bbLongRaw  = ta.crossover(source, lower_mtf)
bbShortRaw = ta.crossunder(source, upper_mtf)

// Full entry: BB signal + trend + vol + session + cooldown
long_entry  = bbLongRaw  and trendLongOK  and rsiLongOK  and notTooWild and inSqueeze and in_date and sessionOK and atrOK and cooldownOK
short_entry = bbShortRaw and trendShortOK and rsiShortOK and notTooWild and inSqueeze and in_date and sessionOK and atrOK and cooldownOK

// ═══════════════════════════════════════════════════════════════════════════
// ENTRIES
// ═══════════════════════════════════════════════════════════════════════════
if long_entry
    strategy.entry("BBandLE", strategy.long, comment="BB Long")
    lastEntryBar := bar_index

if short_entry
    strategy.entry("BBandSE", strategy.short, comment="BB Short")
    lastEntryBar := bar_index

// ═══════════════════════════════════════════════════════════════════════════
// EXITS — ATR-based SL/TP/Trail (run anytime)
// ═══════════════════════════════════════════════════════════════════════════
if strategy.position_size > 0
    longSL = strategy.position_avg_price - slMultLong * atrValue
    longTP = strategy.position_avg_price + tpMultLong * atrValue
    if useTrail
        strategy.exit("Long Exit", "BBandLE",
             stop         = longSL,
             limit        = longTP,
             trail_points = atrValue * trailATRMult / syminfo.mintick,
             trail_offset = atrValue * trailATRMult / syminfo.mintick)
    else
        strategy.exit("Long Exit", "BBandLE", stop=longSL, limit=longTP)

if strategy.position_size < 0
    shortSL = strategy.position_avg_price + slMultShort * atrValue
    shortTP = strategy.position_avg_price - tpMultShort * atrValue
    if useTrail
        strategy.exit("Short Exit", "BBandSE",
             stop         = shortSL,
             limit        = shortTP,
             trail_points = atrValue * trailATRMult / syminfo.mintick,
             trail_offset = atrValue * trailATRMult / syminfo.mintick)
    else
        strategy.exit("Short Exit", "BBandSE", stop=shortSL, limit=shortTP)

// ═══════════════════════════════════════════════════════════════════════════
// PLOTS
// ═══════════════════════════════════════════════════════════════════════════
p_basis = plot(basis_mtf, "Basis", color=color.yellow, linewidth=1)
p_upper = plot(upper_mtf, "Upper Band", color=color.new(color.red, 30), linewidth=2)
p_lower = plot(lower_mtf, "Lower Band", color=color.new(color.green, 30), linewidth=2)
fill(p_upper, p_lower, title="BB Fill", color=color.new(color.gray, 90))

plot(use200EMA ? ema200 : na, "200 EMA", color=color.white, linewidth=2)

// Signal markers
plotshape(long_entry and strategy.position_size <= 0,  "Buy",
     shape.triangleup,   location.belowbar, color.lime, size=size.normal)
plotshape(short_entry and strategy.position_size >= 0, "Sell",
     shape.triangledown, location.abovebar, color.red,  size=size.normal)

// Backgrounds
bgcolor(not notTooWild ? color.new(color.orange, 90) : na, title="Vol Spike")
bgcolor(sessionOK and use_session and in_date ? color.new(color.blue, 95) : na, title="NY Session")
bgcolor(not atrOK and minATR > 0 ? color.new(color.red, 95) : na, title="ATR Low")
bgcolor(strategy.position_size > 0 ? color.new(color.green, 95) :
     strategy.position_size < 0 ? color.new(color.red, 95) : na, title="Position")

// ═══════════════════════════════════════════════════════════════════════════
// INFO TABLE
// ═══════════════════════════════════════════════════════════════════════════
var table info = table.new(position.top_right, 2, 12, bgcolor=color.new(color.black, 80), border_width=1)

if barstate.islast
    table.cell(info, 0, 0, "NAS100",     bgcolor=color.new(color.purple, 40), text_color=color.white, text_size=size.small)
    table.cell(info, 1, 0, "BB MTF v3",  bgcolor=color.new(color.purple, 40), text_color=color.white, text_size=size.small)

    table.cell(info, 0, 1, "Timeframe",  text_color=color.white, text_size=size.small)
    table.cell(info, 1, 1, tf_select,    text_color=color.aqua, text_size=size.small)

    table.cell(info, 0, 2, "Upper",      text_color=color.white, text_size=size.small)
    table.cell(info, 1, 2, str.tostring(upper_mtf, "#.#"), text_color=color.red, text_size=size.small)

    table.cell(info, 0, 3, "Basis",      text_color=color.white, text_size=size.small)
    table.cell(info, 1, 3, str.tostring(basis_mtf, "#.#"), text_color=color.yellow, text_size=size.small)

    table.cell(info, 0, 4, "Lower",      text_color=color.white, text_size=size.small)
    table.cell(info, 1, 4, str.tostring(lower_mtf, "#.#"), text_color=color.green, text_size=size.small)

    table.cell(info, 0, 5, "Bandwidth",  text_color=color.white, text_size=size.small)
    table.cell(info, 1, 5, str.tostring(bandwidth, "#.##") + "%",
         text_color=color.white, text_size=size.small)

    table.cell(info, 0, 6, "200 EMA",    text_color=color.white, text_size=size.small)
    table.cell(info, 1, 6, str.tostring(ema200, "#.#"),
         text_color=close > ema200 ? color.green : color.red, text_size=size.small)

    table.cell(info, 0, 7, "Trend",      text_color=color.white, text_size=size.small)
    table.cell(info, 1, 7, close > ema200 ? "BULLISH (>200)" : "BEARISH (<200)",
         text_color=close > ema200 ? color.green : color.red, text_size=size.small)

    table.cell(info, 0, 8, "RSI (14)",   text_color=color.white, text_size=size.small)
    table.cell(info, 1, 8, str.tostring(rsiVal, "#.#"),
         text_color=rsiVal > 70 ? color.red : rsiVal < 30 ? color.green : color.yellow, text_size=size.small)

    table.cell(info, 0, 9, "ATR (" + str.tostring(atrLen) + ")", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 9, str.tostring(atrValue, "#.#"),
         text_color=color.green, text_size=size.small)

    table.cell(info, 0, 10, "Vol Spike",  text_color=color.white, text_size=size.small)
    table.cell(info, 1, 10, notTooWild ? "NORMAL" : "BLOCKED",
         text_color=notTooWild ? color.green : color.orange, text_size=size.small)

    table.cell(info, 0, 11, "Position",   text_color=color.white, text_size=size.small)
    table.cell(info, 1, 11,
         strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT",
         text_color=strategy.position_size > 0 ? color.green : strategy.position_size < 0 ? color.red : color.gray,
         text_size=size.small)
