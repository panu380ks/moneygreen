//@version=6
// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
// © moneygreen

strategy("Bollinger Bands Strategy v4 — NAS100 Daily", shorttitle="BB v4 NAS100 1D", overlay=true,
     process_orders_on_close=true, initial_capital=100000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     currency=currency.USD, pyramiding=0,
     commission_type=strategy.commission.percent, commission_value=0.05,
     slippage=2)

// ═══════════════════════════════════════════════════════════════════════════
// NAS100 BB STRATEGY — v4 (DAILY TIMEFRAME)
// ═══════════════════════════════════════════════════════════════════════════
// Based on TradingView's built-in "Bollinger Bands Strategy directed"
// Adjusted for 1D NAS100 with proper risk management.
//
// Original had NO exits — positions held until opposite signal.
// On NAS100 daily since 2008, the original long-only actually works
// because NAS100 trends up. But it gives back huge drawdowns.
//
// v4 keeps the simple crossover logic and adds:
//   • ATR-based SL/TP to cap drawdowns
//   • 200 EMA trend filter (long above, short below)
//   • Trailing stop to lock in gains
//   • Cooldown of 3 daily bars (no back-to-back entries)
//   • Long-only default (NAS100 long bias)
// ═══════════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════

// ── Bollinger Bands (same as original) ──
bb_group  = "== Bollinger Bands =="
source    = input.source(close, "Source", group=bb_group)
length    = input.int(20, "BB Length", minval=1, group=bb_group)
mult      = input.float(2.0, "BB Multiplier", minval=0.001, maxval=50, group=bb_group)

// ── Direction (same as original) ──
dir_group     = "== Trading Mode =="
direction     = input.int(1, "Strategy Direction (0=Both, 1=Long, -1=Short)", minval=-1, maxval=1, group=dir_group,
     tooltip="1 = Long only. NAS100 has massive upward bias — shorting it long-term loses money")
strategy.risk.allow_entry_in(direction == 0 ? strategy.direction.all : (direction < 0 ? strategy.direction.short : strategy.direction.long))
cooldownBars  = input.int(3, "Min Bars Between Trades", minval=0, maxval=50, group=dir_group,
     tooltip="3 daily bars — prevents whipsaw re-entries")

// ── Trend Filter ──
trend_group    = "== Trend Filter =="
use200EMA      = input.bool(true, "Enable 200 EMA Trend Filter", group=trend_group,
     tooltip="Only long above 200 EMA, only short below. Keeps you on the right side of the macro trend")
ema200Len      = input.int(200, "200 EMA Length", minval=1, group=trend_group)

// ── Risk Management ──
risk_group   = "== Risk Management =="
atrLen       = input.int(14, "ATR Length", minval=1, group=risk_group)
slMult       = input.float(2.0, "Stop Loss ATR Mult", minval=0.5, maxval=10.0, step=0.5, group=risk_group,
     tooltip="2.0x ATR — wide enough for daily noise, caps worst-case loss")
tpMult       = input.float(4.0, "Take Profit ATR Mult", minval=1.0, maxval=30.0, step=0.5, group=risk_group,
     tooltip="4.0x ATR — 2:1 R:R, lets daily winners run")
useTrail     = input.bool(true, "Use Trailing Stop", group=risk_group)
trailMult    = input.float(2.5, "Trailing Stop ATR Mult", minval=0.5, maxval=10.0, step=0.5, group=risk_group,
     tooltip="2.5x ATR — wide trail for daily TF, doesn't get shaken out by normal swings")

// ── Volatility Filter ──
vol_group    = "== Volatility Filter =="
useVolFilter = input.bool(true, "Enable Volatility Spike Filter", group=vol_group,
     tooltip="Blocks entries when daily ATR is 3x its 20-day avg (crash days, FOMC)")
volSpikeMult = input.float(3.0, "Vol Spike Multiplier", minval=1.5, maxval=5.0, step=0.5, group=vol_group)

// ═══════════════════════════════════════════════════════════════════════════
// BOLLINGER BANDS (same calculation as original)
// ═══════════════════════════════════════════════════════════════════════════
basis = ta.sma(source, length)
dev   = mult * ta.stdev(source, length)
upper = basis + dev
lower = basis - dev

// ═══════════════════════════════════════════════════════════════════════════
// TREND FILTER
// ═══════════════════════════════════════════════════════════════════════════
ema200 = ta.ema(close, ema200Len)

trendLongOK  = not use200EMA or close > ema200
trendShortOK = not use200EMA or close < ema200

// ═══════════════════════════════════════════════════════════════════════════
// ATR + VOLATILITY FILTER
// ═══════════════════════════════════════════════════════════════════════════
atrValue   = ta.atr(atrLen)
atrMA      = ta.sma(atrValue, 20)
notTooWild = not useVolFilter or atrValue < atrMA * volSpikeMult

// ═══════════════════════════════════════════════════════════════════════════
// COOLDOWN
// ═══════════════════════════════════════════════════════════════════════════
var int lastEntryBar = 0
barsSinceEntry = bar_index - lastEntryBar
cooldownOK     = barsSinceEntry >= cooldownBars

// ═══════════════════════════════════════════════════════════════════════════
// ENTRY CONDITIONS (crossover logic from original)
// ═══════════════════════════════════════════════════════════════════════════
long_entry  = ta.crossover(source, lower)  and trendLongOK  and notTooWild and cooldownOK
short_entry = ta.crossunder(source, upper) and trendShortOK and notTooWild and cooldownOK

// ═══════════════════════════════════════════════════════════════════════════
// ENTRIES
// ═══════════════════════════════════════════════════════════════════════════
if long_entry
    strategy.entry("BBandLE", strategy.long, comment="BB Long")
    lastEntryBar := bar_index

if short_entry
    strategy.entry("BBandSE", strategy.short, comment="BB Short")
    lastEntryBar := bar_index

// ═══════════════════════════════════════════════════════════════════════════
// EXITS — ATR-based SL/TP/Trail
// ═══════════════════════════════════════════════════════════════════════════
if strategy.position_size > 0
    longSL = strategy.position_avg_price - slMult * atrValue
    longTP = strategy.position_avg_price + tpMult * atrValue
    if useTrail
        strategy.exit("Long Exit", "BBandLE",
             stop         = longSL,
             limit        = longTP,
             trail_points = atrValue * trailMult / syminfo.mintick,
             trail_offset = atrValue * trailMult / syminfo.mintick)
    else
        strategy.exit("Long Exit", "BBandLE", stop=longSL, limit=longTP)

if strategy.position_size < 0
    shortSL = strategy.position_avg_price + slMult * atrValue
    shortTP = strategy.position_avg_price - tpMult * atrValue
    if useTrail
        strategy.exit("Short Exit", "BBandSE",
             stop         = shortSL,
             limit        = shortTP,
             trail_points = atrValue * trailMult / syminfo.mintick,
             trail_offset = atrValue * trailMult / syminfo.mintick)
    else
        strategy.exit("Short Exit", "BBandSE", stop=shortSL, limit=shortTP)

// ═══════════════════════════════════════════════════════════════════════════
// PLOTS
// ═══════════════════════════════════════════════════════════════════════════
p_basis = plot(basis, "Basis", color=color.yellow, linewidth=1)
p_upper = plot(upper, "Upper Band", color=color.new(color.red, 30), linewidth=2)
p_lower = plot(lower, "Lower Band", color=color.new(color.green, 30), linewidth=2)
fill(p_upper, p_lower, title="BB Fill", color=color.new(color.gray, 90))

plot(use200EMA ? ema200 : na, "200 EMA", color=color.white, linewidth=2)

// Signal markers
plotshape(long_entry and strategy.position_size <= 0,  "Buy",
     shape.triangleup,   location.belowbar, color.lime, size=size.normal)
plotshape(short_entry and strategy.position_size >= 0, "Sell",
     shape.triangledown, location.abovebar, color.red,  size=size.normal)

// Backgrounds
bgcolor(not notTooWild ? color.new(color.orange, 90) : na, title="Vol Spike")
bgcolor(strategy.position_size > 0 ? color.new(color.green, 95) :
     strategy.position_size < 0 ? color.new(color.red, 95) : na, title="Position")

// ═══════════════════════════════════════════════════════════════════════════
// INFO TABLE
// ═══════════════════════════════════════════════════════════════════════════
var table info = table.new(position.top_right, 2, 10, bgcolor=color.new(color.black, 80), border_width=1)

if barstate.islast
    table.cell(info, 0, 0, "NAS100",     bgcolor=color.new(color.purple, 40), text_color=color.white, text_size=size.small)
    table.cell(info, 1, 0, "BB v4 1D",   bgcolor=color.new(color.purple, 40), text_color=color.white, text_size=size.small)

    table.cell(info, 0, 1, "Upper",      text_color=color.white, text_size=size.small)
    table.cell(info, 1, 1, str.tostring(upper, "#.#"), text_color=color.red, text_size=size.small)

    table.cell(info, 0, 2, "Basis",      text_color=color.white, text_size=size.small)
    table.cell(info, 1, 2, str.tostring(basis, "#.#"), text_color=color.yellow, text_size=size.small)

    table.cell(info, 0, 3, "Lower",      text_color=color.white, text_size=size.small)
    table.cell(info, 1, 3, str.tostring(lower, "#.#"), text_color=color.green, text_size=size.small)

    table.cell(info, 0, 4, "200 EMA",    text_color=color.white, text_size=size.small)
    table.cell(info, 1, 4, str.tostring(ema200, "#.#"),
         text_color=close > ema200 ? color.green : color.red, text_size=size.small)

    table.cell(info, 0, 5, "Trend",      text_color=color.white, text_size=size.small)
    table.cell(info, 1, 5, close > ema200 ? "BULLISH" : "BEARISH",
         text_color=close > ema200 ? color.green : color.red, text_size=size.small)

    table.cell(info, 0, 6, "ATR (14)",   text_color=color.white, text_size=size.small)
    table.cell(info, 1, 6, str.tostring(atrValue, "#.#"), text_color=color.green, text_size=size.small)

    table.cell(info, 0, 7, "Vol Spike",  text_color=color.white, text_size=size.small)
    table.cell(info, 1, 7, notTooWild ? "NORMAL" : "BLOCKED",
         text_color=notTooWild ? color.green : color.orange, text_size=size.small)

    table.cell(info, 0, 8, "Direction",  text_color=color.white, text_size=size.small)
    table.cell(info, 1, 8, direction == 1 ? "LONG ONLY" : direction == -1 ? "SHORT ONLY" : "BOTH",
         text_color=direction == 1 ? color.green : direction == -1 ? color.red : color.yellow, text_size=size.small)

    table.cell(info, 0, 9, "Position",   text_color=color.white, text_size=size.small)
    table.cell(info, 1, 9,
         strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT",
         text_color=strategy.position_size > 0 ? color.green : strategy.position_size < 0 ? color.red : color.gray,
         text_size=size.small)
