//@version=6
strategy("BB HH Session Strategy", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=5, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0.05, slippage=1)
source = close
length = input.int(20, minval=1)
mult = input.float(2.0, minval=0.001, maxval=50)
direction = input.int(0, title = "Strategy Direction", minval=-1, maxval=1)
strategy.risk.allow_entry_in(direction == 0 ? strategy.direction.all : (direction < 0 ? strategy.direction.short : strategy.direction.long))
basis = ta.sma(source, length)
dev = mult * ta.stdev(source, length)
upper = basis + dev
lower = basis - dev

// ── Session Filter ──
sess_tz    = input.string("America/New_York", "Session Timezone", group="Session Filter")
sess_start = input.int(8,  "Session Start Hour (0-23)", minval=0, maxval=23, group="Session Filter")
sess_end   = input.int(12, "Session End Hour (0-23)",   minval=0, maxval=23, group="Session Filter")

current_hour = hour(time, sess_tz)
in_session   = current_hour >= sess_start and current_hour < sess_end

// ── Track Higher Highs ──
pivot_len = input.int(5, "Pivot Lookback", minval=1)
ph = ta.pivothigh(high, pivot_len, pivot_len)

var float prev_high = na
var float last_high = na

if not na(ph)
    prev_high := last_high
    last_high := ph

higher_high = not na(prev_high) and not na(last_high) and last_high > prev_high

// ── Volume Filter (reduce trades) ──
vol_filter   = input.bool(true, "Require Above-Avg Volume", group="Trade Filters")
vol_len      = input.int(20, "Volume MA Length", minval=5, maxval=100, group="Trade Filters")
vol_thresh   = input.float(1.2, "Volume Threshold (x avg)", minval=1.0, maxval=3.0, step=0.1, group="Trade Filters")
avg_vol      = ta.sma(volume, vol_len)
vol_ok       = not vol_filter or (volume >= avg_vol * vol_thresh)

// ── Cooldown (min bars between entries) ──
cooldown_bars = input.int(10, "Min Bars Between Trades", minval=1, maxval=50, group="Trade Filters")
var int last_entry_bar = 0
bars_since_entry = bar_index - last_entry_bar
cooldown_ok = bars_since_entry >= cooldown_bars

// ── Risk Management Inputs ──
atr_length     = input.int(14, "ATR Length", minval=1, maxval=50, group="Risk Management")
sl_atr_mult    = input.float(1.0, "Stop Loss (ATR multiplier)", minval=0.5, maxval=5.0, step=0.1, group="Risk Management")
tp_atr_mult    = input.float(3.5, "Take Profit (ATR multiplier)", minval=0.5, maxval=10.0, step=0.1, group="Risk Management")
use_trail      = input.bool(true, "Use Trailing Stop", group="Risk Management")
trail_atr_mult = input.float(1.5, "Trailing Stop (ATR multiplier)", minval=0.5, maxval=5.0, step=0.1, group="Risk Management")

// Dashboard
show_dashboard = input.bool(true, "Show Backtest Dashboard", group="Dashboard")

// ── ATR Calculation ──
atr_val = ta.atr(atr_length)

// ── Combined entry filter ──
can_trade = in_session and vol_ok and cooldown_ok

// ── Long: BB crossover + higher high + session + filters ──
if (ta.crossover(source, lower)) and higher_high and can_trade
    strategy.entry("BBandLE", strategy.long, stop=lower, oca_name="BollingerBands", oca_type=strategy.oca.cancel, comment="BBandLE")
    last_entry_bar := bar_index
    long_sl = close - atr_val * sl_atr_mult
    long_tp = close + atr_val * tp_atr_mult
    if use_trail
        strategy.exit("Long_Exit", "BBandLE", stop=long_sl, limit=long_tp, trail_points=atr_val * trail_atr_mult / syminfo.mintick, trail_offset=atr_val * trail_atr_mult / syminfo.mintick)
    else
        strategy.exit("Long_Exit", "BBandLE", stop=long_sl, limit=long_tp)
else
    strategy.cancel(id="BBandLE")

// ── Short: BB crossunder + session + filters ──
if ((ta.crossunder(source, upper)) or (higher_high and close < last_high)) and can_trade
    strategy.entry("BBandSE", strategy.short, stop=upper, oca_name="BollingerBands", oca_type=strategy.oca.cancel, comment="BBandSE")
    last_entry_bar := bar_index
    short_sl = close + atr_val * sl_atr_mult
    short_tp = close - atr_val * tp_atr_mult
    if use_trail
        strategy.exit("Short_Exit", "BBandSE", stop=short_sl, limit=short_tp, trail_points=atr_val * trail_atr_mult / syminfo.mintick, trail_offset=atr_val * trail_atr_mult / syminfo.mintick)
    else
        strategy.exit("Short_Exit", "BBandSE", stop=short_sl, limit=short_tp)
else
    strategy.cancel(id="BBandSE")

// ── Close any open positions at session end ──
if not in_session and (strategy.position_size != 0)
    strategy.close_all(comment="Session End")

// ── Plots ──
plot(last_high, "Last High", color=color.orange, linewidth=1, style=plot.style_stepline)
plot(prev_high, "Prev High", color=color.gray, linewidth=1, style=plot.style_stepline)
plot(upper, "BB Upper", color=color.new(color.red, 30), linewidth=1)
plot(basis, "BB Mid", color=color.new(color.gray, 50), linewidth=1)
plot(lower, "BB Lower", color=color.new(color.green, 30), linewidth=1)
bgcolor(in_session ? color.new(color.blue, 93) : na, title="Session Window")

// ──────────────────────────────────────────────────────────────────────────────
// BACKTEST PERFORMANCE DASHBOARD
// ──────────────────────────────────────────────────────────────────────────────

if show_dashboard and barstate.islast
    total_trades   = strategy.closedtrades
    total_wins     = strategy.wintrades
    total_losses   = strategy.losstrades
    win_rate       = total_trades > 0 ? (total_wins / total_trades) * 100 : 0.0
    net_profit     = strategy.netprofit
    net_profit_pct = strategy.netprofit_percent
    gross_profit   = strategy.grossprofit
    gross_loss     = strategy.grossloss
    profit_factor  = gross_loss != 0 ? math.abs(gross_profit / gross_loss) : 0.0
    max_dd         = strategy.max_drawdown
    max_dd_pct     = strategy.max_drawdown_percent

    float sum_win  = 0.0
    float sum_loss = 0.0
    int win_count  = 0
    int loss_count = 0

    if total_trades > 0
        for i = 0 to total_trades - 1
            pnl = strategy.closedtrades.profit(i)
            if pnl > 0
                sum_win  += pnl
                win_count += 1
            else if pnl < 0
                sum_loss += pnl
                loss_count += 1

    avg_win  = win_count > 0 ? sum_win / win_count : 0.0
    avg_loss = loss_count > 0 ? sum_loss / loss_count : 0.0
    avg_rr   = avg_loss != 0 ? math.abs(avg_win / avg_loss) : 0.0

    int long_wins    = 0
    int long_losses  = 0
    int short_wins   = 0
    int short_losses = 0

    if total_trades > 0
        for i = 0 to total_trades - 1
            is_long = strategy.closedtrades.size(i) > 0
            is_win  = strategy.closedtrades.profit(i) > 0
            if is_long
                if is_win
                    long_wins += 1
                else
                    long_losses += 1
            else
                if is_win
                    short_wins += 1
                else
                    short_losses += 1

    total_longs  = long_wins + long_losses
    total_shorts = short_wins + short_losses
    long_wr  = total_longs > 0 ? (long_wins / total_longs) * 100 : 0.0
    short_wr = total_shorts > 0 ? (short_wins / total_shorts) * 100 : 0.0

    wr_color  = win_rate >= 60 ? color.green : win_rate >= 50 ? color.yellow : color.red
    pf_color  = profit_factor >= 1.5 ? color.green : profit_factor >= 1.0 ? color.yellow : color.red
    pnl_color = net_profit >= 0 ? color.green : color.red

    var table dash = table.new(position.top_right, 3, 14, bgcolor=color.new(color.black, 80), border_width=1, border_color=color.gray)

    table.cell(dash, 0, 0, "BACKTEST RESULTS", text_color=color.white, text_size=size.normal, text_halign=text.align_left)
    table.cell(dash, 1, 0, "", text_size=size.small)
    table.cell(dash, 2, 0, "", text_size=size.small)

    table.cell(dash, 0, 1, "─────────────", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 1, "────────", text_color=color.gray, text_size=size.small)
    table.cell(dash, 2, 1, "", text_size=size.small)

    table.cell(dash, 0, 2, "Total Trades", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 2, str.tostring(total_trades), text_color=color.aqua, text_size=size.small)
    table.cell(dash, 2, 2, "", text_size=size.small)

    table.cell(dash, 0, 3, "WIN RATE", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 3, str.tostring(win_rate, "#.1") + "%", text_color=wr_color, text_size=size.normal)
    table.cell(dash, 2, 3, str.tostring(total_wins) + "W / " + str.tostring(total_losses) + "L", text_color=color.gray, text_size=size.small)

    table.cell(dash, 0, 4, "Net Profit", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 4, str.tostring(net_profit, "#.2"), text_color=pnl_color, text_size=size.small)
    table.cell(dash, 2, 4, str.tostring(net_profit_pct, "#.1") + "%", text_color=pnl_color, text_size=size.small)

    table.cell(dash, 0, 5, "Profit Factor", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 5, str.tostring(profit_factor, "#.2"), text_color=pf_color, text_size=size.small)
    table.cell(dash, 2, 5, "", text_size=size.small)

    table.cell(dash, 0, 6, "Max Drawdown", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 6, str.tostring(max_dd, "#.2"), text_color=color.red, text_size=size.small)
    table.cell(dash, 2, 6, str.tostring(max_dd_pct, "#.1") + "%", text_color=color.red, text_size=size.small)

    table.cell(dash, 0, 7, "─────────────", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 7, "────────", text_color=color.gray, text_size=size.small)
    table.cell(dash, 2, 7, "", text_size=size.small)

    table.cell(dash, 0, 8, "Avg Win", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 8, str.tostring(avg_win, "#.2"), text_color=color.green, text_size=size.small)
    table.cell(dash, 2, 8, "", text_size=size.small)

    table.cell(dash, 0, 9, "Avg Loss", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 9, str.tostring(avg_loss, "#.2"), text_color=color.red, text_size=size.small)
    table.cell(dash, 2, 9, "", text_size=size.small)

    table.cell(dash, 0, 10, "Avg R:R", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 10, str.tostring(avg_rr, "#.2"), text_color=avg_rr >= 1.0 ? color.green : color.red, text_size=size.small)
    table.cell(dash, 2, 10, "", text_size=size.small)

    table.cell(dash, 0, 11, "─────────────", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 11, "────────", text_color=color.gray, text_size=size.small)
    table.cell(dash, 2, 11, "", text_size=size.small)

    table.cell(dash, 0, 12, "Long WR", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 12, str.tostring(long_wr, "#.1") + "%", text_color=long_wr >= 60 ? color.green : long_wr >= 50 ? color.yellow : color.red, text_size=size.small)
    table.cell(dash, 2, 12, str.tostring(total_longs) + " trades", text_color=color.gray, text_size=size.small)

    table.cell(dash, 0, 13, "Short WR", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 13, str.tostring(short_wr, "#.1") + "%", text_color=short_wr >= 60 ? color.green : short_wr >= 50 ? color.yellow : color.red, text_size=size.small)
    table.cell(dash, 2, 13, str.tostring(total_shorts) + " trades", text_color=color.gray, text_size=size.small)
