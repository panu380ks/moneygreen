// Gaussian Channel Strategy v3 — Forex + NY Session
// Buy ONCE on GREEN flip, Sell ONCE on RED flip. No re-entry until next flip.
// v3: MTF, MACD, dynamic stops, break-even, win-rate sizing, NY session mode
//@version=6
strategy("Gaussian Channel FX v3", overlay=true,
     initial_capital=10000, default_qty_type=strategy.percent_of_equity,
     default_qty_value=100, commission_type=strategy.commission.percent,
     commission_value=0.005, slippage=2, pyramiding=0)

strategy.risk.max_drawdown(15, strategy.percent_of_equity)

// ═══════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════

// Gaussian Channel
src       = input.source(hlc3, "Source", group="Gaussian Channel")
poles     = input.int(4, "Poles (1-4)", minval=1, maxval=4, group="Gaussian Channel")
period    = input.int(144, "Period", minval=1, group="Gaussian Channel")
mult      = input.float(1.414, "Band Multiplier", step=0.001, group="Gaussian Channel")

// Trend Filter
useEMA      = input.bool(true, "EMA Trend Filter", group="Trend Filter")
emaLen      = input.int(200, "EMA Length", group="Trend Filter")
useADX      = input.bool(true, "ADX Trend Strength", group="Trend Filter")
adxLen      = input.int(14, "ADX Length", group="Trend Filter")
adxMin      = input.float(20.0, "Min ADX", step=1.0, group="Trend Filter")
useMTF      = input.bool(true, "Higher TF Confirmation", group="Trend Filter",
     tooltip="Gaussian filter on higher TF must agree with entry direction")
mtfMult     = input.int(4, "HTF Multiplier", minval=2, maxval=10, group="Trend Filter",
     tooltip="e.g. 4 = 4H filter if on 1H chart")

// Entry Quality
confirmBars   = input.int(4, "Confirm Bars After Flip", minval=1, maxval=10, group="Entry")
useMACD       = input.bool(true, "MACD Histogram Confirmation", group="Entry",
     tooltip="MACD histogram must agree with trade direction")
macdFast      = input.int(12, "MACD Fast", group="Entry")
macdSlow      = input.int(26, "MACD Slow", group="Entry")
macdSignal    = input.int(9, "MACD Signal", group="Entry")
useRSI        = input.bool(true, "RSI Filter", group="Entry")
rsiLen        = input.int(14, "RSI Length", group="Entry")
rsiLongMax    = input.float(65, "Max RSI for Longs", group="Entry")
rsiLongMin    = input.float(40, "Min RSI for Longs", group="Entry")
rsiShortMax   = input.float(60, "Max RSI for Shorts", group="Entry")
rsiShortMin   = input.float(35, "Min RSI for Shorts", group="Entry")
reqConsClose  = input.int(2, "Consecutive Closes Past Filter", minval=1, maxval=5, group="Entry",
     tooltip="Price must close on correct side of filter for N bars")
reqPricePos   = input.bool(true, "Price Must Be On Correct Side of Filter", group="Entry")
useMinATR     = input.bool(true, "Minimum ATR Filter", group="Entry",
     tooltip="Skip trades when volatility is too low — whipsaw zone")
minATRpct     = input.float(0.5, "Min ATR % of Average", step=0.1, group="Entry")

// Direction
direction = input.string("Both", "Trade Direction", options=["Both", "Long Only", "Short Only"], group="Direction")

// Risk
atrLen     = input.int(14, "ATR Length", group="Risk")
useBandSL  = input.bool(true, "Use Band-Width Stop", group="Risk",
     tooltip="Stop loss based on channel width instead of fixed ATR multiple")
slATR      = input.float(1.5, "Stop Loss ATR x (fallback)", step=0.25, group="Risk")
bandSLmult = input.float(0.5, "Band SL Width Multiplier", step=0.1, group="Risk",
     tooltip="0.5 = stop at half the band width beyond entry")
tp1ATR     = input.float(2.5, "TP1 ATR x", step=0.25, group="Risk")
tp2ATR     = input.float(5.0, "TP2 ATR x", step=0.5, group="Risk")
q1         = input.int(50, "TP1 Qty %", group="Risk")
useTrail   = input.bool(true, "Trailing Stop", group="Risk")
trailATR   = input.float(1.5, "Trail ATR x", step=0.25, group="Risk")
useBE      = input.bool(true, "Break-Even After TP1", group="Risk",
     tooltip="Move stop to entry after first target hit")

// Position Sizing
basePos      = input.float(50.0, "Base Position %", minval=10, maxval=100, step=5, group="Size")
useVolScale  = input.bool(true, "Volatility Scaling", group="Size")
volScaleLen  = input.int(40, "Vol Scale Lookback", group="Size")
useWRscale   = input.bool(true, "Win Rate Scaling", group="Size",
     tooltip="Reduce size when recent win rate is poor")
wrLookback   = input.int(20, "Win Rate Lookback Trades", group="Size")

// Drawdown
useCooldown  = input.bool(true, "Loss Cooldown", group="Drawdown")
coolBars     = input.int(15, "Cooldown Bars", group="Drawdown")
maxConsLoss  = input.int(3, "Max Consecutive Losses", group="Drawdown")

// Session — supports NY session mode or custom session
sessionMode  = input.string("NY Session", "Session Mode",
     options=["Off", "NY Session", "London/NY Overlap", "Custom"], group="Session",
     tooltip="Off = trade 24/7. NY = 0800-1600 EST. Overlap = London/NY. Custom = your hours")
customSess   = input.session("0700-1700", "Custom Session (UTC)", group="Session")
closeAtEnd   = input.bool(true, "Close All at Session End", group="Session",
     tooltip="Flatten all positions when session closes — no overnight risk")
noLateEntry  = input.bool(true, "No Late Entries", group="Session",
     tooltip="Block new entries in last 2 hours of session")
useKillzone  = input.bool(true, "Killzone Size Boost", group="Session",
     tooltip="Increase position size during London/NY overlap (1300-1700 UTC)")
kzSizeMult   = input.float(1.25, "Killzone Size Multiplier", step=0.05, group="Session")

// ═══════════════════════════════════════════════════════════════
// GAUSSIAN FILTER — Multi-pole IIR implementation
// ═══════════════════════════════════════════════════════════════

beta  = (1 - math.cos(2 * math.pi / period)) / (math.pow(math.sqrt(2.0), 2.0 / poles) - 1)
alpha = -beta + math.sqrt(beta * beta + 2 * beta)

var float f1 = na
f1 := alpha * src + (1 - alpha) * nz(f1[1], src)

var float f2 = na
f2 := poles >= 2 ? alpha * f1 + (1 - alpha) * nz(f2[1], f1) : f1

var float f3 = na
f3 := poles >= 3 ? alpha * f2 + (1 - alpha) * nz(f3[1], f2) : f2

var float f4 = na
f4 := poles >= 4 ? alpha * f3 + (1 - alpha) * nz(f4[1], f3) : f3

gaussFilter = f4

// ═══════════════════════════════════════════════════════════════
// BAND CALCULATION
// ═══════════════════════════════════════════════════════════════

dev = math.abs(src - gaussFilter)

var float d1 = na
d1 := alpha * dev + (1 - alpha) * nz(d1[1], dev)

var float d2 = na
d2 := poles >= 2 ? alpha * d1 + (1 - alpha) * nz(d2[1], d1) : d1

var float d3 = na
d3 := poles >= 3 ? alpha * d2 + (1 - alpha) * nz(d3[1], d2) : d2

var float d4 = na
d4 := poles >= 4 ? alpha * d3 + (1 - alpha) * nz(d4[1], d3) : d3

filteredDev = d4

upperBand = gaussFilter + mult * filteredDev
lowerBand = gaussFilter - mult * filteredDev
bandWidth = upperBand - lowerBand

// ═══════════════════════════════════════════════════════════════
// HIGHER TIMEFRAME GAUSSIAN FILTER (MTF)
// ═══════════════════════════════════════════════════════════════

htfPeriod = period * mtfMult
htfBeta   = (1 - math.cos(2 * math.pi / htfPeriod)) / (math.pow(math.sqrt(2.0), 2.0 / poles) - 1)
htfAlpha  = -htfBeta + math.sqrt(htfBeta * htfBeta + 2 * htfBeta)

var float hf1 = na
hf1 := htfAlpha * src + (1 - htfAlpha) * nz(hf1[1], src)

var float hf2 = na
hf2 := poles >= 2 ? htfAlpha * hf1 + (1 - htfAlpha) * nz(hf2[1], hf1) : hf1

var float hf3 = na
hf3 := poles >= 3 ? htfAlpha * hf2 + (1 - htfAlpha) * nz(hf3[1], hf2) : hf2

var float hf4 = na
hf4 := poles >= 4 ? htfAlpha * hf3 + (1 - htfAlpha) * nz(hf4[1], hf3) : hf3

htfFilter    = hf4
htfIsGreen   = htfFilter > htfFilter[1]
htfIsRed     = htfFilter < htfFilter[1]

// ═══════════════════════════════════════════════════════════════
// CHANNEL DIRECTION
// ═══════════════════════════════════════════════════════════════

isGreen = gaussFilter > gaussFilter[1]
isRed   = gaussFilter < gaussFilter[1]

justTurnedGreen = isGreen and not isGreen[1]
justTurnedRed   = isRed and not isRed[1]

// ═══════════════════════════════════════════════════════════════
// BARS SINCE FLIP
// ═══════════════════════════════════════════════════════════════

var int barsSinceGreen = 999
var int barsSinceRed   = 999

if justTurnedGreen
    barsSinceGreen := 0
else if isGreen
    barsSinceGreen := barsSinceGreen + 1

if justTurnedRed
    barsSinceRed := 0
else if isRed
    barsSinceRed := barsSinceRed + 1

greenConfirmed = barsSinceGreen == confirmBars and isGreen
redConfirmed   = barsSinceRed == confirmBars and isRed

// ═══════════════════════════════════════════════════════════════
// INDICATORS
// ═══════════════════════════════════════════════════════════════

rsiVal = ta.rsi(close, rsiLen)
atrVal = ta.atr(atrLen)
ema200 = ta.ema(close, emaLen)

[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)
adxOK = not useADX or adxVal >= adxMin

[macdLine, signalLine, histLine] = ta.macd(close, macdFast, macdSlow, macdSignal)
macdBullOK = not useMACD or histLine > 0
macdBearOK = not useMACD or histLine < 0

atrMA    = ta.sma(atrVal, volScaleLen)
atrOK    = not useMinATR or (atrVal >= atrMA * minATRpct)

// ═══════════════════════════════════════════════════════════════
// SESSION LOGIC — NY, London/NY overlap, Custom, or Off
// ═══════════════════════════════════════════════════════════════

// Session windows (UTC)
nySess       = "1300-2100"   // NY 08:00-16:00 EST
nyEntrySess  = "1300-1900"   // No entries last 2 hours
lonNySess    = "1300-1700"   // London/NY overlap
lonNyEntry   = "1300-1500"   // Overlap entry window

sessStr = switch sessionMode
    "NY Session"        => nySess
    "London/NY Overlap" => lonNySess
    "Custom"            => customSess
    => ""

entryStr = switch sessionMode
    "NY Session"        => nyEntrySess
    "London/NY Overlap" => lonNyEntry
    "Custom"            => customSess
    => ""

inSession     = sessionMode == "Off" or not na(time(timeframe.period, sessStr, "UTC"))
inEntryWindow = sessionMode == "Off" or not noLateEntry or not na(time(timeframe.period, entryStr, "UTC"))

// Detect session end
wasInSession    = sessionMode != "Off" and not na(time(timeframe.period, sessStr, "UTC")[1])
sessionJustEnded = wasInSession and not inSession

// Killzone — London/NY overlap
inKillzone = not na(time(timeframe.period, "1300-1700", "UTC"))

// ═══════════════════════════════════════════════════════════════
// CONSECUTIVE CLOSE CONFIRMATION
// ═══════════════════════════════════════════════════════════════

var int consAbove = 0
var int consBelow = 0

if close > gaussFilter
    consAbove := consAbove + 1
    consBelow := 0
else if close < gaussFilter
    consBelow := consBelow + 1
    consAbove := 0
else
    consAbove := 0
    consBelow := 0

consCloseOKlong  = consAbove >= reqConsClose
consCloseOKshort = consBelow >= reqConsClose

// ═══════════════════════════════════════════════════════════════
// ENTRY CONDITIONS
// ═══════════════════════════════════════════════════════════════

emaBullOK = not useEMA or close > ema200
emaBearOK = not useEMA or close < ema200

mtfBullOK = not useMTF or htfIsGreen
mtfBearOK = not useMTF or htfIsRed

rsiBuyOK  = not useRSI or (rsiVal >= rsiLongMin and rsiVal <= rsiLongMax)
rsiSellOK = not useRSI or (rsiVal >= rsiShortMin and rsiVal <= rsiShortMax)

priceLongOK  = not reqPricePos or close > gaussFilter
priceShortOK = not reqPricePos or close < gaussFilter

canLong  = direction == "Both" or direction == "Long Only"
canShort = direction == "Both" or direction == "Short Only"

longEntry = greenConfirmed and canLong and emaBullOK and mtfBullOK and adxOK and macdBullOK and rsiBuyOK and priceLongOK and consCloseOKlong and atrOK and inSession and inEntryWindow

shortEntry = redConfirmed and canShort and emaBearOK and mtfBearOK and adxOK and macdBearOK and rsiSellOK and priceShortOK and consCloseOKshort and atrOK and inSession and inEntryWindow

// ═══════════════════════════════════════════════════════════════
// DRAWDOWN CONTROLS & WIN RATE TRACKING
// ═══════════════════════════════════════════════════════════════

var int lastLossBar      = -999
var int prevClosedCount  = 0
var int consLosses       = 0

if strategy.closedtrades > prevClosedCount
    lastProfit = strategy.closedtrades.profit(strategy.closedtrades - 1)
    if lastProfit < 0
        lastLossBar := bar_index
        consLosses  := consLosses + 1
    else
        consLosses := 0
    prevClosedCount := strategy.closedtrades

cooldownOK  = not useCooldown or (bar_index - lastLossBar) > coolBars
consLossOK  = consLosses < maxConsLoss

totalTrades = strategy.closedtrades
lookbackN   = math.min(wrLookback, totalTrades)
var float rollingWR = 0.5
if lookbackN > 0
    wins = 0
    for i = 0 to lookbackN - 1
        if strategy.closedtrades.profit(totalTrades - 1 - i) > 0
            wins := wins + 1
    rollingWR := wins / lookbackN

wrScale = useWRscale ? (rollingWR < 0.40 ? 0.5 : rollingWR > 0.55 ? 1.0 : 0.75) : 1.0

volRatio = nz(atrVal / atrMA, 1.0)
volScale = useVolScale ? (volRatio > 1.5 ? 0.5 : volRatio > 1.2 ? 0.75 : 1.0) : 1.0

kzScale = useKillzone and inKillzone and sessionMode != "Off" ? kzSizeMult : 1.0

ddGate = cooldownOK and consLossOK

posSize = strategy.equity * (basePos / 100.0) * volScale * wrScale * kzScale / close

// ═══════════════════════════════════════════════════════════════
// EXECUTE TRADES
// ═══════════════════════════════════════════════════════════════

slDist     = useBandSL ? bandWidth * bandSLmult : atrVal * slATR
slTicks    = slDist / syminfo.mintick
tp1Ticks   = atrVal * tp1ATR / syminfo.mintick
tp2Ticks   = atrVal * tp2ATR / syminfo.mintick
trailTicks = atrVal * trailATR / syminfo.mintick
trailOff   = atrVal * trailATR * 0.4 / syminfo.mintick

var float entryPrice  = na
var bool  tp1Hit      = false

// ═══ LONG ENTRY ═══
if longEntry and ddGate and strategy.position_size <= 0
    if strategy.position_size < 0
        strategy.close("Short", comment="Flip to Long")
    strategy.entry("Long", strategy.long, qty=posSize)
    entryPrice := close
    tp1Hit     := false
    strategy.exit("L-TP1", "Long", qty_percent=q1, profit=tp1Ticks, loss=slTicks)
    if useTrail
        strategy.exit("L-Trail", "Long", profit=tp2Ticks, loss=slTicks,
             trail_points=trailTicks, trail_offset=trailOff)
    else
        strategy.exit("L-TP2", "Long", profit=tp2Ticks, loss=slTicks)

// ═══ SHORT ENTRY ═══
if shortEntry and ddGate and strategy.position_size >= 0
    if strategy.position_size > 0
        strategy.close("Long", comment="Flip to Short")
    strategy.entry("Short", strategy.short, qty=posSize)
    entryPrice := close
    tp1Hit     := false
    strategy.exit("S-TP1", "Short", qty_percent=q1, profit=tp1Ticks, loss=slTicks)
    if useTrail
        strategy.exit("S-Trail", "Short", profit=tp2Ticks, loss=slTicks,
             trail_points=trailTicks, trail_offset=trailOff)
    else
        strategy.exit("S-TP2", "Short", profit=tp2Ticks, loss=slTicks)

// ═══════════════════════════════════════════════════════════════
// BREAK-EVEN AFTER TP1
// ═══════════════════════════════════════════════════════════════

if useBE and strategy.position_size != 0 and not tp1Hit
    if strategy.position_size > 0 and high >= entryPrice + atrVal * tp1ATR
        tp1Hit := true
        beTicks = math.max(1, (close - entryPrice) * 0.1 / syminfo.mintick)
        if useTrail
            strategy.exit("L-Trail", "Long", profit=tp2Ticks, loss=beTicks,
                 trail_points=trailTicks, trail_offset=trailOff)
        else
            strategy.exit("L-TP2", "Long", profit=tp2Ticks, loss=beTicks)
    if strategy.position_size < 0 and low <= entryPrice - atrVal * tp1ATR
        tp1Hit := true
        beTicks = math.max(1, (entryPrice - close) * 0.1 / syminfo.mintick)
        if useTrail
            strategy.exit("S-Trail", "Short", profit=tp2Ticks, loss=beTicks,
                 trail_points=trailTicks, trail_offset=trailOff)
        else
            strategy.exit("S-TP2", "Short", profit=tp2Ticks, loss=beTicks)

// ═══════════════════════════════════════════════════════════════
// EXITS — Band flip + Session end
// ═══════════════════════════════════════════════════════════════

if strategy.position_size > 0 and justTurnedRed
    strategy.close("Long", comment="Channel Red")

if strategy.position_size < 0 and justTurnedGreen
    strategy.close("Short", comment="Channel Green")

// Close ALL at session end
if closeAtEnd and sessionJustEnded and strategy.position_size != 0
    strategy.close_all(comment="Session Close")

// ═══════════════════════════════════════════════════════════════
// PLOTS
// ═══════════════════════════════════════════════════════════════

filterColor = isGreen ? color.new(#00e676, 0) : isRed ? color.new(#ff5252, 0) : color.new(#9e9e9e, 0)
plot(gaussFilter, "Gaussian Filter", filterColor, linewidth=2)

p_upper  = plot(upperBand, "Upper Band", color.new(#ffffff, 70), linewidth=1)
p_lower  = plot(lowerBand, "Lower Band", color.new(#ffffff, 70), linewidth=1)
p_filter = plot(gaussFilter, "Filter Fill", color.new(color.black, 100), display=display.none)

fill(p_upper, p_filter, color=isGreen ? color.new(#00e676, 85) : color.new(#ff5252, 85), title="Upper Fill")
fill(p_filter, p_lower, color=isGreen ? color.new(#00e676, 85) : color.new(#ff5252, 85), title="Lower Fill")

plot(useEMA ? ema200 : na, "EMA 200", color.new(#ffeb3b, 30), linewidth=2)
plot(useMTF ? htfFilter : na, "HTF Gaussian", color.new(#ff9800, 40), linewidth=1)

plotshape(longEntry and ddGate and strategy.position_size <= 0, "Buy",
     shape.triangleup, location.belowbar, color.new(#00e676, 0), size=size.small, text="BUY")
plotshape(shortEntry and ddGate and strategy.position_size >= 0, "Sell",
     shape.triangledown, location.abovebar, color.new(#ff5252, 0), size=size.small, text="SELL")

plotshape(justTurnedGreen, "Green Flip", shape.circle, location.belowbar,
     color.new(#00e676, 30), size=size.tiny)
plotshape(justTurnedRed, "Red Flip", shape.circle, location.abovebar,
     color.new(#ff5252, 30), size=size.tiny)

// Session backgrounds
bgcolor(inSession and sessionMode != "Off" ? color.new(#2196f3, 94) : na, title="Session Active")
bgcolor(inKillzone and useKillzone and sessionMode != "Off" ? color.new(#ff9800, 92) : na, title="Killzone")
bgcolor(isGreen ? color.new(#00e676, 96) : isRed ? color.new(#ff5252, 96) : na, title="Channel Direction")
bgcolor(not ddGate ? color.new(#ff9800, 88) : na, title="DD Paused")

// ═══════════════════════════════════════════════════════════════
// INFO TABLE
// ═══════════════════════════════════════════════════════════════

var table infoT = table.new(position.top_right, 2, 14, bgcolor=color.new(color.black, 80), border_width=1)
if barstate.islast
    table.cell(infoT, 0, 0, "STRATEGY", text_color=color.yellow, text_size=size.small)
    table.cell(infoT, 1, 0, "GAUSS CH FX v3", text_color=color.yellow, text_size=size.small)

    table.cell(infoT, 0, 1, "SESSION", text_color=color.gray, text_size=size.small)
    sessStatus = sessionMode == "Off" ? "24/7" : inSession ? (inEntryWindow ? "ACTIVE" : "EXIT ONLY") : "CLOSED"
    sessColor  = sessionMode == "Off" ? color.white : inSession ? (inEntryWindow ? color.green : color.orange) : color.red
    table.cell(infoT, 1, 1, sessStatus, text_color=sessColor, text_size=size.small)

    table.cell(infoT, 0, 2, "CHANNEL", text_color=color.gray, text_size=size.small)
    table.cell(infoT, 1, 2, isGreen ? "GREEN" : isRed ? "RED" : "FLAT",
         text_color=isGreen ? color.green : isRed ? color.red : color.gray, text_size=size.small)

    table.cell(infoT, 0, 3, "HTF TREND", text_color=color.gray, text_size=size.small)
    table.cell(infoT, 1, 3, htfIsGreen ? "BULL" : htfIsRed ? "BEAR" : "FLAT",
         text_color=htfIsGreen ? color.green : htfIsRed ? color.red : color.gray, text_size=size.small)

    table.cell(infoT, 0, 4, "EMA 200", text_color=color.gray, text_size=size.small)
    table.cell(infoT, 1, 4, close > ema200 ? "ABOVE" : "BELOW",
         text_color=close > ema200 ? color.green : color.red, text_size=size.small)

    table.cell(infoT, 0, 5, "ADX", text_color=color.gray, text_size=size.small)
    table.cell(infoT, 1, 5, str.tostring(adxVal, "#.0") + (adxVal >= adxMin ? " OK" : " WEAK"),
         text_color=adxVal >= adxMin ? color.green : color.red, text_size=size.small)

    table.cell(infoT, 0, 6, "MACD HIST", text_color=color.gray, text_size=size.small)
    table.cell(infoT, 1, 6, histLine > 0 ? "BULL" : "BEAR",
         text_color=histLine > 0 ? color.green : color.red, text_size=size.small)

    table.cell(infoT, 0, 7, "RSI", text_color=color.gray, text_size=size.small)
    table.cell(infoT, 1, 7, str.tostring(rsiVal, "#.0"), text_color=color.white, text_size=size.small)

    table.cell(infoT, 0, 8, "WIN RATE", text_color=color.gray, text_size=size.small)
    table.cell(infoT, 1, 8, str.tostring(rollingWR * 100, "#.0") + "% (" + str.tostring(lookbackN) + ")",
         text_color=rollingWR >= 0.50 ? color.green : color.red, text_size=size.small)

    table.cell(infoT, 0, 9, "SIZE SCALE", text_color=color.gray, text_size=size.small)
    table.cell(infoT, 1, 9, str.tostring(volScale * wrScale * kzScale * 100, "#") + "%",
         text_color=volScale * wrScale < 1 ? color.orange : color.green, text_size=size.small)

    table.cell(infoT, 0, 10, "SL TYPE", text_color=color.gray, text_size=size.small)
    table.cell(infoT, 1, 10, useBandSL ? "BAND" : "ATR",
         text_color=color.white, text_size=size.small)

    table.cell(infoT, 0, 11, "KILLZONE", text_color=color.gray, text_size=size.small)
    table.cell(infoT, 1, 11, inKillzone and sessionMode != "Off" ? "LON/NY" : "OFF",
         text_color=inKillzone and sessionMode != "Off" ? color.green : color.gray, text_size=size.small)

    table.cell(infoT, 0, 12, "CONS LOSS", text_color=color.gray, text_size=size.small)
    table.cell(infoT, 1, 12, str.tostring(consLosses) + "/" + str.tostring(maxConsLoss),
         text_color=consLosses >= maxConsLoss ? color.red : color.green, text_size=size.small)

    table.cell(infoT, 0, 13, "POSITION", text_color=color.gray, text_size=size.small)
    table.cell(infoT, 1, 13,
         strategy.position_size > 0 ? "LONG" + (tp1Hit ? " (BE)" : "") :
         strategy.position_size < 0 ? "SHORT" + (tp1Hit ? " (BE)" : "") : "FLAT",
         text_color=strategy.position_size > 0 ? #00e676 : strategy.position_size < 0 ? #ff5252 : color.gray,
         text_size=size.small)

// ═══════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════
alertcondition(justTurnedGreen and inSession, title="Channel Green", message="Gaussian Channel turned GREEN — Buy zone")
alertcondition(justTurnedRed and inSession, title="Channel Red", message="Gaussian Channel turned RED — Sell zone")
alertcondition(longEntry and ddGate, title="Long Entry", message="Gaussian Channel v3 — Long entry signal")
alertcondition(shortEntry and ddGate, title="Short Entry", message="Gaussian Channel v3 — Short entry signal")
alertcondition(sessionJustEnded, title="Session End", message="Session closed — all positions flattened")
