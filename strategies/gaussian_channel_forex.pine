// Gaussian Channel Strategy v2 — Forex Optimized
// Buy ONCE on GREEN flip, Sell ONCE on RED flip. No re-entry until next flip.
// Added: EMA trend filter, ADX strength filter, confirmation bars, better R:R
//@version=6
strategy("Gaussian Channel FX v2", overlay=true,
     initial_capital=10000, default_qty_type=strategy.percent_of_equity,
     default_qty_value=100, commission_type=strategy.commission.percent,
     commission_value=0.005, slippage=2, pyramiding=0)

strategy.risk.max_drawdown(25, strategy.percent_of_equity)

// ═══════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════

// Gaussian Channel
src       = input.source(hlc3, "Source", group="Gaussian Channel")
poles     = input.int(4, "Poles (1-4)", minval=1, maxval=4, group="Gaussian Channel")
period    = input.int(144, "Period", minval=1, group="Gaussian Channel")
mult      = input.float(1.414, "Band Multiplier", step=0.001, group="Gaussian Channel")

// Trend Filter — prevents trading against the macro trend
useEMA      = input.bool(true, "EMA Trend Filter", group="Trend Filter",
     tooltip="Long only above EMA, Short only below EMA")
emaLen      = input.int(200, "EMA Length", group="Trend Filter")
useADX      = input.bool(true, "ADX Trend Strength", group="Trend Filter",
     tooltip="Only trade when ADX shows a real trend, skip chop")
adxLen      = input.int(14, "ADX Length", group="Trend Filter")
adxMin      = input.float(20.0, "Min ADX", step=1.0, group="Trend Filter")

// Entry Quality
confirmBars = input.int(3, "Confirm Bars After Flip", minval=1, maxval=10, group="Entry",
     tooltip="Wait N bars after channel flips to confirm it's real, not a fake wiggle")
useRSI      = input.bool(true, "RSI Filter", group="Entry")
rsiLen      = input.int(14, "RSI Length", group="Entry")
rsiMax      = input.float(70, "Max RSI for Longs", group="Entry")
rsiMin      = input.float(30, "Min RSI for Shorts", group="Entry")
reqPricePos = input.bool(true, "Price Must Be On Correct Side of Filter", group="Entry",
     tooltip="For longs: close > filter. For shorts: close < filter")

// Direction
direction = input.string("Both", "Trade Direction", options=["Both", "Long Only", "Short Only"], group="Direction")

// Risk — ATR-based with better R:R
atrLen     = input.int(14, "ATR Length", group="Risk")
slATR      = input.float(1.5, "Stop Loss ATR x", step=0.25, group="Risk")
tp1ATR     = input.float(2.5, "TP1 ATR x", step=0.25, group="Risk",
     tooltip="1.67:1 R:R minimum on first target")
tp2ATR     = input.float(5.0, "TP2 ATR x", step=0.5, group="Risk",
     tooltip="3.3:1 R:R on runner — let winners ride")
q1         = input.int(50, "TP1 Qty %", group="Risk")
useTrail   = input.bool(true, "Trailing Stop", group="Risk")
trailATR   = input.float(2.0, "Trail ATR x", step=0.25, group="Risk")

// Position Sizing
basePos      = input.float(50.0, "Base Position %", minval=10, maxval=100, step=5, group="Size")
useVolScale  = input.bool(true, "Volatility Scaling", group="Size",
     tooltip="Reduce size when volatility is high")
volScaleLen  = input.int(40, "Vol Scale Lookback", group="Size")

// Drawdown
useCooldown  = input.bool(true, "Loss Cooldown", group="Drawdown")
coolBars     = input.int(15, "Cooldown Bars", group="Drawdown")
maxConsLoss  = input.int(3, "Max Consecutive Losses", group="Drawdown",
     tooltip="Pause after N consecutive losses")

// Session
useSession   = input.bool(false, "Session Filter", group="Session")
sessionStr   = input.session("0700-1700", "Trading Session (UTC)", group="Session")

// ═══════════════════════════════════════════════════════════════
// GAUSSIAN FILTER — Multi-pole IIR implementation
// ═══════════════════════════════════════════════════════════════

beta  = (1 - math.cos(2 * math.pi / period)) / (math.pow(math.sqrt(2.0), 2.0 / poles) - 1)
alpha = -beta + math.sqrt(beta * beta + 2 * beta)

var float f1 = na
f1 := alpha * src + (1 - alpha) * nz(f1[1], src)

var float f2 = na
f2 := poles >= 2 ? alpha * f1 + (1 - alpha) * nz(f2[1], f1) : f1

var float f3 = na
f3 := poles >= 3 ? alpha * f2 + (1 - alpha) * nz(f3[1], f2) : f2

var float f4 = na
f4 := poles >= 4 ? alpha * f3 + (1 - alpha) * nz(f4[1], f3) : f3

gaussFilter = f4

// ═══════════════════════════════════════════════════════════════
// BAND CALCULATION
// ═══════════════════════════════════════════════════════════════

dev = math.abs(src - gaussFilter)

var float d1 = na
d1 := alpha * dev + (1 - alpha) * nz(d1[1], dev)

var float d2 = na
d2 := poles >= 2 ? alpha * d1 + (1 - alpha) * nz(d2[1], d1) : d1

var float d3 = na
d3 := poles >= 3 ? alpha * d2 + (1 - alpha) * nz(d3[1], d2) : d2

var float d4 = na
d4 := poles >= 4 ? alpha * d3 + (1 - alpha) * nz(d4[1], d3) : d3

filteredDev = d4

upperBand = gaussFilter + mult * filteredDev
lowerBand = gaussFilter - mult * filteredDev

// ═══════════════════════════════════════════════════════════════
// CHANNEL DIRECTION — Green vs Red
// ═══════════════════════════════════════════════════════════════

isGreen = gaussFilter > gaussFilter[1]
isRed   = gaussFilter < gaussFilter[1]

justTurnedGreen = isGreen and not isGreen[1]
justTurnedRed   = isRed and not isRed[1]

// ═══════════════════════════════════════════════════════════════
// BARS SINCE FLIP — only enter once per flip, with confirmation
// ═══════════════════════════════════════════════════════════════

var int barsSinceGreen = 999
var int barsSinceRed   = 999

if justTurnedGreen
    barsSinceGreen := 0
else if isGreen
    barsSinceGreen := barsSinceGreen + 1

if justTurnedRed
    barsSinceRed := 0
else if isRed
    barsSinceRed := barsSinceRed + 1

// Entry window: only enter within N bars after the flip (confirmed)
// This means: enter ONCE after confirmation, not every single bar
greenConfirmed = barsSinceGreen == confirmBars and isGreen
redConfirmed   = barsSinceRed == confirmBars and isRed

// ═══════════════════════════════════════════════════════════════
// INDICATORS
// ═══════════════════════════════════════════════════════════════

rsiVal = ta.rsi(close, rsiLen)
atrVal = ta.atr(atrLen)
ema200 = ta.ema(close, emaLen)

// ADX
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)
adxOK = not useADX or adxVal >= adxMin

// Session
inSession = not useSession or not na(time(timeframe.period, sessionStr, "UTC"))

// ═══════════════════════════════════════════════════════════════
// ENTRY CONDITIONS — strict, one entry per flip
// ═══════════════════════════════════════════════════════════════

// Trend alignment
emaBullOK = not useEMA or close > ema200
emaBearOK = not useEMA or close < ema200

// RSI
rsiBuyOK  = not useRSI or rsiVal < rsiMax
rsiSellOK = not useRSI or rsiVal > rsiMin

// Price position relative to filter
priceLongOK  = not reqPricePos or close > gaussFilter
priceShortOK = not reqPricePos or close < gaussFilter

// Direction
canLong  = direction == "Both" or direction == "Long Only"
canShort = direction == "Both" or direction == "Short Only"

// ═══ LONG: Enter once after channel flips GREEN + all confirmations ═══
longEntry = greenConfirmed and canLong and emaBullOK and adxOK and rsiBuyOK and priceLongOK and inSession

// ═══ SHORT: Enter once after channel flips RED + all confirmations ═══
shortEntry = redConfirmed and canShort and emaBearOK and adxOK and rsiSellOK and priceShortOK and inSession

// ═══════════════════════════════════════════════════════════════
// DRAWDOWN CONTROLS
// ═══════════════════════════════════════════════════════════════

var int lastLossBar      = -999
var int prevClosedCount  = 0
var int consLosses       = 0

if strategy.closedtrades > prevClosedCount
    lastProfit = strategy.closedtrades.profit(strategy.closedtrades - 1)
    if lastProfit < 0
        lastLossBar := bar_index
        consLosses  := consLosses + 1
    else
        consLosses := 0
    prevClosedCount := strategy.closedtrades

cooldownOK  = not useCooldown or (bar_index - lastLossBar) > coolBars
consLossOK  = consLosses < maxConsLoss

// Volatility scaling — reduce size in high vol
atrMA    = ta.sma(atrVal, volScaleLen)
volRatio = nz(atrVal / atrMA, 1.0)
volScale = useVolScale ? (volRatio > 1.5 ? 0.5 : volRatio > 1.2 ? 0.75 : 1.0) : 1.0

ddGate = cooldownOK and consLossOK

posSize = strategy.equity * (basePos / 100.0) * volScale / close

// ═══════════════════════════════════════════════════════════════
// EXECUTE TRADES
// ═══════════════════════════════════════════════════════════════

slTicks    = atrVal * slATR / syminfo.mintick
tp1Ticks   = atrVal * tp1ATR / syminfo.mintick
tp2Ticks   = atrVal * tp2ATR / syminfo.mintick
trailTicks = atrVal * trailATR / syminfo.mintick
trailOff   = atrVal * trailATR * 0.4 / syminfo.mintick

// ═══ LONG ENTRY ═══
if longEntry and ddGate and strategy.position_size <= 0
    if strategy.position_size < 0
        strategy.close("Short", comment="Flip to Long")
    strategy.entry("Long", strategy.long, qty=posSize)
    strategy.exit("L-TP1", "Long", qty_percent=q1, profit=tp1Ticks, loss=slTicks)
    if useTrail
        strategy.exit("L-Trail", "Long", profit=tp2Ticks, loss=slTicks,
             trail_points=trailTicks, trail_offset=trailOff)
    else
        strategy.exit("L-TP2", "Long", profit=tp2Ticks, loss=slTicks)

// ═══ SHORT ENTRY ═══
if shortEntry and ddGate and strategy.position_size >= 0
    if strategy.position_size > 0
        strategy.close("Long", comment="Flip to Short")
    strategy.entry("Short", strategy.short, qty=posSize)
    strategy.exit("S-TP1", "Short", qty_percent=q1, profit=tp1Ticks, loss=slTicks)
    if useTrail
        strategy.exit("S-Trail", "Short", profit=tp2Ticks, loss=slTicks,
             trail_points=trailTicks, trail_offset=trailOff)
    else
        strategy.exit("S-TP2", "Short", profit=tp2Ticks, loss=slTicks)

// ═══════════════════════════════════════════════════════════════
// BAND-COLOR EXITS — close when band flips
// ═══════════════════════════════════════════════════════════════

if strategy.position_size > 0 and justTurnedRed
    strategy.close("Long", comment="Channel Red")

if strategy.position_size < 0 and justTurnedGreen
    strategy.close("Short", comment="Channel Green")

// ═══════════════════════════════════════════════════════════════
// PLOTS
// ═══════════════════════════════════════════════════════════════

filterColor = isGreen ? color.new(#00e676, 0) : isRed ? color.new(#ff5252, 0) : color.new(#9e9e9e, 0)
plot(gaussFilter, "Gaussian Filter", filterColor, linewidth=2)

p_upper  = plot(upperBand, "Upper Band", color.new(#ffffff, 70), linewidth=1)
p_lower  = plot(lowerBand, "Lower Band", color.new(#ffffff, 70), linewidth=1)
p_filter = plot(gaussFilter, "Filter Fill", color.new(color.black, 100), display=display.none)

fill(p_upper, p_filter, color=isGreen ? color.new(#00e676, 85) : color.new(#ff5252, 85), title="Upper Fill")
fill(p_filter, p_lower, color=isGreen ? color.new(#00e676, 85) : color.new(#ff5252, 85), title="Lower Fill")

plot(useEMA ? ema200 : na, "EMA 200", color.new(#ffeb3b, 30), linewidth=2)

// Entry signals
plotshape(longEntry and ddGate and strategy.position_size <= 0, "Buy",
     shape.triangleup, location.belowbar, color.new(#00e676, 0), size=size.small, text="BUY")
plotshape(shortEntry and ddGate and strategy.position_size >= 0, "Sell",
     shape.triangledown, location.abovebar, color.new(#ff5252, 0), size=size.small, text="SELL")

plotshape(justTurnedGreen, "Green Flip", shape.circle, location.belowbar,
     color.new(#00e676, 30), size=size.tiny)
plotshape(justTurnedRed, "Red Flip", shape.circle, location.abovebar,
     color.new(#ff5252, 30), size=size.tiny)

bgcolor(isGreen ? color.new(#00e676, 96) : isRed ? color.new(#ff5252, 96) : na, title="Channel Direction")
bgcolor(not ddGate ? color.new(#ff9800, 88) : na, title="DD Paused")

// ═══════════════════════════════════════════════════════════════
// INFO TABLE
// ═══════════════════════════════════════════════════════════════

var table infoT = table.new(position.top_right, 2, 10, bgcolor=color.new(color.black, 80), border_width=1)
if barstate.islast
    table.cell(infoT, 0, 0, "STRATEGY", text_color=color.yellow, text_size=size.small)
    table.cell(infoT, 1, 0, "GAUSS CH FX v2", text_color=color.yellow, text_size=size.small)

    table.cell(infoT, 0, 1, "CHANNEL", text_color=color.gray, text_size=size.small)
    table.cell(infoT, 1, 1, isGreen ? "GREEN" : isRed ? "RED" : "FLAT",
         text_color=isGreen ? color.green : isRed ? color.red : color.gray, text_size=size.small)

    table.cell(infoT, 0, 2, "EMA 200", text_color=color.gray, text_size=size.small)
    table.cell(infoT, 1, 2, close > ema200 ? "ABOVE" : "BELOW",
         text_color=close > ema200 ? color.green : color.red, text_size=size.small)

    table.cell(infoT, 0, 3, "ADX", text_color=color.gray, text_size=size.small)
    table.cell(infoT, 1, 3, str.tostring(adxVal, "#.0") + (adxVal >= adxMin ? " OK" : " WEAK"),
         text_color=adxVal >= adxMin ? color.green : color.red, text_size=size.small)

    table.cell(infoT, 0, 4, "RSI", text_color=color.gray, text_size=size.small)
    table.cell(infoT, 1, 4, str.tostring(rsiVal, "#.0"), text_color=color.white, text_size=size.small)

    table.cell(infoT, 0, 5, "VOL SCALE", text_color=color.gray, text_size=size.small)
    table.cell(infoT, 1, 5, str.tostring(volScale * 100, "#") + "%",
         text_color=volScale < 1 ? color.orange : color.green, text_size=size.small)

    table.cell(infoT, 0, 6, "CONS LOSSES", text_color=color.gray, text_size=size.small)
    table.cell(infoT, 1, 6, str.tostring(consLosses) + "/" + str.tostring(maxConsLoss),
         text_color=consLosses >= maxConsLoss ? color.red : color.green, text_size=size.small)

    table.cell(infoT, 0, 7, "DIRECTION", text_color=color.gray, text_size=size.small)
    table.cell(infoT, 1, 7, direction, text_color=color.white, text_size=size.small)

    table.cell(infoT, 0, 8, "FILTER", text_color=color.gray, text_size=size.small)
    table.cell(infoT, 1, 8, str.tostring(gaussFilter, format.mintick), text_color=color.white, text_size=size.small)

    table.cell(infoT, 0, 9, "POSITION", text_color=color.gray, text_size=size.small)
    table.cell(infoT, 1, 9,
         strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT",
         text_color=strategy.position_size > 0 ? #00e676 : strategy.position_size < 0 ? #ff5252 : color.gray,
         text_size=size.small)

// ═══════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════
alertcondition(justTurnedGreen, title="Channel Green", message="Gaussian Channel turned GREEN — Buy zone")
alertcondition(justTurnedRed, title="Channel Red", message="Gaussian Channel turned RED — Sell zone")
alertcondition(longEntry and ddGate, title="Long Entry", message="Gaussian Channel — Long entry signal")
alertcondition(shortEntry and ddGate, title="Short Entry", message="Gaussian Channel — Short entry signal")
