// XRP Trend EMA Color Flip Strategy
// BUY when Trend EMA turns BLUE (rising), SELL when it turns RED (falling)
// Designed for CRYPTOCAP:XRP on 1H timeframe
//@version=6
strategy("XRP Trend Flip", shorttitle="XRP_TrendFlip",
     overlay=true, initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.1,
     slippage=3, pyramiding=0)

// ═══════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════
trendLen = input.int(100, "Trend EMA Length", minval=20, group="Settings",
     tooltip="The big line — blue = buy, red = sell")
fastLen  = input.int(10,  "Fast EMA Length",  minval=3,  group="Settings")
slowLen  = input.int(30,  "Slow EMA Length",  minval=10, group="Settings")

// Risk Management
atrLen   = input.int(14,   "ATR Length", group="Risk Management")
slMult   = input.float(2.0, "Stop Loss ATR x", step=0.25, group="Risk Management")
tpMult   = input.float(4.0, "Take Profit ATR x", step=0.25, group="Risk Management")
useTrail = input.bool(true, "Use Trailing Stop", group="Risk Management")
trailMult = input.float(1.5, "Trail ATR x", step=0.25, group="Risk Management")

// ═══════════════════════════════════════════════════════════════
// CALCULATIONS
// ═══════════════════════════════════════════════════════════════
maFast  = ta.ema(close, fastLen)
maSlow  = ta.ema(close, slowLen)
maTrend = ta.ema(close, trendLen)
atr     = ta.atr(atrLen)

// Trend EMA direction — this IS the signal
trendRising  = ta.change(maTrend) > 0   // line is BLUE
trendFalling = ta.change(maTrend) <= 0  // line is RED

// Color flip detection — the exact bar the line changes color
turnedBlue = trendRising and not trendRising[1]   // was red, now blue → BUY
turnedRed  = trendFalling and not trendFalling[1]  // was blue, now red → SELL

// ═══════════════════════════════════════════════════════════════
// STRATEGY — dead simple
// ═══════════════════════════════════════════════════════════════

// BUY when line turns blue
if turnedBlue
    if strategy.position_size < 0
        strategy.close("Short", comment="Flip Long")
    strategy.entry("Long", strategy.long)
    strategy.exit("L Exit", "Long",
         stop=close - atr * slMult,
         limit=close + atr * tpMult,
         trail_points=useTrail ? atr * trailMult / syminfo.mintick : na,
         trail_offset=useTrail ? atr * trailMult * 0.4 / syminfo.mintick : na)

// SELL when line turns red
if turnedRed
    if strategy.position_size > 0
        strategy.close("Long", comment="Flip Short")
    strategy.entry("Short", strategy.short)
    strategy.exit("S Exit", "Short",
         stop=close + atr * slMult,
         limit=close - atr * tpMult,
         trail_points=useTrail ? atr * trailMult / syminfo.mintick : na,
         trail_offset=useTrail ? atr * trailMult * 0.4 / syminfo.mintick : na)

// ═══════════════════════════════════════════════════════════════
// PLOTS
// ═══════════════════════════════════════════════════════════════
fastColor  = ta.change(maFast) > 0  ? color.new(#00e676, 0) : color.new(#ff5252, 0)
slowColor  = ta.change(maSlow) > 0  ? color.new(#ffeb3b, 0) : color.new(#ff9800, 0)
trendColor = trendRising ? color.new(#2196f3, 0) : color.new(#e91e63, 0)

plot(maFast,  "Fast EMA (10)",   fastColor,  2)
plot(maSlow,  "Slow EMA (30)",   slowColor,  2)
plot(maTrend, "Trend EMA (100)", trendColor, 3)

// Bar coloring — green when holding long, red when short
barcolor(strategy.position_size > 0 ? color.new(#00e676, 0) :
     strategy.position_size < 0 ? color.new(#ff5252, 0) :
     color.new(#2196f3, 0))

// Background — blue zone = long, red zone = short
bgcolor(trendRising ? color.new(#2196f3, 95) : color.new(#e91e63, 95), title="Trend BG")

// Entry signals
plotshape(turnedBlue, "BUY",  shape.triangleup,   location.belowbar,
     color.new(#2196f3, 0), size=size.normal, text="BUY")
plotshape(turnedRed,  "SELL", shape.triangledown,  location.abovebar,
     color.new(#e91e63, 0), size=size.normal, text="SELL")

// ═══════════════════════════════════════════════════════════════
// INFO TABLE
// ═══════════════════════════════════════════════════════════════
var table infoTable = table.new(position.top_right, 2, 3,
     bgcolor=color.new(color.black, 80), border_width=1)

if barstate.islast
    table.cell(infoTable, 0, 0, "TREND EMA", text_color=color.yellow, text_size=size.small)
    table.cell(infoTable, 1, 0,
         trendRising ? "BLUE — LONG" : "RED — SHORT",
         text_color=trendRising ? #2196f3 : #e91e63, text_size=size.small)

    table.cell(infoTable, 0, 1, "POSITION", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 1,
         strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT",
         text_color=strategy.position_size > 0 ? #00e676 : strategy.position_size < 0 ? #ff5252 : color.gray,
         text_size=size.small)

    table.cell(infoTable, 0, 2, "SIGNAL", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 2, "Trend EMA Color Flip", text_color=color.white, text_size=size.small)

// ═══════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════
alertcondition(turnedBlue, title="XRP Buy — Blue", message="Trend EMA turned BLUE — Go Long")
alertcondition(turnedRed,  title="XRP Sell — Red",  message="Trend EMA turned RED — Go Short")
