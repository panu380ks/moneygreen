//@version=6
strategy("XRP/USD CHoCH Bear Short v3", overlay=true,
     initial_capital=10000, default_qty_type=strategy.percent_of_equity,
     default_qty_value=100, commission_type=strategy.commission.percent,
     commission_value=0.1, slippage=3, pyramiding=0)

strategy.risk.max_drawdown(25, strategy.percent_of_equity)
strategy.risk.allow_entry_in(strategy.direction.short)

// ═══════════════════════════════════════════════════════════════
// CORE CONCEPT v3 — SCORING SYSTEM:
// v2 had 10+ AND filters → almost never fired.
// v3 uses a SCORING SYSTEM: each filter adds points.
// Entry requires minimum score, not ALL filters green.
// This dramatically increases trade frequency while keeping quality.
//
// Structure entry logic (OB retest / FVG fill) is unchanged.
// The momentum/trend filters now ADD SCORE instead of blocking.
// ═══════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════

// Structure Detection
swingLen      = input.int(5, "Swing Length", minval=2, maxval=20, group="Structure")
maxOBAge      = input.int(40, "Max Order Block Age (bars)", minval=5, maxval=100, group="Structure",
     tooltip="v2 was 30 — extended to catch more retests")
maxFVGAge     = input.int(25, "Max FVG Age (bars)", minval=3, maxval=60, group="Structure")
obLookback    = input.int(20, "OB Lookback Bars", minval=5, maxval=40, group="Structure",
     tooltip="v2 was 15 — extended to find more OBs")

// Entry Mode
entryMode     = input.string("Both", "Entry Mode", options=["OB Retest", "FVG Fill", "Both", "Aggressive CHoCH"], group="Entry",
     tooltip="'Both' gives 2x the opportunities of v2's default 'OB Retest'")
reqRejCandle  = input.bool(true, "Require Rejection Candle at Zone", group="Entry")
reqBOS        = input.bool(true, "Allow BOS Continuation Entries", group="Entry")
minRR         = input.float(1.2, "Minimum Risk:Reward", step=0.1, minval=0.5, maxval=5.0, group="Entry",
     tooltip="v2 was 1.5 — lowered slightly since scoring system adds quality control")

// Scoring System
minScore      = input.int(5, "Minimum Entry Score", minval=2, maxval=12, group="Scoring",
     tooltip="Total score needed to enter. Max possible ~14. Lower = more trades, higher = pickier")
aGradeScore   = input.int(10, "A+ Grade Threshold", group="Scoring")
bGradeScore   = input.int(7, "A Grade Threshold", group="Scoring")

// Trend Filters (now add score instead of blocking)
emaFastLen    = input.int(21, "Fast EMA", group="Trend Filters")
emaSlowLen    = input.int(50, "Slow EMA", group="Trend Filters")
use200EMA     = input.bool(true, "200 EMA Trend Gate (HARD)", group="Trend Filters",
     tooltip="This one stays as hard gate — never short above 200 EMA")
useHTF        = input.bool(true, "HTF Trend Filter", group="Trend Filters")
htfTF         = input.timeframe("D", "HTF Timeframe", group="Trend Filters")
useMidTF      = input.bool(true, "Mid TF Trend Filter", group="Trend Filters")
midTF         = input.timeframe("240", "Mid Timeframe", group="Trend Filters")

// Momentum Filters (add score)
rsiLen        = input.int(14, "RSI Length", group="Momentum")
rsiOBLevel    = input.float(60.0, "RSI OB Threshold", step=1.0, group="Momentum")
rsiOBLookback = input.int(20, "RSI OB Lookback", minval=2, maxval=40, group="Momentum",
     tooltip="v2 was 15 — extended window")
adxLen        = input.int(14, "ADX Length", group="Momentum")
adxMin        = input.float(18.0, "Min ADX", step=1.0, group="Momentum")
useMacd       = input.bool(true, "MACD Bear Filter", group="Momentum")
macdFast      = input.int(12, "MACD Fast", group="Momentum")
macdSlow      = input.int(26, "MACD Slow", group="Momentum")
macdSig       = input.int(9, "MACD Signal", group="Momentum")

// Risk Management
atrLen        = input.int(14, "ATR Length", group="Risk")
slBuffer      = input.float(0.3, "SL Buffer (ATR mult above OB)", step=0.1, group="Risk")
tp1Mult       = input.float(2.0, "TP1 R:R Multiple", step=0.5, group="Risk")
tp2Mult       = input.float(4.0, "TP2 R:R Multiple", step=0.5, group="Risk")
tp3Mult       = input.float(7.0, "TP3 R:R Multiple", step=0.5, group="Risk")
q1            = input.int(40, "TP1 Qty %", group="Risk", tooltip="v2 was 35 — take more off early to lock profit")
q2            = input.int(30, "TP2 Qty %", group="Risk")
q3            = input.int(15, "TP3 Qty %", group="Risk")
useTrail      = input.bool(true, "Trail Remainder", group="Risk")
trailATR      = input.float(2.0, "Trail ATR Mult", step=0.1, group="Risk")

// Drawdown Controls
basePos       = input.float(75.0, "Base Position %", minval=10, maxval=100, step=5, group="Drawdown")
useVolRegime  = input.bool(true, "Volatility Regime Filter", group="Drawdown")
volFilterLen  = input.int(40, "Vol Filter MA Length", group="Drawdown")
maxVolRatio   = input.float(2.0, "Max Vol Ratio", step=0.1, group="Drawdown")
useEqFilter   = input.bool(true, "Equity Curve Filter", group="Drawdown")
eqFilterLen   = input.int(50, "Equity SMA Length", group="Drawdown")
useCooldown   = input.bool(true, "Loss Cooldown", group="Drawdown")
coolBars      = input.int(8, "Cooldown Bars After Loss", group="Drawdown",
     tooltip="v2 was 10 — reduced to get back in faster")

// Supertrend Filter — only SHORT when Supertrend is RED
useSupertrend = input.bool(true, "Supertrend Filter", group="Supertrend",
     tooltip="Only SHORT when Supertrend is RED (downtrend)")
stATRLen      = input.int(10,    "Supertrend ATR Length", minval=1, group="Supertrend")
stFactor      = input.float(3.0, "Supertrend Factor", minval=0.01, step=0.01, group="Supertrend")

// Session
useSession    = input.bool(false, "Session Filter", group="Session")
sessionStr    = input.session("0800-2000", "Session (UTC)", group="Session")

// ═══════════════════════════════════════════════════════════════
// SESSION
// ═══════════════════════════════════════════════════════════════

inSession = not useSession or not na(time(timeframe.period, sessionStr, "UTC"))

// ═══════════════════════════════════════════════════════════════
// CORE INDICATORS
// ═══════════════════════════════════════════════════════════════

emaFast   = ta.ema(close, emaFastLen)
emaSlow   = ta.ema(close, emaSlowLen)
ema200    = ta.ema(close, 200)
rsiVal    = ta.rsi(close, rsiLen)
atrVal    = ta.atr(atrLen)

// Supertrend
[supertrend, stDirection] = ta.supertrend(stFactor, stATRLen)
stRed   = stDirection > 0   // downtrend = red = allow shorts
stOK    = not useSupertrend or stRed

// ═══════════════════════════════════════════════════════════════
// SWING STRUCTURE DETECTION
// ═══════════════════════════════════════════════════════════════

swH = ta.pivothigh(high, swingLen, swingLen)
swL = ta.pivotlow(low, swingLen, swingLen)

var float lastSH  = na
var float lastSL  = na
var float prevSH  = na
var float prevSL  = na
var int   lastSHBar = 0
var int   lastSLBar = 0

if not na(swH)
    prevSH   := lastSH
    lastSH   := swH
    lastSHBar := bar_index - swingLen
if not na(swL)
    prevSL   := lastSL
    lastSL   := swL
    lastSLBar := bar_index - swingLen

// ═══════════════════════════════════════════════════════════════
// MARKET STRUCTURE — CHoCH & BOS
// ═══════════════════════════════════════════════════════════════

breakBelow = not na(lastSL) and close < lastSL and close[1] >= lastSL
breakAbove = not na(lastSH) and close > lastSH and close[1] <= lastSH

var int msTrend = 0
if breakAbove
    msTrend := 1
if breakBelow
    msTrend := -1

chochBear = breakBelow and msTrend[1] >= 0
bosShort  = breakBelow and msTrend[1] == -1
chochBull = breakAbove and msTrend[1] <= 0

// ═══════════════════════════════════════════════════════════════
// ORDER BLOCK DETECTION — extended lookback
// ═══════════════════════════════════════════════════════════════

var float obHigh     = na
var float obLow      = na
var int   obBar      = 0
var bool  obActive   = false
var bool  obTested   = false
var float obEntryLvl = na

findOB() =>
    float _obH = na
    float _obL = na
    int   _obB = 0
    for i = 1 to obLookback
        if close[i] > open[i]
            _obH := high[i]
            _obL := low[i]
            _obB := bar_index - i
            break
    [_obH, _obL, _obB]

if chochBear or (bosShort and reqBOS)
    [_h, _l, _b] = findOB()
    if not na(_h)
        obHigh   := _h
        obLow    := _l
        obBar    := _b
        obActive := true
        obTested := false
        obEntryLvl := (_h + _l) / 2.0

if obActive and (bar_index - obBar) > maxOBAge
    obActive := false

if obActive and close > obHigh and close[1] > obHigh
    obActive := false

// ═══════════════════════════════════════════════════════════════
// FAIR VALUE GAP DETECTION — BEARISH
// ═══════════════════════════════════════════════════════════════

var float fvgTop    = na
var float fvgBot    = na
var int   fvgBar    = 0
var bool  fvgActive = false

bearFVG = low[2] > high[0] and (msTrend == -1 or msTrend[1] == -1)
if bearFVG
    fvgTop    := low[2]
    fvgBot    := high[0]
    fvgBar    := bar_index - 1
    fvgActive := true

if fvgActive and (bar_index - fvgBar) > maxFVGAge
    fvgActive := false

fvgFilled = fvgActive and high >= fvgBot and close < fvgTop

// ═══════════════════════════════════════════════════════════════
// REJECTION CANDLE PATTERNS
// ═══════════════════════════════════════════════════════════════

bodySize    = math.abs(close - open)
upperWick   = high - math.max(close, open)
lowerWick   = math.min(close, open) - low
candleRange = high - low

bearEngulf      = close < open and close[1] > open[1] and close < open[1] and open > close[1] and bodySize > bodySize[1]
bearPin         = upperWick > bodySize * 2.0 and upperWick > lowerWick * 2.0 and close < open
strongBearClose = close < open and bodySize > candleRange * 0.6 and (close - low) < candleRange * 0.15
rejectionCandle = bearEngulf or bearPin or strongBearClose
rejectionOK = not reqRejCandle or rejectionCandle

// ═══════════════════════════════════════════════════════════════
// ZONE ENTRY DETECTION
// ═══════════════════════════════════════════════════════════════

priceInOB = obActive and not obTested and high >= obLow and close < obHigh
obRetestEntry = priceInOB and rejectionOK and msTrend == -1

if priceInOB
    obTested := true

fvgFillEntry = fvgFilled and rejectionOK and msTrend == -1
if fvgFilled
    fvgActive := false

aggressiveEntry = (chochBear or (bosShort and reqBOS)) and rejectionOK

structureEntry = switch entryMode
    "OB Retest"       => obRetestEntry
    "FVG Fill"        => fvgFillEntry
    "Both"            => obRetestEntry or fvgFillEntry
    "Aggressive CHoCH" => aggressiveEntry
    => obRetestEntry or fvgFillEntry

// ═══════════════════════════════════════════════════════════════
// SCORING SYSTEM — replaces v2's all-or-nothing AND chain
// Each filter adds points. Entry needs minimum score.
// ═══════════════════════════════════════════════════════════════

// ADX
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)

// MACD
[macdLine, signalLine, histLine] = ta.macd(close, macdFast, macdSlow, macdSig)

// RSI was overbought recently
rsiWasOB = ta.highest(rsiVal, rsiOBLookback) > rsiOBLevel

// EMA bearish alignment
emaBear = emaFast < emaSlow or (emaFast < emaFast[1] and close < emaFast)

// HTF filter
htfEma50  = request.security(syminfo.tickerid, htfTF, ta.ema(close, 50))
htfBear   = not useHTF or na(htfEma50) or close < htfEma50

// Mid TF filter
midEmaF   = request.security(syminfo.tickerid, midTF, ta.ema(close, 21))
midEmaS   = request.security(syminfo.tickerid, midTF, ta.ema(close, 50))
midBear   = not useMidTF or na(midEmaF) or midEmaF < midEmaS

// Lower high structure
lowerHigh = not na(lastSH) and not na(prevSH) and lastSH < prevSH

// Score calculation — each true condition adds points
score = 0
score += adxVal >= adxMin ? 2 : 0                                           // Trending market
score += diMinus > diPlus ? 2 : 0                                           // Bearish DI
score += (not useMacd or histLine < 0) ? 2 : (histLine < histLine[1] ? 1 : 0)  // MACD bearish
score += rsiWasOB ? 1 : 0                                                   // RSI exhaustion
score += emaBear ? 2 : 0                                                    // EMA alignment
score += htfBear ? 2 : 0                                                    // HTF bearish
score += midBear ? 1 : 0                                                    // Mid TF bearish
score += lowerHigh ? 1 : 0                                                  // Structure LH
score += rejectionCandle ? 1 : 0                                            // Candle quality bonus

// Grade
grade = score >= aGradeScore ? "A+" : score >= bGradeScore ? "A" : score >= minScore ? "B" : "C"
scoreOK = score >= minScore

// ═══════════════════════════════════════════════════════════════
// HARD GATES — these still block entry entirely
// ═══════════════════════════════════════════════════════════════

// 200 EMA: never short above it
trendGate = not use200EMA or close < ema200

// R:R check
slLevel = obActive ? obHigh + atrVal * slBuffer : (not na(lastSH) ? lastSH + atrVal * slBuffer : close + atrVal * 2.0)
slDist  = math.abs(slLevel - close)
tpTarget = not na(lastSL) ? lastSL : close - atrVal * 3.0
tpDist   = math.abs(close - tpTarget)
rrRatio = slDist > 0 ? tpDist / slDist : 0.0
rrOK    = rrRatio >= minRR

// ═══════════════════════════════════════════════════════════════
// DRAWDOWN CONTROLS
// ═══════════════════════════════════════════════════════════════

atrMA      = ta.sma(atrVal, volFilterLen)
volRatio   = atrVal / nz(atrMA, atrVal)
volOK      = not useVolRegime or volRatio < maxVolRatio

eqSMA      = ta.sma(strategy.equity, eqFilterLen)
equityOK   = not useEqFilter or strategy.equity >= eqSMA

var int lastLossBar     = -999
var int prevClosedCount = 0
if strategy.closedtrades > prevClosedCount
    if strategy.closedtrades.profit(strategy.closedtrades - 1) < 0
        lastLossBar := bar_index
    prevClosedCount := strategy.closedtrades
cooldownOK = not useCooldown or (bar_index - lastLossBar) > coolBars

// Dynamic sizing — scale down in high vol, scale up for A+ grades
volScale   = useVolRegime ? (volRatio > 1.5 ? 0.5 : volRatio > 1.2 ? 0.75 : 1.0) : 1.0
gradeScale = grade == "A+" ? 1.0 : grade == "A" ? 0.8 : 0.6
unitQty    = strategy.equity * (basePos / 100.0) * volScale * gradeScale / close

ddGate = volOK and equityOK and cooldownOK

// ═══════════════════════════════════════════════════════════════
// COMBINED ENTRY SIGNAL — scoring replaces AND chain
// ═══════════════════════════════════════════════════════════════

shortSignal = structureEntry and scoreOK and trendGate and stOK and rrOK and inSession and rsiVal < 75 and rsiVal > 15

// ═══════════════════════════════════════════════════════════════
// EXECUTE ENTRIES
// ═══════════════════════════════════════════════════════════════

if shortSignal and ddGate and strategy.position_size == 0
    strategy.entry("Short", strategy.short, qty=unitQty)

// ═══════════════════════════════════════════════════════════════
// EXITS — R:R based TPs with trailing
// ═══════════════════════════════════════════════════════════════

slTicks    = slDist / syminfo.mintick
tp1Ticks   = slDist * tp1Mult / syminfo.mintick
tp2Ticks   = slDist * tp2Mult / syminfo.mintick
tp3Ticks   = slDist * tp3Mult / syminfo.mintick
trailTicks = atrVal * trailATR / syminfo.mintick
trailOff   = atrVal * trailATR * 0.5 / syminfo.mintick

strategy.exit("x1", qty_percent=q1, profit=tp1Ticks, loss=slTicks)
strategy.exit("x2", qty_percent=q2, profit=tp2Ticks, loss=slTicks)
strategy.exit("x3", qty_percent=q3, profit=tp3Ticks, loss=slTicks)

if useTrail
    strategy.exit("xTrail", profit=tp3Ticks * 1.5, loss=slTicks, trail_points=trailTicks, trail_offset=trailOff)
else
    strategy.exit("x4", profit=tp3Ticks * 1.5, loss=slTicks)

// Emergency exit: bullish CHoCH + price reclaims 200 EMA
if strategy.position_size < 0 and chochBull and close > ema200
    strategy.close("Short", comment="Bull Reversal")

// ═══════════════════════════════════════════════════════════════
// PLOTS
// ═══════════════════════════════════════════════════════════════

// Supertrend plot
stPlotVal = barstate.isfirst ? na : supertrend
plot(useSupertrend and not stRed ? stPlotVal : na, "ST Up",   color=color.new(color.green, 0), style=plot.style_linebr, linewidth=2)
plot(useSupertrend and stRed     ? stPlotVal : na, "ST Down", color=color.new(color.red, 0),   style=plot.style_linebr, linewidth=2)

plot(lastSH, "Swing High", color.new(#ff5252, 30), style=plot.style_stepline_diamond)
plot(lastSL, "Swing Low", color.new(#00e676, 30), style=plot.style_stepline_diamond)

plot(emaFast, "EMA 21", color.new(#2196f3, 50))
plot(emaSlow, "EMA 50", color.new(#ff9800, 50))
plot(use200EMA ? ema200 : na, "EMA 200", color.new(#ffffff, 30), linewidth=2)
plot(useHTF and not na(htfEma50) ? htfEma50 : na, "HTF EMA", color.new(#e040fb, 0), linewidth=2)

// Order Block zone
obColor = obActive and not obTested ? color.new(#ff5252, 75) : color.new(#ff5252, 95)
p_obH = plot(obActive ? obHigh : na, "OB High", color.new(#ff5252, 60), style=plot.style_linebr)
p_obL = plot(obActive ? obLow : na, "OB Low", color.new(#ff5252, 60), style=plot.style_linebr)
fill(p_obH, p_obL, obActive ? obColor : na, title="Order Block Zone")

// FVG zone
fvgColor = fvgActive ? color.new(#ff9800, 80) : na
p_fvgT = plot(fvgActive ? fvgTop : na, "FVG Top", color.new(#ff9800, 60), style=plot.style_linebr)
p_fvgB = plot(fvgActive ? fvgBot : na, "FVG Bot", color.new(#ff9800, 60), style=plot.style_linebr)
fill(p_fvgT, p_fvgB, fvgColor, title="FVG Zone")

// Entry signals
plotshape(chochBear, "CHoCH Bear", shape.triangledown, location.abovebar, color.new(#ff5252, 0), size=size.small, text="CHoCH")
plotshape(bosShort and not chochBear, "BOS Short", shape.circle, location.abovebar, color.new(#ff9800, 0), size=size.tiny, text="BOS")
plotshape(obRetestEntry and structureEntry, "OB Retest", shape.arrowdown, location.abovebar, color.new(#f50057, 0), size=size.small, text="OB Short")
plotshape(fvgFillEntry and structureEntry and not obRetestEntry, "FVG Fill", shape.arrowdown, location.abovebar, color.new(#ff6d00, 0), size=size.small, text="FVG Short")
plotshape(rejectionCandle and (priceInOB or fvgFilled), "Rejection", shape.diamond, location.belowbar, color.new(#ffeb3b, 0), size=size.tiny, text="Rej")

lhPlot = not na(lastSH) and not na(prevSH) and lastSH < prevSH
plotshape(lhPlot and not na(swH), "Lower High", shape.xcross, location.abovebar, color.new(#ffab00, 0), size=size.tiny, text="LH")

// Background
bgcolor(msTrend == -1 ? color.new(#ff5252, 95) : msTrend == 1 ? color.new(#00e676, 97) : na, title="Structure Trend")
bgcolor(not ddGate ? color.new(#ff9800, 88) : na, title="DD Gate Paused")
bgcolor(not inSession ? color.new(#000000, 96) : na, title="Out of Session")

// ═══════════════════════════════════════════════════════════════
// INFO TABLE — now shows score
// ═══════════════════════════════════════════════════════════════

var table t = table.new(position.top_right, 2, 16, bgcolor=color.new(color.black, 80), border_width=1)
if barstate.islast
    table.cell(t, 0, 0,  "STRATEGY",    text_color=color.yellow, text_size=size.small)
    table.cell(t, 1, 0,  "CHoCH SHORT v3", text_color=color.yellow, text_size=size.small)

    table.cell(t, 0, 1,  "Entry Mode",  text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 1,  entryMode, text_color=color.white, text_size=size.small)

    table.cell(t, 0, 2,  "SUPERTREND",  text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 2,  stRed ? "RED — SHORTS OK" : "GREEN — NO SHORTS",
         text_color=stRed ? color.green : color.red, text_size=size.small)

    table.cell(t, 0, 3,  "Structure",   text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 3,  msTrend == 1 ? "BULL" : msTrend == -1 ? "BEAR" : "NEUTRAL", text_color=msTrend == -1 ? color.green : color.red, text_size=size.small)

    table.cell(t, 0, 4,  "SCORE",       text_color=color.yellow, text_size=size.small)
    table.cell(t, 1, 4,  str.tostring(score) + "/14 — " + grade,
         text_color=score >= aGradeScore ? #00e676 : score >= bGradeScore ? #2196f3 : score >= minScore ? #ffeb3b : #ff5252, text_size=size.small)

    table.cell(t, 0, 5,  "Order Block", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 5,  obActive ? (obTested ? "TESTED" : "ACTIVE " + str.tostring(bar_index - obBar) + "b") : "NONE", text_color=obActive and not obTested ? color.green : color.gray, text_size=size.small)

    table.cell(t, 0, 6,  "FVG",         text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 6,  fvgActive ? "ACTIVE " + str.tostring(bar_index - fvgBar) + "b" : "NONE", text_color=fvgActive ? color.green : color.gray, text_size=size.small)

    table.cell(t, 0, 7,  "R:R",         text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 7,  str.tostring(rrRatio, "#.#") + ":1", text_color=rrOK ? color.green : color.red, text_size=size.small)

    table.cell(t, 0, 8,  "ADX",         text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 8,  str.tostring(adxVal, "#.0") + (adxVal >= adxMin ? " +2" : " +0"), text_color=adxVal >= adxMin ? color.green : color.red, text_size=size.small)

    table.cell(t, 0, 9,  "DI",          text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 9,  (diMinus > diPlus ? "DI- LEAD +2" : "DI+ LEAD +0"), text_color=diMinus > diPlus ? color.green : color.red, text_size=size.small)

    table.cell(t, 0, 10, "MACD",        text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 10, histLine < 0 ? "BEAR +2" : histLine < histLine[1] ? "FADING +1" : "BULL +0", text_color=histLine < 0 ? color.green : color.red, text_size=size.small)

    table.cell(t, 0, 11, "HTF",         text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 11, htfBear ? "BEAR +2" : "BULL +0", text_color=htfBear ? color.green : color.red, text_size=size.small)

    table.cell(t, 0, 12, "200 EMA",     text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 12, close < ema200 ? "BELOW (OK)" : "ABOVE (BLOCK)", text_color=close < ema200 ? color.green : color.red, text_size=size.small)

    table.cell(t, 0, 13, "Vol Ratio",   text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 13, str.tostring(volRatio, "#.##"), text_color=volOK ? color.green : color.red, text_size=size.small)

    table.cell(t, 0, 14, "Cooldown",    text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 14, cooldownOK ? "READY" : str.tostring(coolBars - (bar_index - lastLossBar)) + " bars", text_color=cooldownOK ? color.green : color.yellow, text_size=size.small)

    table.cell(t, 0, 15, "Position",    text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 15,
         strategy.position_size < 0 ? "SHORT" : "FLAT",
         text_color=strategy.position_size < 0 ? #ff5252 : color.gray, text_size=size.small)
