// Silver (XAG/USD) Short-Only Strategy — 200 EMA Rejection
// Sells only when price is below or rejecting the 200 EMA
// Timeframe: 1H (optimized), works on 15m-4H
//@version=6
strategy("Silver (XAG) Short Only — 200 EMA", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0.1, pyramiding=0, calc_on_every_tick=false)

// ──────────────────────────────────────────────
// INPUTS
// ──────────────────────────────────────────────

// EMAs
fastLen   = input.int(12,   "Fast EMA",          minval=3)
midLen    = input.int(26,   "Mid EMA",           minval=5)
slowLen   = input.int(50,   "Slow EMA",          minval=10)
trendLen  = input.int(200,  "Trend EMA (200)",   minval=50)

// RSI
rsiLen    = input.int(14,   "RSI Length",         minval=2)
rsiOB     = input.float(60, "RSI Short Trigger",  minval=45, maxval=85)

// SuperTrend
stFactor  = input.float(3.0,"SuperTrend Factor",  minval=1.0, step=0.1)
stPeriod  = input.int(12,   "SuperTrend Period",   minval=5)

// ADX
useAdx    = input.bool(true,"Use ADX Filter")
adxLen    = input.int(14,   "ADX Length",          minval=5)
adxMin    = input.float(20, "ADX Minimum",         minval=10, maxval=50)

// MACD
useMacd   = input.bool(true,"Use MACD Filter")
macdFast  = input.int(12,   "MACD Fast",           minval=5)
macdSlow  = input.int(26,   "MACD Slow",           minval=10)
macdSig   = input.int(9,    "MACD Signal",         minval=3)

// ATR & Risk
atrLen    = input.int(14,   "ATR Length",          minval=5)
slMult    = input.float(1.5,"Stop Loss ATR Mult",  minval=0.5, step=0.1)
tp1Mult   = input.float(2.5,"TP1 ATR Mult",        minval=0.5, step=0.1)
tp2Mult   = input.float(5.0,"TP2 ATR Mult",        minval=1.0, step=0.1)
tp1Pct    = input.float(50, "TP1 Close %",         minval=10, maxval=90)
useTrail  = input.bool(true,"Use Trailing Stop")
trailMult = input.float(1.5,"Trail ATR Mult",      minval=0.3, step=0.1)

// Cooldown
cooldownBars = input.int(15,"Cooldown Bars",       minval=0, maxval=100)

// Scoring threshold
minScore  = input.int(4,    "Min Entry Score",     minval=2, maxval=9)

// Hard gate toggles
requireBelow200  = input.bool(true, "Require Price Below 200 EMA", tooltip="Core filter: blocks shorts in bull trends")
requireBearStack = input.bool(true, "Require Bearish EMA Stack",   tooltip="Fast < Mid < Slow")
requireBearST    = input.bool(true, "Require Bearish SuperTrend")

// Daily trend
useDailyTrend = input.bool(true, "Use Daily Trend Filter")
dailyFastLen  = input.int(12,    "Daily Fast EMA",    minval=3)
dailySlowLen  = input.int(50,    "Daily Slow EMA",    minval=10)

// ──────────────────────────────────────────────
// CALCULATIONS
// ──────────────────────────────────────────────

fastEma  = ta.ema(close, fastLen)
midEma   = ta.ema(close, midLen)
slowEma  = ta.ema(close, slowLen)
ema200   = ta.ema(close, trendLen)

// SuperTrend
[stLine, stDir] = ta.supertrend(stFactor, stPeriod)
bearST = stDir > 0

// ADX / DMI
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)
adxOk      = useAdx ? adxVal > adxMin : true
adxBearish = useAdx ? diMinus > diPlus : true

// RSI
rsi = ta.rsi(close, rsiLen)

// MACD
[macdLine, signalLine, histLine] = ta.macd(close, macdFast, macdSlow, macdSig)
macdBear     = useMacd ? macdLine < signalLine : true
macdFading   = useMacd ? (histLine < histLine[1]) : false

// ATR
atr = ta.atr(atrLen)

// 200 EMA rejection — price wicks above 200 EMA but closes below
ema200reject = high > ema200 and close < ema200

// Bearish candle patterns
bearEngulf = close < open and close < open[1] and open > close[1] and (open - close) > (close[1] - open[1]) * 0.5
upperWick  = high - math.max(open, close)
bodySize   = math.abs(close - open)
bearPin    = upperWick > bodySize * 2 and close < open

// EMA rejection — price wicks above mid/slow EMA but closes below
emaReject = (high > midEma and close < midEma) or (high > slowEma and close < slowEma)

// Swing structure
swingLen     = 6
swingHigh    = ta.pivothigh(high, swingLen, swingLen)
swingLow     = ta.pivotlow(low, swingLen, swingLen)
recentSwHigh = ta.valuewhen(not na(swingHigh), high[swingLen], 0)
prevSwHigh   = ta.valuewhen(not na(swingHigh), high[swingLen], 1)
recentSwLow  = ta.valuewhen(not na(swingLow), low[swingLen], 0)
prevSwLow    = ta.valuewhen(not na(swingLow), low[swingLen], 1)
lowerHigh    = not na(recentSwHigh) and not na(prevSwHigh) and recentSwHigh < prevSwHigh
lowerLow     = not na(recentSwLow)  and not na(prevSwLow)  and recentSwLow < prevSwLow
bearStructure = lowerHigh and lowerLow

// Daily trend filter
dailyFastEma = request.security(syminfo.tickerid, "D", ta.ema(close, dailyFastLen))
dailySlowEma = request.security(syminfo.tickerid, "D", ta.ema(close, dailySlowLen))
dailyBear    = useDailyTrend ? dailyFastEma < dailySlowEma : true

// ──────────────────────────────────────────────
// TREND STATES
// ──────────────────────────────────────────────

strongBear  = fastEma < midEma and midEma < slowEma
modBear     = fastEma < slowEma
belowTrend  = close < ema200

// ──────────────────────────────────────────────
// HARD GATES — all must pass to allow any short
// ──────────────────────────────────────────────

gate1 = requireBelow200  ? belowTrend  : true
gate2 = requireBearStack ? strongBear  : modBear
gate3 = requireBearST    ? bearST      : true
gate4 = dailyBear
gate5 = adxBearish
allGatesPass = gate1 and gate2 and gate3 and gate4 and gate5

// ──────────────────────────────────────────────
// COOLDOWN
// ──────────────────────────────────────────────

var int lastEntryBar = 0
barsSinceEntry = bar_index - lastEntryBar
cooldownOk     = barsSinceEntry > cooldownBars

// ──────────────────────────────────────────────
// SCORING — higher score = higher conviction short
// ──────────────────────────────────────────────

score = 0
score += strongBear     ? 2 : modBear ? 1 : 0
score += bearST         ? 1 : 0
score += belowTrend     ? 1 : 0
score += adxOk          ? 1 : 0
score += rsi > rsiOB    ? 1 : 0
score += macdBear       ? 1 : 0
score += macdFading     ? 1 : 0
score += bearStructure  ? 2 : lowerHigh ? 1 : 0
score += emaReject      ? 1 : 0
score += ema200reject   ? 2 : 0
score += bearEngulf     ? 1 : 0
score += bearPin        ? 1 : 0

// ──────────────────────────────────────────────
// SHORT ENTRY
// ──────────────────────────────────────────────

shortCond = allGatesPass and score >= minScore and cooldownOk and strategy.position_size == 0

if shortCond
    lastEntryBar := bar_index
    stopLoss = close + atr * slMult
    target1  = close - atr * tp1Mult
    target2  = close - atr * tp2Mult

    strategy.entry("Short", strategy.short)
    strategy.exit("TP1", "Short", limit=target1, qty_percent=tp1Pct, stop=stopLoss)

    if useTrail
        strategy.exit("TP2", "Short", limit=target2, stop=stopLoss, trail_points=atr * trailMult / syminfo.mintick, trail_offset=atr * trailMult * 0.5 / syminfo.mintick)
    else
        strategy.exit("TP2", "Short", limit=target2, stop=stopLoss)

// ──────────────────────────────────────────────
// EMERGENCY EXIT — trend flips bullish
// ──────────────────────────────────────────────

if strategy.position_size < 0 and fastEma > midEma and fastEma > slowEma and stDir < 0
    strategy.close("Short", comment="Trend Flip")

// ──────────────────────────────────────────────
// PLOTS
// ──────────────────────────────────────────────

plot(fastEma, "Fast EMA",  color=color.new(color.teal, 0),   linewidth=1)
plot(midEma,  "Mid EMA",   color=color.new(color.yellow, 0), linewidth=2)
plot(slowEma, "Slow EMA",  color=color.new(color.orange, 0), linewidth=2)
plot(ema200,  "200 EMA",   color=color.new(color.white, 20), linewidth=3)
plot(stLine,  "SuperTrend", color=bearST ? color.new(color.red, 20) : color.new(color.green, 20), linewidth=2, style=plot.style_stepline)

// Background when all gates are open
bgcolor(allGatesPass ? color.new(color.red, 90) : na, title="Gates Open")

// Entry signals by quality
plotshape(shortCond and score >= 8, "A+ Short", shape.triangledown, location.abovebar, color.new(color.red, 0),  size=size.normal)
plotshape(shortCond and score >= 6 and score < 8, "A Short", shape.triangledown, location.abovebar, color.new(color.red, 15), size=size.small)
plotshape(shortCond and score < 6,  "B Short",  shape.triangledown, location.abovebar, color.new(color.red, 40), size=size.small)

// Score label on entry
if shortCond
    label.new(bar_index, high + atr * 0.5, str.tostring(score), style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)

// ──────────────────────────────────────────────
// INFO TABLE
// ──────────────────────────────────────────────

var table t = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 80), border_width=1)
if barstate.islast
    table.cell(t, 0, 0, "GATES",      text_color=color.yellow, text_size=size.small)
    table.cell(t, 1, 0, allGatesPass ? "ALL OPEN" : "BLOCKED", text_color=allGatesPass ? color.red : color.gray, text_size=size.small)
    table.cell(t, 0, 1, "Score",      text_color=color.gray,  text_size=size.small)
    table.cell(t, 1, 1, str.tostring(score) + " / " + str.tostring(minScore), text_color=score >= minScore ? color.red : color.white, text_size=size.small)
    table.cell(t, 0, 2, "< 200 EMA",  text_color=color.gray,  text_size=size.small)
    table.cell(t, 1, 2, belowTrend ? "YES" : "NO", text_color=belowTrend ? color.red : color.green, text_size=size.small)
    table.cell(t, 0, 3, "EMA Stack",  text_color=color.gray,  text_size=size.small)
    table.cell(t, 1, 3, strongBear ? "BEARISH" : "NO", text_color=strongBear ? color.red : color.green, text_size=size.small)
    table.cell(t, 0, 4, "SuperTrend", text_color=color.gray,  text_size=size.small)
    table.cell(t, 1, 4, bearST ? "BEAR" : "BULL", text_color=bearST ? color.red : color.green, text_size=size.small)
    table.cell(t, 0, 5, "Daily Trend",text_color=color.gray,  text_size=size.small)
    table.cell(t, 1, 5, dailyBear ? "BEAR" : "BULL", text_color=dailyBear ? color.red : color.green, text_size=size.small)
    table.cell(t, 0, 6, "ADX",        text_color=color.gray,  text_size=size.small)
    table.cell(t, 1, 6, str.tostring(adxVal, "#.0") + (adxBearish ? " DI-" : " DI+"), text_color=adxBearish and adxOk ? color.red : color.white, text_size=size.small)
    table.cell(t, 0, 7, "Cooldown",   text_color=color.gray,  text_size=size.small)
    table.cell(t, 1, 7, cooldownOk ? "READY" : str.tostring(cooldownBars - barsSinceEntry) + " bars", text_color=cooldownOk ? color.green : color.yellow, text_size=size.small)
