//@version=6
strategy("Bollinger Bands Strategy — London Session", overlay=true,
     initial_capital=10000, default_qty_type=strategy.percent_of_equity,
     default_qty_value=100, commission_type=strategy.commission.percent,
     commission_value=0.005, slippage=2, pyramiding=0)

// ═══════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════

source    = close
length    = input.int(20, "BB Length", minval=1, group="Bollinger Bands")
mult      = input.float(2.0, "BB Multiplier", minval=0.001, maxval=50, group="Bollinger Bands")
direction = input.int(0, "Strategy Direction (-1=Short, 0=Both, 1=Long)", minval=-1, maxval=1, group="Direction")

// Session
useSession    = input.bool(true, "London Session Filter", group="Session",
     tooltip="Only enter trades during London session hours")
sessionStr    = input.session("0800-1600", "London Session (UTC)", group="Session")
closeAtEnd    = input.bool(true, "Close Positions at Session End", group="Session",
     tooltip="Auto-close all open positions when London session ends")
sessionTZ     = input.string("UTC", "Session Timezone", options=["UTC", "Europe/London", "America/New_York"], group="Session")

// ═══════════════════════════════════════════════════════════════
// DIRECTION FILTER
// ═══════════════════════════════════════════════════════════════

strategy.risk.allow_entry_in(direction == 0 ? strategy.direction.all : (direction < 0 ? strategy.direction.short : strategy.direction.long))

// ═══════════════════════════════════════════════════════════════
// BOLLINGER BANDS
// ═══════════════════════════════════════════════════════════════

basis = ta.sma(source, length)
dev   = mult * ta.stdev(source, length)
upper = basis + dev
lower = basis - dev

// ═══════════════════════════════════════════════════════════════
// SESSION LOGIC
// ═══════════════════════════════════════════════════════════════

inSession        = not useSession or not na(time(timeframe.period, sessionStr, sessionTZ))
wasInSession     = not na(time(timeframe.period, sessionStr, sessionTZ)[1])
sessionJustEnded = useSession and wasInSession and not inSession

// ═══════════════════════════════════════════════════════════════
// ENTRY SIGNALS (same logic as original)
// ═══════════════════════════════════════════════════════════════

longSignal  = ta.crossover(source, lower) and inSession
shortSignal = ta.crossunder(source, upper) and inSession

// ═══════════════════════════════════════════════════════════════
// EXECUTE TRADES
// ═══════════════════════════════════════════════════════════════

if longSignal
    strategy.entry("BBandLE", strategy.long, stop=lower,
         oca_name="BollingerBands", oca_type=strategy.oca.cancel, comment="BBandLE")
else
    strategy.cancel(id="BBandLE")

if shortSignal
    strategy.entry("BBandSE", strategy.short, stop=upper,
         oca_name="BollingerBands", oca_type=strategy.oca.cancel, comment="BBandSE")
else
    strategy.cancel(id="BBandSE")

// Close at session end
if closeAtEnd and sessionJustEnded and strategy.position_size != 0
    strategy.close_all(comment="London Close")

// ═══════════════════════════════════════════════════════════════
// PLOTS
// ═══════════════════════════════════════════════════════════════

p_upper = plot(upper, "Upper Band", color.new(#ff5252, 30), linewidth=1)
p_lower = plot(lower, "Lower Band", color.new(#00e676, 30), linewidth=1)
p_basis = plot(basis, "Basis", color.new(#ffffff, 50), linewidth=1)
fill(p_upper, p_basis, color.new(#ff5252, 90))
fill(p_basis, p_lower, color.new(#00e676, 90))

// Session background
bgcolor(useSession and inSession ? color.new(#2196f3, 93) : na, title="London Session")

// Entry signals
plotshape(longSignal and strategy.position_size <= 0, "Buy",
     shape.triangleup, location.belowbar, color.new(#00e676, 0), size=size.small, text="BUY")
plotshape(shortSignal and strategy.position_size >= 0, "Sell",
     shape.triangledown, location.abovebar, color.new(#ff5252, 0), size=size.small, text="SELL")

// Session end marker
plotshape(closeAtEnd and sessionJustEnded and strategy.position_size[1] != 0, "Session Close",
     shape.xcross, location.abovebar, color.new(#ffeb3b, 0), size=size.tiny, text="CLOSE")

// ═══════════════════════════════════════════════════════════════
// INFO TABLE
// ═══════════════════════════════════════════════════════════════

var table t = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 80), border_width=1)
if barstate.islast
    table.cell(t, 0, 0, "STRATEGY", text_color=color.yellow, text_size=size.small)
    table.cell(t, 1, 0, "BB LONDON", text_color=color.yellow, text_size=size.small)

    table.cell(t, 0, 1, "SESSION", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 1, inSession ? "ACTIVE" : "CLOSED",
         text_color=inSession ? color.green : color.red, text_size=size.small)

    table.cell(t, 0, 2, "UPPER", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 2, str.tostring(upper, format.mintick), text_color=#ff5252, text_size=size.small)

    table.cell(t, 0, 3, "LOWER", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 3, str.tostring(lower, format.mintick), text_color=#00e676, text_size=size.small)

    table.cell(t, 0, 4, "DIRECTION", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 4, direction == 0 ? "BOTH" : direction > 0 ? "LONG" : "SHORT",
         text_color=color.white, text_size=size.small)

    table.cell(t, 0, 5, "POSITION", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 5,
         strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT",
         text_color=strategy.position_size > 0 ? #00e676 : strategy.position_size < 0 ? #ff5252 : color.gray,
         text_size=size.small)

// ═══════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════
alertcondition(longSignal, title="BB Long", message="BB Long Entry — London Session")
alertcondition(shortSignal, title="BB Short", message="BB Short Entry — London Session")
alertcondition(sessionJustEnded, title="Session End", message="London Session Ended")
