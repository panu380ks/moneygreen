//@version=6
// This Pine Script code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
// (c) moneygreen
strategy("NAS100 4H - SuperTrend + BOS", overlay=true,
     default_qty_type=strategy.percent_of_equity, default_qty_value=50,
     initial_capital=10000, commission_type=strategy.commission.percent,
     commission_value=0.04, slippage=3, pyramiding=0,
     calc_on_every_tick=false, margin_long=0, margin_short=0,
     currency=currency.USD)

// --------------------------------------------------------------------------
// STRATEGY OVERVIEW
// --------------------------------------------------------------------------
// SuperTrend + Break of Structure (BOS) strategy for NAS100 on 4H.
//
// Pure trend-following, long-only:
//   BUY  -> uptrend starts: SuperTrend flips GREEN + Bullish BOS
//   SELL -> downtrend starts: SuperTrend flips RED OR Bearish BOS
//
// No shorts. No premature exits. Ride the trend until it reverses.
// SL/TP/trailing stop still protect against catastrophic losses.
// --------------------------------------------------------------------------

// --------------------------------------------------------------------------
// INPUTS
// --------------------------------------------------------------------------

// -- SuperTrend --
st_group   = "== SuperTrend =="
st_atr     = input.int(10,     "ATR Period",  minval=1,    group=st_group)
st_factor  = input.float(3.0,  "Factor",      minval=0.01, step=0.1, group=st_group)

// -- Break of Structure --
bos_group      = "== Break of Structure =="
bos_lookback   = input.int(5,  "Pivot Lookback (bars each side)", minval=2, maxval=20, group=bos_group,
     tooltip="Number of bars on each side to confirm a swing high/low. Higher = fewer but more significant pivots. 5 = ~20 hours on 4H")
bos_close_only = input.bool(true, "BOS on Close Only", group=bos_group,
     tooltip="Only trigger BOS when the candle CLOSES beyond the swing level (stronger confirmation)")
use_bos_entry  = input.bool(true, "Require Bullish BOS to Enter Long", group=bos_group,
     tooltip="When ON: buy requires ST green + bullish BOS. When OFF: buy on ST flip green only")
use_bos_exit   = input.bool(true, "Exit Long on Bearish BOS", group=bos_group,
     tooltip="When ON: exit longs when price breaks below last swing low, even if ST is still green")

// -- Bollinger Bands --
bb_group   = "== Bollinger Bands =="
bb_len     = input.int(20,     "BB Length",    minval=1,    group=bb_group)
bb_mult    = input.float(2.0,  "BB Multiplier",minval=0.1, step=0.1, group=bb_group)

// -- Entry Filters --
filt_group      = "== Entry Filters =="
use_ema         = input.bool(true,  "Use EMA Trend Filter",   group=filt_group,
     tooltip="Only long above EMA — the #1 institutional trend filter for indices")
ema_len         = input.int(200,    "EMA Length",              minval=1, group=filt_group)
use_vol         = input.bool(true,  "Use Volume Filter",      group=filt_group,
     tooltip="Only enter when current volume exceeds its moving average")
vol_lookback    = input.int(20,     "Volume MA Length",        minval=1, group=filt_group)
use_session     = input.bool(true,  "US Session Only",         group=filt_group,
     tooltip="Only enter during US session (09:30-16:00 exchange time)")
session_str     = input.session("0930-1600", "Session Window", group=filt_group)
allow_shorts    = input.bool(false, "Allow Short Entries",     group=filt_group,
     tooltip="When ON: enter short on ST red + bearish BOS. When OFF: only exit longs, never go short")
use_adx         = input.bool(true,  "Use ADX Trend Strength Filter", group=filt_group,
     tooltip="Only enter when ADX > threshold — avoids choppy markets where most losses occur")
adx_len         = input.int(14,     "ADX Length",              minval=1, group=filt_group)
adx_thresh      = input.float(20,   "ADX Min Threshold",      minval=5, maxval=50, step=1, group=filt_group,
     tooltip="ADX above this = trending market. Below = choppy/range-bound (avoid)")
use_rsi_filt    = input.bool(true,  "Use RSI Entry Filter",   group=filt_group,
     tooltip="Prevents chasing — no longs when RSI is overbought, no shorts when oversold")
rsi_filt_len    = input.int(14,     "RSI Length",              minval=1, group=filt_group)
rsi_filt_ob     = input.float(70,   "RSI Long Reject Above",  minval=50, maxval=95, group=filt_group,
     tooltip="Don't enter long when RSI is above this (chasing overbought)")
rsi_filt_os     = input.float(30,   "RSI Short Reject Below", minval=5,  maxval=50, group=filt_group,
     tooltip="Don't enter short when RSI is below this (chasing oversold)")
use_bb_zone     = input.bool(true,  "Use BB Value Zone Filter", group=filt_group,
     tooltip="Only enter longs in lower BB zone (value) and shorts in upper BB zone (overvalued)")
bb_long_max     = input.float(0.70, "Long Max BB %B",         minval=0.3, maxval=1, step=0.05, group=filt_group,
     tooltip="Don't enter long when price is above this BB %B level (overextended)")
bb_short_min    = input.float(0.30, "Short Min BB %B",        minval=0, maxval=0.7, step=0.05, group=filt_group,
     tooltip="Don't enter short when price is below this BB %B level (already crashed)")

// -- Risk Management --
risk_group  = "== Risk Management =="
use_sl      = input.bool(true,   "Use Stop Loss",         group=risk_group)
sl_atr_mult = input.float(1.2,   "SL ATR Multiplier",    minval=0.5, step=0.1, group=risk_group,
     tooltip="Tighter SL (1.2x ATR) cuts losers faster — key for loss reduction")
use_tp      = input.bool(true,   "Use Take Profit",       group=risk_group)
tp_rr       = input.float(2.0,   "Risk:Reward Ratio",    minval=0.5, step=0.1, group=risk_group)
use_trail   = input.bool(true,   "Use Trailing Stop",     group=risk_group)
trail_atr   = input.float(0.75,  "Trail ATR Multiplier", minval=0.3, step=0.05, group=risk_group,
     tooltip="Tight trail (0.75x ATR) locks in profits aggressively — reduces give-back losses")
// -- Date Filter --
date_group  = "== Date Filter =="
use_date    = input.bool(false,  "Use Date Filter",        group=date_group)
start_date  = input.time(timestamp("2024-01-01"), "Start Date", group=date_group)
end_date    = input.time(timestamp("2026-12-31"), "End Date",   group=date_group)

// --------------------------------------------------------------------------
// INDICATOR CALCULATIONS
// --------------------------------------------------------------------------

// SuperTrend
[st_line, st_dir] = ta.supertrend(st_factor, st_atr)
st_bullish   = st_dir < 0   // price above SuperTrend = GREEN
st_bearish   = st_dir > 0   // price below SuperTrend = RED
st_flip_bull = st_bullish and not st_bullish[1]
st_flip_bear = st_bearish and not st_bearish[1]

// Bollinger Bands
bb_basis = ta.sma(close, bb_len)
bb_dev   = bb_mult * ta.stdev(close, bb_len)
bb_upper = bb_basis + bb_dev
bb_lower = bb_basis - bb_dev
bb_range = bb_upper - bb_lower
bb_pct   = bb_range != 0 ? (close - bb_lower) / bb_range : 0.5

// ATR for risk management
atr = ta.atr(14)

// EMA trend filter
ema = ta.ema(close, ema_len)

// Volume filter
vol_avg = ta.sma(volume, vol_lookback)
vol_ok  = not use_vol or volume > vol_avg

// Session filter
in_session = not use_session or not na(time(timeframe.period, session_str))

// ADX trend strength (using DI+/DI- and smoothed true range)
[di_plus, di_minus, adx_val] = ta.dmi(adx_len, adx_len)
adx_ok = not use_adx or adx_val > adx_thresh

// RSI entry filter
rsi_val    = ta.rsi(close, rsi_filt_len)
rsi_long_ok  = not use_rsi_filt or rsi_val < rsi_filt_ob
rsi_short_ok = not use_rsi_filt or rsi_val > rsi_filt_os

// BB value zone filter
bb_long_ok  = not use_bb_zone or bb_pct < bb_long_max
bb_short_ok = not use_bb_zone or bb_pct > bb_short_min

// --------------------------------------------------------------------------
// BREAK OF STRUCTURE (BOS) DETECTION
// --------------------------------------------------------------------------

// Detect swing highs and swing lows using pivot points
// ta.pivothigh/low returns the value at the pivot, offset by bos_lookback bars
pivot_high = ta.pivothigh(high, bos_lookback, bos_lookback)
pivot_low  = ta.pivotlow(low,   bos_lookback, bos_lookback)

// Track the most recent swing high and swing low levels
var float last_swing_high = na
var float last_swing_low  = na

// Update swing levels when new pivots are confirmed
if not na(pivot_high)
    last_swing_high := pivot_high

if not na(pivot_low)
    last_swing_low := pivot_low

// Detect Break of Structure
// Bullish BOS: price breaks ABOVE the last swing high -> structure shifts UP
// Bearish BOS: price breaks BELOW the last swing low  -> structure shifts DOWN
bullish_bos = not na(last_swing_high) and (bos_close_only ? close > last_swing_high : high > last_swing_high) and (bos_close_only ? close[1] <= last_swing_high : high[1] <= last_swing_high)
bearish_bos = not na(last_swing_low)  and (bos_close_only ? close < last_swing_low  : low  < last_swing_low)  and (bos_close_only ? close[1] >= last_swing_low  : low[1]  >= last_swing_low)

// --------------------------------------------------------------------------
// ENTRY CONDITIONS
// --------------------------------------------------------------------------

in_date = not use_date or (time >= start_date and time <= end_date)

// === LONG ENTRY ===
// SuperTrend GREEN + Bullish BOS + all filters must pass
long_st   = st_bullish
long_bos  = not use_bos_entry or bullish_bos
long_ema  = not use_ema or close > ema
long_vol  = vol_ok

// Entry triggers:
// Option A (BOS required): ST green + bullish BOS on this bar
// Option B (BOS not required): ST flips green (original behavior)
long_trigger = use_bos_entry ? (long_st and bullish_bos) : st_flip_bull

long_entry = long_trigger and long_ema and long_vol and in_session and in_date and adx_ok and rsi_long_ok and bb_long_ok

// === SHORT ENTRY (optional) ===
// SuperTrend RED + Bearish BOS + all filters must pass
short_st   = st_bearish
short_bos  = not use_bos_entry or bearish_bos
short_ema  = not use_ema or close < ema
short_vol  = vol_ok

short_trigger = use_bos_entry ? (short_st and bearish_bos) : st_flip_bear

short_entry = allow_shorts and short_trigger and short_ema and short_vol and in_session and in_date and adx_ok and rsi_short_ok and bb_short_ok

// --------------------------------------------------------------------------
// EXIT CONDITIONS
// --------------------------------------------------------------------------

// Exit LONG only when DOWNTREND starts:
// 1. SuperTrend flips RED (trend reversal confirmed)
// 2. OR Bearish BOS (structure breaks down — early reversal signal)
// NO BB upper exit — let winners run during uptrend
// NO max bars exit — stay in as long as trend is up
exit_long_st  = st_flip_bear
exit_long_bos = use_bos_exit and bearish_bos

// Exit SHORT only when UPTREND starts (if shorts enabled):
exit_short_st  = st_flip_bull
exit_short_bos = use_bos_exit and bullish_bos

// --------------------------------------------------------------------------
// STRATEGY EXECUTION
// --------------------------------------------------------------------------

// Long entries — only when SuperTrend is GREEN + all filters pass
if long_entry and strategy.position_size == 0
    sl_price = use_sl ? close - (atr * sl_atr_mult) : na
    tp_price = use_tp ? close + (atr * sl_atr_mult * tp_rr) : na
    strategy.entry("Long", strategy.long)
    if use_sl or use_tp
        strategy.exit("Long TP/SL", "Long",
             stop  = use_sl ? sl_price : na,
             limit = use_tp ? tp_price : na,
             trail_points = use_trail ? int(atr * trail_atr / syminfo.mintick) : na,
             trail_offset = use_trail ? int(atr * trail_atr / syminfo.mintick) : na)

// Short entries — only when SuperTrend is RED + all filters pass
if short_entry and strategy.position_size == 0
    sl_price = use_sl ? close + (atr * sl_atr_mult) : na
    tp_price = use_tp ? close - (atr * sl_atr_mult * tp_rr) : na
    strategy.entry("Short", strategy.short)
    if use_sl or use_tp
        strategy.exit("Short TP/SL", "Short",
             stop  = use_sl ? sl_price : na,
             limit = use_tp ? tp_price : na,
             trail_points = use_trail ? int(atr * trail_atr / syminfo.mintick) : na,
             trail_offset = use_trail ? int(atr * trail_atr / syminfo.mintick) : na)

// Signal-based exits — ONLY on downtrend signals
if strategy.position_size > 0 and (exit_long_st or exit_long_bos)
    exit_reason = exit_long_st ? "Downtrend: ST Red" : "Downtrend: Bearish BOS"
    strategy.close("Long", comment=exit_reason)

if strategy.position_size < 0 and (exit_short_st or exit_short_bos)
    exit_reason = exit_short_st ? "Uptrend: ST Green" : "Uptrend: Bullish BOS"
    strategy.close("Short", comment=exit_reason)

// --------------------------------------------------------------------------
// PLOTS
// --------------------------------------------------------------------------

// SuperTrend line (GREEN = buy zone, RED = sell zone)
st_color = st_bullish ? color.new(color.green, 0) : color.new(color.red, 0)
plot(st_line, "SuperTrend", color=st_color, linewidth=2, style=plot.style_linebr)

// EMA trend filter
plot(use_ema ? ema : na, "EMA 200", color=color.new(color.orange, 30), linewidth=2)

// Bollinger Bands
p_bb_upper = plot(bb_upper, "BB Upper", color=color.new(color.green, 50))
p_bb_lower = plot(bb_lower, "BB Lower", color=color.new(color.red, 50))
plot(bb_basis, "BB Basis", color=color.new(color.gray, 50), linewidth=1)
fill(p_bb_upper, p_bb_lower, color=color.new(color.gray, 93))

// Swing levels (horizontal lines showing current structure)
plot(last_swing_high, "Swing High", color=color.new(color.teal, 40),
     linewidth=1, style=plot.style_stepline_diamond)
plot(last_swing_low,  "Swing Low",  color=color.new(color.purple, 40),
     linewidth=1, style=plot.style_stepline_diamond)

// Pivot markers (where swing highs/lows were detected)
plotshape(not na(pivot_high), "Pivot High", shape.diamond, location.abovebar,
     color.new(color.teal, 30), size=size.tiny, offset=-bos_lookback)
plotshape(not na(pivot_low),  "Pivot Low",  shape.diamond, location.belowbar,
     color.new(color.purple, 30), size=size.tiny, offset=-bos_lookback)

// BOS signals
plotshape(bullish_bos, "Bullish BOS", shape.labelup, location.belowbar,
     color.new(color.green, 0), size=size.small, text="BOS", textcolor=color.white)
plotshape(bearish_bos, "Bearish BOS", shape.labeldown, location.abovebar,
     color.new(color.red, 0), size=size.small, text="BOS", textcolor=color.white)

// Entry signals (only fires when all conditions met)
plotshape(long_entry and strategy.position_size == 0, "Buy Signal",
     shape.triangleup, location.belowbar, color.lime, size=size.normal)
plotshape(short_entry and strategy.position_size == 0, "Sell Signal",
     shape.triangledown, location.abovebar, color.red, size=size.normal)

// SuperTrend zone background
bgcolor(st_bullish ? color.new(color.green, 96) : color.new(color.red, 96), title="ST Zone BG")

// Session background
bgcolor(use_session and in_session ? color.new(color.blue, 95) : na, title="Session BG")

// --------------------------------------------------------------------------
// INFO TABLE
// --------------------------------------------------------------------------

var info = table.new(position.top_right, 2, 12, border_width=1)
if barstate.islast
    table.cell(info, 0, 0, "Indicator",  bgcolor=color.new(color.gray, 80), text_color=color.white)
    table.cell(info, 1, 0, "Signal",     bgcolor=color.new(color.gray, 80), text_color=color.white)

    table.cell(info, 0, 1, "SuperTrend", text_color=color.white)
    table.cell(info, 1, 1, st_bullish ? "GREEN ^" : "RED v",
         text_color=st_bullish ? color.green : color.red)

    table.cell(info, 0, 2, "ADX (" + str.tostring(adx_val, "#.0") + ")", text_color=color.white)
    table.cell(info, 1, 2, adx_val > adx_thresh ? "TRENDING" : "CHOPPY",
         text_color=adx_val > adx_thresh ? color.green : color.red)

    table.cell(info, 0, 3, "RSI (" + str.tostring(rsi_val, "#.0") + ")", text_color=color.white)
    table.cell(info, 1, 3, rsi_val > rsi_filt_ob ? "OVERBOUGHT" : rsi_val < rsi_filt_os ? "OVERSOLD" : "OK",
         text_color=rsi_val > rsi_filt_ob ? color.red : rsi_val < rsi_filt_os ? color.red : color.green)

    table.cell(info, 0, 4, "Swing High", text_color=color.white)
    table.cell(info, 1, 4, not na(last_swing_high) ? str.tostring(last_swing_high, "#.##") : "N/A",
         text_color=color.teal)

    table.cell(info, 0, 5, "Swing Low", text_color=color.white)
    table.cell(info, 1, 5, not na(last_swing_low) ? str.tostring(last_swing_low, "#.##") : "N/A",
         text_color=color.purple)

    table.cell(info, 0, 6, "Last BOS", text_color=color.white)
    table.cell(info, 1, 6, bullish_bos ? "BULLISH ^" : bearish_bos ? "BEARISH v" : "---",
         text_color=bullish_bos ? color.green : bearish_bos ? color.red : color.gray)

    table.cell(info, 0, 7, "EMA " + str.tostring(ema_len), text_color=color.white)
    table.cell(info, 1, 7, close > ema ? "ABOVE ^" : "BELOW v",
         text_color=close > ema ? color.green : color.red)

    table.cell(info, 0, 8, "Volume", text_color=color.white)
    table.cell(info, 1, 8, volume > vol_avg ? "ABOVE AVG" : "BELOW AVG",
         text_color=volume > vol_avg ? color.green : color.gray)

    table.cell(info, 0, 9, "ATR(14)", text_color=color.white)
    table.cell(info, 1, 9, str.tostring(atr, "#.##"), text_color=color.white)

    table.cell(info, 0, 10, "BB %B", text_color=color.white)
    table.cell(info, 1, 10, str.tostring(bb_pct * 100, "#.0") + "%",
         text_color=bb_pct > 0.8 ? color.red : bb_pct < 0.2 ? color.green : color.orange)

    table.cell(info, 0, 11, "Position", text_color=color.white)
    table.cell(info, 1, 11,
         strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT",
         text_color=strategy.position_size > 0 ? color.green : strategy.position_size < 0 ? color.red : color.gray)

// --------------------------------------------------------------------------
// STRATEGY LOGIC SUMMARY
// --------------------------------------------------------------------------
//
// +-----------+-----------------------------------------------+
// | BUY       | Uptrend starts:                               |
// |           |   SuperTrend GREEN + Bullish BOS              |
// |           |   + ADX > 20 + RSI < 70 + BB %B < 0.70       |
// |           |   + EMA above + Volume above avg              |
// +-----------+-----------------------------------------------+
// | SELL      | Downtrend starts:                             |
// |           |   SuperTrend flips RED                        |
// |           |   OR Bearish BOS (structure breaks down)      |
// +-----------+-----------------------------------------------+
// | SHORTS    | Disabled by default (long-only)               |
// +-----------+-----------------------------------------------+
//
// Philosophy: ride the trend. Only exit when trend actually reverses.
// No premature exits (no BB upper, no max bars).
// SL/TP/trail still protect against catastrophic single-trade losses.
// --------------------------------------------------------------------------
