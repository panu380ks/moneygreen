// https://mozilla.org/MPL/2.0/
// Hull Suite — London v7 (1-Min Optimized)
// Complete rewrite for 1-minute scalping — loosened filters, more trades, better R:R

//@version=6
strategy("Hull Suite — London v7 (1min)", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, initial_capital=10000, commission_type=strategy.commission.cash_per_order, commission_value=0.0, slippage=1, calc_on_every_tick=false, max_bars_back=500)

// ─── INPUTS ───────────────────────────────────────────────────────────────────

// Hull Suite
grp_hull = "Hull Suite"
hullLength    = input.int(16,       "Hull Length",       minval=4,  group=grp_hull, tooltip="Faster Hull for 1min — 16 is sweet spot")
hullSrc       = input.source(close, "Hull Source",       group=grp_hull)
hullModeIdx   = input.int(0,        "Hull Mode (0=HMA, 1=EHMA, 2=THMA)", minval=0, maxval=2, group=grp_hull)

// Confirmation MA (fast EMA to confirm Hull direction)
grp_conf = "Confirmation"
useConfEma    = input.bool(true,  "Use Confirmation EMA",  group=grp_conf, tooltip="Price must be on correct side of fast EMA")
confEmaLen    = input.int(9,      "Confirmation EMA Len",  group=grp_conf)

// Session Filter
grp_sess = "Session Filter"
useSess       = input.bool(true,   "Use Session Filter",     group=grp_sess)
sessStart     = input.session("0200-1700", "Trading Session (UTC)", group=grp_sess, tooltip="London + NY overlap = most volume")

// Trend Filter — single HTF EMA (replaces both 200 EMA and 50 EMA)
grp_trend = "HTF Trend Filter"
useHtfTrend   = input.bool(true,   "Use HTF Trend Filter",   group=grp_trend, tooltip="Single higher-timeframe EMA for trend bias")
htfEmaLen     = input.int(50,      "HTF EMA Length",          group=grp_trend)
htfTf         = input.timeframe("15", "HTF Timeframe",        group=grp_trend, tooltip="15-min EMA is ideal for 1-min entries")

// ADX Filter (simplified — no DI requirement)
grp_adx = "ADX Filter"
useAdx        = input.bool(true,   "Use ADX Filter",       group=grp_adx)
adxLen        = input.int(14,      "ADX Length",            group=grp_adx)
adxThresh     = input.float(15.0,  "ADX Threshold",        group=grp_adx, step=0.5, tooltip="Low threshold — just need SOME trend")

// RSI Guard (only blocks extremes)
grp_rsi = "RSI Guard"
useRsi        = input.bool(true,   "Use RSI Extreme Guard",  group=grp_rsi)
rsiLen        = input.int(7,       "RSI Length",              group=grp_rsi, tooltip="Short RSI for 1min responsiveness")
rsiOB         = input.float(80.0,  "RSI Overbought Block",   group=grp_rsi)
rsiOS         = input.float(20.0,  "RSI Oversold Block",     group=grp_rsi)

// Risk Management
grp_risk = "Risk Management"
atrLen        = input.int(10,      "ATR Length",              group=grp_risk)
atrMultSL     = input.float(1.5,   "ATR Stop Loss Multi",    group=grp_risk, step=0.1)
atrMultTP     = input.float(3.0,   "ATR Take Profit Multi",  group=grp_risk, step=0.1, tooltip="1:2 R:R for positive expectancy")
useTrailing   = input.bool(true,   "Use Trailing Stop",      group=grp_risk)
trailAtrMult  = input.float(1.0,   "Trail ATR Multiplier",   group=grp_risk, step=0.1)
useHullExit   = input.bool(true,   "Exit on Hull Flip",      group=grp_risk)
maxConsecLoss = input.int(0,       "Max Consec. Losses (0=off)", group=grp_risk, minval=0)

// Re-entry cooldown
grp_cool = "Cooldown"
useCooldown   = input.bool(true,   "Use Cooldown After Trade", group=grp_cool)
cooldownBars  = input.int(5,       "Cooldown Bars",            group=grp_cool, minval=1, maxval=30, tooltip="Wait N bars after exit before next entry")

// ─── HULL MOVING AVERAGE ──────────────────────────────────────────────────────

hma(_src, _len) =>
    _wma1 = ta.wma(_src, _len / 2)
    _wma2 = ta.wma(_src, _len)
    ta.wma(2 * _wma1 - _wma2, math.round(math.sqrt(_len)))

ehma(_src, _len) =>
    _ema1 = ta.ema(_src, _len / 2)
    _ema2 = ta.ema(_src, _len)
    ta.ema(2 * _ema1 - _ema2, math.round(math.sqrt(_len)))

thma(_src, _len) =>
    _wma1 = ta.wma(_src, _len / 3)
    _wma2 = ta.wma(_src, _len / 2)
    _wma3 = ta.wma(_src, _len)
    ta.wma(_wma1 * 3 - _wma2 - _wma3, _len)

hullVal = switch hullModeIdx
    0 => hma(hullSrc, hullLength)
    1 => ehma(hullSrc, hullLength)
    2 => thma(hullSrc, hullLength)

hullBull = hullVal > hullVal[1]
hullBear = hullVal < hullVal[1]
hullFlipBull = hullBull and hullBear[1]
hullFlipBear = hullBear and hullBull[1]

hullColor = hullBull ? color.new(color.lime, 0) : color.new(color.red, 0)
plot(hullVal, "Hull MA", color=hullColor, linewidth=2)

// ─── CONFIRMATION EMA ─────────────────────────────────────────────────────────

confEma = ta.ema(close, confEmaLen)
plot(useConfEma ? confEma : na, "Conf EMA", color=color.new(color.aqua, 40), linewidth=1)

confBullOk = not useConfEma or close > confEma
confBearOk = not useConfEma or close < confEma

// ─── SESSION ──────────────────────────────────────────────────────────────────

inSession = not useSess or not na(time(timeframe.period, sessStart))
bgcolor(inSession ? color.new(color.blue, 95) : na, title="Session BG")

// ─── HTF TREND ────────────────────────────────────────────────────────────────

htfEma = request.security(syminfo.tickerid, htfTf, ta.ema(close, htfEmaLen), lookahead=barmerge.lookahead_off)
plot(useHtfTrend ? htfEma : na, "HTF EMA", color=color.new(color.orange, 30), linewidth=1)

htfBullOk = not useHtfTrend or close > htfEma
htfBearOk = not useHtfTrend or close < htfEma

// ─── ADX ──────────────────────────────────────────────────────────────────────

[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)
adxOk = not useAdx or adxVal >= adxThresh

// ─── RSI ──────────────────────────────────────────────────────────────────────

rsiVal    = ta.rsi(close, rsiLen)
rsiBullOk = not useRsi or rsiVal < rsiOB
rsiBearOk = not useRsi or rsiVal > rsiOS

// ─── ATR ──────────────────────────────────────────────────────────────────────

atrVal = ta.atr(atrLen)

// ─── COOLDOWN TRACKER ─────────────────────────────────────────────────────────

var int barsSinceExit = 100  // start high so first trade isn't blocked

if strategy.position_size == 0 and strategy.position_size[1] != 0
    barsSinceExit := 0
else if strategy.position_size == 0
    barsSinceExit += 1

cooldownOk = not useCooldown or barsSinceExit >= cooldownBars

// ─── CONSECUTIVE LOSS TRACKER ─────────────────────────────────────────────────

var int consecLosses = 0
var int prevTradeCount = 0

if strategy.closedtrades > prevTradeCount
    lastPnl = strategy.closedtrades.profit(strategy.closedtrades - 1)
    if lastPnl < 0
        consecLosses += 1
    else
        consecLosses := 0
    prevTradeCount := strategy.closedtrades

// Reset at session start
if inSession and not inSession[1]
    consecLosses := 0

lossPauseOk = maxConsecLoss == 0 or consecLosses < maxConsecLoss

// ─── ENTRY CONDITIONS ─────────────────────────────────────────────────────────

// Enter on Hull flip with minimal confirmation — this is the core signal
longCond  = hullFlipBull and inSession and htfBullOk and confBullOk and adxOk and rsiBullOk and cooldownOk and lossPauseOk
shortCond = hullFlipBear and inSession and htfBearOk and confBearOk and adxOk and rsiBearOk and cooldownOk and lossPauseOk

// Prevent re-entering same direction while already in position
canLong  = longCond  and strategy.position_size <= 0
canShort = shortCond and strategy.position_size >= 0

// ─── EXECUTE ENTRIES ──────────────────────────────────────────────────────────

if canLong
    slDist  = atrVal * atrMultSL
    tpDist  = atrVal * atrMultTP
    slPrice = close - slDist
    tpPrice = close + tpDist
    strategy.entry("Long", strategy.long)
    if useTrailing
        strategy.exit("Long Exit", "Long", stop=slPrice, limit=tpPrice, trail_points=atrVal * trailAtrMult / syminfo.mintick, trail_offset=atrVal * trailAtrMult / syminfo.mintick)
    else
        strategy.exit("Long Exit", "Long", stop=slPrice, limit=tpPrice)

if canShort
    slDist  = atrVal * atrMultSL
    tpDist  = atrVal * atrMultTP
    slPrice = close + slDist
    tpPrice = close - tpDist
    strategy.entry("Short", strategy.short)
    if useTrailing
        strategy.exit("Short Exit", "Short", stop=slPrice, limit=tpPrice, trail_points=atrVal * trailAtrMult / syminfo.mintick, trail_offset=atrVal * trailAtrMult / syminfo.mintick)
    else
        strategy.exit("Short Exit", "Short", stop=slPrice, limit=tpPrice)

// ─── EXIT ON HULL FLIP ────────────────────────────────────────────────────────

if useHullExit
    if hullFlipBear and strategy.position_size > 0
        strategy.close("Long", comment="Hull Flip")
    if hullFlipBull and strategy.position_size < 0
        strategy.close("Short", comment="Hull Flip")

// ─── EXIT ON SESSION CLOSE ────────────────────────────────────────────────────

if not inSession and inSession[1]
    if strategy.position_size != 0
        strategy.close_all(comment="Session End")

// ─── DASHBOARD ────────────────────────────────────────────────────────────────

var table dash = table.new(position.top_right, 2, 11, bgcolor=color.new(color.black, 70), border_width=1, border_color=color.gray)

if barstate.islast
    table.cell(dash, 0, 0, "STRATEGY",    text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 0, "Hull London v7", text_color=color.yellow, text_size=size.small)

    table.cell(dash, 0, 1, "Hull",         text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 1, hullBull ? "BULL" : "BEAR", text_color=hullBull ? color.lime : color.red, text_size=size.small)

    table.cell(dash, 0, 2, "Session",      text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 2, inSession ? "OPEN" : "CLOSED", text_color=inSession ? color.lime : color.red, text_size=size.small)

    table.cell(dash, 0, 3, "HTF Trend",    text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 3, close > htfEma ? "ABOVE" : "BELOW", text_color=close > htfEma ? color.lime : color.red, text_size=size.small)

    table.cell(dash, 0, 4, "Conf EMA",     text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 4, close > confEma ? "ABOVE" : "BELOW", text_color=close > confEma ? color.lime : color.red, text_size=size.small)

    table.cell(dash, 0, 5, "ADX",          text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 5, str.tostring(adxVal, "#.#") + (adxOk ? " OK" : " LOW"), text_color=adxOk ? color.lime : color.orange, text_size=size.small)

    table.cell(dash, 0, 6, "RSI",          text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 6, str.tostring(rsiVal, "#.#"), text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 7, "ATR",          text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 7, str.tostring(atrVal, "#.#####"), text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 8, "Cooldown",     text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 8, cooldownOk ? "READY" : str.tostring(cooldownBars - barsSinceExit) + " bars", text_color=cooldownOk ? color.lime : color.orange, text_size=size.small)

    table.cell(dash, 0, 9, "Consec Loss",  text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 9, str.tostring(consecLosses), text_color=consecLosses >= 2 ? color.orange : color.white, text_size=size.small)

    table.cell(dash, 0, 10, "Position",    text_color=color.white, text_size=size.small)
    posText = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"
    posColor = strategy.position_size > 0 ? color.lime : strategy.position_size < 0 ? color.red : color.gray
    table.cell(dash, 1, 10, posText, text_color=posColor, text_size=size.small)

// ─── PLOT SIGNALS ─────────────────────────────────────────────────────────────

plotshape(canLong,  "Buy",  shape.labelup,   location.belowbar, color.lime, text="BUY",  textcolor=color.white, size=size.small)
plotshape(canShort, "Sell", shape.labeldown,  location.abovebar, color.red,  text="SELL", textcolor=color.white, size=size.small)
plotshape(hullFlipBull and not canLong, "Hull Flip Up",   shape.triangleup,   location.belowbar, color.new(color.lime, 60), size=size.tiny)
plotshape(hullFlipBear and not canShort, "Hull Flip Down", shape.triangledown, location.abovebar, color.new(color.red, 60),  size=size.tiny)
