// This Pine Script™ is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
// Hull Suite — London v8 (1-Min Scalper)
// Fixes: whipsaw filter, no Hull flip exit (kills winners), momentum confirmation,
// chop detection, better trailing, longer cooldown

//@version=6
strategy("Hull Suite — London v8 (1min)", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, initial_capital=10000, commission_type=strategy.commission.cash_per_order, commission_value=0.0, slippage=1, calc_on_every_tick=false, max_bars_back=500)

// ─── INPUTS ───────────────────────────────────────────────────────────────────

// Hull Suite — dual Hull for trend + signal
grp_hull = "Hull Suite"
hullFastLen   = input.int(16,       "Fast Hull Length",    minval=4,  group=grp_hull, tooltip="Signal Hull — triggers entries")
hullSlowLen   = input.int(48,       "Slow Hull Length",    minval=10, group=grp_hull, tooltip="Trend Hull — must agree with fast Hull direction")
hullSrc       = input.source(close, "Hull Source",         group=grp_hull)
hullModeIdx   = input.int(0,        "Hull Mode (0=HMA, 1=EHMA, 2=THMA)", minval=0, maxval=2, group=grp_hull)

// Momentum Confirmation
grp_mom = "Momentum Filter"
useMomFilter  = input.bool(true,  "Use Momentum Filter",    group=grp_mom, tooltip="Hull must move minimum distance to confirm flip is real")
momAtrMult    = input.float(0.3,  "Min Hull Move (ATR x)",  group=grp_mom, step=0.05, tooltip="Hull change must exceed this fraction of ATR")

// Chop / Range Filter
grp_chop = "Chop Filter"
useChopFilter = input.bool(true,  "Use Chop Index Filter",  group=grp_chop, tooltip="Avoid ranging/choppy markets")
chopLen       = input.int(14,     "Chop Index Length",       group=grp_chop)
chopThresh    = input.float(55.0, "Chop Threshold",          group=grp_chop, step=1.0, tooltip="Above this = choppy, below = trending")

// Session Filter
grp_sess = "Session Filter"
useSess       = input.bool(true,   "Use Session Filter",     group=grp_sess)
sessStart     = input.session("0200-1700", "Trading Session (UTC)", group=grp_sess)

// HTF Trend Filter
grp_trend = "HTF Trend Filter"
useHtfTrend   = input.bool(true,   "Use HTF Trend Filter",   group=grp_trend)
htfEmaLen     = input.int(50,      "HTF EMA Length",          group=grp_trend)
htfTf         = input.timeframe("15", "HTF Timeframe",        group=grp_trend)

// ADX Filter
grp_adx = "ADX Filter"
useAdx        = input.bool(true,   "Use ADX Filter",       group=grp_adx)
adxLen        = input.int(14,      "ADX Length",            group=grp_adx)
adxThresh     = input.float(18.0,  "ADX Threshold",        group=grp_adx, step=0.5)

// RSI Guard
grp_rsi = "RSI Guard"
useRsi        = input.bool(true,   "Use RSI Guard",          group=grp_rsi)
rsiLen        = input.int(7,       "RSI Length",              group=grp_rsi)
rsiOB         = input.float(78.0,  "RSI Overbought Block",   group=grp_rsi)
rsiOS         = input.float(22.0,  "RSI Oversold Block",     group=grp_rsi)

// Risk Management
grp_risk = "Risk Management"
atrLen        = input.int(10,      "ATR Length",              group=grp_risk)
atrMultSL     = input.float(1.5,   "ATR Stop Loss Multi",    group=grp_risk, step=0.1)
atrMultTP     = input.float(4.0,   "ATR Take Profit Multi",  group=grp_risk, step=0.1, tooltip="Wider TP — let winners run with trailing")
useTrailing   = input.bool(true,   "Use Trailing Stop",      group=grp_risk)
trailAtrMult  = input.float(1.0,   "Trail ATR Multiplier",   group=grp_risk, step=0.1)
trailOffset   = input.float(0.5,   "Trail Offset ATR Multi", group=grp_risk, step=0.1, tooltip="How far behind price the trail follows")
maxConsecLoss = input.int(3,       "Max Consec. Losses (0=off)", group=grp_risk, minval=0, tooltip="Pause after 3 consecutive losses")

// Cooldown
grp_cool = "Cooldown"
useCooldown   = input.bool(true,   "Use Cooldown",           group=grp_cool)
cooldownBars  = input.int(10,      "Cooldown Bars",           group=grp_cool, minval=1, maxval=60, tooltip="Longer cooldown reduces whipsaws")

// ─── HULL MOVING AVERAGE ──────────────────────────────────────────────────────

hma(_src, _len) =>
    _wma1 = ta.wma(_src, _len / 2)
    _wma2 = ta.wma(_src, _len)
    ta.wma(2 * _wma1 - _wma2, math.round(math.sqrt(_len)))

ehma(_src, _len) =>
    _ema1 = ta.ema(_src, _len / 2)
    _ema2 = ta.ema(_src, _len)
    ta.ema(2 * _ema1 - _ema2, math.round(math.sqrt(_len)))

thma(_src, _len) =>
    _wma1 = ta.wma(_src, _len / 3)
    _wma2 = ta.wma(_src, _len / 2)
    _wma3 = ta.wma(_src, _len)
    ta.wma(_wma1 * 3 - _wma2 - _wma3, _len)

calcHull(_src, _len) =>
    switch hullModeIdx
        0 => hma(_src, _len)
        1 => ehma(_src, _len)
        2 => thma(_src, _len)

// Fast Hull (signal)
hullFast     = calcHull(hullSrc, hullFastLen)
fastBull     = hullFast > hullFast[1]
fastBear     = hullFast < hullFast[1]
fastFlipBull = fastBull and fastBear[1]
fastFlipBear = fastBear and fastBull[1]

// Slow Hull (trend)
hullSlow     = calcHull(hullSrc, hullSlowLen)
slowBull     = hullSlow > hullSlow[1]
slowBear     = hullSlow < hullSlow[1]

// Plot
fastColor = fastBull ? color.new(color.lime, 0) : color.new(color.red, 0)
slowColor = slowBull ? color.new(color.lime, 60) : color.new(color.red, 60)
plot(hullFast, "Fast Hull", color=fastColor, linewidth=2)
plot(hullSlow, "Slow Hull", color=slowColor, linewidth=3)

// ─── MOMENTUM FILTER ──────────────────────────────────────────────────────────

atrVal    = ta.atr(atrLen)
hullDelta = math.abs(hullFast - hullFast[1])
momOk     = not useMomFilter or hullDelta > atrVal * momAtrMult

// ─── CHOP INDEX ───────────────────────────────────────────────────────────────
// Chop Index: high value = ranging, low value = trending

chopHigh  = ta.highest(high, chopLen)
chopLow   = ta.lowest(low, chopLen)
chopRange = chopHigh - chopLow
chopAtr   = math.sum(ta.atr(1), chopLen)
chopIdx   = chopRange > 0 ? 100.0 * math.log10(chopAtr / chopRange) / math.log10(chopLen) : 50.0
chopOk    = not useChopFilter or chopIdx < chopThresh

// ─── SESSION ──────────────────────────────────────────────────────────────────

inSession = not useSess or not na(time(timeframe.period, sessStart))
bgcolor(inSession ? color.new(color.blue, 95) : na, title="Session BG")

// ─── HTF TREND ────────────────────────────────────────────────────────────────

htfEma    = request.security(syminfo.tickerid, htfTf, ta.ema(close, htfEmaLen), lookahead=barmerge.lookahead_off)
plot(useHtfTrend ? htfEma : na, "HTF EMA", color=color.new(color.orange, 30), linewidth=1)

htfBullOk = not useHtfTrend or close > htfEma
htfBearOk = not useHtfTrend or close < htfEma

// ─── ADX ──────────────────────────────────────────────────────────────────────

[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)
adxOk = not useAdx or adxVal >= adxThresh

// ─── RSI ──────────────────────────────────────────────────────────────────────

rsiVal    = ta.rsi(close, rsiLen)
rsiBullOk = not useRsi or rsiVal < rsiOB
rsiBearOk = not useRsi or rsiVal > rsiOS

// ─── COOLDOWN ─────────────────────────────────────────────────────────────────

var int barsSinceExit = 100

if strategy.position_size == 0 and strategy.position_size[1] != 0
    barsSinceExit := 0
else if strategy.position_size == 0
    barsSinceExit += 1

cooldownOk = not useCooldown or barsSinceExit >= cooldownBars

// ─── CONSECUTIVE LOSS TRACKER ─────────────────────────────────────────────────

var int consecLosses = 0
var int prevTradeCount = 0

if strategy.closedtrades > prevTradeCount
    lastPnl = strategy.closedtrades.profit(strategy.closedtrades - 1)
    if lastPnl < 0
        consecLosses += 1
    else
        consecLosses := 0
    prevTradeCount := strategy.closedtrades

if inSession and not inSession[1]
    consecLosses := 0

lossPauseOk = maxConsecLoss == 0 or consecLosses < maxConsecLoss

// ─── ENTRY CONDITIONS ─────────────────────────────────────────────────────────

// Core: fast Hull flips + slow Hull agrees on direction + momentum + not choppy
longCond  = fastFlipBull and slowBull and inSession and htfBullOk and adxOk and rsiBullOk and momOk and chopOk and cooldownOk and lossPauseOk
shortCond = fastFlipBear and slowBear and inSession and htfBearOk and adxOk and rsiBearOk and momOk and chopOk and cooldownOk and lossPauseOk

canLong  = longCond  and strategy.position_size <= 0
canShort = shortCond and strategy.position_size >= 0

// ─── EXECUTE ENTRIES ──────────────────────────────────────────────────────────

if canLong
    slPrice = close - atrVal * atrMultSL
    tpPrice = close + atrVal * atrMultTP
    strategy.entry("Long", strategy.long)
    if useTrailing
        strategy.exit("Long Exit", "Long", stop=slPrice, limit=tpPrice, trail_points=atrVal * trailAtrMult / syminfo.mintick, trail_offset=atrVal * trailOffset / syminfo.mintick)
    else
        strategy.exit("Long Exit", "Long", stop=slPrice, limit=tpPrice)

if canShort
    slPrice = close + atrVal * atrMultSL
    tpPrice = close - atrVal * atrMultTP
    strategy.entry("Short", strategy.short)
    if useTrailing
        strategy.exit("Short Exit", "Short", stop=slPrice, limit=tpPrice, trail_points=atrVal * trailAtrMult / syminfo.mintick, trail_offset=atrVal * trailOffset / syminfo.mintick)
    else
        strategy.exit("Short Exit", "Short", stop=slPrice, limit=tpPrice)

// ─── NO HULL FLIP EXIT — let trailing stop & TP handle exits ─────────────────
// (Hull flip exit was killing winners in v7)

// ─── EXIT ON SESSION CLOSE ────────────────────────────────────────────────────

if not inSession and inSession[1]
    if strategy.position_size != 0
        strategy.close_all(comment="Session End")

// ─── DASHBOARD ────────────────────────────────────────────────────────────────

var table dash = table.new(position.top_right, 2, 13, bgcolor=color.new(color.black, 70), border_width=1, border_color=color.gray)

if barstate.islast
    table.cell(dash, 0, 0, "STRATEGY",    text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 0, "Hull London v8", text_color=color.yellow, text_size=size.small)

    table.cell(dash, 0, 1, "Fast Hull",    text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 1, fastBull ? "BULL" : "BEAR", text_color=fastBull ? color.lime : color.red, text_size=size.small)

    table.cell(dash, 0, 2, "Slow Hull",    text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 2, slowBull ? "BULL" : "BEAR", text_color=slowBull ? color.lime : color.red, text_size=size.small)

    table.cell(dash, 0, 3, "Aligned",      text_color=color.white, text_size=size.small)
    aligned = (fastBull and slowBull) or (fastBear and slowBear)
    table.cell(dash, 1, 3, aligned ? "YES" : "NO", text_color=aligned ? color.lime : color.orange, text_size=size.small)

    table.cell(dash, 0, 4, "Session",      text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 4, inSession ? "OPEN" : "CLOSED", text_color=inSession ? color.lime : color.red, text_size=size.small)

    table.cell(dash, 0, 5, "HTF Trend",    text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 5, close > htfEma ? "ABOVE" : "BELOW", text_color=close > htfEma ? color.lime : color.red, text_size=size.small)

    table.cell(dash, 0, 6, "ADX",          text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 6, str.tostring(adxVal, "#.#") + (adxOk ? " OK" : " LOW"), text_color=adxOk ? color.lime : color.orange, text_size=size.small)

    table.cell(dash, 0, 7, "Chop Idx",     text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 7, str.tostring(chopIdx, "#.#") + (chopOk ? " OK" : " CHOP"), text_color=chopOk ? color.lime : color.orange, text_size=size.small)

    table.cell(dash, 0, 8, "Momentum",     text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 8, momOk ? "OK" : "WEAK", text_color=momOk ? color.lime : color.orange, text_size=size.small)

    table.cell(dash, 0, 9, "RSI",          text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 9, str.tostring(rsiVal, "#.#"), text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 10, "Cooldown",    text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 10, cooldownOk ? "READY" : str.tostring(cooldownBars - barsSinceExit) + " bars", text_color=cooldownOk ? color.lime : color.orange, text_size=size.small)

    table.cell(dash, 0, 11, "Consec Loss", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 11, str.tostring(consecLosses) + (maxConsecLoss > 0 ? "/" + str.tostring(maxConsecLoss) : ""), text_color=consecLosses >= 2 ? color.orange : color.white, text_size=size.small)

    table.cell(dash, 0, 12, "Position",    text_color=color.white, text_size=size.small)
    posText = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"
    posColor = strategy.position_size > 0 ? color.lime : strategy.position_size < 0 ? color.red : color.gray
    table.cell(dash, 1, 12, posText, text_color=posColor, text_size=size.small)

// ─── PLOT SIGNALS ─────────────────────────────────────────────────────────────

plotshape(canLong,  "Buy",  shape.labelup,   location.belowbar, color.lime, text="BUY",  textcolor=color.white, size=size.small)
plotshape(canShort, "Sell", shape.labeldown,  location.abovebar, color.red,  text="SELL", textcolor=color.white, size=size.small)
plotshape(fastFlipBull and not canLong,  "Flip Up (blocked)",   shape.triangleup,   location.belowbar, color.new(color.lime, 70), size=size.tiny)
plotshape(fastFlipBear and not canShort, "Flip Down (blocked)", shape.triangledown, location.abovebar, color.new(color.red, 70),  size=size.tiny)
