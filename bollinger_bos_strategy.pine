//@version=6
strategy("Bollinger Bands + BOS Strategy (Heiken Ashi)", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0.05)

// ──────────────────────────────────────────────────────────────────────────────
// INPUTS
// ──────────────────────────────────────────────────────────────────────────────

// Bollinger Bands
bb_length     = input.int(20, "BB Length", minval=1, group="Bollinger Bands")
bb_mult       = input.float(2.0, "BB Multiplier", minval=0.001, maxval=50, step=0.1, group="Bollinger Bands")
bb_source     = input.source(close, "BB Source", group="Bollinger Bands")

// Heiken Ashi
use_ha        = input.bool(true, "Use Heiken Ashi Candles", group="Heiken Ashi")

// Break of Structure
swing_lookback = input.int(5, "Swing Lookback Bars", minval=2, maxval=50, group="Break of Structure", tooltip="Number of bars left/right to identify swing highs and lows")
bos_confirm   = input.int(1, "BOS Confirmation Bars", minval=1, maxval=5, group="Break of Structure", tooltip="Bars to wait for BOS confirmation")

// Strategy Direction
direction     = input.int(0, "Strategy Direction (0=Both, 1=Long, -1=Short)", minval=-1, maxval=1, group="Strategy")
strategy.risk.allow_entry_in(direction == 0 ? strategy.direction.all : (direction < 0 ? strategy.direction.short : strategy.direction.long))

// Session Time Filter
use_session   = input.bool(true, "Use Session Time Filter", group="Session")
session_time  = input.session("0800-1200", "Trading Session", group="Session", tooltip="Only allow entries during this time window (exchange timezone)")

// Risk Management
use_sl        = input.bool(true, "Use Stop Loss", group="Risk Management")
sl_mult       = input.float(1.0, "Stop Loss (BB dev multiplier)", minval=0.1, maxval=5.0, step=0.1, group="Risk Management", tooltip="SL distance as a fraction of BB deviation")
use_tp        = input.bool(true, "Use Take Profit", group="Risk Management")
tp_mult       = input.float(1.5, "Take Profit (BB dev multiplier)", minval=0.1, maxval=10.0, step=0.1, group="Risk Management", tooltip="TP distance as a fraction of BB deviation")

// ──────────────────────────────────────────────────────────────────────────────
// HEIKEN ASHI DATA
// ──────────────────────────────────────────────────────────────────────────────

ha_ticker = ticker.heikinashi(syminfo.tickerid)
data_src  = use_ha ? ha_ticker : syminfo.tickerid

ha_open  = request.security(data_src, timeframe.period, open)
ha_high  = request.security(data_src, timeframe.period, high)
ha_low   = request.security(data_src, timeframe.period, low)
ha_close = request.security(data_src, timeframe.period, close)

ha_bullish = ha_close > ha_open
ha_bearish = ha_close < ha_open

// Plot Heiken Ashi candles
ha_color = ha_bullish ? color.green : color.red
plotcandle(ha_open, ha_high, ha_low, ha_close, "Heiken Ashi", ha_color, color.black)

// ──────────────────────────────────────────────────────────────────────────────
// BOLLINGER BANDS
// ──────────────────────────────────────────────────────────────────────────────

basis = ta.sma(bb_source, bb_length)
dev   = bb_mult * ta.stdev(bb_source, bb_length)
upper = basis + dev
lower = basis - dev

// Plots
p_basis = plot(basis, "Basis", color=color.orange, linewidth=1)
p_upper = plot(upper, "Upper Band", color=color.new(color.blue, 0), linewidth=1)
p_lower = plot(lower, "Lower Band", color=color.new(color.blue, 0), linewidth=1)
fill(p_upper, p_lower, color=color.new(color.blue, 90), title="BB Fill")

// ──────────────────────────────────────────────────────────────────────────────
// SWING HIGH / SWING LOW DETECTION
// ──────────────────────────────────────────────────────────────────────────────

// Detect pivot highs and lows using the lookback period
swing_high = ta.pivothigh(high, swing_lookback, swing_lookback)
swing_low  = ta.pivotlow(low, swing_lookback, swing_lookback)

// Track the last two swing highs and swing lows
var float prev_swing_high  = na
var float last_swing_high  = na
var float prev_swing_low   = na
var float last_swing_low   = na

// Store the bar index of each swing for reference
var int prev_sh_bar  = na
var int last_sh_bar  = na
var int prev_sl_bar  = na
var int last_sl_bar  = na

if not na(swing_high)
    prev_swing_high := last_swing_high
    prev_sh_bar     := last_sh_bar
    last_swing_high := swing_high
    last_sh_bar     := bar_index - swing_lookback

if not na(swing_low)
    prev_swing_low := last_swing_low
    prev_sl_bar    := last_sl_bar
    last_swing_low := swing_low
    last_sl_bar    := bar_index - swing_lookback

// ──────────────────────────────────────────────────────────────────────────────
// BREAK OF STRUCTURE (BOS) DETECTION
// ──────────────────────────────────────────────────────────────────────────────

// Higher High: current swing high > previous swing high  → Bullish BOS
higher_high = not na(last_swing_high) and not na(prev_swing_high) and last_swing_high > prev_swing_high

// Higher Low: current swing low > previous swing low
higher_low = not na(last_swing_low) and not na(prev_swing_low) and last_swing_low > prev_swing_low

// Lower Low: current swing low < previous swing low  → Bearish BOS
lower_low = not na(last_swing_low) and not na(prev_swing_low) and last_swing_low < prev_swing_low

// Lower High: current swing high < previous swing high
lower_high = not na(last_swing_high) and not na(prev_swing_high) and last_swing_high < prev_swing_high

// ── Bullish BOS ──
// Price closes above the last swing high → structure break to the upside
// Confirmed by Higher High pattern
bullish_bos = higher_high and close > last_swing_high

// We require confirmation: price must hold above for N bars
bullish_bos_confirmed = bullish_bos
if bos_confirm > 1 and bullish_bos
    count = 0
    for i = 1 to bos_confirm - 1
        if close[i] > last_swing_high
            count += 1
    bullish_bos_confirmed := count >= (bos_confirm - 1)

// ── Bearish BOS ──
// Price closes below the last swing low → structure break to the downside
// Triggered by Higher Lows being violated (HL break) OR continuation Lower Lows
bearish_bos_hl = higher_low and close < last_swing_low   // HL broken → trend reversal
bearish_bos_ll = lower_low and close < last_swing_low    // LL continuation → bearish momentum
bearish_bos = bearish_bos_hl or bearish_bos_ll

bearish_bos_confirmed = bearish_bos
if bos_confirm > 1 and bearish_bos
    count = 0
    for i = 1 to bos_confirm - 1
        if close[i] < last_swing_low
            count += 1
    bearish_bos_confirmed := count >= (bos_confirm - 1)

// ──────────────────────────────────────────────────────────────────────────────
// SESSION TIME FILTER
// ──────────────────────────────────────────────────────────────────────────────

in_session = not use_session or not na(time("240", session_time))

// ──────────────────────────────────────────────────────────────────────────────
// ENTRY CONDITIONS
// ──────────────────────────────────────────────────────────────────────────────

// ── LONG ENTRY ──
// Bullish BOS (Higher High confirmed) + price above basis (upper half of BB)
// + Heiken Ashi bullish candle for momentum confirmation + within session
long_bb_filter   = close >= basis                          // price is above basis (only long above basis)
long_ha_filter   = ha_bullish                              // HA candle is green
long_signal      = bullish_bos_confirmed and long_bb_filter and long_ha_filter and in_session

// ── SHORT ENTRY ──
// Bearish BOS (HL break or LL continuation) + price below basis (lower half of BB)
// + Heiken Ashi bearish candle for momentum confirmation + within session
short_bb_filter  = close <= basis                          // price is below basis (only short below basis)
short_ha_filter  = ha_bearish                              // HA candle is red
short_signal     = bearish_bos_confirmed and short_bb_filter and short_ha_filter and in_session

// ──────────────────────────────────────────────────────────────────────────────
// RISK MANAGEMENT: SL & TP CALCULATION
// ──────────────────────────────────────────────────────────────────────────────

sl_distance = dev * sl_mult
tp_distance = dev * tp_mult

long_sl  = use_sl ? close - sl_distance : na
long_tp  = use_tp ? close + tp_distance : na
short_sl = use_sl ? close + sl_distance : na
short_tp = use_tp ? close - tp_distance : na

// ──────────────────────────────────────────────────────────────────────────────
// STRATEGY EXECUTION
// ──────────────────────────────────────────────────────────────────────────────

if long_signal
    strategy.entry("Long_BOS", strategy.long, comment="Long: HH BOS")
    if use_sl or use_tp
        strategy.exit("Long_Exit", "Long_BOS", stop=long_sl, limit=long_tp)

if short_signal
    strategy.entry("Short_BOS", strategy.short, comment="Short: BOS")
    if use_sl or use_tp
        strategy.exit("Short_Exit", "Short_BOS", stop=short_sl, limit=short_tp)

// ── EXIT on opposite BOS ──
// Close long if bearish BOS fires, close short if bullish BOS fires
if bearish_bos_confirmed and strategy.position_size > 0
    strategy.close("Long_BOS", comment="Exit Long: Bearish BOS")

if bullish_bos_confirmed and strategy.position_size < 0
    strategy.close("Short_BOS", comment="Exit Short: Bullish BOS")

// ──────────────────────────────────────────────────────────────────────────────
// VISUAL MARKERS
// ──────────────────────────────────────────────────────────────────────────────

// Swing points
plotshape(not na(swing_high), title="Swing High", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 30), size=size.tiny, offset=-swing_lookback)
plotshape(not na(swing_low), title="Swing Low", style=shape.triangleup, location=location.belowbar, color=color.new(color.green, 30), size=size.tiny, offset=-swing_lookback)

// BOS signals
plotshape(long_signal, title="Long BOS Signal", style=shape.labelup, location=location.belowbar, color=color.green, text="BOS↑", textcolor=color.white, size=size.small)
plotshape(short_signal, title="Short BOS Signal", style=shape.labeldown, location=location.abovebar, color=color.red, text="BOS↓", textcolor=color.white, size=size.small)

// Background color for active BOS regime
bgcolor(bullish_bos_confirmed ? color.new(color.green, 93) : bearish_bos_confirmed ? color.new(color.red, 93) : na, title="BOS Background")

// ──────────────────────────────────────────────────────────────────────────────
// INFORMATION TABLE
// ──────────────────────────────────────────────────────────────────────────────

var table info = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 80), border_width=1, border_color=color.gray)

if barstate.islast
    table.cell(info, 0, 0, "Metric", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 0, "Value", text_color=color.white, text_size=size.small)

    table.cell(info, 0, 1, "Last Swing High", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 1, str.tostring(last_swing_high, format.mintick), text_color=color.yellow, text_size=size.small)

    table.cell(info, 0, 2, "Last Swing Low", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 2, str.tostring(last_swing_low, format.mintick), text_color=color.yellow, text_size=size.small)

    table.cell(info, 0, 3, "Structure", text_color=color.white, text_size=size.small)
    struct_text = higher_high ? "HH (Bullish)" : lower_low ? "LL (Bearish)" : higher_low ? "HL" : lower_high ? "LH" : "N/A"
    struct_color = higher_high ? color.green : lower_low ? color.red : color.gray
    table.cell(info, 1, 3, struct_text, text_color=struct_color, text_size=size.small)

    table.cell(info, 0, 4, "BB Position", text_color=color.white, text_size=size.small)
    bb_pos = close > upper ? "Above Upper" : close < lower ? "Below Lower" : close > basis ? "Upper Half" : "Lower Half"
    table.cell(info, 1, 4, bb_pos, text_color=color.aqua, text_size=size.small)

    table.cell(info, 0, 5, "HA Trend", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 5, ha_bullish ? "Bullish" : "Bearish", text_color=ha_bullish ? color.green : color.red, text_size=size.small)

    table.cell(info, 0, 6, "Session", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 6, in_session ? "Active" : "Closed", text_color=in_session ? color.green : color.gray, text_size=size.small)
