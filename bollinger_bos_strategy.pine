//@version=6
strategy("Bollinger Bands + Crossover Strategy (Heiken Ashi)", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0.05)

// ──────────────────────────────────────────────────────────────────────────────
// INPUTS
// ──────────────────────────────────────────────────────────────────────────────

// Bollinger Bands
bb_length     = input.int(20, "BB Length", minval=1, group="Bollinger Bands")
bb_mult       = input.float(2.0, "BB Multiplier", minval=0.001, maxval=50, step=0.1, group="Bollinger Bands")
bb_source     = input.source(close, "BB Source", group="Bollinger Bands")

// Heiken Ashi
use_ha        = input.bool(true, "Use Heiken Ashi Candles", group="Heiken Ashi")

// Strategy Direction
direction     = input.int(0, "Strategy Direction (0=Both, 1=Long, -1=Short)", minval=-1, maxval=1, group="Strategy")
strategy.risk.allow_entry_in(direction == 0 ? strategy.direction.all : (direction < 0 ? strategy.direction.short : strategy.direction.long))

// Session Time Filter
use_session   = input.bool(true, "Use Session Time Filter", group="Session")
session_time  = input.session("0800-1200", "Trading Session", group="Session", tooltip="Only allow entries during this time window (exchange timezone)")

// Risk Management
use_sl        = input.bool(true, "Use Stop Loss", group="Risk Management")
sl_mult       = input.float(1.0, "Stop Loss (BB dev multiplier)", minval=0.1, maxval=5.0, step=0.1, group="Risk Management", tooltip="SL distance as a fraction of BB deviation")
use_tp        = input.bool(true, "Use Take Profit", group="Risk Management")
tp_mult       = input.float(1.5, "Take Profit (BB dev multiplier)", minval=0.1, maxval=10.0, step=0.1, group="Risk Management", tooltip="TP distance as a fraction of BB deviation")

// ──────────────────────────────────────────────────────────────────────────────
// HEIKEN ASHI DATA
// ──────────────────────────────────────────────────────────────────────────────

ha_ticker = ticker.heikinashi(syminfo.tickerid)
data_src  = use_ha ? ha_ticker : syminfo.tickerid

ha_open  = request.security(data_src, timeframe.period, open)
ha_high  = request.security(data_src, timeframe.period, high)
ha_low   = request.security(data_src, timeframe.period, low)
ha_close = request.security(data_src, timeframe.period, close)

ha_bullish = ha_close > ha_open
ha_bearish = ha_close < ha_open

// Plot Heiken Ashi candles
ha_color = ha_bullish ? color.green : color.red
plotcandle(ha_open, ha_high, ha_low, ha_close, "Heiken Ashi", ha_color, color.black)

// ──────────────────────────────────────────────────────────────────────────────
// BOLLINGER BANDS
// ──────────────────────────────────────────────────────────────────────────────

basis = ta.sma(bb_source, bb_length)
dev   = bb_mult * ta.stdev(bb_source, bb_length)
upper = basis + dev
lower = basis - dev

// Plots
p_basis = plot(basis, "Basis", color=color.orange, linewidth=1)
p_upper = plot(upper, "Upper Band", color=color.new(color.blue, 0), linewidth=1)
p_lower = plot(lower, "Lower Band", color=color.new(color.blue, 0), linewidth=1)
fill(p_upper, p_lower, color=color.new(color.blue, 90), title="BB Fill")

// ──────────────────────────────────────────────────────────────────────────────
// SESSION TIME FILTER
// ──────────────────────────────────────────────────────────────────────────────

in_session = not use_session or not na(time("240", session_time))

// ──────────────────────────────────────────────────────────────────────────────
// ENTRY CONDITIONS — Crossover + BB Filter + HA Filter + Session
// ──────────────────────────────────────────────────────────────────────────────

// ── LONG ENTRY ──
// Crossover: price crosses above lower band
// BB filter: only long when price is above the basis line
// HA filter: Heiken Ashi candle must be bullish (green)
long_crossover   = ta.crossover(bb_source, lower)
long_bb_filter   = close >= basis
long_ha_filter   = ha_bullish
long_signal      = long_crossover and long_bb_filter and long_ha_filter and in_session

// ── SHORT ENTRY ──
// Crossunder: price crosses below upper band
// BB filter: only short when price is below the basis line
// HA filter: Heiken Ashi candle must be bearish (red)
short_crossunder = ta.crossunder(bb_source, upper)
short_bb_filter  = close <= basis
short_ha_filter  = ha_bearish
short_signal     = short_crossunder and short_bb_filter and short_ha_filter and in_session

// ──────────────────────────────────────────────────────────────────────────────
// RISK MANAGEMENT: SL & TP CALCULATION
// ──────────────────────────────────────────────────────────────────────────────

sl_distance = dev * sl_mult
tp_distance = dev * tp_mult

long_sl  = use_sl ? close - sl_distance : na
long_tp  = use_tp ? close + tp_distance : na
short_sl = use_sl ? close + sl_distance : na
short_tp = use_tp ? close - tp_distance : na

// ──────────────────────────────────────────────────────────────────────────────
// STRATEGY EXECUTION
// ──────────────────────────────────────────────────────────────────────────────

if long_signal
    strategy.entry("BBandLE", strategy.long, stop=lower, oca_name="BollingerBands", oca_type=strategy.oca.cancel, comment="BBandLE")
    if use_sl or use_tp
        strategy.exit("Long_Exit", "BBandLE", stop=long_sl, limit=long_tp)
else
    strategy.cancel(id="BBandLE")

if short_signal
    strategy.entry("BBandSE", strategy.short, stop=upper, oca_name="BollingerBands", oca_type=strategy.oca.cancel, comment="BBandSE")
    if use_sl or use_tp
        strategy.exit("Short_Exit", "BBandSE", stop=short_sl, limit=short_tp)
else
    strategy.cancel(id="BBandSE")

// ──────────────────────────────────────────────────────────────────────────────
// VISUAL MARKERS
// ──────────────────────────────────────────────────────────────────────────────

// Entry signals
plotshape(long_signal, title="Long Signal", style=shape.labelup, location=location.belowbar, color=color.green, text="Long", textcolor=color.white, size=size.small)
plotshape(short_signal, title="Short Signal", style=shape.labeldown, location=location.abovebar, color=color.red, text="Short", textcolor=color.white, size=size.small)

// Background color for session
bgcolor(in_session ? color.new(color.blue, 95) : na, title="Session Background")

// ──────────────────────────────────────────────────────────────────────────────
// INFORMATION TABLE
// ──────────────────────────────────────────────────────────────────────────────

var table info = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 80), border_width=1, border_color=color.gray)

if barstate.islast
    table.cell(info, 0, 0, "Metric", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 0, "Value", text_color=color.white, text_size=size.small)

    table.cell(info, 0, 1, "BB Position", text_color=color.white, text_size=size.small)
    bb_pos = close > upper ? "Above Upper" : close < lower ? "Below Lower" : close > basis ? "Upper Half" : "Lower Half"
    table.cell(info, 1, 1, bb_pos, text_color=color.aqua, text_size=size.small)

    table.cell(info, 0, 2, "HA Trend", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 2, ha_bullish ? "Bullish" : "Bearish", text_color=ha_bullish ? color.green : color.red, text_size=size.small)

    table.cell(info, 0, 3, "Session", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 3, in_session ? "Active" : "Closed", text_color=in_session ? color.green : color.gray, text_size=size.small)

    table.cell(info, 0, 4, "Upper Band", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 4, str.tostring(upper, format.mintick), text_color=color.yellow, text_size=size.small)

    table.cell(info, 0, 5, "Lower Band", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 5, str.tostring(lower, format.mintick), text_color=color.yellow, text_size=size.small)
