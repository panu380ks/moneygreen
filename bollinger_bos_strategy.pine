//@version=6
strategy("Heiken Ashi Market Structure Strategy", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0.05)

// ──────────────────────────────────────────────────────────────────────────────
// INPUTS
// ──────────────────────────────────────────────────────────────────────────────

// Heiken Ashi
use_ha        = input.bool(true, "Use Heiken Ashi Candles", group="Heiken Ashi")

// Trend Filter
use_ema       = input.bool(true, "Use EMA Trend Filter", group="Trend Filter", tooltip="Only long above EMA, only short below EMA")
ema_length    = input.int(50, "EMA Length", minval=5, maxval=200, group="Trend Filter")

// HA Confirmation
ha_confirm    = input.int(2, "HA Candles to Confirm Flip", minval=1, maxval=5, group="Entry", tooltip="Number of consecutive same-color HA candles required before entry")

// Strategy Direction
direction     = input.int(0, "Strategy Direction (0=Both, 1=Long, -1=Short)", minval=-1, maxval=1, group="Strategy")
strategy.risk.allow_entry_in(direction == 0 ? strategy.direction.all : (direction < 0 ? strategy.direction.short : strategy.direction.long))

// Session Time Filter
use_session   = input.bool(true, "Use Session Time Filter", group="Session")
session_time  = input.session("0800-1200", "Trading Session", group="Session", tooltip="Only allow entries during this time window (exchange timezone)")

// Risk Management
use_sl        = input.bool(true, "Use Stop Loss", group="Risk Management")
sl_atr_mult   = input.float(1.5, "Stop Loss (ATR multiplier)", minval=0.5, maxval=5.0, step=0.1, group="Risk Management")
use_tp        = input.bool(true, "Use Take Profit", group="Risk Management")
tp_atr_mult   = input.float(2.5, "Take Profit (ATR multiplier)", minval=0.5, maxval=10.0, step=0.1, group="Risk Management")
atr_length    = input.int(14, "ATR Length", minval=1, maxval=50, group="Risk Management")
use_ha_exit   = input.bool(true, "Close on HA Color Flip", group="Risk Management", tooltip="Exit position when HA candles flip to opposite color")

// Dashboard
show_dashboard = input.bool(true, "Show Backtest Dashboard", group="Dashboard")

// ──────────────────────────────────────────────────────────────────────────────
// HEIKEN ASHI DATA
// ──────────────────────────────────────────────────────────────────────────────

ha_ticker = ticker.heikinashi(syminfo.tickerid)
data_src  = use_ha ? ha_ticker : syminfo.tickerid

ha_open  = request.security(data_src, timeframe.period, open)
ha_high  = request.security(data_src, timeframe.period, high)
ha_low   = request.security(data_src, timeframe.period, low)
ha_close = request.security(data_src, timeframe.period, close)

ha_bullish = ha_close > ha_open
ha_bearish = ha_close < ha_open

// Plot Heiken Ashi candles
ha_color = ha_bullish ? color.green : color.red
plotcandle(ha_open, ha_high, ha_low, ha_close, "Heiken Ashi", ha_color, color.black)

// ──────────────────────────────────────────────────────────────────────────────
// TREND FILTER — EMA
// ──────────────────────────────────────────────────────────────────────────────

ema_val = ta.ema(close, ema_length)
plot(use_ema ? ema_val : na, "EMA", color=color.orange, linewidth=2)

ema_long_ok  = not use_ema or close > ema_val
ema_short_ok = not use_ema or close < ema_val

// ──────────────────────────────────────────────────────────────────────────────
// HA CONSECUTIVE CANDLE COUNT
// ──────────────────────────────────────────────────────────────────────────────

// Count consecutive bullish HA candles
var int bull_count = 0
var int bear_count = 0

if ha_bullish
    bull_count := bull_count + 1
    bear_count := 0
else
    bear_count := bear_count + 1
    bull_count := 0

// Detect the exact bar where confirmation count is reached (entry trigger)
bull_confirmed = bull_count == ha_confirm
bear_confirmed = bear_count == ha_confirm

// ──────────────────────────────────────────────────────────────────────────────
// SESSION TIME FILTER
// ──────────────────────────────────────────────────────────────────────────────

in_session = not use_session or not na(time("240", session_time))

// ──────────────────────────────────────────────────────────────────────────────
// ENTRY CONDITIONS — HA Flip + Trend Filter + Session
// ──────────────────────────────────────────────────────────────────────────────

// Long: HA turns green (confirmed) + price above EMA + in session
long_signal  = bull_confirmed and ema_long_ok and in_session

// Short: HA turns red (confirmed) + price below EMA + in session
short_signal = bear_confirmed and ema_short_ok and in_session

// ──────────────────────────────────────────────────────────────────────────────
// RISK MANAGEMENT: ATR-BASED SL & TP
// ──────────────────────────────────────────────────────────────────────────────

atr_val = ta.atr(atr_length)

long_sl  = use_sl ? close - atr_val * sl_atr_mult : na
long_tp  = use_tp ? close + atr_val * tp_atr_mult : na
short_sl = use_sl ? close + atr_val * sl_atr_mult : na
short_tp = use_tp ? close - atr_val * tp_atr_mult : na

// ──────────────────────────────────────────────────────────────────────────────
// STRATEGY EXECUTION
// ──────────────────────────────────────────────────────────────────────────────

// ── ENTRIES ──
if long_signal
    strategy.entry("Long", strategy.long, comment="HA Long")
    if use_sl or use_tp
        strategy.exit("Long_Exit", "Long", stop=long_sl, limit=long_tp)

if short_signal
    strategy.entry("Short", strategy.short, comment="HA Short")
    if use_sl or use_tp
        strategy.exit("Short_Exit", "Short", stop=short_sl, limit=short_tp)

// ── HA COLOR FLIP EXIT ──
// If in a long and HA flips red → close
// If in a short and HA flips green → close
if use_ha_exit
    if strategy.position_size > 0 and ha_bearish
        strategy.close("Long", comment="HA Flip Exit")
    if strategy.position_size < 0 and ha_bullish
        strategy.close("Short", comment="HA Flip Exit")

// ──────────────────────────────────────────────────────────────────────────────
// VISUAL MARKERS
// ──────────────────────────────────────────────────────────────────────────────

// Entry signals
plotshape(long_signal, title="Long Signal", style=shape.labelup, location=location.belowbar, color=color.green, text="Long", textcolor=color.white, size=size.small)
plotshape(short_signal, title="Short Signal", style=shape.labeldown, location=location.abovebar, color=color.red, text="Short", textcolor=color.white, size=size.small)

// Background color for session
bgcolor(in_session ? color.new(color.blue, 95) : na, title="Session Background")

// ──────────────────────────────────────────────────────────────────────────────
// BACKTEST PERFORMANCE DASHBOARD
// ──────────────────────────────────────────────────────────────────────────────

if show_dashboard and barstate.islast
    // ── Calculate backtest stats ──
    total_trades   = strategy.closedtrades
    total_wins     = strategy.wintrades
    total_losses   = strategy.losstrades
    win_rate       = total_trades > 0 ? (total_wins / total_trades) * 100 : 0.0
    net_profit     = strategy.netprofit
    net_profit_pct = strategy.netprofit_percent
    gross_profit   = strategy.grossprofit
    gross_loss     = strategy.grossloss
    profit_factor  = gross_loss != 0 ? math.abs(gross_profit / gross_loss) : 0.0
    max_dd         = strategy.max_drawdown
    max_dd_pct     = strategy.max_drawdown_percent

    // Average win & loss
    float avg_win  = 0.0
    float avg_loss = 0.0
    float sum_win  = 0.0
    float sum_loss = 0.0
    int win_count  = 0
    int loss_count = 0

    if total_trades > 0
        for i = 0 to total_trades - 1
            pnl = strategy.closedtrades.profit(i)
            if pnl > 0
                sum_win  += pnl
                win_count += 1
            else if pnl < 0
                sum_loss += pnl
                loss_count += 1
        avg_win  := win_count > 0 ? sum_win / win_count : 0.0
        avg_loss := loss_count > 0 ? sum_loss / loss_count : 0.0

    avg_rr = avg_loss != 0 ? math.abs(avg_win / avg_loss) : 0.0

    // Long vs Short breakdown
    int long_wins   = 0
    int long_losses = 0
    int short_wins  = 0
    int short_losses = 0

    if total_trades > 0
        for i = 0 to total_trades - 1
            is_long = strategy.closedtrades.size(i) > 0
            is_win  = strategy.closedtrades.profit(i) > 0
            if is_long
                if is_win
                    long_wins += 1
                else
                    long_losses += 1
            else
                if is_win
                    short_wins += 1
                else
                    short_losses += 1

    total_longs  = long_wins + long_losses
    total_shorts = short_wins + short_losses
    long_wr  = total_longs > 0 ? (long_wins / total_longs) * 100 : 0.0
    short_wr = total_shorts > 0 ? (short_wins / total_shorts) * 100 : 0.0

    // ── Color helpers ──
    wr_color = win_rate >= 60 ? color.green : win_rate >= 50 ? color.yellow : color.red
    pf_color = profit_factor >= 1.5 ? color.green : profit_factor >= 1.0 ? color.yellow : color.red
    pnl_color = net_profit >= 0 ? color.green : color.red

    // ── Build dashboard table ──
    var table dash = table.new(position.top_right, 3, 14, bgcolor=color.new(color.black, 80), border_width=1, border_color=color.gray)

    // Header
    table.cell(dash, 0, 0, "BACKTEST RESULTS", text_color=color.white, text_size=size.normal, text_halign=text.align_left)
    table.cell(dash, 1, 0, "", text_color=color.white, text_size=size.small)
    table.cell(dash, 2, 0, "", text_color=color.white, text_size=size.small)

    // Separator
    table.cell(dash, 0, 1, "─────────────", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 1, "────────", text_color=color.gray, text_size=size.small)
    table.cell(dash, 2, 1, "", text_color=color.gray, text_size=size.small)

    // Overall Stats
    table.cell(dash, 0, 2, "Total Trades", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 2, str.tostring(total_trades), text_color=color.aqua, text_size=size.small)
    table.cell(dash, 2, 2, "", text_size=size.small)

    table.cell(dash, 0, 3, "WIN RATE", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 3, str.tostring(win_rate, "#.1") + "%", text_color=wr_color, text_size=size.normal)
    table.cell(dash, 2, 3, str.tostring(total_wins) + "W / " + str.tostring(total_losses) + "L", text_color=color.gray, text_size=size.small)

    table.cell(dash, 0, 4, "Net Profit", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 4, str.tostring(net_profit, "#.2"), text_color=pnl_color, text_size=size.small)
    table.cell(dash, 2, 4, str.tostring(net_profit_pct, "#.1") + "%", text_color=pnl_color, text_size=size.small)

    table.cell(dash, 0, 5, "Profit Factor", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 5, str.tostring(profit_factor, "#.2"), text_color=pf_color, text_size=size.small)
    table.cell(dash, 2, 5, "", text_size=size.small)

    table.cell(dash, 0, 6, "Max Drawdown", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 6, str.tostring(max_dd, "#.2"), text_color=color.red, text_size=size.small)
    table.cell(dash, 2, 6, str.tostring(max_dd_pct, "#.1") + "%", text_color=color.red, text_size=size.small)

    // Separator
    table.cell(dash, 0, 7, "─────────────", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 7, "────────", text_color=color.gray, text_size=size.small)
    table.cell(dash, 2, 7, "", text_color=color.gray, text_size=size.small)

    // Trade Quality
    table.cell(dash, 0, 8, "Avg Win", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 8, str.tostring(avg_win, "#.2"), text_color=color.green, text_size=size.small)
    table.cell(dash, 2, 8, "", text_size=size.small)

    table.cell(dash, 0, 9, "Avg Loss", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 9, str.tostring(avg_loss, "#.2"), text_color=color.red, text_size=size.small)
    table.cell(dash, 2, 9, "", text_size=size.small)

    table.cell(dash, 0, 10, "Avg R:R", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 10, str.tostring(avg_rr, "#.2"), text_color=avg_rr >= 1.0 ? color.green : color.red, text_size=size.small)
    table.cell(dash, 2, 10, "", text_size=size.small)

    // Separator
    table.cell(dash, 0, 11, "─────────────", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 11, "────────", text_color=color.gray, text_size=size.small)
    table.cell(dash, 2, 11, "", text_color=color.gray, text_size=size.small)

    // Long vs Short breakdown
    table.cell(dash, 0, 12, "Long WR", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 12, str.tostring(long_wr, "#.1") + "%", text_color=long_wr >= 60 ? color.green : long_wr >= 50 ? color.yellow : color.red, text_size=size.small)
    table.cell(dash, 2, 12, str.tostring(total_longs) + " trades", text_color=color.gray, text_size=size.small)

    table.cell(dash, 0, 13, "Short WR", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 13, str.tostring(short_wr, "#.1") + "%", text_color=short_wr >= 60 ? color.green : short_wr >= 50 ? color.yellow : color.red, text_size=size.small)
    table.cell(dash, 2, 13, str.tostring(total_shorts) + " trades", text_color=color.gray, text_size=size.small)
