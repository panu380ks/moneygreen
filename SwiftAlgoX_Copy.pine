//@version=6
indicator("Swift Algo X Copy", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=200)
// ============================================================================
// INPUTS
// ============================================================================
string GRP_CORE   = "Core Settings"
string GRP_SIGNAL = "Signal Settings"
string GRP_TP     = "Take Profit / Stop Loss"
string GRP_DASH   = "Dashboard"
string GRP_STYLE  = "Style"
string GRP_TIME   = "Time Filter"
string GRP_FILTER = "Signal Quality Filters"
// Core — optimized for 1H chart
sensitivity   = input.timeframe("D",   "Indicator Sensitivity",          group=GRP_CORE, tooltip="Higher timeframe for trend context. 1H->1D recommended")
multiplier    = input.float(1.5,       "Multiplier",        minval=0.1, step=0.5, group=GRP_CORE)
period        = input.int(2,           "Period",            minval=1,              group=GRP_CORE)
atrLength     = input.int(14,          "ATR Length",        minval=1,              group=GRP_CORE)
volDriftLen   = input.int(3,           "Volume Drift Length",minval=1,             group=GRP_CORE)
lookback      = input.int(200,         "Lookback Bars",     minval=50,             group=GRP_CORE)
mtfTimeframe  = input.timeframe("240", "MTF Timeframe",                            group=GRP_CORE)
volThreshold  = input.int(15000,       "Volume Threshold",  minval=100,            group=GRP_CORE)
// Signal
showBuy       = input.bool(true, "Show Buy Signals",     group=GRP_SIGNAL)
showSell      = input.bool(true, "Show Sell Signals",    group=GRP_SIGNAL)
showTP        = input.bool(true, "Show Take Profit",     group=GRP_SIGNAL)
showSL        = input.bool(true, "Show Stop Loss Lines", group=GRP_SIGNAL)
labelSize     = input.string("Small", "Label Size", options=["Tiny","Small","Normal","Large"], group=GRP_SIGNAL)
// TP / SL
tpMultiplier  = input.float(3.0, "TP ATR Multiplier", minval=0.5, step=0.5, group=GRP_TP)
slMultiplier  = input.float(1.0, "SL ATR Multiplier", minval=0.5, step=0.5, group=GRP_TP)
useTrailStop  = input.bool(true, "Use Trailing Stop",                       group=GRP_TP, tooltip="Trail stop loss behind price as trade moves in your favor")
trailATRMult  = input.float(1.5, "Trail ATR Multiplier", minval=0.5, step=0.5, group=GRP_TP)
// Time Filter
useTimeFilter  = input.bool(true,   "Enable Time Filter",       group=GRP_TIME, tooltip="Only allow new signals after the start time")
startHour      = input.int(8,       "Start Hour (0-23)",        minval=0, maxval=23, group=GRP_TIME)
startMinute    = input.int(30,      "Start Minute (0-59)",      minval=0, maxval=59, group=GRP_TIME)
timeZone       = input.string("America/New_York", "Time Zone",  group=GRP_TIME, options=["America/New_York","America/Chicago","America/Denver","America/Los_Angeles","UTC","Europe/London","Europe/Berlin","Asia/Tokyo","Asia/Hong_Kong","Asia/Kolkata"])
// Signal Quality Filters
useHTFFilter   = input.bool(true,  "Require HTF Trend Alignment",  group=GRP_FILTER, tooltip="Only buy when daily trend is bullish, only sell when bearish")
useVolFilter   = input.bool(true,  "Require Volume Confirmation",  group=GRP_FILTER, tooltip="Signal bar volume must be above average")
volAvgLen      = input.int(20,     "Volume Average Length",         minval=5,  group=GRP_FILTER)
volMultReq     = input.float(1.0,  "Min Volume Multiple",          minval=0.5, step=0.1, group=GRP_FILTER, tooltip="Signal bar volume must be >= this x average volume")
useRSIFilter   = input.bool(true,  "Use RSI Confirmation",         group=GRP_FILTER, tooltip="Avoid buying overbought / selling oversold")
rsiLen         = input.int(14,     "RSI Length",                    minval=5,  group=GRP_FILTER)
rsiOB          = input.int(70,     "RSI Overbought",               minval=60, maxval=90, group=GRP_FILTER)
rsiOS          = input.int(30,     "RSI Oversold",                  minval=10, maxval=40, group=GRP_FILTER)
useConsolFilter = input.bool(true, "Skip Consolidation Signals",   group=GRP_FILTER, tooltip="No signals when price is in a tight range")
consolATR      = input.float(0.5,  "Consolidation Threshold (x ATR)", minval=0.1, step=0.1, group=GRP_FILTER)
consolBars     = input.int(10,     "Consolidation Lookback Bars",  minval=3, group=GRP_FILTER)
cooldownBars   = input.int(3,      "Min Bars Between Signals",     minval=1, group=GRP_FILTER, tooltip="Prevent rapid signal clustering")
candleBodyPct  = input.float(40.0, "Min Candle Body % of Range",   minval=10.0, maxval=90.0, step=5.0, group=GRP_FILTER, tooltip="Reject weak doji-like candles. Higher = require more conviction")
// Dashboard
showDashboard  = input.bool(true, "Show Trend Dashboard", group=GRP_DASH)
showBacktest   = input.bool(true, "Show Backtest Panel",  group=GRP_DASH)
// ============================================================================
// TIME FILTER
// ============================================================================
currentHour   = hour(time, timeZone)
currentMinute = minute(time, timeZone)
timeInMinutes = currentHour * 60 + currentMinute
startInMinutes = startHour * 60 + startMinute
isTradingTime = not useTimeFilter or (timeInMinutes >= startInMinutes)
// ============================================================================
// HELPER: LABEL SIZE
// ============================================================================
lblSize = switch labelSize
    "Tiny"   => size.tiny
    "Small"  => size.small
    "Normal" => size.normal
    "Large"  => size.large
// ============================================================================
// VOLUME-DRIFT MODEL
// ============================================================================
volUp   = volume * (close > open ? 1 : close < open ? 0 : 0.5)
volDown = volume * (close < open ? 1 : close > open ? 0 : 0.5)
netPressure = volUp - volDown
cumPressure = math.sum(netPressure, volDriftLen > 1 ? volDriftLen : 1)
pressEmaFast = ta.ema(cumPressure, 3)
pressEmaSlow = ta.ema(cumPressure, 8)
pressSpread  = pressEmaFast - pressEmaSlow
pressStdev   = ta.stdev(pressSpread, 20)
normPressure = pressStdev != 0 ? pressSpread / pressStdev : 0
atr          = ta.atr(math.max(atrLength, 1))
drift        = normPressure * atr * 0.5
projHigh = high + drift
projLow  = low  + drift
// ============================================================================
// ADAPTIVE TRAILING BANDS
// ============================================================================
basis       = math.avg(projHigh, projLow)
bandOffset  = atr * multiplier
upperBand   = basis + bandOffset
lowerBand   = basis - bandOffset
var float trailUpper = na
var float trailLower = na
var int   direction  = 1
trailUpper := na(trailUpper[1]) ? upperBand : upperBand < trailUpper[1] or close[1] > trailUpper[1] ? upperBand : trailUpper[1]
trailLower := na(trailLower[1]) ? lowerBand : lowerBand > trailLower[1] or close[1] < trailLower[1] ? lowerBand : trailLower[1]
direction := na(direction[1]) ? 1 : direction[1] == -1 and close > trailUpper[1] ? 1 : direction[1] == 1 and close < trailLower[1] ? -1 : direction[1]
trailLine = direction == 1 ? trailLower : trailUpper
// ============================================================================
// HIGHER-TIMEFRAME TREND FILTER (now actually used!)
// ============================================================================
htfClose    = request.security(syminfo.tickerid, sensitivity, close)
htfEma      = request.security(syminfo.tickerid, sensitivity, ta.ema(close, 21))
htfBullish  = htfClose > htfEma
htfBearish  = htfClose < htfEma
// ============================================================================
// RSI
// ============================================================================
rsi = ta.rsi(close, rsiLen)
// ============================================================================
// VOLUME CONFIRMATION
// ============================================================================
volAvg      = ta.sma(volume, volAvgLen)
volConfirm  = not useVolFilter or (volume >= volAvg * volMultReq)
// ============================================================================
// CONSOLIDATION DETECTION
// ============================================================================
rangeHigh      = ta.highest(high, consolBars)
rangeLow       = ta.lowest(low, consolBars)
priceRange     = rangeHigh - rangeLow
isConsolidating = useConsolFilter and (priceRange < atr * consolATR * consolBars / 3)
// ============================================================================
// SIGNAL COOLDOWN
// ============================================================================
var int lastBuyBar  = 0
var int lastSellBar = 0
buyCooldownOk  = bar_index - lastBuyBar  > cooldownBars
sellCooldownOk = bar_index - lastSellBar > cooldownBars
// ============================================================================
// CANDLE QUALITY CHECK
// ============================================================================
candleRange = high - low
candleBody  = math.abs(close - open)
bodyRatio   = candleRange > 0 ? (candleBody / candleRange) * 100 : 0
strongCandle = bodyRatio >= candleBodyPct
// ============================================================================
// SIGNAL GENERATION — MULTI-CONFIRMATION
// ============================================================================
// Base trigger: candle color transition (same as before)
greenCandle = close > open
redCandle   = close < open
candleTurnedGreen = greenCandle and not greenCandle[1]
candleTurnedRed   = redCandle and not redCandle[1]
// Band direction confirmation (required — no more fallback signals)
bandBullish = direction == 1
bandBearish = direction == -1

// HTF trend alignment
htfBuyOk  = not useHTFFilter or htfBullish
htfSellOk = not useHTFFilter or htfBearish

// RSI confirmation: don't buy overbought, don't sell oversold
rsiBuyOk  = not useRSIFilter or (rsi < rsiOB)
rsiSellOk = not useRSIFilter or (rsi > rsiOS)

// Combined signal: all filters must agree
finalBuy  = candleTurnedGreen and bandBullish  and htfBuyOk  and rsiBuyOk  and volConfirm and strongCandle and not isConsolidating and buyCooldownOk  and isTradingTime
finalSell = candleTurnedRed   and bandBearish  and htfSellOk and rsiSellOk and volConfirm and strongCandle and not isConsolidating and sellCooldownOk and isTradingTime

// Update cooldown on signal fire
if finalBuy
    lastBuyBar := bar_index
if finalSell
    lastSellBar := bar_index
// ============================================================================
// POSITION TRACKING
// ============================================================================
var float longTP  = na
var float longSL  = na
var float shortTP = na
var float shortSL = na
var bool  inLong  = false
var bool  inShort = false
canEnterLong  = finalBuy  and not inLong
canEnterShort = finalSell and not inShort
if useTrailStop and inLong and not na(longSL)
    newTrailSL = close - atr * trailATRMult
    if newTrailSL > longSL
        longSL := newTrailSL
if useTrailStop and inShort and not na(shortSL)
    newTrailSL = close + atr * trailATRMult
    if newTrailSL < shortSL
        shortSL := newTrailSL
longTPHit  = inLong  and not na(longTP)  and high >= longTP
shortTPHit = inShort and not na(shortTP) and low  <= shortTP
longSLHit  = inLong  and not na(longSL)  and low  <= longSL
shortSLHit = inShort and not na(shortSL) and high >= shortSL
if longTPHit or longSLHit
    longTP := na
    longSL := na
    inLong := false
if shortTPHit or shortSLHit
    shortTP := na
    shortSL := na
    inShort := false
if canEnterShort and inLong
    longTP  := na
    longSL  := na
    inLong  := false
if canEnterLong and inShort
    shortTP := na
    shortSL := na
    inShort := false
if canEnterLong
    inLong  := true
    longTP  := close + atr * tpMultiplier
    longSL  := close - atr * slMultiplier
if canEnterShort
    inShort := true
    shortTP := close - atr * tpMultiplier
    shortSL := close + atr * slMultiplier
// ============================================================================
// PLOTTING
// ============================================================================
trailColor = direction == 1 ? color.new(color.aqua, 0) : color.new(color.red, 0)
plot(trailLine, "Trailing Band", color=trailColor, linewidth=2)
plot(showSL and inLong  ? longSL  : na, "Long SL",  color=color.new(color.red, 40),    style=plot.style_linebr, linewidth=1)
plot(showSL and inShort ? shortSL : na, "Short SL", color=color.new(color.red, 40),    style=plot.style_linebr, linewidth=1)
plot(showTP and inLong  ? longTP  : na, "Long TP",  color=color.new(color.green, 40),  style=plot.style_linebr, linewidth=1)
plot(showTP and inShort ? shortTP : na, "Short TP", color=color.new(color.purple, 40), style=plot.style_linebr, linewidth=1)
if showBuy and canEnterLong
    label.new(bar_index, low, "Buy", style=label.style_label_up, color=color.green, textcolor=color.white, size=lblSize)
if showSell and canEnterShort
    label.new(bar_index, high, "Sell", style=label.style_label_down, color=color.red, textcolor=color.white, size=lblSize)
if showTP and longTPHit
    label.new(bar_index, high, "Long TP", style=label.style_label_down, color=color.new(color.blue, 20), textcolor=color.white, size=lblSize)
if showTP and shortTPHit
    label.new(bar_index, low, "Short TP", style=label.style_label_up, color=color.new(color.purple, 20), textcolor=color.white, size=lblSize)
bgcolor(canEnterLong ? color.new(color.green, 88) : canEnterShort ? color.new(color.red, 88) : na)
// ============================================================================
// BACKTESTING ENGINE
// ============================================================================
var int   totalTrades = 0
var int   wins        = 0
var float bestWinPct  = 0.0
var int   tradeDir    = 0
var float entryPrice  = na
if longTPHit and tradeDir == 1
    totalTrades += 1
    wins        += 1
    tradeDir    := 0
    entryPrice  := na
if shortTPHit and tradeDir == -1
    totalTrades += 1
    wins        += 1
    tradeDir    := 0
    entryPrice  := na
if longSLHit and tradeDir == 1
    totalTrades += 1
    tradeDir    := 0
    entryPrice  := na
if shortSLHit and tradeDir == -1
    totalTrades += 1
    tradeDir    := 0
    entryPrice  := na
if canEnterShort and tradeDir == 1
    totalTrades += 1
    if not na(entryPrice) and close > entryPrice
        wins += 1
    tradeDir   := -1
    entryPrice := close
else if canEnterLong and tradeDir == -1
    totalTrades += 1
    if not na(entryPrice) and close < entryPrice
        wins += 1
    tradeDir   := 1
    entryPrice := close
if canEnterLong and tradeDir <= 0 and not (canEnterShort and tradeDir == 1)
    tradeDir   := 1
    entryPrice := close
if canEnterShort and tradeDir >= 0 and not (canEnterLong and tradeDir == -1)
    tradeDir   := -1
    entryPrice := close
currentWinPct = totalTrades > 0 ? (wins / totalTrades) * 100 : 0.0
bestWinPct := math.max(bestWinPct, currentWinPct)
// ============================================================================
// BACKTESTING DASHBOARD (top-right)
// ============================================================================
if showBacktest and barstate.islast
    var table btPanel = table.new(position.top_right, 2, 7, border_width=1)
    table.cell(btPanel, 0, 0, "Backtesting",        bgcolor=color.new(color.gray, 40), text_color=color.white, text_size=size.tiny)
    table.cell(btPanel, 1, 0, "Dashboard",           bgcolor=color.new(color.gray, 40), text_color=color.white, text_size=size.tiny)
    table.cell(btPanel, 0, 1, "Total Trades",        bgcolor=color.new(color.gray, 60), text_color=color.white, text_size=size.tiny)
    table.cell(btPanel, 1, 1, str.tostring(totalTrades), bgcolor=color.new(color.gray, 60), text_color=color.white, text_size=size.tiny)
    table.cell(btPanel, 0, 2, "Wins",                bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(btPanel, 1, 2, str.tostring(wins),    bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(btPanel, 0, 3, "Win %",               bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(btPanel, 1, 3, str.tostring(currentWinPct, "#.##") + "%", bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(btPanel, 0, 4, "Best Win %",          bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(btPanel, 1, 4, str.tostring(bestWinPct, "#.##") + "%",    bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(btPanel, 0, 5, "Multiplier",          bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(btPanel, 1, 5, str.tostring(multiplier),                  bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(btPanel, 0, 6, "Period",              bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(btPanel, 1, 6, str.tostring(period),                      bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
// ============================================================================
// MULTI-TIMEFRAME TREND DASHBOARD (bottom-right)
// ============================================================================
f_trendData(tf) =>
    [reqC, reqH, reqL, reqATR, reqVol] = request.security(syminfo.tickerid, tf, [close, high, low, ta.atr(14), volume])
    reqEMA = request.security(syminfo.tickerid, tf, ta.ema(close, 21))
    trendDir  = reqC > reqEMA ? 1 : -1
    atrRatio  = reqATR / reqC * 100
    strength  = atrRatio > 2.0 ? "High" : atrRatio > 1.0 ? "Medium" : "Low"
    isRanging = (reqH - reqL) < reqATR * 0.5
    [trendDir, strength, isRanging]
if showDashboard and barstate.islast
    var table dash = table.new(position.bottom_right, 5, 10, border_width=1)
    table.cell(dash, 0, 0, "Timeframe", bgcolor=color.new(color.teal, 50),   text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 0, "Trend",     bgcolor=color.new(color.teal, 50),   text_color=color.white, text_size=size.tiny)
    table.cell(dash, 2, 0, "Strength",  bgcolor=color.new(color.orange, 50), text_color=color.white, text_size=size.tiny)
    table.cell(dash, 3, 0, "Ranging",   bgcolor=color.new(color.yellow, 50), text_color=color.white, text_size=size.tiny)
    tfLabels = array.from("1M", "5M", "15M", "30M", "1H", "4H", "1D", "1W")
    tfValues = array.from("1",  "5",  "15",  "30",  "60", "240","D",  "W")
    bullCount = 0
    bearCount = 0
    for i = 0 to 7
        [tDir, str_val, ranging] = f_trendData(array.get(tfValues, i))
        trendClr    = tDir == 1 ? color.new(color.red, 30) : color.new(color.red, 30)
        trendClr2   = tDir == 1 ? color.new(color.green, 30) : color.new(color.red, 30)
        strengthClr = str_val == "High" ? color.new(color.green, 30) : str_val == "Medium" ? color.new(color.orange, 30) : color.new(color.red, 30)
        rangingClr  = ranging ? color.new(color.green, 30) : color.new(color.red, 30)
        if tDir == 1
            bullCount += 1
        else
            bearCount += 1
        table.cell(dash, 0, i + 1, array.get(tfLabels, i), bgcolor=color.new(color.gray, 70),  text_color=color.white, text_size=size.tiny)
        table.cell(dash, 1, i + 1, tDir == 1 ? "▲" : "▼", bgcolor=trendClr2,                    text_color=color.white, text_size=size.tiny)
        table.cell(dash, 2, i + 1, str_val,                 bgcolor=strengthClr,                  text_color=color.white, text_size=size.tiny)
        table.cell(dash, 3, i + 1, ranging ? "●" : "●",     bgcolor=rangingClr,                   text_color=color.white, text_size=size.tiny)
    midCount   = 8 - bullCount - bearCount
    overallClr = bullCount > bearCount ? color.new(color.green, 30) : color.new(color.red, 30)
    table.cell(dash, 0, 9, "Overall", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 9, "(" + str.tostring(bullCount) + "/" + str.tostring(bearCount) + ")", bgcolor=overallClr, text_color=color.white, text_size=size.tiny)
    table.cell(dash, 2, 9, "Mid (" + str.tostring(bullCount) + "/" + str.tostring(bearCount) + "/" + str.tostring(8 - bullCount - bearCount) + ")", bgcolor=color.new(color.orange, 40), text_color=color.white, text_size=size.tiny)
    table.cell(dash, 3, 9, "(" + str.tostring(bullCount) + "/" + str.tostring(bearCount) + ")", bgcolor=overallClr, text_color=color.white, text_size=size.tiny)
// ============================================================================
// ALERTS
// ============================================================================
alertcondition(canEnterLong,  "Buy Signal",       "Swift Algo X — Buy Signal")
alertcondition(canEnterShort, "Sell Signal",       "Swift Algo X — Sell Signal")
alertcondition(longTPHit,   "Long TP Hit",       "Swift Algo X — Long TP Reached")
alertcondition(shortTPHit,  "Short TP Hit",      "Swift Algo X — Short TP Reached")
alertcondition(longSLHit,   "Long SL Hit",       "Swift Algo X — Long Stop Loss Hit")
alertcondition(shortSLHit,  "Short SL Hit",      "Swift Algo X — Short Stop Loss Hit")
