//@version=6
strategy("BB USDJPY", overlay=true, currency=currency.USD, initial_capital=10000)

source = close
length = input.int(20, minval=1)
mult = input.float(1.5, minval=0.001, maxval=50)
direction = input.int(0, title="Strategy Direction", minval=-1, maxval=1)
max_dd = input.float(10.0, title="Max Drawdown %", minval=1.0, maxval=50.0, step=0.5)
riskPct = input.float(1.5, title="Risk Per Trade %", minval=0.5, maxval=5.0, step=0.5)

// Trend filter
trendLen = input.int(200, title="Trend SMA Length", minval=1)
trendSma = ta.sma(source, trendLen)
bullTrend = source > trendSma
bearTrend = source < trendSma

// ATR for stops and position sizing
atrLen = input.int(14, title="ATR Length", minval=1)
atrMult = input.float(1.5, title="ATR SL Multiplier", minval=0.1, step=0.1)
tpMult = input.float(2.0, title="ATR TP Multiplier", minval=0.1, step=0.1)
atrVal = ta.atr(atrLen)

strategy.risk.allow_entry_in(direction == 0 ? strategy.direction.all : (direction < 0 ? strategy.direction.short : strategy.direction.long))
strategy.risk.max_drawdown(value=max_dd, type=strategy.percent_of_equity)

basis = ta.sma(source, length)
dev = mult * ta.stdev(source, length)
upper = basis + dev
lower = basis - dev

// Position sizing
stopDist = atrVal * atrMult
riskAmount = strategy.equity * (riskPct / 100.0)
qty = nz(math.max(math.floor(riskAmount * source / stopDist), 1), 1)

// Entry conditions
longCond = ta.crossover(source, lower) and bullTrend and not na(atrVal)
shortCond = ta.crossunder(source, upper) and bearTrend and not na(atrVal)

if longCond
    strategy.entry("BBandLE", strategy.long, qty=qty)
    strategy.exit("LE Exit", "BBandLE", stop=close - stopDist, limit=close + atrVal * tpMult)

if shortCond
    strategy.entry("BBandSE", strategy.short, qty=qty)
    strategy.exit("SE Exit", "BBandSE", stop=close + stopDist, limit=close - atrVal * tpMult)

plot(trendSma, title="Trend SMA", color=color.orange, linewidth=2)
plot(upper, title="BB Upper", color=color.red)
plot(lower, title="BB Lower", color=color.green)
plot(basis, title="BB Basis", color=color.blue)
