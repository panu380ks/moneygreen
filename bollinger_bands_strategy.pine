//@version=6
strategy("Bollinger Bands Strategy directed", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=5)
source = close
length = input.int(20, minval=1)
mult = input.float(2.0, minval=0.001, maxval=50)
earlyPct = input.float(0.5, title="Early Entry Offset (bands)", minval=0.0, maxval=1.0, step=0.1)
direction = input.int(0, title="Strategy Direction", minval=-1, maxval=1)

// Trend filter
trendLen = input.int(200, title="Trend SMA Length", minval=1)
trendSma = ta.sma(source, trendLen)

// RSI — used as pullback confirmation, NOT extreme levels
rsiLen = input.int(14, title="RSI Length", minval=1)
rsiVal = ta.rsi(source, rsiLen)

// ATR stops, take profit & trailing
atrLen = input.int(14, title="ATR Length", minval=1)
atrSlMult = input.float(1.0, title="ATR SL Multiplier", minval=0.1, step=0.1)
atrTpMult = input.float(3.0, title="ATR TP Multiplier", minval=0.1, step=0.1)
atrTrailMult = input.float(1.5, title="ATR Trail Offset", minval=0.1, step=0.1)
atrVal = ta.atr(atrLen)

// Cooldown
cooldown = input.int(10, title="Min Bars Between Trades", minval=1)
var int lastTradeBar = 0
canTrade = bar_index - lastTradeBar >= cooldown

// ── Equity curve filter — stop trading when equity drops below its own MA ──
equityLen = input.int(50, title="Equity MA Length", minval=5)
equityMa = ta.sma(strategy.equity, equityLen)
equityOk = strategy.equity > equityMa

// ── Max intraday loss — hard circuit breaker ──
strategy.risk.allow_entry_in(direction == 0 ? strategy.direction.all : (direction < 0 ? strategy.direction.short : strategy.direction.long))
strategy.risk.max_intraday_loss(2, strategy.percent_of_equity)

basis = ta.sma(source, length)
dev = mult * ta.stdev(source, length)
upper = basis + dev
lower = basis - dev

// Band width filter — skip when bands are too narrow (chop)
bbWidth = (upper - lower) / basis
bbWidthMa = ta.sma(bbWidth, length)
volOk = bbWidth > bbWidthMa

// Early trigger bands
earlyUpper = upper - earlyPct * dev
earlyLower = lower + earlyPct * dev

// ── Entry logic ──
// Long: price pulls back to lower band region IN an uptrend (above 200 SMA)
//       RSI < 50 confirms pullback without requiring extreme oversold
// Short: price rallies to upper band region IN a downtrend (below 200 SMA)
//        RSI > 50 confirms rally without requiring extreme overbought
longCond  = ta.crossover(source, earlyLower) and source > trendSma and rsiVal < 50 and canTrade and volOk and equityOk
shortCond = ta.crossunder(source, earlyUpper) and source < trendSma and rsiVal > 50 and canTrade and volOk and equityOk

if longCond
    strategy.entry("BBandLE", strategy.long, comment="BBandLE")
    lastTradeBar := bar_index
else
    strategy.cancel(id="BBandLE")

if shortCond
    strategy.entry("BBandSE", strategy.short, comment="BBandSE")
    lastTradeBar := bar_index
else
    strategy.cancel(id="BBandSE")

// ── Exits: tight stop + wide target + trailing stop ──
if strategy.position_size > 0
    sl = strategy.position_avg_price - atrVal * atrSlMult
    tp = strategy.position_avg_price + atrVal * atrTpMult
    strategy.exit("LE Exit", "BBandLE", stop=sl, limit=tp, trail_points=atrVal * atrTrailMult / syminfo.mintick, trail_offset=atrVal * atrTrailMult / syminfo.mintick)

if strategy.position_size < 0
    sl = strategy.position_avg_price + atrVal * atrSlMult
    tp = strategy.position_avg_price - atrVal * atrTpMult
    strategy.exit("SE Exit", "BBandSE", stop=sl, limit=tp, trail_points=atrVal * atrTrailMult / syminfo.mintick, trail_offset=atrVal * atrTrailMult / syminfo.mintick)

// ── Plots ──
plot(upper, title="BB Upper", color=color.red)
plot(lower, title="BB Lower", color=color.green)
plot(basis, title="BB Basis", color=color.blue)
plot(earlyUpper, title="Early Upper", color=color.new(color.red, 60), style=plot.style_circles)
plot(earlyLower, title="Early Lower", color=color.new(color.green, 60), style=plot.style_circles)
plot(trendSma, title="Trend SMA", color=color.orange, linewidth=2)
