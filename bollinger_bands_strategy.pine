//@version=6
strategy("Bollinger Bands Strategy directed", overlay=true)

source = close
length = input.int(20, minval=1)
mult = input.float(1.5, minval=0.001, maxval=50)
direction = input.int(0, title="Strategy Direction", minval=-1, maxval=1)
max_dd = input.float(2.0, title="Max Drawdown %", minval=1.0, maxval=2.0, step=0.1)

// Trend filter
trendLen = input.int(200, title="Trend SMA Length", minval=1)
trendSma = ta.sma(source, trendLen)
bullTrend = source > trendSma
bearTrend = source < trendSma

// ATR exit
atrLen = input.int(14, title="ATR Length", minval=1)
atrMult = input.float(1.5, title="ATR Multiplier", minval=0.1, step=0.1)
atrVal = ta.atr(atrLen)

strategy.risk.allow_entry_in(direction == 0 ? strategy.direction.all : (direction < 0 ? strategy.direction.short : strategy.direction.long))
strategy.risk.max_drawdown(value=max_dd, type=strategy.percent_of_equity)

basis = ta.sma(source, length)
dev = mult * ta.stdev(source, length)
upper = basis + dev
lower = basis - dev

if (ta.crossover(source, lower)) and bullTrend
    strategy.entry("BBandLE", strategy.long, stop=lower, oca_name="BollingerBands", oca_type=strategy.oca.cancel, comment="BBandLE")
else
    strategy.cancel(id="BBandLE")

if (ta.crossunder(source, upper)) and bearTrend
    strategy.entry("BBandSE", strategy.short, stop=upper, oca_name="BollingerBands", oca_type=strategy.oca.cancel, comment="BBandSE")
else
    strategy.cancel(id="BBandSE")

// ATR-based exits
if strategy.position_size > 0
    strategy.exit("LE Exit", "BBandLE", stop=close - atrVal * atrMult, limit=close + atrVal * atrMult)
if strategy.position_size < 0
    strategy.exit("SE Exit", "BBandSE", stop=close + atrVal * atrMult, limit=close - atrVal * atrMult)

plot(trendSma, title="Trend SMA", color=color.orange, linewidth=2)
//plot(strategy.equity, title="equity", color=color.red, linewidth=2, style=plot.style_areabr)
