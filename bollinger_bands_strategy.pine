//@version=6
strategy("BB USDJPY + Cipher B", overlay=true, currency=currency.USD, initial_capital=20, margin_long=1, margin_short=1, default_qty_type=strategy.fixed, default_qty_value=100, commission_type=strategy.commission.cash_per_order, commission_value=0)

source = close
length = input.int(20, minval=1)
mult = input.float(1.5, minval=0.001, maxval=50)
direction = input.int(0, title="Strategy Direction", minval=-1, maxval=1)
max_dd = input.float(10.0, title="Max Drawdown %", minval=1.0, maxval=50.0, step=0.5)
riskPct = input.float(1.5, title="Risk Per Trade %", minval=0.5, maxval=5.0, step=0.5)

// Trend filter
trendLen = input.int(200, title="Trend SMA Length", minval=1)
trendSma = ta.sma(source, trendLen)
bullTrend = source > trendSma
bearTrend = source < trendSma

// ATR for stops and position sizing
atrLen = input.int(14, title="ATR Length", minval=1)
atrMult = input.float(1.5, title="ATR SL Multiplier", minval=0.1, step=0.1)
tpMult = input.float(2.0, title="ATR TP Multiplier", minval=0.1, step=0.1)
atrVal = ta.atr(atrLen)

strategy.risk.allow_entry_in(direction == 0 ? strategy.direction.all : (direction < 0 ? strategy.direction.short : strategy.direction.long))
strategy.risk.max_drawdown(value=max_dd, type=strategy.percent_of_equity)

basis = ta.sma(source, length)
dev = mult * ta.stdev(source, length)
upper = basis + dev
lower = basis - dev

// Position sizing: risk riskPct% of equity per trade based on ATR stop distance
stopDist = atrVal * atrMult
riskAmount = strategy.equity * (riskPct / 100.0)
qtyRaw = riskAmount * source / stopDist
qty = na(qtyRaw) ? 100 : int(math.max(math.floor(qtyRaw), 1))

// Entry conditions
longCond = ta.crossover(source, lower) and bullTrend and not na(atrVal)
shortCond = ta.crossunder(source, upper) and bearTrend and not na(atrVal)

if longCond
    strategy.entry("BBandLE", strategy.long, qty=qty)

if shortCond
    strategy.entry("BBandSE", strategy.short, qty=qty)

// Exits — anchored to fill price, updated each bar
if strategy.position_size > 0
    strategy.exit("LE Exit", "BBandLE", stop=strategy.position_avg_price - stopDist, limit=strategy.position_avg_price + atrVal * tpMult)

if strategy.position_size < 0
    strategy.exit("SE Exit", "BBandSE", stop=strategy.position_avg_price + stopDist, limit=strategy.position_avg_price - atrVal * tpMult)

// BB + Trend plots (price overlay)
plot(trendSma, title="Trend SMA", color=color.orange, linewidth=2)
plot(upper, title="BB Upper", color=color.red)
plot(lower, title="BB Lower", color=color.green)
plot(basis, title="BB Basis", color=color.blue)

// ═══════════════════════════════════════════════════
// Market Cipher B — separate pane
// ═══════════════════════════════════════════════════
n1 = input.int(10, "Channel Length")
n2 = input.int(21, "Average Length")
obLevel1 = input.int(60, "Over Bought Level 1")
obLevel2 = input.int(53, "Over Bought Level 2")
osLevel1 = input.int(-60, "Over Sold Level 1")
osLevel2 = input.int(-53, "Over Sold Level 2")

ap = hlc3
esa = ta.ema(ap, n1)
d = ta.ema(math.abs(ap - esa), n1)
ci = (ap - esa) / (0.015 * d)
tci = ta.ema(ci, n2)

wt1 = tci
wt2 = ta.sma(wt1, 4)

plot(0, color=color.gray, force_overlay=false, title="Zero")
plot(obLevel1, color=color.red, force_overlay=false, title="OB1")
plot(osLevel1, color=color.green, force_overlay=false, title="OS1")
plot(obLevel2, color=color.red, force_overlay=false, title="OB2")
plot(osLevel2, color=color.green, force_overlay=false, title="OS2")
plot(wt1, style=plot.style_area, color=color.new(#2196F3, 10), force_overlay=false, title="WT1")
plot(wt2, style=plot.style_area, color=color.new(color.blue, 10), force_overlay=false, title="WT2")
plot(wt1 - wt2, color=color.yellow, style=plot.style_area, force_overlay=false, title="WT Diff")
plot(ta.cross(wt1, wt2) ? wt2 : na, color=color.black, style=plot.style_line, linewidth=5, force_overlay=false, title="Cross BG")
plot(ta.cross(wt1, wt2) ? wt2 : na, color=(wt2 - wt1 > 0 ? color.red : color.lime), style=plot.style_circles, linewidth=6, force_overlay=false, title="Cross Signal")
