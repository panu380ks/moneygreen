//@version=6
strategy("Bollinger Bands Strategy directed", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=35)

source = close
length = input.int(20, minval=1)
mult = input.float(2.0, minval=0.001, maxval=50)
direction = input.int(0, title = "Strategy Direction", minval=-1, maxval=1)

// Trend filter length
trendLen = input.int(30, title="Trend MA Length", minval=1)

// RSI filter
rsiLen = input.int(14, title="RSI Length")
rsiOB = input.int(65, title="RSI Overbought", minval=50, maxval=90)
rsiOS = input.int(35, title="RSI Oversold", minval=10, maxval=50)

// Risk management inputs
atrLen = input.int(14, title="ATR Length")
slMult = input.float(1.2, title="Stop Loss ATR Mult", minval=0.1)
tpMult = input.float(2.5, title="Take Profit ATR Mult", minval=0.1)
useTrailing = input.bool(true, title="Use Trailing Stop")
trailMult = input.float(1.5, title="Trailing Stop ATR Mult", minval=0.1)

// Max consecutive losses before cooldown
maxConsecLoss = input.int(3, title="Max Consecutive Losses", minval=1)
cooldownBars = input.int(5, title="Cooldown Bars After Max Losses", minval=1)

strategy.risk.allow_entry_in(direction == 0 ? strategy.direction.all : (direction < 0 ? strategy.direction.short : strategy.direction.long))

// Bollinger Bands
basis = ta.sma(source, length)
dev = mult * ta.stdev(source, length)
upper = basis + dev
lower = basis - dev

// Trend filter — 30 SMA
trendMA = ta.sma(source, trendLen)
upTrend = source > trendMA
downTrend = source < trendMA

// RSI filter — don't buy overbought, don't sell oversold
rsi = ta.rsi(source, rsiLen)
rsiLongOK = rsi < rsiOB
rsiShortOK = rsi > rsiOS

// ATR for dynamic stop loss / take profit
atr = ta.atr(atrLen)

// Consecutive loss tracking
var int consecLosses = 0
var int barsSinceCooldown = 0

if strategy.closedtrades > 0
    lastProfit = strategy.closedtrades.profit(strategy.closedtrades - 1)
    if lastProfit < 0 and ta.change(strategy.closedtrades) == 1
        consecLosses := consecLosses + 1
        if consecLosses >= maxConsecLoss
            barsSinceCooldown := 0
    else if lastProfit >= 0 and ta.change(strategy.closedtrades) == 1
        consecLosses := 0

barsSinceCooldown := barsSinceCooldown + 1
cooldownActive = consecLosses >= maxConsecLoss and barsSinceCooldown <= cooldownBars

// Trend filter: only buy above MA, only sell below MA
aboveMA = source > basis and upTrend
belowMA = source < basis and downTrend

// Band width filter — softened threshold to allow more trades
bbWidth = (upper - lower) / basis
bbWidthMA = ta.sma(bbWidth, length)
expanding = bbWidth > bbWidthMA * 0.8

// Entry 1: BB crossover signals (original)
longCross = ta.crossover(source, lower)
shortCross = ta.crossunder(source, upper)

// Entry 2: Basis bounce — price pulls back to basis and bounces with trend
longBounce = ta.crossover(source, basis) and upTrend and source > lower
shortBounce = ta.crossunder(source, basis) and downTrend and source < upper

// Entry 3: Re-entry — price comes back above lower band after dipping below, in uptrend
longReentry = source > lower and source[1] <= lower and upTrend and source > basis * 0.995
shortReentry = source < upper and source[1] >= upper and downTrend and source < basis * 1.005

// Combined signals with RSI filter and cooldown
longSignal = ((longCross and aboveMA and expanding) or (longBounce and expanding) or (longReentry and expanding)) and rsiLongOK and not cooldownActive
shortSignal = ((shortCross and belowMA and expanding) or (shortBounce and expanding) or (shortReentry and expanding)) and rsiShortOK and not cooldownActive

// Only enter if not already in a position in the same direction
if longSignal and strategy.position_size <= 0
    strategy.entry("BBandLE", strategy.long, comment="BBandLE")

if shortSignal and strategy.position_size >= 0
    strategy.entry("BBandSE", strategy.short, comment="BBandSE")

// Dynamic exits based on ATR
if strategy.position_size > 0
    slPrice = strategy.position_avg_price - atr * slMult
    tpPrice = strategy.position_avg_price + atr * tpMult
    if useTrailing
        strategy.exit("Long Exit", "BBandLE", stop=slPrice, limit=tpPrice, trail_points=atr * trailMult / syminfo.mintick, trail_offset=atr * trailMult / syminfo.mintick)
    else
        strategy.exit("Long Exit", "BBandLE", stop=slPrice, limit=tpPrice)

if strategy.position_size < 0
    slPrice = strategy.position_avg_price + atr * slMult
    tpPrice = strategy.position_avg_price - atr * tpMult
    if useTrailing
        strategy.exit("Short Exit", "BBandSE", stop=slPrice, limit=tpPrice, trail_points=atr * trailMult / syminfo.mintick, trail_offset=atr * trailMult / syminfo.mintick)
    else
        strategy.exit("Short Exit", "BBandSE", stop=slPrice, limit=tpPrice)

plot(basis, "Basis", color=color.orange)
plot(upper, "Upper", color=color.blue)
plot(lower, "Lower", color=color.blue)
plot(trendMA, "Trend MA", color=color.purple, linewidth=2)
