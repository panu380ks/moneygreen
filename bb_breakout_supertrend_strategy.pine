//@version=6
strategy("BB + Breakout + Supertrend", shorttitle="BB+BO+ST", overlay=true,
     process_orders_on_close=true, initial_capital=100000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     currency=currency.USD, pyramiding=0,
     commission_type=strategy.commission.percent, commission_value=0.05, slippage=1)

// ══════════════════════════════════════════════════════════════════════════════
// STRATEGY OVERVIEW
// ══════════════════════════════════════════════════════════════════════════════
//
// Three entry modes in one strategy -- pick the style that fits your market:
//
//   1. BREAKOUT     — HH/LL breakout with safety guard (trend-following)
//   2. MEAN REVERT  — Bollinger Band bounce (mean-reversion)
//   3. SQUEEZE      — BB squeeze + HH/LL breakout (compression → explosion)
//
// All modes share:
//   • Supertrend as the macro trend filter (only long in uptrend, short in downtrend)
//   • ATR-based SL/TP with configurable R:R and optional trailing stop
//   • NY Session filter, volume filter, cooldown between trades
//   • Full backtest dashboard
//
// ══════════════════════════════════════════════════════════════════════════════


// ──────────────────────────────────────────────────────────────────────────────
// INPUTS
// ──────────────────────────────────────────────────────────────────────────────

// ── Entry Mode ──
mode_group  = "== Entry Mode =="
entry_mode  = input.string("Squeeze", "Entry Mode",
     options=["Breakout", "Mean Revert", "Squeeze"],
     group=mode_group,
     tooltip="Breakout = HH/LL breakout (momentum)\nMean Revert = BB bounce (reversion)\nSqueeze = BB squeeze + breakout (compression → explosion)")

// ── Direction ──
dir_group     = "== Direction =="
allow_longs   = input.bool(true,  "Allow Long Entries",  group=dir_group)
allow_shorts  = input.bool(true,  "Allow Short Entries", group=dir_group)

// ── Bollinger Bands ──
bb_group    = "== Bollinger Bands =="
bb_len      = input.int(20,    "BB Length",     minval=5,     maxval=100,  group=bb_group)
bb_mult     = input.float(2.0, "BB Multiplier", minval=0.5,   maxval=5.0, step=0.1, group=bb_group)
sq_thresh   = input.float(0.04, "Squeeze Threshold (bandwidth %)", minval=0.005, maxval=0.20, step=0.005,
     group=bb_group,
     tooltip="Bandwidth below this = squeeze. Lower = tighter squeeze required. 0.04 = 4% of basis")

// ── Breakout Detection ──
bo_group    = "== Breakout Detection =="
lookback    = input.int(41, "Lookback Period", minval=5, maxval=200, group=bo_group,
     tooltip="Bars to find the highest high / lowest low")
guard_len   = input.int(10, "Guard Length",    minval=2, maxval=100, group=bo_group,
     tooltip="Secondary lookback to confirm breakout is genuine")
guard_delay = input.int(1,  "Guard Delay",     minval=1, maxval=10,  group=bo_group)

// ── Supertrend Filter ──
st_group    = "== Supertrend Filter =="
use_st      = input.bool(true,  "Use Supertrend Filter", group=st_group)
st_atr_len  = input.int(10,    "ATR Length",  minval=1, group=st_group)
st_factor   = input.float(3.0, "Factor",      minval=0.01, step=0.01, group=st_group)
use_st_exit = input.bool(true,  "Exit on Supertrend Flip", group=st_group)

// ── Risk Management ──
risk_group     = "== Risk Management =="
atr_length     = input.int(14,    "ATR Length (for SL/TP)", minval=1,   maxval=50,   group=risk_group)
sl_atr_mult    = input.float(1.5, "Stop Loss (ATR x)",     minval=0.5, maxval=5.0,  step=0.1, group=risk_group)
tp_atr_mult    = input.float(4.5, "Take Profit (ATR x)",   minval=1.0, maxval=15.0, step=0.5, group=risk_group,
     tooltip="Default 4.5 = 1:3 R:R with 1.5 SL. Adjust for your style")
use_trail      = input.bool(true,  "Use Trailing Stop",    group=risk_group)
trail_atr_mult = input.float(2.0,  "Trail Offset (ATR x)", minval=0.5, maxval=5.0, step=0.1, group=risk_group)

// ── Volume Filter ──
vol_group    = "== Volume Filter =="
vol_filter   = input.bool(true,  "Require Above-Avg Volume", group=vol_group)
vol_len      = input.int(20,    "Volume MA Length",          minval=5, maxval=100, group=vol_group)
vol_thresh   = input.float(1.2, "Volume Threshold (x avg)", minval=1.0, maxval=3.0, step=0.1, group=vol_group)

// ── Cooldown ──
cool_group     = "== Cooldown =="
cooldown_bars  = input.int(5, "Min Bars Between Trades", minval=1, maxval=50, group=cool_group)

// ── Session Filter ──
sess_group  = "== Session Filter =="
use_session = input.bool(true,   "NY Session Only", group=sess_group)
ny_session  = input.session("0930-1600", "NY Session (ET)", group=sess_group)
close_eod   = input.bool(true,  "Close Positions at Session End", group=sess_group)

// ── Date Filter ──
date_group  = "== Date Filter =="
use_date    = input.bool(false, "Use Date Filter", group=date_group)
start_date  = input.time(timestamp("2024-01-01"), "Start Date", group=date_group)
end_date    = input.time(timestamp("2026-12-31"), "End Date",   group=date_group)

// ── Dashboard ──
dash_group     = "== Dashboard =="
show_dashboard = input.bool(true, "Show Backtest Dashboard", group=dash_group)


// ──────────────────────────────────────────────────────────────────────────────
// CALCULATIONS
// ──────────────────────────────────────────────────────────────────────────────

// ── Bollinger Bands ──
basis     = ta.sma(close, bb_len)
dev       = bb_mult * ta.stdev(close, bb_len)
bb_upper  = basis + dev
bb_lower  = basis - dev
bandwidth = (bb_upper - bb_lower) / basis   // normalized bandwidth

// BB signals
bb_cross_up   = ta.crossover(close, bb_lower)    // bounce off lower band → long
bb_cross_down = ta.crossunder(close, bb_upper)    // reject from upper band → short

// BB squeeze detection
in_squeeze     = bandwidth < sq_thresh
was_in_squeeze = in_squeeze[1] and not in_squeeze  // squeeze just released

// ── Breakout Detection (HH/LL) ──
hi       = ta.highest(high, lookback)
lo       = ta.lowest(low, lookback)
hi_guard = ta.highest(high, guard_len)
lo_guard = ta.lowest(low, guard_len)

breakout_up   = close > hi[1]
breakout_down = close < lo[1]

guard_long  = breakout_up  and hi[1] > hi_guard[guard_delay]
guard_short = breakout_down and lo[1] < lo_guard[guard_delay]

// ── Supertrend ──
[supertrend, st_direction] = ta.supertrend(st_factor, st_atr_len)
st_uptrend   = st_direction < 0
st_downtrend = st_direction > 0
st_flip_up   = st_direction < 0 and st_direction[1] > 0
st_flip_down = st_direction > 0 and st_direction[1] < 0

st_long_ok   = not use_st or st_uptrend
st_short_ok  = not use_st or st_downtrend

// ── ATR for risk management ──
atr_val = ta.atr(atr_length)

// ── Volume ──
avg_vol = ta.sma(volume, vol_len)
vol_ok  = not vol_filter or (volume >= avg_vol * vol_thresh)

// ── Cooldown ──
var int last_entry_bar = 0
bars_since_entry = bar_index - last_entry_bar
cooldown_ok      = bars_since_entry >= cooldown_bars

// ── Filters ──
in_date       = not use_date or (time >= start_date and time <= end_date)
in_ny_session = not use_session or not na(time(timeframe.period, ny_session, "America/New_York"))
all_filters   = in_date and in_ny_session and vol_ok and cooldown_ok


// ──────────────────────────────────────────────────────────────────────────────
// ENTRY SIGNALS (mode-dependent)
// ──────────────────────────────────────────────────────────────────────────────

// ── Mode 1: Breakout ──
// Pure HH/LL breakout with safety guard + Supertrend trend filter
bo_long  = entry_mode == "Breakout" and guard_long  and st_long_ok
bo_short = entry_mode == "Breakout" and guard_short and st_short_ok

// ── Mode 2: Mean Revert ──
// BB bounce in the direction of Supertrend -- buy dips in uptrend, sell rips in downtrend
mr_long  = entry_mode == "Mean Revert" and bb_cross_up   and st_long_ok
mr_short = entry_mode == "Mean Revert" and bb_cross_down and st_short_ok

// ── Mode 3: Squeeze ──
// BB was squeezed + bands expanding + HH/LL breakout confirms direction
// This is the highest-conviction signal: compression → explosion + structural confirmation
sq_long  = entry_mode == "Squeeze" and was_in_squeeze and breakout_up   and st_long_ok
sq_short = entry_mode == "Squeeze" and was_in_squeeze and breakout_down and st_short_ok

// Also allow squeeze mode entries on strong guarded breakouts during a squeeze release
// (squeeze released within last 3 bars + guarded breakout)
recent_squeeze = in_squeeze[1] or in_squeeze[2] or in_squeeze[3]
sq_long  := sq_long  or (entry_mode == "Squeeze" and guard_long  and recent_squeeze and st_long_ok)
sq_short := sq_short or (entry_mode == "Squeeze" and guard_short and recent_squeeze and st_short_ok)

// ── Final entry signals ──
long_entry  = allow_longs  and (bo_long  or mr_long  or sq_long)  and all_filters
short_entry = allow_shorts and (bo_short or mr_short or sq_short) and all_filters


// ──────────────────────────────────────────────────────────────────────────────
// EXIT SIGNALS
// ──────────────────────────────────────────────────────────────────────────────

// Structural exit -- opposite breakout or Supertrend flip
exit_long  = breakout_down or (use_st_exit and use_st and st_flip_down)
exit_short = breakout_up   or (use_st_exit and use_st and st_flip_up)

// Session end exit
session_end = use_session and close_eod and not in_ny_session and in_ny_session[1]


// ──────────────────────────────────────────────────────────────────────────────
// STRATEGY EXECUTION
// ──────────────────────────────────────────────────────────────────────────────

// ── Long Entry ──
if long_entry
    strategy.entry("Long", strategy.long)
    last_entry_bar := bar_index
    long_sl = close - atr_val * sl_atr_mult
    long_tp = close + atr_val * tp_atr_mult
    if use_trail
        trail_pts = atr_val * trail_atr_mult / syminfo.mintick
        strategy.exit("Long Exit", "Long", stop=long_sl, limit=long_tp,
             trail_points=trail_pts, trail_offset=trail_pts)
    else
        strategy.exit("Long Exit", "Long", stop=long_sl, limit=long_tp)

// ── Short Entry ──
if short_entry
    strategy.entry("Short", strategy.short)
    last_entry_bar := bar_index
    short_sl = close + atr_val * sl_atr_mult
    short_tp = close - atr_val * tp_atr_mult
    if use_trail
        trail_pts = atr_val * trail_atr_mult / syminfo.mintick
        strategy.exit("Short Exit", "Short", stop=short_sl, limit=short_tp,
             trail_points=trail_pts, trail_offset=trail_pts)
    else
        strategy.exit("Short Exit", "Short", stop=short_sl, limit=short_tp)

// ── Signal-based exits ──
if strategy.position_size > 0 and exit_long
    strategy.close("Long", comment="Structure Exit")

if strategy.position_size < 0 and exit_short
    strategy.close("Short", comment="Structure Exit")

// ── Session end exit ──
if session_end and strategy.position_size != 0
    strategy.close_all(comment="Session End")


// ──────────────────────────────────────────────────────────────────────────────
// PLOTS
// ──────────────────────────────────────────────────────────────────────────────

// Bollinger Bands
p_upper = plot(bb_upper, "BB Upper", color=color.new(color.red, 40),   linewidth=1)
p_basis = plot(basis,    "BB Mid",   color=color.new(color.gray, 50),  linewidth=1)
p_lower = plot(bb_lower, "BB Lower", color=color.new(color.green, 40), linewidth=1)
fill(p_upper, p_lower, title="BB Fill", color=in_squeeze ? color.new(color.yellow, 85) : color.new(color.gray, 93))

// HH/LL channel
plot(hi, "Highest High", color=color.new(color.green, 30), linewidth=2)
plot(lo, "Lowest Low",   color=color.new(color.red, 30),   linewidth=2)

// Supertrend
st_plot_up   = plot(use_st and st_uptrend   ? supertrend : na, "ST Uptrend",
     color=color.green, style=plot.style_linebr, linewidth=2)
st_plot_down = plot(use_st and st_downtrend ? supertrend : na, "ST Downtrend",
     color=color.red,   style=plot.style_linebr, linewidth=2)
body_mid     = plot(use_st and not barstate.isfirst ? (open + close) / 2 : na, "Body Mid",
     display=display.none)
fill(body_mid, st_plot_up,   title="ST Up BG",   color=color.new(color.green, 92), fillgaps=false)
fill(body_mid, st_plot_down, title="ST Down BG",  color=color.new(color.red,   92), fillgaps=false)

// Entry signals
plotshape(long_entry  and strategy.position_size <= 0, "Buy",
     shape.triangleup,   location.belowbar, color.lime, size=size.normal)
plotshape(short_entry and strategy.position_size >= 0, "Sell",
     shape.triangledown, location.abovebar, color.red,  size=size.normal)

// Squeeze dots on zero line (shows when BB is compressed)
plotshape(in_squeeze, "BB Squeeze Active", shape.diamond, location.bottom, color.yellow, size=size.tiny)

// Session background
bgcolor(use_session and in_ny_session ? color.new(color.blue, 95) : na, title="NY Session BG")

// Position background
bgcolor(strategy.position_size > 0 ? color.new(color.green, 95) :
     strategy.position_size < 0 ? color.new(color.red, 95) : na, title="Position BG")


// ──────────────────────────────────────────────────────────────────────────────
// INFO TABLE (left side — strategy state)
// ──────────────────────────────────────────────────────────────────────────────

var info = table.new(position.top_left, 2, 10, border_width=1)
if barstate.islast
    table.cell(info, 0, 0, "INDICATOR",  bgcolor=color.new(color.gray, 80), text_color=color.white)
    table.cell(info, 1, 0, "VALUE",      bgcolor=color.new(color.gray, 80), text_color=color.white)

    table.cell(info, 0, 1, "Mode",       text_color=color.white)
    table.cell(info, 1, 1, entry_mode,   text_color=color.yellow)

    table.cell(info, 0, 2, "Supertrend", text_color=color.white)
    table.cell(info, 1, 2,
         use_st ? (st_uptrend ? "UPTREND" : "DOWNTREND") : "OFF",
         text_color=use_st ? (st_uptrend ? color.green : color.red) : color.gray)

    table.cell(info, 0, 3, "BB Squeeze", text_color=color.white)
    table.cell(info, 1, 3, in_squeeze ? "ACTIVE" : "---",
         text_color=in_squeeze ? color.yellow : color.gray)

    table.cell(info, 0, 4, "Bandwidth",  text_color=color.white)
    table.cell(info, 1, 4, str.tostring(bandwidth * 100, "#.2") + "%",
         text_color=in_squeeze ? color.yellow : color.white)

    table.cell(info, 0, 5, "HH (" + str.tostring(lookback) + ")", text_color=color.white)
    table.cell(info, 1, 5, str.tostring(hi, "#.##"), text_color=color.green)

    table.cell(info, 0, 6, "LL (" + str.tostring(lookback) + ")", text_color=color.white)
    table.cell(info, 1, 6, str.tostring(lo, "#.##"), text_color=color.red)

    table.cell(info, 0, 7, "R:R", text_color=color.white)
    table.cell(info, 1, 7, str.tostring(sl_atr_mult, "#.1") + " : " + str.tostring(tp_atr_mult, "#.1"),
         text_color=color.yellow)

    table.cell(info, 0, 8, "NY Session", text_color=color.white)
    table.cell(info, 1, 8, in_ny_session ? "ACTIVE" : "CLOSED",
         text_color=in_ny_session ? color.lime : color.gray)

    table.cell(info, 0, 9, "Position",   text_color=color.white)
    table.cell(info, 1, 9,
         strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT",
         text_color=strategy.position_size > 0 ? color.green : strategy.position_size < 0 ? color.red : color.gray)


// ──────────────────────────────────────────────────────────────────────────────
// BACKTEST DASHBOARD (right side — performance stats)
// ──────────────────────────────────────────────────────────────────────────────

if show_dashboard and barstate.islast
    total_trades   = strategy.closedtrades
    total_wins     = strategy.wintrades
    total_losses   = strategy.losstrades
    win_rate       = total_trades > 0 ? (total_wins / total_trades) * 100 : 0.0
    net_profit     = strategy.netprofit
    net_profit_pct = strategy.netprofit_percent
    gross_profit   = strategy.grossprofit
    gross_loss     = strategy.grossloss
    profit_factor  = gross_loss != 0 ? math.abs(gross_profit / gross_loss) : 0.0
    max_dd         = strategy.max_drawdown
    max_dd_pct     = strategy.max_drawdown_percent

    float sum_win  = 0.0
    float sum_loss = 0.0
    int win_count  = 0
    int loss_count = 0

    if total_trades > 0
        for i = 0 to total_trades - 1
            pnl = strategy.closedtrades.profit(i)
            if pnl > 0
                sum_win  += pnl
                win_count += 1
            else if pnl < 0
                sum_loss += pnl
                loss_count += 1

    avg_win  = win_count  > 0 ? sum_win  / win_count  : 0.0
    avg_loss = loss_count > 0 ? sum_loss / loss_count : 0.0
    avg_rr   = avg_loss != 0 ? math.abs(avg_win / avg_loss) : 0.0

    int long_wins    = 0
    int long_losses  = 0
    int short_wins   = 0
    int short_losses = 0

    if total_trades > 0
        for i = 0 to total_trades - 1
            is_long = strategy.closedtrades.size(i) > 0
            is_win  = strategy.closedtrades.profit(i) > 0
            if is_long
                if is_win
                    long_wins += 1
                else
                    long_losses += 1
            else
                if is_win
                    short_wins += 1
                else
                    short_losses += 1

    total_longs  = long_wins + long_losses
    total_shorts = short_wins + short_losses
    long_wr  = total_longs  > 0 ? (long_wins  / total_longs)  * 100 : 0.0
    short_wr = total_shorts > 0 ? (short_wins / total_shorts) * 100 : 0.0

    wr_color  = win_rate >= 60 ? color.green : win_rate >= 50 ? color.yellow : color.red
    pf_color  = profit_factor >= 1.5 ? color.green : profit_factor >= 1.0 ? color.yellow : color.red
    pnl_color = net_profit >= 0 ? color.green : color.red

    var table dash = table.new(position.top_right, 3, 14,
         bgcolor=color.new(color.black, 80), border_width=1, border_color=color.gray)

    table.cell(dash, 0, 0, "BACKTEST RESULTS", text_color=color.white, text_size=size.normal, text_halign=text.align_left)
    table.cell(dash, 1, 0, "",                 text_size=size.small)
    table.cell(dash, 2, 0, "",                 text_size=size.small)

    table.cell(dash, 0, 1, "─────────────", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 1, "────────",      text_color=color.gray, text_size=size.small)
    table.cell(dash, 2, 1, "",              text_size=size.small)

    table.cell(dash, 0, 2, "Total Trades",  text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 2, str.tostring(total_trades), text_color=color.aqua, text_size=size.small)
    table.cell(dash, 2, 2, "",              text_size=size.small)

    table.cell(dash, 0, 3, "WIN RATE",      text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 3, str.tostring(win_rate, "#.1") + "%", text_color=wr_color, text_size=size.normal)
    table.cell(dash, 2, 3, str.tostring(total_wins) + "W / " + str.tostring(total_losses) + "L",
         text_color=color.gray, text_size=size.small)

    table.cell(dash, 0, 4, "Net Profit",    text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 4, str.tostring(net_profit, "#.2"),        text_color=pnl_color, text_size=size.small)
    table.cell(dash, 2, 4, str.tostring(net_profit_pct, "#.1") + "%", text_color=pnl_color, text_size=size.small)

    table.cell(dash, 0, 5, "Profit Factor", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 5, str.tostring(profit_factor, "#.2"),     text_color=pf_color, text_size=size.small)
    table.cell(dash, 2, 5, "",              text_size=size.small)

    table.cell(dash, 0, 6, "Max Drawdown",  text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 6, str.tostring(max_dd, "#.2"),            text_color=color.red, text_size=size.small)
    table.cell(dash, 2, 6, str.tostring(max_dd_pct, "#.1") + "%", text_color=color.red, text_size=size.small)

    table.cell(dash, 0, 7, "─────────────", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 7, "────────",      text_color=color.gray, text_size=size.small)
    table.cell(dash, 2, 7, "",              text_size=size.small)

    table.cell(dash, 0, 8,  "Avg Win",  text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 8,  str.tostring(avg_win, "#.2"),  text_color=color.green, text_size=size.small)
    table.cell(dash, 2, 8,  "",          text_size=size.small)

    table.cell(dash, 0, 9,  "Avg Loss", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 9,  str.tostring(avg_loss, "#.2"), text_color=color.red,   text_size=size.small)
    table.cell(dash, 2, 9,  "",          text_size=size.small)

    table.cell(dash, 0, 10, "Avg R:R",  text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 10, str.tostring(avg_rr, "#.2"),
         text_color=avg_rr >= 1.0 ? color.green : color.red, text_size=size.small)
    table.cell(dash, 2, 10, "",          text_size=size.small)

    table.cell(dash, 0, 11, "─────────────", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 11, "────────",      text_color=color.gray, text_size=size.small)
    table.cell(dash, 2, 11, "",              text_size=size.small)

    table.cell(dash, 0, 12, "Long WR",  text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 12, str.tostring(long_wr, "#.1") + "%",
         text_color=long_wr >= 60 ? color.green : long_wr >= 50 ? color.yellow : color.red, text_size=size.small)
    table.cell(dash, 2, 12, str.tostring(total_longs) + " trades", text_color=color.gray, text_size=size.small)

    table.cell(dash, 0, 13, "Short WR", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 13, str.tostring(short_wr, "#.1") + "%",
         text_color=short_wr >= 60 ? color.green : short_wr >= 50 ? color.yellow : color.red, text_size=size.small)
    table.cell(dash, 2, 13, str.tostring(total_shorts) + " trades", text_color=color.gray, text_size=size.small)
